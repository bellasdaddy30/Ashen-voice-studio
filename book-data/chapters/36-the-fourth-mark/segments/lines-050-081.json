[{"id": "96c9e276-4320-4f6b-b702-ac123f41df1b", "text": "Three measured blows.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c43a56c3-1072-43bc-a16b-bed05fbe4ebb", "text": "A pause.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6569354e-de0e-4928-993f-aa91d18144d7", "text": "Then a fourth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0b9227a7-c2e6-4768-a35e-8801e13e6812", "text": "Zik tightened his grip on the journal. The leather felt warm beneath his fingers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "31fe6ce4-c888-4691-ac47-412aa8638614", "text": "We need to go.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3b2aa534-0609-4be1-bdb7-2a56b674db65", "text": "Where?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c5537dda-0d53-4e10-a7c7-01a07e0575da", "text": "Balag asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "031a650e-abac-4a05-86e1-0dd6fe76fd8c", "text": "Zik couldn't see the wall anymore, but he could still feel it, the way a man knows where a doorway stands in a familiar room even with his eyes closed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a8ce45c5-473d-4f8f-9798-91d501ab1eb0", "text": "The knocking.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "810ea45b-8e1a-4859-9078-39fb75d900a0", "text": "No one argued.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9bf5e112-0a4d-40f0-acc1-43aedc4217a7", "text": "They followed the sound because it was the only direction the darkness had left them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "03f925f5-401e-4afc-8d22-54e3798b8f16", "text": "Zik walked first, one hand sliding along damp stone, the journal pressed beneath his arm. Behind him he heard Ninsun's footsteps falter only once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cdf7c2bc-f12a-4271-82bd-c75731ec61a7", "text": "Not from fear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4079af6d-2eb8-4173-87cc-56efed78cb95", "text": "From hesitation.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fa5982ad-0d00-46ad-bee0-69a04311d611", "text": "As though she had already begun wondering whether they had left something unfinished.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b1de5d14-be01-49b8-b57f-70b92e2826f5", "text": "I'd like it recorded,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8d569465-b8c6-4a88-8c8e-275860edd322", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "4e8b3c94-ec27-4656-b877-13640ae795a7", "text": "That I objected to following the invisible thing that knocks.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7d8c7095-0284-4ea4-bf93-8053e9e9f977", "text": "You didn't object,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "Post-vision (Ch.29+): same voice, flattened affect. Even pitch, slower, no reach.", "generated": false},
{"id": "d35bbb0e-555e-419e-9861-f16fabeb266a", "text": "Enhedu said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "5c36ec59-efd4-4f87-9225-aa7d5ae503ac", "text": "You raised the torch and went first.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "Post-vision (Ch.29+): same voice, flattened affect. Even pitch, slower, no reach.", "generated": false},
{"id": "36e7a3ad-7ec6-4ccf-b1f1-8247f47ca775", "text": "I objected internally.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "31d9ed14-8ce4-4a65-b685-9a661622b5dc", "text": "That seems convenient.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "Post-vision (Ch.29+): same voice, flattened affect. Even pitch, slower, no reach.", "generated": false},
{"id": "46bb2e32-c9f7-4b72-8e63-457d4529bcaf", "text": "It saves time. Imagine how slow we'd move if I explained every damn sensible thought I had.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8918a245-b51d-44a4-b959-df007f97c879", "text": "Enhedu's mouth shifted at one corner.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "28e9e499-1f36-4056-b136-f646d709d951", "text": "I've never had to imagine that.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "Post-vision (Ch.29+): same voice, flattened affect. Even pitch, slower, no reach.", "generated": false},
{"id": "dd428203-9ed7-4d0d-a9ec-9ffed23b8707", "text": "Zik's thumb crossed the scar in his palm. The pressure behind his eyes had diminished after they left the chamber, though it had not vanished. It waited behind his thoughts like the last note of a struck bell, too low to hear but still present in the bone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a1b41bdf-0908-48a7-ba6e-bb7d23e7d966", "text": "Behind them came the soft mineral sigh of stone settling into stillness.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "14df1851-109f-418a-a5aa-b436071e4926", "text": "Zik resisted the urge to look back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cd1fb372-17ab-4ff5-b372-a8b0330f86f7", "text": "Somehow he knew the fourth mark remained where they had left it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "300f6ea9-c735-4f7c-bb51-41944f625f01", "text": "Not completed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f9d169aa-375c-4e07-9633-213a34b39e2f", "text": "Waiting.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
