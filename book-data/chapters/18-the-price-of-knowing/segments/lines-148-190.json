[{"id": "bb6e4d8f-84ce-4616-acc1-a071c04ebddb", "text": "They hadn't.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "96619fee-7b9c-4b4a-a3a9-d15677dc3e2d", "text": "Zik's breath stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d48f55ce-370e-4d06-b8cc-c28bb1afd0a5", "text": "He looked toward the sleeping pallet. His mother had not moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "509d84e0-2120-4075-8a9b-dfa5f0113c35", "text": "The house was silent except for the kiln. He looked back at the journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bffbe54a-04f2-4d08-a858-c5c60190b698", "text": "The ink beneath the sentence was still wet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a88bd7e0-f6f6-48a8-9eaa-eaa81ee1ee8b", "text": "Zik touched it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a0408093-3ea4-4306-9d4e-dc0cfd653957", "text": "The mark in his palm burned. He pulled his hand away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a758ce06-f84f-4396-b3af-9ba974bd1b38", "text": "Zik closed the journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5022e32e-7dc0-4391-ad1f-55849ca2db65", "text": "He closed the journal carefully.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5fd6f500-8a8e-4ab5-bad9-ba8ac949e292", "text": "The leather settled beneath his hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7f071a8e-15b0-4b57-85dc-d3ea57efe229", "text": "His mother still slept.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8ae7ff3f-6729-4394-878b-cd8edd6c14c9", "text": "The kiln rumbled beneath the floor exactly as it had every night since he was a child.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c71ff5ad-02ea-48af-a083-8b21b8acc65f", "text": "Nothing inside the room had changed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "66434b69-b22a-48c5-8284-c592f9c1fc75", "text": "Everything outside it had.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1acf9024-01e0-4753-bcd2-56fc4bad579c", "text": "Zik slung the satchel over his shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c939eec9-2c1c-4c06-a840-3307e430e910", "text": "At the doorway he paused.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "877feb99-d7f7-402b-b763-5dca8ea504f8", "text": "He almost woke her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8ab87957-a0a2-4d97-b4b1-fb4d84bb61e1", "text": "Instead he repaired the cracked frame with two careful pushes of his thumb until the wood sat flush again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "714589d3-0aad-4bd7-b690-076255d6ab00", "text": "Habit.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b07a51f5-abb7-459b-b6ca-ea1b4c2d5cf5", "text": "Then he stepped into the alley.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c4af621b-4f0a-4cbf-b383-0384e21d3456", "text": "The city breathed around him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8c5209df-5351-4e12-8126-af2ea76cd753", "text": "Torchlight.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f67c793d-170d-4c3f-b9d3-84b72a5f7c52", "text": "Voices.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "04471534-39d5-4d31-88c3-5a8e889707f0", "text": "Wheels.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "07760972-9a45-49cd-bffd-5cc0f3c16d19", "text": "Dogs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "37b3265a-a548-45d8-967d-f4e3f099c2da", "text": "Somewhere, someone laughed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ccfbe6ec-242d-4aa5-8f38-b90e6b58080b", "text": "Halfway to the street the journal moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6f9131a4-500a-4c52-89ef-092828804f68", "text": "Once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "766d8c1f-0c23-4188-8e16-10e4405ecefa", "text": "Not the shifting of paper.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "244b1282-afc6-4501-b7a3-bca69d652892", "text": "A knock.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3b45fbc6-b46f-4f5c-9c05-05159816dca5", "text": "Zik stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b5ed8b3-f44b-40b7-be6c-894d5faac9f0", "text": "The mark beneath the linen pulsed once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "51be9faa-ec8f-4353-a1e6-30eac0b3433f", "text": "Silence.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b674adcf-0732-4921-9c90-0c5b56667cc7", "text": "Then, from somewhere deep beneath Uruk, something answered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dcdce2b8-f4f8-4d63-ae35-60413d5b5bac", "text": "Not loudly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "56fd7727-0c9b-49fd-afd3-0a1bcfb21d58", "text": "Not with sound.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7885cfe5-f003-48b8-bdf9-ea40b5036b07", "text": "With recognition.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a68e5f2f-b06d-4296-8b82-14e360170d67", "text": "Zik stood motionless in the alley.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f444ab60-cf11-4515-aacd-6a086c486bdb", "text": "He looked toward the dark western quarter where the others would be waiting before dawn.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b8acf07f-8e48-4a8f-a51b-edf0f430bfb0", "text": "Then back toward his mother's house.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a80f49cd-2682-42c0-9a29-1324a629e8df", "text": "The journal became still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ee6057d7-9d88-457a-91bc-8fb5bb9de1bc", "text": "It did not feel asleep.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f6e5a451-e4ae-40aa-b900-bd2d39f76a2a", "text": "It felt as though it had received an answer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
