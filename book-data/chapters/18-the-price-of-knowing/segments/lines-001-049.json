[{"id": "77c1c898-c884-404e-b788-a91563a19980", "text": "CHAPTER 18", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "aca186fe-bd6e-47ba-8820-920fe6c8070e", "text": "The Price of Knowing", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "3eff8521-ebb8-4528-a9ee-128a77487d40", "text": "No one spoke after Bel-iddin's final words.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "136266f0-fc16-4827-8a23-586c03741611", "text": "…is still waiting below.", "speaker": "Bel-iddin", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Text calls this 'Bel-iddin's final words' though Zik spoke it at the end of Ch.17. CHECK attribution.", "generated": false},
{"id": "ef0e41e5-a2e2-4e1a-8052-36b7b5f0d72d", "text": "The journal lay closed between them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8977c06b-6915-4c6e-89c9-38572372682c", "text": "Rain dripped from the reed canopy into the basin beside the well. Somewhere beyond the courtyard wall a donkey brayed, followed by an argument over whether it belonged to the temple or to the man trying to drag it away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8b259caf-8ec4-4cb6-b4d4-d10592613f65", "text": "Balag broke the silence first.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c9fd3c58-fd95-45de-ae41-2057a9dd05fc", "text": "If we're doing this again, we leave prepared.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a896151e-8380-430f-9cba-d9fabfeb0eb3", "text": "Zik nodded.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fbdddc52-8963-44ff-9580-98b647c08e7d", "text": "Rope. Lamps. Water. Oil.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "70bb20fb-8939-43f5-9666-bf6415eb165b", "text": "Ninsun gathered her copied notes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "09cc3cbb-da2a-4caa-a8ff-b0f031c0221a", "text": "I'll inventory what we already have.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6c3e66b7-5f0f-4180-be98-08fd05e0bb59", "text": "Enhedu stood.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e5be8e68-1697-4711-acce-09b36aa1c5c0", "text": "I'll see what can be bought without attracting attention.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8290d75e-0058-45a0-9c70-883bf74422ce", "text": "Zik tightened the satchel across his shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0d5420f1-2e07-4504-8c95-e295bc05aafc", "text": "My equipment is still at my mother's house.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5b1c8057-97c8-40d8-b376-1aa1622a3576", "text": "Balag looked at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5f8264d8-2b86-46ad-8e14-3d2a004ac53b", "text": "Then don't wander.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "98e7368e-9733-462e-8b3a-506a73dc4946", "text": "Zik almost laughed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dfa1016c-d0f9-4ec5-ada9-10f381658f8a", "text": "You know me better than that.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dd3ac37c-9337-44d1-aade-637faebdb87b", "text": "He stepped into the evening streets.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fc0685b5-ccee-45ea-8884-b6e470cb3866", "text": "The streets were still crowded with evening traffic. Pilgrims moved toward the temples in loose, chanting groups. Merchants dragged carts through the torchlit haze. Prostitutes leaned in the shadows beneath painted doorways, calling to men who pretended not to hear them. Priests moved through the crowd with the self-important expressions of men who believed the gods had personally appointed them to supervise everyone else's mistakes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "34554528-df38-4155-a6c7-b5b0f605e8cf", "text": "Normal. Manageable.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9068d952-dffc-4f2e-a385-a0077bdef678", "text": "Zik preferred the city when it was loud. Noise gave a man cover. In a crowd, people saw what they expected to see: a trader, a scavenger, another hungry bastard trying to make enough silver to survive the month.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "785d7b1d-aa06-4027-a5aa-29890bb8f607", "text": "Everything had a price.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ec4f4406-fba8-49b5-9347-b64c2e55b9b1", "text": "His own tools remained at his mother's house.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8f8abf59-bc51-4f1a-a0ad-c50e5db99412", "text": "He headed toward his mother's, keeping to the shadows out of habit. Halfway there he noticed the first wrong thing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "aab2a7c2-6aa0-4ffa-b274-01919d68cfb5", "text": "A temple scribe was watching him from across the street.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b3565f94-848f-4335-b040-88f45bca9ef8", "text": "The man was young, well-dressed, and clean enough to look suspicious on principle. His linen robe was too fine for the neighborhood, and the wax tablet tucked beneath his arm was decorated with a small silver seal. He was the kind of man who usually never looked twice at men like Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5cdee815-2544-4b1e-bb9e-66e8406210d8", "text": "But he was looking now.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "90b3876d-4959-480e-ba14-c050f988dfc5", "text": "Zik kept walking.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8d978e3e-c781-435e-bc14-68a9886da0f9", "text": "The scribe kept watching.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1b1d220a-8ae7-4b11-aba0-6e453c377e9e", "text": "Zik slowed near a stall selling bronze chisels. The scribe stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bfade725-c698-41ba-a68e-32f5a201ddda", "text": "Zik turned left.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eb7b9ea2-cfff-46d5-8b3e-19329e5be3fc", "text": "The scribe followed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0f07fd34-8b63-43b7-a926-b303cf3af6d1", "text": "Zik did not look back again. He changed direction twice, moving through the evening crowd with the casual rhythm of a man who had nowhere particular to be. He passed a spice seller, crossed behind a row of pottery stalls, and slipped into a narrow alley between a wine merchant's warehouse and a shuttered bakery.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d88fdf4e-31e1-4ca4-9bcc-eb220e4dc96e", "text": "The alley smelled of old water and rotting grain. Zik waited.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "40b7bead-d8d5-4ab2-9912-cf4727a1144f", "text": "The scribe entered thirty seconds later.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6fbecd2d-50b2-4173-a755-2fbac6b661bb", "text": "Zik stepped out behind him and pressed a knife lightly against his side.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "177ead8b-e0b9-4070-ba90-c6e60829559c", "text": "Temple business or personal?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5610af6a-e2d4-45b4-bde9-65bf12a4e62f", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "92aad089-ef33-492f-b999-0d987199b217", "text": "The scribe stiffened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "fdd24019-88a4-42f0-8f33-758fd1077b34", "text": "Neither.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ed54e70c-7ed5-4911-9eca-53e4d1b4eb6b", "text": "That wasn't one of the options.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b2aa8803-47df-4152-be59-baa9a49d7da1", "text": "The young man swallowed. Zik pressed the blade a little harder. Not enough to cut. Enough to remind him that the distinction was temporary.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "258f648d-a690-4fea-a3aa-fa02385e7545", "text": "The Collector sends his regards,", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "88696d00-dd4b-470c-aed5-d0182769132c", "text": "the scribe said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "3cf15f45-f9dd-4c7a-855a-1a09e2aa9a2a", "text": "Then send mine back.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5f230b07-aa77-4591-bd07-67d54503a2db", "text": "He would like to speak with you again.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
