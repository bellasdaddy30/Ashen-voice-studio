[{"id": "7e272f93-a336-4052-ab2c-8a60bb256668", "text": "Tell him I'm busy.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "72feb047-61e7-47da-b45e-a3d65a13344f", "text": "Tonight.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "930c7de5-b50c-4233-a49b-4dc9fab9cbca", "text": "Zik smiled faintly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "04e90208-60d0-4b9a-8fcf-6fb9af7cfd04", "text": "That sounded less like a request.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "35c81c8a-b766-4f9b-bdd6-c13ac5df8014", "text": "The scribe glanced toward the mouth of the alley. No one was there. The crowd moved past without looking in.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "16ab1160-0756-43d4-a6f6-9283a8d2aa7a", "text": "The Collector is prepared to offer ten times what you received today.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "10769575-5646-4052-ae6c-da86c6433cb9", "text": "For the beads?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "92a40c02-9e3c-440e-9b6f-cb04d7424721", "text": "The scribe hesitated.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e8a524a1-97a5-443d-8bd7-f4ceed82fb10", "text": "Zik's smile disappeared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "80ff2134-d541-4a46-8a39-64a6687e5130", "text": "For the journal,", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "40fb5543-3eee-4fbb-b11c-dcda3d0b8832", "text": "the scribe said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "8af4f974-c457-4112-8e95-1bd1ecb88951", "text": "The knife stopped moving.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5bebfba6-63e5-464c-ab31-49a494cc1a06", "text": "He continued quickly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "3b15d655-89d3-4dcd-8fb3-48a0be7070fb", "text": "Or anything else you removed from the chamber.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "647c0366-81a2-4a02-b5bf-f6fb85b91b2c", "text": "For a moment the alley seemed to contract around them. Zik had never mentioned the journal. He had never told the Collector about the chamber beneath the desert. He had never told him about the skeleton. He had never told him about the symbol appearing beneath his skin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "51224f17-b8e0-499d-9edc-54459b007e16", "text": "The scribe knew about all of it. Or enough of it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a4d00a7b-3da7-4be2-954a-28bd4b38b75f", "text": "How does he know?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0efdc8e2-10c1-4774-a382-fa12a7a92b74", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "6317f802-ff60-4790-8dad-ace7922e26a2", "text": "The scribe's mouth opened. Nothing came out.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9a6224c8-de70-4a0e-bece-405de498db3f", "text": "Zik turned the knife slightly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fc5a4a6d-0b30-4a56-9cba-e1ebe24fed63", "text": "Try again.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f8050d30-2b3b-4a58-9f96-6202e3961798", "text": "The Collector knows many things.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e24bcab7-acfc-41ff-98ee-8f88aa398db1", "text": "That's not an answer.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bfc5c536-2742-4a5b-ae5e-e1cdc4831361", "text": "He says the mark has a way of announcing itself.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "105f28b1-47e3-417a-b712-6915deb2cb4b", "text": "Zik looked down at his palm. The symbol was barely visible beneath the skin—a faint discoloration, an old scar if a man didn't know what he was looking at.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d7a241ad-ba5f-41ab-ac37-55a0c4b9fcfc", "text": "Announcing itself to whom?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d05bfa31-9d4d-45c4-9e4a-cd862fc8b280", "text": "The scribe looked away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "50a2eb19-f11b-4144-8a44-59f27b830e83", "text": "Especially to those who have seen it before.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "05c39bfd-7baa-4600-8452-59aaf008fe5e", "text": "The words settled between them. Zik slowly removed the knife.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dd11bd91-f6a8-4bca-9018-a5ebeb5c3cfa", "text": "The scribe turned to face him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "7ccac9bf-4716-4d84-8bdf-124d4343d00c", "text": "Is that all?", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "16c2cf72-7f56-4b06-a616-c07fe0bdb041", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "254b3150-f965-4c3e-a440-e2ac3e8ff0fa", "text": "Zik waited.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1dba5c0a-2c02-47d4-bb5a-f938faf226f0", "text": "The scribe's face had gone pale.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0bf42430-cdd0-4ecd-8430-bbf76c6a8d0d", "text": "The Collector says you should not go back.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5b4d7f82-6ee5-414c-96b6-ab886766f169", "text": "Zik stared at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1ccac686-88b9-4d9d-a1da-fc63c161dbe8", "text": "To the site?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8495fc14-2ad0-4c2f-918b-df7f148fa19a", "text": "The scribe said nothing. That was answer enough.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "061427db-cd2d-483a-b44e-df291044b3fa", "text": "Zik stepped closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "a0d9b783-3648-4f5a-b8e7-476c06f46c1a", "text": "Did he tell you why?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "68c50b7c-86d7-495c-822a-183530a12029", "text": "The scribe's eyes flicked toward the knife.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a970950f-7e2a-4900-9088-e602daf30b40", "text": "No.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fe13c110-cbd7-47e5-8e8d-c4b0e65dbf2b", "text": "Did he tell you what happens if I do?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b076ec03-cef2-419e-a946-80ae65910053", "text": "No.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5fa70baa-d076-430d-a0d5-0058c965ca87", "text": "Then you have wasted both our time.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "df8f8c60-1c9f-49d7-8db0-521623530632", "text": "Zik stepped aside.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "702d5db8-55d3-49d0-a239-a78adfd615e7", "text": "The scribe hurried past him, then stopped at the end of the alley.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7af54441-295a-46ad-b529-73e4627e99df", "text": "Zikir.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "21e7eef7-3b65-4e48-8bce-575f8676638f", "text": "Zik looked over his shoulder. The scribe's face had changed. The nervousness was gone. For just a second he looked older.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
