[{"id": "4829806f-2acb-4d69-bc32-4b0329e6e54e", "text": "She looked up at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2a73e9bd-b744-47ca-a408-f5af1a980933", "text": "And stone remembers.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1e39e099-09de-4de5-aeea-6c11b57968a5", "text": "No one answered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3a45ffb4-3543-483b-b802-e20a9b9dbf0e", "text": "Zik found himself staring at the narrow strip of untouched floor between the scratches and the wall. It could not have measured more than a handspan, yet it seemed impossibly wide. Whoever had dragged something here had reached the final distance…and never crossed it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4ccf7143-e601-48f7-b6da-bdab4d954464", "text": "He wondered why.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b5b6556-ef9b-4b66-aab8-3486a30b9c95", "text": "The pressure behind his eyes returned instantly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9f6c5c83-5aa8-4c04-9148-9aedb0cff5d1", "text": "He drew a slow breath and forced the thought away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c97e6999-e9ad-4745-9fd9-d0284ed6a319", "text": "The sensation faded before it became pain.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6232bc9b-cfd9-48a9-8c1e-b7ad71e46e1f", "text": "Ninsun noticed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bc1105a5-ceae-4206-97e1-17dbf8375bec", "text": "It happens sooner now.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fa6c2acf-81b4-4bba-be1f-b90feb1dd1bd", "text": "I wasn't asking anything.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cf21351e-6d3b-4889-9002-0f5cac171463", "text": "You were about to.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "349c976d-4576-40bb-a3c6-e48e48c7e2d6", "text": "Silence settled over the chamber again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6075b1f6-5cc2-4256-a47f-4e41feab07fa", "text": "The City's breathing seemed slower now, deeper somehow. Zik couldn't tell whether the sound had actually changed or whether the stillness around them had simply made it easier to hear. The vibration beneath his boots came and went with each distant breath, subtle enough that he might have imagined it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b16804ad-0fa3-4a75-887f-f6e5896499a4", "text": "Then something shifted beneath his arm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "80ea25b5-8421-438b-a126-e43f24029e2a", "text": "He frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3e85cf71-0827-487c-82bd-4442c2111c0b", "text": "The journal had not slipped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "04c23b06-9d98-49e4-9588-9033cc6fbf05", "text": "It had become heavier.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "15da5ff3-4ece-481d-bc5d-235aacee5d14", "text": "Almost reluctantly, he drew it into both hands.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "634a5a0d-b063-4fed-b775-ee54ed50d8c0", "text": "I didn't—", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0ea7af75-ee88-4052-bfca-53af1bf0a7f5", "text": "The leather cover eased open before he could finish speaking.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4f29f65c-0e94-4b32-bd63-c7d09f647bb4", "text": "No hidden mechanism revealed itself. No invisible force tore the pages apart. The journal simply opened to a blank sheet with the quiet certainty of a ledger being consulted by someone who already knew where the next entry belonged.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b10ef771-7387-48c3-8b16-d8101b5d0912", "text": "The parchment remained empty for several heartbeats.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f96e58b7-4bf6-4723-9431-00ee07c8c044", "text": "Then dark ink began to rise through the fibers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a099f045-b63e-415e-8d09-13dbc6be5d89", "text": "None of them moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "27548239-1b68-4c50-891f-8ea0617f75fc", "text": "The letters formed themselves with deliberate precision until the first line stood complete.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5d1894ab-fac2-4556-b5f8-9c0c8a46a741", "text": "THE RULE DOES NOT CHANGE.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "ded375e7-4554-4a05-94af-08d06f4bdd06", "text": "Another line emerged beneath it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "56921b2b-9439-488a-acd7-a232d9117106", "text": "YOU ALREADY KNOW WHAT HAPPENS IF YOU ASK.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "c53121c7-050e-48df-a735-bd68e86178e4", "text": "Balag took an involuntary step backward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7dd0b11f-514e-454e-9b9c-3a3963bfa2ae", "text": "Tell me the rest of you can see that.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cdcb0dd6-b49e-4881-a5eb-3bdf02b1421e", "text": "I can,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "Post-vision (Ch.29+): same voice, flattened affect. Even pitch, slower, no reach. Whispered.", "generated": false},
{"id": "e333242f-aa2a-462b-866c-d858f786234f", "text": "Enhedu whispered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "be705a13-cc2f-4302-8739-a6cd9628f483", "text": "Ninsun never looked away from the page.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4192663e-3104-4f02-814b-f1297dc53ae9", "text": "It isn't answering a question.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "88179490-babc-409c-8f2b-dd51b28a3ad9", "text": "What is it answering?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6d48d61a-86c8-42db-b88f-213f82befe10", "text": "Balag asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "d9fb57ec-faec-4153-b4e7-8b9020e24760", "text": "Our presence.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4d1f2c43-aa7c-4224-8ae8-100321d8a4cc", "text": "She glanced toward the scratches.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9fdf5aee-80d0-4229-bfef-1a17c01489b5", "text": "We came looking for an answer. That was enough.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3bc00f68-4dfa-4de3-b2de-c0a30a536218", "text": "Zik stared at the words until they blurred.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "74abca9a-158f-4bb3-926f-ad38f4cc6b49", "text": "They didn't feel like a threat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "08d2c2bd-67f6-4441-8db1-f8e925e763b8", "text": "They felt like a record.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6420a4fc-019c-4b15-91ec-7b7446fc822b", "text": "I know,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "Whispered.", "generated": false},
{"id": "e2dc9ae3-aebb-4eb6-98c4-5225a9855c6b", "text": "he whispered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "c1a0a12b-3682-4217-8e69-0f10a456ad95", "text": "The pressure behind his eyes vanished not because he had obeyed, but because something inside the City had acknowledged him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7b8cfd7a-4ab6-44d1-b39f-a50b35781302", "text": "A low vibration moved through the floor before anyone could speak. It began beneath Zik's boots and spread outward, passing through the chamber in widening pulses that set dust trembling along the base of the wall. The sound was too deep to hear clearly, but he felt it in his teeth and in the hollow behind his ribs. Above them, stone ground against stone with the slow, deliberate force of something testing its jaw.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "26395c51-bdff-4775-bfc5-4c9478561dec", "text": "Balag looked up.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "c84dde4d-929e-4115-969b-8a1d2c5c841b", "text": "That sounds bad.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
