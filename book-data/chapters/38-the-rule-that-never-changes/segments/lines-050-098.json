[{"id": "9a066bf0-2e88-4539-bb1d-09206b8f7e5a", "text": "…That's annoyingly sensible.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fb3d5b26-6903-4782-8faf-1b239f324d43", "text": "It isn't the question that's dangerous,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "da6e1866-44bf-4ac1-8ed4-f055cc0237a9", "text": "Ninsun said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "dcb421af-78a0-44a5-bfc1-b01b200d70e9", "text": "It's whatever survives inside you after the answer.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b86fa691-0554-42da-aa20-5d476860d0b3", "text": "The corridor ended so abruptly that Balag nearly walked into her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2aa7f858-5278-450f-9483-5482162df0c2", "text": "All four of them stood before a blank wall of black stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e957dd98-8cea-4f18-99dc-a8fd71600bbe", "text": "It was unmistakably the same material they had found beneath the desert months earlier: smooth, almost oily to the touch, without mortar joints or visible tool marks. There was no doorway, no crack, no inscription. Only a single symbol had been carved into its center—a vertical line descending into an open circle.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fb6c929e-36fe-4c4b-b1b8-cecbb7ae337d", "text": "For several moments no one spoke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "165733a2-2364-4132-86bf-ac070ebff3ac", "text": "Enhedu stepped forward first, lifting her torch until the flame almost touched the carving.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "434ed69e-f858-49fc-af5e-0f13e3e935f2", "text": "The cuts are clean.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "Post-vision (Ch.29+): same voice, flattened affect. Even pitch, slower, no reach.", "generated": false},
{"id": "af9d5cda-c54a-442b-9ae3-738fbbe50a8a", "text": "Ninsun crouched without replying. She set her satchel aside and brushed a layer of dust away from the base of the wall with the edge of her sleeve.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d675a509-0ea1-426c-bb3d-b34a508d70b7", "text": "What are you looking for?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "89d8e11f-f7a1-427f-ba83-831b45b49046", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "94bbc648-42af-485c-a02b-396e7913791a", "text": "Anything.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c8634087-f36a-4721-aaf5-edfd0d4f3902", "text": "She leaned closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fc25b783-046a-4faa-b0af-c0ae6d44cad0", "text": "The City repeats itself. If this place mattered before we arrived, someone else came here.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "da022e12-c7f1-4a19-bf9b-395423a58d6b", "text": "And if they did?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "05d9471b-a329-4356-b605-9ef025c016f1", "text": "Balag asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "2fc0f280-10b7-4160-bf41-b6bf32833f6b", "text": "They left evidence.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e10b11bc-4223-4a6e-8d2d-8cf256da2bcd", "text": "He snorted softly but crouched beside her anyway.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8487b7ac-0e7d-46a8-a552-0dc0d192fad7", "text": "The chamber fell quiet except for the distant breathing that rolled through the stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a81aedea-7455-4bb0-a90f-1178cbcd1db7", "text": "Then Ninsun stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "728115c5-5c5c-476f-9ca7-181cb595598a", "text": "There.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "42980450-0104-4fee-8da8-09c4e339fa93", "text": "She wasn't looking at the symbol.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7fdc3c26-3477-4630-bc10-5fc55909a668", "text": "She pointed at the floor.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8a23bcfc-3b64-499b-b152-d4223792525b", "text": "There are scratches.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f13f0cbb-e5ce-4d8b-a82b-5f693a11e5bd", "text": "Zik knelt beside her. At first he saw nothing beyond dust and worn stone. Then the torch shifted, and faint parallel grooves appeared beneath the light.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b5e18e04-d342-497a-bf83-6eeb69a7fb24", "text": "Balag ran a thumb across one of them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b18c8a2-4b30-4a58-83c8-dfc781e19149", "text": "Dragged.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "417d1fd9-d6ee-4557-abd7-5e48b18f039d", "text": "What?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a208c69e-f3fc-4fa9-ad4a-b08930934872", "text": "Something heavy.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "df009777-2a7e-4fa6-b4b8-eb1b0935b52a", "text": "He studied the grooves for another moment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6217a948-9aa7-49e1-b9d8-3b74ad695ee2", "text": "I've seen marks like these moving limestone blocks.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b1065bef-ae8f-4644-b527-f08ab6444da6", "text": "Ninsun brushed away more dust.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2c25b002-17a9-4188-89e8-8fcfd72d7aca", "text": "The scratches stop.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "111c4ace-ed16-4907-a22d-0a8e8cdd33c8", "text": "They reached the wall,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "63abd1b7-c9f1-43f3-aeeb-7831b2798640", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "76648a18-97b7-45c1-bb0b-9a588533a564", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cd283adb-dc2a-4f10-b252-7097b8de8b60", "text": "She swept away another strip of dust.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "122e47c9-edf7-4090-9068-7f46b341f086", "text": "They stop before they reach it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2e9760d4-660c-464a-a7aa-2e54642b4b7b", "text": "The grooves ended in a perfectly straight line a handspan short of the carved symbol. Beyond that point the stone remained untouched, as smooth as polished glass.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4beebb16-17a3-4430-9ecb-f115233016aa", "text": "Balag leaned closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "59e1627e-810d-45ef-8ebf-3a5d65e39bb3", "text": "What difference does that make?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "68a5c2b4-ee70-4f57-b99a-13ace93befe5", "text": "Ninsun sat back slowly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f8ca91ec-0ee0-4bb4-98c5-a07626d4cb66", "text": "If they'd abandoned the work, the marks would wander. They'd hesitate. Correct themselves. Whoever made these stopped exactly where they intended.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "79d90e33-c73c-4201-a47d-898b3d1f9171", "text": "They were interrupted.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8f0fb013-4858-4b7a-bdf7-322ee9050070", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "50d5b4b0-70a9-424e-907c-ceffd18e6b4e", "text": "You don't know that.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f592abf4-bc16-4e6d-8668-8e7ec227b8bd", "text": "I know stone.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
