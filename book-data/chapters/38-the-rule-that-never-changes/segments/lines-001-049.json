[{"id": "e41a9117-a09c-49c5-937e-dffe5f6466ce", "text": "CHAPTER 38", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "bb8a72bf-2ee6-4a07-9121-a25734a1000d", "text": "The Rule That Never Changes", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "0596b3ec-46a5-4bac-885b-da241c5401ae", "text": "The corridors breathed faster now.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "94e82cd0-1531-4557-906f-2521175f9187", "text": "Earlier, the City's slow, deliberate rhythm had reminded Zik of an animal asleep beneath the earth, something so vast that each breath took half a minute to complete. That illusion was gone. The inhalations came unevenly now, broken by long pauses and shallow gasps that echoed through the stone. The silence between them had become worse than the sound itself. Every pause carried the expectation that the next breath might never come.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c8e6ac45-9443-4137-b493-a19c920d3345", "text": "Ninsun walked ahead without looking back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0c6104e8-33c3-4376-87a1-44bd364e2877", "text": "She had stopped trying to hide her exhaustion hours ago. Dust clung to the hem of her robe, and dried blood darkened one sleeve where sharp stone had opened the skin. Yet there was nothing unsteady about her pace. She studied the floor as she moved, holding her torch low enough that its light skimmed across the polished stone instead of disappearing into the darkness overhead.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b9eb6a36-5ca4-4ba8-b383-06c70dcd0fa7", "text": "Zik followed a few paces behind with the journal tucked beneath one arm. It had remained unnaturally quiet since the chamber of names, and somehow that unsettled him more than its interruptions ever had. The silence felt deliberate, as though the book were waiting for something it already knew would happen.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ffa17e51-0886-440d-9598-82b78dd748ef", "text": "Balag broke the silence first.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "04dfc8b0-f412-4b4b-88ad-41ceef6835eb", "text": "I've had enough of corridors.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f17205e7-b8dd-45a4-8d39-e09af14d255a", "text": "No one answered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4d88febe-38aa-4575-a70c-58185493997d", "text": "I'm serious. If I ever get out of this place, I'm building a house with one room. No passages. No bloody hallways. You open the door, there's the room. That's civilized.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "754ac3a1-36e6-4faa-a1d2-4c5c761b1aa7", "text": "Enhedu glanced sideways at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "35032507-4dae-4636-8d56-d3ec785c5fdc", "text": "And where would you sleep?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "Post-vision (Ch.29+): same voice, flattened affect. Even pitch, slower, no reach.", "generated": false},
{"id": "ba5e7d3f-3971-40ee-889a-a5e29d5502c1", "text": "In the room.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "326d773b-63a9-41fe-99dd-d05763e3189c", "text": "And where would you cook?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "Post-vision (Ch.29+): same voice, flattened affect. Even pitch, slower, no reach.", "generated": false},
{"id": "18550cc0-ff12-4a99-be39-e2e8ca985e65", "text": "The room.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4e7bba82-5b67-491c-97c7-d035dd0bf0aa", "text": "She shook her head.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e37be00c-b9b6-4081-b716-f26ab5fb77c8", "text": "You'd burn your own house down.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "Post-vision (Ch.29+): same voice, flattened affect. Even pitch, slower, no reach.", "generated": false},
{"id": "b838f6b9-6b3a-4a91-ac68-a450d6decf25", "text": "Maybe.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ae193218-e977-4040-b558-0d37edf250f2", "text": "He shrugged.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "313059a8-8811-498e-92ee-36c4d281bc12", "text": "Still sounds better than this.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6f6b5497-5d7b-4cc0-9f24-919befdd380f", "text": "His voice faded as the passage narrowed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4fd5487f-56df-4ca0-b6a4-fdcb2ee1b977", "text": "The walls had changed. Earlier they had been cut with the straight, deliberate lines of worked masonry, but here the stone curved inward in slow, uneven folds. Moisture gathered in shallow depressions and reflected the torchlight in dull patches that looked almost metallic. Every few steps Zik caught himself studying those reflections, convinced for an instant that something had shifted just beyond the reach of the light.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "27625e1b-094d-4701-9453-64bdf5ceb68c", "text": "Nothing ever had.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b282877c-f099-49b0-b0a2-99e1300fb162", "text": "The pressure behind his eyes returned without warning.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cb691cae-c6d4-4148-939a-9bac0e3bf48a", "text": "It wasn't pain—not yet. It was the same tightening he had learned to recognize since entering the City, a sensation that began somewhere behind thought itself. Every question he allowed himself to form seemed to brush against it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "10825aa0-5266-4658-ad41-ee1e3d1d30ff", "text": "What is the fourth place?", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "note": "Internal thought; intimate, not voiced aloud.", "generated": false},
{"id": "989a54ce-ba52-4547-a985-777869e512ef", "text": "The pressure sharpened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eecb1114-4264-4ecb-8e72-ef0d63c8dddb", "text": "What happens when—", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "note": "Internal thought; intimate, not voiced aloud.", "generated": false},
{"id": "67b094a7-5782-43ef-98a0-9e69b7615520", "text": "He stopped the thought before it reached its end.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "48d8f65e-f8e7-4b53-a3fb-95365e8de072", "text": "Immediately the sensation eased.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "36b2c6ae-fe43-4ad0-8a6c-3d78ff5767d8", "text": "Ninsun spoke without turning.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "abab6158-3f51-4bac-b4dc-966e8a828215", "text": "You felt it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "86c1df57-b8cc-4cc0-9604-aad4fe7c460b", "text": "Yes.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fbd2ff02-74c0-4c26-862a-a7d01b0b4a51", "text": "It isn't reading your mind.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d2398a2f-20ac-4fa3-9943-029ade723513", "text": "She let her fingertips trail lightly across the wall as she walked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ee9c75ae-19e1-4e57-8963-92b87ab0390e", "text": "It doesn't care what you know. It cares about the part of you that's still trying to know more.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b4957ea6-309c-448f-a603-9f1efa0265c7", "text": "Balag frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "71cd41ca-09bc-41ac-a917-ac5aeabb4466", "text": "That's a ridiculous sentence.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bc5d60c8-c0b3-499c-810f-283f40eb2a8a", "text": "I know.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b139c768-5bb5-48d7-ac9c-c4f596994ed1", "text": "Then explain it like I'm an idiot.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3117edc4-abb0-441d-a48e-1c6580d5cb57", "text": "You've never touched a hot cooking pot twice.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5571afef-86fa-4fa3-a279-fd5842f63a2a", "text": "I have.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3a50e268-ea57-4640-812c-079f00c4db7f", "text": "She looked over her shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c8eb03d3-153e-440c-9ce9-5bc427829a3b", "text": "On purpose?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "51c12fdc-3f9d-4572-a7db-0f27cf30ccfd", "text": "Balag hesitated.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cc2f6626-91c4-4123-b680-9ad4cb3f6874", "text": "…No.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5b69f931-9bbc-4ff9-a0b7-4683ae96d901", "text": "You lost the part of yourself that believed it was worth trying again.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "db681a55-b309-4a36-83df-f377d9b9e79e", "text": "He scratched at his beard.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
