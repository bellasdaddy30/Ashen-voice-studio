[{"id": "a6354f9f-110f-46cf-80bb-3c0a38b312ba", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f9b36048-2c8a-4ceb-972f-eacb194d9a2f", "text": "Zik.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a41459c1-c6fe-4c05-9d9c-25c19b24abde", "text": "He drove the bronze awl into the mortar beside the brick and levered downward. The mortar cracked. Black water leaked from the seam and ran over his hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7a073959-c5cb-4430-b570-fc87b144bf80", "text": "The linen darkened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a27b0482-f35d-4b61-9c29-fc826ffca885", "text": "The spiral beneath it pulsed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e028ead7-50f6-4276-9769-a21d3cf3b512", "text": "The brick withdrew.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0a8287f3-62ad-4792-9f91-38f870a5c33e", "text": "Not broke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f46a337f-dcf8-4ef7-ad53-2e68e8cdbd21", "text": "Withdrew into the wall as though reconsidering.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "725539c8-ad14-4906-b2ec-d4d870629e96", "text": "Zik yanked the satchel free.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "575f5432-f0f8-4fda-be9b-c98890c23992", "text": "Enhedu pulled him through the narrowing gap.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e16c5ad8-bbfc-4455-ae46-99435ab8a5be", "text": "They stumbled into the street together.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "13d0b50e-fc8b-4798-814b-f863cc1caeba", "text": "The water-seller was still shouting.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d27fb747-76d2-4586-a435-fb450bdf40c6", "text": "I measured it in front of you.", "speaker": "Water-Seller", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6ce3bd46-282b-412e-8fe4-4d5c587a64c0", "text": "With your thumb in the cup.", "speaker": "Water Customer", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "afcc5ab5-547a-4403-ab41-10888a572186", "text": "My thumb is not that large.", "speaker": "Water-Seller", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7eca9197-3c05-4845-944c-c5a0e936e24e", "text": "It has always been that large.", "speaker": "Water Customer", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5ad3ce81-7e75-490b-bd26-757f17dc6c4f", "text": "Behind them, the dark opening narrowed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9b85c890-66c8-4c67-bca1-06dbf90e4ca5", "text": "Ninsun turned toward it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e96d769b-3fe7-461b-af8e-f78761faa0ce", "text": "The chamber was no longer visible. Only a strip of black passage remained.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1697cf3c-9138-4051-84af-399684c03044", "text": "A voice came through.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4fe602f0-48df-4410-8d29-d63dc6006ca6", "text": "Ammaru.", "speaker": "The City", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "The City speaking: not fully human. Whispered, wet, close.", "generated": false},
{"id": "d5577467-1bfc-4d7e-9447-6dbd4266e3fe", "text": "Ninsun took a step forward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "644262c9-c888-45dc-9e12-bc6ac1e7ba75", "text": "Balag blocked her with the shaft of his spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "77dd6786-b53b-48ed-92a6-fe923be2212f", "text": "No.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3f2dc090-e045-4779-931c-53eabec8995a", "text": "The passage repeated the name.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b3ea4cce-520f-458e-a688-53c69e553727", "text": "Then another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0e9dce53-b399-4f20-a2d3-f4625df60a5e", "text": "Ninsun.", "speaker": "The City", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "The City speaking: not fully human. Whispered, wet, close.", "generated": false},
{"id": "223da142-23f9-41dc-a902-e316401749af", "text": "Her face went pale.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c8698395-4085-43ac-a379-287fbfe0fa4d", "text": "The opening closed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5975504c-895c-4160-9fba-4f3b8a2b0b9a", "text": "Ordinary brick filled the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "45c5a591-adff-41df-8163-2681d4c64087", "text": "The water-seller's customer shoved a cup into his chest and stalked away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b48ebcb0-206c-4245-9775-904983b9154d", "text": "No one else looked at the four of them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "38417cb2-9c98-453e-84f3-4096f7205bae", "text": "Ninsun opened her satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f1113b59-c2c9-47ad-b83b-4b9dc288f50a", "text": "The scrap of parchment was damp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ccd430c1-2fbd-4b0f-bc5c-34aa55881a6d", "text": "The name remained in her handwriting.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a767da66-a409-420c-8b11-d0d7c7599d35", "text": "Beneath it, a second line had appeared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "67136f21-87a6-401b-a59d-31b84fcaf72b", "text": "The ink was not hers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1a4752d6-55ee-4ca6-9562-7311ddbaffa3", "text": "A NAME SPOKEN IS A DOOR LEFT OPEN.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "b01b20f1-b3c1-4294-a699-43347c342d53", "text": "Enhedu read over her shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1c47e86f-2eff-4799-91a5-a5d0f624141f", "text": "That sounds less like advice than a threat.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "299efbd8-945f-4460-84e3-355347fd78b1", "text": "Ninsun folded the parchment carefully.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a934f946-9d8d-4fb7-ac31-b304f0005b7d", "text": "You asked whether I would tell anyone.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a025e722-e87b-4a0a-a2c1-56fd85d43e1b", "text": "I did.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b3073dea-6f67-4fd5-ab86-bc2248c3c03a", "text": "Not yet.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e4e299fb-3e57-4fc1-8ef4-3e1f07f3ac81", "text": "Why not?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f4261a90-b8c5-4536-96ef-b18fa97de601", "text": "Because the moment I do, someone with a better title will decide it belongs in a locked drawer.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fea29016-0319-4dad-a3d2-b5524f527a60", "text": "She tucked the parchment deeper into the satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "49690e84-b475-4ce7-acd7-2e8ff5d13106", "text": "I'd rather it stay on a piece of paper I control.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6ef3bb96-9806-4efc-81a1-8fb3ae54e937", "text": "Balag grunted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
