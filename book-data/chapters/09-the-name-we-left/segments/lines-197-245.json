[{"id": "9e0c984d-26df-48a1-9841-1c3f119407b5", "text": "Ammaru.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "90fe6243-baf0-4862-85f3-b5b98869e9a4", "text": "The letters floated beneath the surface.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a484a689-94b4-4bcc-8401-484232f5c13d", "text": "Ninsun leaned closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cb22b748-31c5-4756-9406-38b02c286319", "text": "The water reflected her face.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ada4c099-4829-46ea-aa28-d253e47082a8", "text": "Then it changed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e58d53b0-448f-4e1f-9513-04f37d1f1785", "text": "Another woman stared up from the basin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ea8c73fb-94a9-46e9-9496-b0b3857c461a", "text": "Same dark eyes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "32b49cac-d9fb-43d8-8581-5779313ac0c6", "text": "Same narrow jaw.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3c1b78ea-755a-4409-a22c-d0cc3119ad92", "text": "Younger.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fa05d29d-ba7d-4552-80ac-2bdf7e8a6647", "text": "Her hair hung wet against her cheeks.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5660c74b-814a-4b9d-9c96-65eb36c3519d", "text": "Ninsun stopped breathing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "581268ce-4d67-4bd2-8119-e9975d662a66", "text": "Zik caught her shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4a97a53e-cc64-463f-ac6e-43e8ed90f801", "text": "She jerked away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b9c8727a-cc6e-435f-80ab-b8d28e740d47", "text": "I saw her.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0b069147-50ae-42bb-885d-83f2e8f0f336", "text": "What?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "65a8ea7d-a4ff-4c2e-a8e3-6157a18c6b61", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "cde32443-e904-4083-ab22-8e932c96a5eb", "text": "My sister.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3055cb0f-872a-4c14-a1bf-277ed4256746", "text": "The water stilled.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "72c7d53d-027e-45e3-ab6c-2299c80a4e09", "text": "Only Ninsun's reflection remained.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1f0f2012-2e32-4f83-a8de-f7526dca1af4", "text": "Balag moved between her and the basin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7d5be0d9-46c8-4740-b972-3e8e68739c9f", "text": "What did it show you?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "213dbacb-bf00-4555-99ca-5ef83d974281", "text": "She was there.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0f4296b1-b7d5-4e07-a4f5-2f67fd251415", "text": "In the water?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "86b3dac4-1d9a-4143-ad87-126aed5d375b", "text": "She looked at me.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e107558e-c80e-47c8-b0f2-57bc827390be", "text": "Ninsun,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c1c6543c-933f-411d-9904-02d7eca094e9", "text": "Zik said,", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "c892ee96-5c37-42c7-925d-7d38b84a46c3", "text": "did she speak?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "662eabb8-8f8e-456a-8a42-8e2666268abf", "text": "Ninsun stared past Balag.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "92b60f14-72d8-4719-ae56-4114f84e7219", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b673cecf-5137-44b3-84fb-d37ce2caa125", "text": "The basin made a faint sound.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fac90c29-9de1-42c4-a5e4-cb0692becc63", "text": "A breath drawn through closed teeth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d9def33d-9361-4040-806d-392ab18ac015", "text": "The uncrossed name on the rim darkened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1304c521-b022-4a5c-bc40-f77a1106d4e9", "text": "Moisture filled the grooves of the letters.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "deee7566-c2fd-49a2-957b-6aea1fcb02e2", "text": "Zik watched the first stroke of the name deepen.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8f5aa994-c617-4b4c-98f6-eb2d1e24dbfc", "text": "A crack formed through it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cc2a8842-4fb9-447e-b102-a55b912bc5f7", "text": "Ninsun saw it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cf0b3f42-8401-4f13-a90d-7ffe1394ae82", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a67c91ee-5bbf-44c4-8c2c-b6cce464c92a", "text": "She lunged for the stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0c97b2a4-8db3-43ed-9df3-b2fa444d3669", "text": "Zik caught her wrist before her fingers touched the carving.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ae05b5e9-a844-49c5-9542-829444d84116", "text": "The crack widened across the first sign.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "19d42403-8154-420c-b0ff-0b01e20f0891", "text": "They're crossing it out,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fa88aeec-fd05-4f50-9de1-2c99b43e907b", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "62798f4b-a1e2-45e9-b0fb-a6e3bd0dff33", "text": "Who?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "65d36fca-61d0-4f3b-80cf-84ea65d41d1d", "text": "I don't know.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6acd5a62-95f6-4d48-89ce-83fcb23384b9", "text": "She pulled against him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cd68508a-b481-4863-a075-9666612ac962", "text": "Let go.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9155ee25-fbf6-45cf-b5f4-c461192ad5ee", "text": "The basin wants you close.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "76b0d2ba-4471-4bec-be74-18c529e3035f", "text": "The name will disappear.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c865762d-5794-4516-927c-7d0eb62752c7", "text": "You copied it.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
