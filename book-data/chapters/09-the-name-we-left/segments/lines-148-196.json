[{"id": "7f92a70c-5dd2-418c-9bad-0e5f654af4f3", "text": "These cuts weren't made by the same person.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "49b319af-68f1-49b0-8e80-54093bb836a1", "text": "Ninsun joined her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bacb7336-3ab5-4aba-aa70-7fd317ad76a7", "text": "How can you tell?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "107845cb-cabd-4bce-a6c7-07a92421cb8f", "text": "Different depths. Different tools. Some used chisels. Some used blades.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8653b1b4-708a-4fa8-8832-da11e683181a", "text": "She pointed to a name almost completely destroyed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d9372fbc-a0a3-4cdb-b1a2-d7bbfb1122b0", "text": "This one was hammered out.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "45701dd4-121a-42d7-b2a7-29a273e3b47d", "text": "Another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "450d8039-43fc-40fc-b5af-e0b839db0d4a", "text": "This one was scratched away slowly.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "06efbf8d-325b-415a-82a3-d49db812dad8", "text": "Zik studied the pattern.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f6c45332-4848-4c2c-85e9-ebf4b8221da8", "text": "The marks did not look administrative.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a8d9bca1-7a93-4f2c-a5a4-1166ab934b9a", "text": "They looked angry.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "38b1b53d-cdee-4502-9f57-28e31ee94573", "text": "Or frightened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fea067f0-b8de-4d00-ba14-91d1744dec1c", "text": "Maybe the names were condemned,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4125c509-4f5c-492d-82b8-ebd3e179715d", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "c3af2de7-f54f-449f-8158-9b5e10ee1c60", "text": "Then why leave one?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2e27866c-1a0f-441f-b4bc-a7198f5c7581", "text": "Ninsun asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "4b3a0d8e-1a25-4ca7-85b0-a773f03e6bbe", "text": "Someone hadn't reached it yet.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ff485f56-12a8-4038-87cd-f27e302e1b6f", "text": "Enhedu looked toward the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1472242b-1322-4ca3-8113-29c206bb47ca", "text": "Or it was only just added.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6cd54e08-3615-46b1-9473-53e41c305568", "text": "The air shifted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fe92bba6-2a5f-4c62-ab3a-23a0e27d60d4", "text": "Not a breeze.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9cc1c93c-a91f-40a5-9f0e-f29218858b98", "text": "A pressure change.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dc0dc996-f063-436e-b309-40eec38c6aa2", "text": "The lamp flame bent toward the basin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9abde9d3-1970-4081-ad5a-9eba29a239fd", "text": "All four of them watched it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a93be330-6165-4593-8295-89617e21fdb7", "text": "The flame stretched nearly horizontal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6ef3586f-ae27-475c-bfdf-029f31cf2be5", "text": "Ninsun folded the parchment and slipped it into her satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6e8a4bd5-8dcb-4d93-ae26-108bd0fe3bf5", "text": "Zik leaned over the basin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5db0d174-c6d8-4d22-935a-9369458fb193", "text": "Its polished interior reflected the lamp, Ninsun's hands, the lower edge of his own face.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1fe5288c-e138-45ae-b603-4bd8b1d0733d", "text": "Then the reflection deepened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "53f0c0db-f1e5-4f70-8c00-a0b7dfeb7198", "text": "Blackness gathered across the stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7e14ac8a-af5d-4c07-bbbd-df00bd3c04a4", "text": "Water rose without sound.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c8842f25-ddd6-469f-9df9-34c4549f68a1", "text": "It did not pour from a crack or seep through the sides. One moment the basin was dry. The next, a thin layer of dark liquid covered the bottom.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ead92bb5-55a3-4338-888e-50071e6ebce8", "text": "Balag stepped back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4bccda18-e04f-4226-a4f3-221810c7296d", "text": "That seems enough.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "512d2f7d-e6db-49e9-8686-88e0c6a018d4", "text": "The water continued rising.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1b29efde-7c6e-448e-aa54-c0a53deafb63", "text": "Zik could smell it now.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dae48a48-cf21-4461-be57-93f140d4ed3e", "text": "Brackish.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "080cd78b-5a4c-4e78-b500-20c292cee983", "text": "Heavy.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "08b927a2-e127-4ba9-a737-567f7fc0cf87", "text": "Exactly as it had tasted in the dream.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7ee65647-1934-407b-bbb5-b2b50a787c57", "text": "The mark beneath his linen warmed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9a8412b5-5014-4319-ab08-5fd4402abf6c", "text": "Ninsun stared into the basin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f80da039-614c-4463-992b-230ea842cbd5", "text": "There's writing.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "00a512b1-fe4e-492c-98b0-53510ef27e07", "text": "Ripples passed across the surface.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e9460cfa-4bed-4761-92d3-e154ece99863", "text": "Beneath them, pale lines emerged as if carved into the bottom of the stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "530ae404-3640-4543-ac06-e10387559edd", "text": "Not cuneiform.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f320ae81-1cbc-41fe-b758-27e73e322289", "text": "Names.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "431c9f13-d324-4631-b365-a901c567a1b3", "text": "Dozens of them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e66e3863-71b4-4a80-8aeb-a2220745a255", "text": "They appeared beneath the water, crowding over one another, too many to read.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4c6ade28-ceb1-45c9-9525-825e8f20632d", "text": "Then one separated from the rest.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
