[{"id": "26bf4022-ecaa-41a0-a9ee-a7e6d554d118", "text": "Recognition.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a3111d20-c758-46b4-b29e-24228676e41c", "text": "She never had that.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "59bc2a41-548e-4451-a39c-0d884fdecfc5", "text": "The face smiled.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "274a10ee-3b12-4c43-baec-5ae009aea0a6", "text": "Ninsun recoiled.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6ccbfbab-2403-46b8-a6b6-7c43ded4bfbd", "text": "The water surged over the rim.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "24013467-75e1-4855-a578-1be10469d51b", "text": "Balag shoved her toward the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a2fdd046-01ba-47f0-8859-7be425af0a56", "text": "Now.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "44bc6880-2aa3-4da6-916f-a5731b021fbb", "text": "The black liquid struck the stone floor and spread in a perfect circle.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f379c087-6878-42f9-a809-1ef7cb3b53af", "text": "It avoided their boots.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f7e0c5df-275c-48db-8261-cba29530c4a8", "text": "Not by chance.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f09dc017-61a5-4837-b59b-7894318d5bc9", "text": "It bent around them in four narrow streams, each one curving toward a different person.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5a256de6-e41c-42cf-ba88-f081c50181bd", "text": "Zik backed away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bfa0a090-a056-455c-b364-c30246e5527a", "text": "The stream aimed at him stopped at the edge of his sandal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9351ec26-bb42-4a94-8d94-cafd70647151", "text": "The mark beneath his linen flared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f7608307-0bcb-4dcc-9cf4-c8138f4fb230", "text": "The water rose into a thin upright shape.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4061ed19-93ec-4ece-be76-c2fe3d0be763", "text": "Like a finger.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6fd3d184-de16-4028-8b0b-76f9d548c2ac", "text": "It pointed toward the satchel holding his father's journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "35f9fc60-012c-4d66-a551-0abbb13a18a8", "text": "Then collapsed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8bd39fcd-e32f-4e78-a5d3-0fe15383a836", "text": "They moved quickly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0b6f8630-8a6f-490f-9e6e-f0d223eed937", "text": "Balag first, pushing Ninsun ahead of him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a5ef7077-4b61-4154-94d2-7a702275cf3f", "text": "Enhedu followed with her knife drawn, though there was nothing visible to cut.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4c14fc19-44a1-4d75-a377-5f38e925c244", "text": "Zik remained at the chamber threshold long enough to look back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "27fa503b-f028-4d8d-b6c5-8b1f9a3ec9e1", "text": "The basin was empty again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5cb1a379-9e0d-4f99-b9f1-56d507f90494", "text": "The name Ammaru remained uncrossed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cccb4d69-ec24-47dc-8618-1d16f2004b7e", "text": "But a new name had appeared beside it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0f816ea0-941a-4903-8c95-5b1da44ec15e", "text": "Freshly carved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "547264ea-d270-42c1-9b26-32dc93af1925", "text": "Ninsun.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6c32621f-9512-407c-96de-c642c6827b80", "text": "Zik stepped back into the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3f0920cb-1868-4b96-9286-5a677119e449", "text": "The chamber went dark.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "17759b8c-81b2-4291-bcc7-df2964c6ab2c", "text": "He said nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3f3b678f-9281-49c6-bc05-733714f835ef", "text": "They reached the groove in the floor.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c8315267-25af-4de3-be77-0a7b38844017", "text": "As Balag crossed it, the echoing tap sounded from below.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9d4c279b-38fb-4fce-a71f-4df2b22790e1", "text": "This time it did not wait for his spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "baf053aa-9ef9-4fa7-b62f-2162047bdbdf", "text": "One knock.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7b08aa15-aa70-43ba-bf84-19f114ad27ae", "text": "Then four.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7be0389c-b26e-4f03-838d-01cc28713ceb", "text": "The floor shifted under Zik's boots.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c26a52f8-5622-4b6f-845c-fc39839913c4", "text": "He pushed Ninsun forward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "641bd67b-554c-4fda-a497-0d434bfacbce", "text": "The passage behind them began to narrow.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "773fe41d-7f5a-41dd-aaed-6e330920fac6", "text": "Bricks slid outward from the walls, closing the space course by course. Enhedu twisted sideways and forced herself past the first constriction. Balag caught Ninsun beneath the arms and hauled her through the next.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "da776075-8dfe-4d9e-ba37-28aeedeafb7e", "text": "Zik's satchel snagged.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8eb06a93-043f-4430-836f-f35276e020bb", "text": "The strap tightened across his chest.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "285271d2-707a-41f7-94ef-5814a641f6e5", "text": "He turned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3edddf20-75b9-4e95-98d2-06d69489505b", "text": "One brick had pushed through the leather flap and caught the journal beneath it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b1bf1ec0-6c99-4324-9db5-cdedd7bcf591", "text": "The mark on his palm burned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "550e2c09-c8d1-4d30-bf57-288ae4996de3", "text": "Zik pulled once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7a3fd82d-279a-4863-a0ac-d912e0bced3c", "text": "The journal did not move.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4305e000-275f-4206-96cb-9133a28b9e9e", "text": "The passage continued closing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "34e7f202-a986-4adc-a4ac-2c7ca1a4c802", "text": "Enhedu grabbed the satchel strap from the other side.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "01b5ce8c-01ee-49a0-ab23-32bb5402ed6c", "text": "Leave it.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
