[{"id": "e8e729c5-0841-41c5-927f-2dcf8442184b", "text": "And beneath that, faint but unmistakable, the sour mineral stink of stagnant water.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ccf98c06-5ca7-4e83-95df-afc8ed464731", "text": "Zik counted the steps.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ff4b23b4-5625-4b94-8a19-ed14f8f65e53", "text": "Twenty-one.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fe33f1e3-a558-4fa2-b421-bb8612da4ed3", "text": "Twenty-two.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9ee00e16-f55b-4960-86a5-899f5dd44cf2", "text": "At twenty-three, his boot struck something.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c41ed58e-0e95-401d-8594-2d754cf7684b", "text": "He looked down.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "69133630-0474-4510-9811-af14f1a74683", "text": "A thin groove crossed the floor from wall to wall. It was too straight to be a crack and too shallow to be a drain.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b6396a3e-9e0d-490c-889f-4464b317ee05", "text": "Ninsun crouched.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cb559e9c-4b15-4747-8cd8-670c407e52b9", "text": "Threshold.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f49d7eb3-d4ae-4d5f-b4da-8cc784fe4287", "text": "To what?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b7fac050-5729-4a0b-9da6-f5e510d59f91", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "9f19e718-bfab-42be-ae7a-bea13f4706df", "text": "Ninsun studied the blank walls.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a3288294-4bf4-4fdd-8724-137912709ade", "text": "I don't know.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7286a37c-b27c-44df-817a-ec8422203202", "text": "Balag tapped the groove with his spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4b312172-a51c-4550-ba71-677a1545e289", "text": "The sound came back from below.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3ee68b51-0b42-47d3-bda5-dacfc2df9fcf", "text": "A second sound followed a moment later.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2c2cea97-5bb6-4433-86f9-a3cb822f0aee", "text": "The same tap.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c43cf247-6210-4857-8a57-1d22f1509553", "text": "Softer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9319e1b2-dc74-4ca5-acca-4bc70df48415", "text": "As though something under the floor had answered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "48fcd807-fbe8-4e47-b9a7-52b25ed2e26b", "text": "Balag lifted the spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b8aaa044-bebb-4f90-814c-7056b1040fec", "text": "No.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b8f6f558-b7ff-4733-9d14-9ec19f191277", "text": "Enhedu glanced at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "539913d3-c377-4a16-a22f-8bb81c56667e", "text": "No what?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c96a0862-f363-4495-8f30-6c604fa40d1c", "text": "No returning the greeting.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "235b1928-0973-4e4c-ae63-2d99e6b43aa4", "text": "They continued.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "221a1967-dc48-45aa-9c02-c43fea78dd61", "text": "The passage ended in a low chamber with a single stone basin set into the floor.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eb6fa010-65ad-4ef1-8513-c38ffbba6abc", "text": "The room was circular, though the bricks had been laid in straight courses, each one narrowing slightly to imitate the curve. The ceiling domed overhead. Dark stains radiated from the center like the traces of smoke from a fire that had burned downward instead of up.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0f33d61d-2672-4074-9e91-fa9f3c9bfaa3", "text": "The basin was dry.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9020084a-df46-41ce-b194-7916f328f26d", "text": "Around its rim someone had cut a ring of names in the old script—dozens of them, perhaps more. Most were crossed out so thoroughly that the stone itself looked wounded.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c8889709-149d-4446-a54a-d77b10378b30", "text": "Some had been struck through once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3bda18e0-5d4a-4458-aac0-9bf17cd78795", "text": "Others had been attacked repeatedly until the letters disappeared beneath grooves and chips.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d38d0ce4-a0ef-47ef-8de3-d2cf89379969", "text": "One name near the far edge was still clear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "71069613-5e05-4a52-a546-dc0bfb5c91a6", "text": "Ninsun crouched beside it and went still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6e761660-17c5-44c9-9cba-ba8867b94ea8", "text": "What?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f55d7ee5-3589-4928-ac3c-cc15d0cbf6d9", "text": "Balag asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "b54c8a5a-d9cd-4ce1-b2c7-e703cfc8461b", "text": "She did not answer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "82b26f7d-8b08-4b5f-899a-9712468eed15", "text": "Her hand hovered above the carving.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "69a07ec8-5897-4df1-aa08-9ec29a12fd99", "text": "Enhedu approached more slowly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a77b706a-670e-43b1-bbbf-709b53a9b218", "text": "Anyone we know?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b893a73e-c142-48aa-84d5-633fec02b7a5", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "39702e7d-94d1-4ec2-982b-881047c786a6", "text": "Ninsun's voice had gone flat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e4afb7c7-29e5-4ef2-a2cd-2b389595ab03", "text": "This one isn't crossed out.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0e9902c1-fa79-444c-8855-4b02ddcac78a", "text": "Zik moved beside her and studied the letters.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "66007bf5-c564-4106-a0cc-76baf23a3488", "text": "The name was ordinary.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5e207c86-f2f9-4e34-bd14-bc58b83d5717", "text": "Ammaru.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b7afabcb-c6ed-4dfc-9bdb-72af2b667e52", "text": "The kind of name that belonged to a potter, a dock worker, or someone who sold onions in the lower market. The kind of name the city usually did not bother remembering long enough to carve into stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c289493b-3487-4ca6-bf32-6cf807f9ceaf", "text": "The hand is recent,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ac915b6b-896f-4570-857b-21dd90e0933a", "text": "Ninsun said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ea156449-ef12-4ef0-8607-fa7419e11328", "text": "Her finger hovered over the first sign without touching it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
