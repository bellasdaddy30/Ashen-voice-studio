[{"id": "2fb8e30c-aa1b-46fc-9bf5-768d1659472f", "text": "That's either smart or the kind of thinking that gets people buried under better titles.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c37c6e6b-fe6f-4926-b97b-a835db6430fe", "text": "Probably both.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "63ba5622-4dd1-41ff-9426-4e5bbaabd8b9", "text": "They stepped fully back into the ordinary flow of the street.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2d190e88-5d55-48ea-b119-54407a7bbd28", "text": "The dark mouth in the wall had become a shallow recess. A basket seller had already set three empty crates against it. Any local would have sworn the recess had always been there.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cec72a24-69a5-4b58-b845-b7d39ebda047", "text": "Zik flexed his left hand inside the wet linen.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0588cc10-82fc-4a35-9a2a-468eb476b392", "text": "The mark stayed quiet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7cd07bda-081c-437f-bd86-26722f1898cd", "text": "Ninsun walked ahead, one hand resting over her satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7b7576e7-a642-4b20-931e-f02064eb053f", "text": "Zik watched her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "937f5bc8-97b4-4fbe-85c8-3596593f95d4", "text": "He considered telling her about the second name on the basin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4fcecc6d-ab05-440f-aaef-e62c9568bf55", "text": "He considered how quickly the chamber had learned her voice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "961a3d4b-c382-4a06-a540-0bdbbf924c1b", "text": "He said nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9f86a8e3-eda3-4e79-9c8a-87fdb03af506", "text": "They walked on.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d3a92fdb-0d14-4aab-81f0-c899885fabf3", "text": "Behind them, in a room the city no longer admitted existed, one name remained uncrossed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "05e1a71a-36d3-4667-9ebf-abb18ae51335", "text": "And beside it, another waited.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
