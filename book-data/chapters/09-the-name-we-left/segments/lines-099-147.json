[{"id": "ce4c9c4e-6a25-49c6-9138-4f192ca0de95", "text": "The edges haven't taken dust yet.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "086d3ff3-060b-47f6-b12c-f51cdd7d75ca", "text": "Zik crouched and blew lightly across the carving.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "29175d09-e00e-4586-a474-5c3791f623f2", "text": "Fine powder lifted from the older names.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7c2de757-16a9-4953-804d-f2788cd0faa7", "text": "None came from Ammaru's.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6ad2189d-b7a6-4ff9-9349-105e94b27ce0", "text": "Today?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "77bc062c-8332-4203-a0af-00b3318e1b7e", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "caae2b62-b566-473a-8762-9c4d07b1fdda", "text": "Possibly.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b6314229-8185-4d04-b298-50316f99997d", "text": "Balag tested the walls with the butt of his spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c374b0f2-b323-4e11-99e9-911c3ab58051", "text": "We taking anything?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "723a93c7-1332-4732-a9fb-bdcd1adc8d84", "text": "No,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ffe0cfa0-b63e-452b-bc74-09390da2e5d5", "text": "Ninsun said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "7b113f3b-aac3-4593-8d92-67efdbc8c27c", "text": "She had already pulled a scrap of parchment from her satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "541e461f-837d-49f2-bd1c-a50cc1de7528", "text": "But I'm not leaving it unrecorded.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d00b9a2b-1d1b-46ca-9253-bf92b82bfb90", "text": "She copied the name with quick, exact strokes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7573cbde-616d-46f0-98b1-405216a2d7ed", "text": "Zik examined the basin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2475115a-8bf9-4b7f-912f-058f44d2e8c7", "text": "It had been cut from a single block of dark stone, harder than the limestone commonly used in the lower districts. The interior was shallow and polished. No drainage hole. No channels. Nothing to explain what it was meant to hold.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2f06ab24-c8e7-460c-b0e4-addaef8e2be9", "text": "He ran the edge of his awl around the inside.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "82321b80-a755-473c-ad70-9b3f1a2e4065", "text": "A dark residue gathered at the tip.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1d236cf6-661f-4365-9f46-e3d743e11b7f", "text": "Enhedu noticed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "09c632fa-72e0-4949-9457-c076144f035e", "text": "Blood?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "95ad2f9f-56cf-4229-b1f5-abc1f603cde6", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "397c25bc-9e86-4370-9cec-5288736a5e91", "text": "Oil?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a119c0fb-002f-46f7-b5f8-787143e9340c", "text": "Zik smelled it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d5408b26-ea8e-421f-83bf-1ec64c7e30db", "text": "The brackish taste from his dream returned so suddenly that his throat closed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "455eff0f-50a4-4a1e-bf5f-d52ecc10ade9", "text": "Water.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0fa531c5-2a03-4ac2-875f-d07d564eb1da", "text": "Balag peered into the empty basin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "97dd383a-36d7-478a-b287-e190eb400e51", "text": "There is no water.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f08214dd-d70e-4993-90af-0f547e5833be", "text": "There was.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8a6bf00d-1989-477c-a979-df7f6b617cda", "text": "When?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b14f1c2c-908e-4901-a33b-aa70a60d7594", "text": "Zik looked at the dark residue.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7f49c841-ce0e-4893-b729-47fc898e90d7", "text": "I don't know.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "93727111-f2e0-4f3d-97c3-3447a834c725", "text": "Ninsun stopped writing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e9c40bd9-a3b3-4eaa-ad79-e466ccad4b15", "text": "What is it?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5cd7185b-ebdf-46d9-8187-461ab96aa244", "text": "Nothing.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f9d458c7-471e-44e1-8d3f-394e91a8efbf", "text": "That answer is becoming insulting.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d5cc8ea5-ebcd-4577-a4a6-72357ef6e361", "text": "Zik wiped the awl clean on a scrap of cloth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7b05480d-6b2d-44fe-a44c-eff99deb33b5", "text": "The basin held mineral water.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "43fdb7f4-c4ce-4315-8e1d-6212e2ea34c5", "text": "From below?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2c1af6fc-310b-4472-8204-1a7640bdfeb7", "text": "she asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "4a6211e1-0e6a-4ae3-abae-b1e8105cb53e", "text": "Probably.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "88808e26-09f6-4a1d-abca-7c969bfc6e8e", "text": "Ninsun looked around the sealed chamber.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "634eefee-efd2-4c6c-ad79-e7bd1df8dede", "text": "There's no channel.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "62954198-b64c-4c89-b313-b55c7df720a3", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4785f74d-5609-43a3-9d17-92917a54e0cc", "text": "No pipe.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d65cfad8-cbe5-45de-8063-c88498775976", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ac1572eb-41ef-4887-b839-43b0dd84a159", "text": "Balag shifted his spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "918f1907-390b-428e-af65-7692b8789553", "text": "Then perhaps we stop asking how the water entered and leave before it remembers.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f3f35c0d-35c5-40da-8886-1216aa127f60", "text": "Enhedu had moved to the opposite side of the basin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "23eef96b-9a99-4411-b0c4-03d89b34bc0f", "text": "She traced one of the crossed-out names with the point of her knife.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
