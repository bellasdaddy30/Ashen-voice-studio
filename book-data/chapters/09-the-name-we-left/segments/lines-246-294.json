[{"id": "555503c1-4d8f-498a-b2e5-8aae360c2301", "text": "That isn't the same.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c929e50d-d025-4e89-8686-57550161ccc6", "text": "The next groove formed across the second sign.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d2ea8098-dc3e-4286-b303-cd5e757d8468", "text": "Stone dust curled from the cut, though no tool touched it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bebb7104-8816-4451-84ee-a139bc5c3c87", "text": "Ninsun twisted free and pressed the parchment against her chest.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f210c53c-27f9-4879-ab12-6de252936d85", "text": "Ammaru,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e68b10e0-d9fe-4867-a961-cc2d7bf974ea", "text": "she said aloud.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "403bfeb7-fc7d-47ba-ac7a-cbe9e601575b", "text": "The cutting stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6ef5c69c-164a-47a0-b95b-bdb2e22d9337", "text": "Everyone went still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "117cfbe9-eff9-43ca-85d2-e67903721672", "text": "Ninsun repeated it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "95b8c77f-1677-4765-9eee-b0851be5170f", "text": "Ammaru.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e51f99e0-43ac-4e07-ae08-e8e8c7fb9309", "text": "The black water trembled.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "03913fe6-2320-4be8-8873-b1f36673fa1c", "text": "The name remained.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "371d1a18-d7a9-4ad1-8bde-6c02fc7b58be", "text": "Balag looked at Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d46a5d78-3529-4089-83d5-167c1b818267", "text": "That seemed unwise.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "97b9f82f-d154-4b3e-b279-6972dc8152e1", "text": "It worked,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7da16474-da76-4fac-8b7f-3df37e807f21", "text": "Ninsun said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "4e752827-4890-46af-88a7-740beb20a9f4", "text": "For now.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8886199a-ce5f-477e-a32a-3fdf2b437465", "text": "The basin answered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ccda90eb-cc72-48ba-b44c-c7f5f4bcdbb9", "text": "A voice rose from the water.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4881d699-bf70-45e3-8069-05df14bdd1d2", "text": "Not loud.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fc30bbe0-2039-4b66-ab99-971bbcbdfd3b", "text": "Not fully human.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "451d9b5a-0f35-46af-bbe9-f164ff65b639", "text": "Ammaru.", "speaker": "The City", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "The City speaking: not fully human. Whispered, wet, close.", "generated": false},
{"id": "e9770d49-835e-4b88-a2a6-dcb5565890ee", "text": "It pronounced the name perfectly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dc9f6335-ef2c-4c84-824b-7677bce48c2f", "text": "Then again, in Ninsun's voice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6b77bf8f-a6f6-4d36-b978-5373bb12520b", "text": "Ammaru.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "CITY MIMIC of Ninsun's voice from the basin: wet, slightly delayed, not quite human.", "generated": false},
{"id": "da4995c8-705d-4990-9b56-240b53f1dfb5", "text": "The chamber walls returned it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e23326a0-b787-483c-b2ea-cac7487d790c", "text": "Ammaru.", "speaker": "The City", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "The walls repeat the name from different places. The City speaking: not fully human. Whispered, wet, close.", "generated": false},
{"id": "04a533e4-224e-4e43-8690-ed480ddd3612", "text": "Ammaru.", "speaker": "The City", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "The walls repeat the name from different places. The City speaking: not fully human. Whispered, wet, close.", "generated": false},
{"id": "daf3070b-7681-404c-8320-cdcad7252e59", "text": "Ammaru.", "speaker": "The City", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "The walls repeat the name from different places. The City speaking: not fully human. Whispered, wet, close.", "generated": false},
{"id": "3d6af376-6c76-4b49-917c-6064fb5dc349", "text": "Each repetition came from a different place.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "861cceaa-6549-48b6-9f6c-7c482d1fcffb", "text": "One from beneath the floor.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f86b33ad-8a3d-44c6-ad03-410992d1d702", "text": "One behind the blocked bricks.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8353ff1b-8e67-431d-9c8b-cf21e5084179", "text": "One directly beside Zik's ear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d70a1310-aea0-413e-842d-2e37fe9e6daa", "text": "Enhedu backed toward the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8dadb477-59fb-475e-8a52-29684eb43771", "text": "We're leaving.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d2b1f545-17d3-4e72-a861-4d7d24e484ba", "text": "Ninsun did not move.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c2463211-186d-4a25-a8f9-d85dec04233a", "text": "The water changed again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0f6a951e-5f06-4bea-b6d2-a507117fbf91", "text": "Her sister's face appeared beneath the surface.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a9878430-4b9f-4e23-b2ea-c2f4b3f7835a", "text": "This time the woman's lips moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5d5325d2-8c43-49dd-9775-f4612f3ba415", "text": "Ninsun stepped forward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "253a3914-4c45-4294-bda8-134164783a00", "text": "Zik tightened his grip on her wrist.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b5382f2-0055-4145-9579-daf6c4ebb252", "text": "What is she saying?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "79d3042a-5fde-42ed-a6f6-09ea8320577c", "text": "Ninsun stared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3ff85925-f3be-4225-b7c9-9ca42ea6e726", "text": "I can't hear.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "285e8618-f5c4-4406-94d9-d40e28428b59", "text": "The woman beneath the water raised one hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1e4d11c6-59ff-42fd-a38c-0fbf6cce862e", "text": "Her palm pressed against the underside of the surface.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1b752806-a762-4912-a30f-449d467d6383", "text": "A spiral-drop mark covered it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9dab836c-7913-4cdb-98f0-d72637368104", "text": "Ninsun's expression broke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8a1b8f19-8b3a-45fe-a098-9aab8de908d5", "text": "Not into grief.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
