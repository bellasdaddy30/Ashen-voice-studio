[{"id": "c4997c89-4641-4884-aa47-f4bf21396fc5", "text": "Thoughtful.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4d1912ea-d03f-4b26-9837-50cad64e347f", "text": "They lowered their packs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "50110563-de1c-4b05-8a39-2360901c2cfd", "text": "Balag inspected every strap, knot, blanket, and buckle before allowing anyone to load the animals. He found one split leather loop, replaced it with cord, then found fault with the cord and replaced that with a strip cut from his spare belt.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ac7cef22-4952-4164-9cf6-41c2b9ce733a", "text": "Enhedu leaned against the broken wall and watched the fields.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fbb60f59-2dd6-483e-8a3c-4178393a2489", "text": "Ninsun stood near Zik with Bel-iddin's warning folded inside her robe.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "84f62aa8-9957-4870-ab7b-f33719ff0d7a", "text": "You did not tell us about the animals.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e2cbd940-ba37-4f7f-ab37-2d3207e6c4a8", "text": "You mentioned that.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e83baa30-fcda-47de-ac1b-e403c3e0f01e", "text": "You also did not tell us about the seal until the Collector placed it on the floor.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "58a217c2-eb17-4451-96a8-72b36f366b1b", "text": "I had not known about the seal.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c32e0706-73f7-42e0-bf10-470df6c0601a", "text": "The journal, then.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "420c717c-20c0-4193-90f2-175814e8361c", "text": "Zik tightened a strap around a waterskin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "401c49f9-d9da-4753-a158-39ded994bf5f", "text": "What about it?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ab732612-f818-4600-a0e7-10b0609349fb", "text": "You have not told us everything it wrote.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "eb65642a-b4ae-4767-9392-7b18c7e06a7c", "text": "I told you about the map.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8010266c-911b-4f5c-80e5-0922025e3fae", "text": "You told us enough to make following you seem slightly less irrational.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c64daed1-3ab7-4503-b6d1-8a48c8c4563d", "text": "That was generous.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "49c54ff8-ccc5-455e-a37a-ff1810cbb042", "text": "The exact words matter.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d242bf67-d13b-470e-a9eb-44badb35eeff", "text": "Sometimes.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1e81ddb0-1a2f-4d96-bc69-82bbab55886c", "text": "They always matter.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cb55d14d-1371-4abb-ba4b-6f3fd443eca4", "text": "That is why archives are full of people arguing over marks made by accountants.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "043f4cfe-6788-4889-9332-5cf2771e714d", "text": "Ninsun stepped into his path when he reached for the next pack.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fa72a8eb-b494-4d43-9874-d839e8273e3c", "text": "The journal named you.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6654570b-35ca-4875-b8ec-8ceeac1917d6", "text": "Zik stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "98ca3076-7f41-48dd-8845-ffc44dbe5aec", "text": "Behind her, Balag pretended to be occupied with a saddle blanket. His hands had gone still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "117a7bab-c4fe-4fed-9352-cf8e0b27c767", "text": "Enhedu continued watching the fields, though her head had turned enough to hear them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b5e96be8-823d-472c-92cb-faf2e0b3fedd", "text": "The Collector named me,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "66828ace-89f3-4a1d-9950-70cb50024ff0", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "74e2f41d-ec65-4930-b83e-ce550b9b78f2", "text": "The journal reacted.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e0067a58-2117-48f6-8cdd-c6331307ffc1", "text": "It moves whenever it dislikes the conversation.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9b7cd6ad-f424-4332-ab38-ed01e49968ee", "text": "It knocked after he called you Bel-iddin's successor.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f474141d-d2f9-41a3-8981-5d8358ea3e0c", "text": "It also knocked inside a wall.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "85c5dc54-48c5-40c7-9691-d7289c7dcfcf", "text": "That is not an argument against meaning.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6592aba6-30c1-4da2-b764-8498ec0149a8", "text": "It is an argument against expecting clarity.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "33875ce8-8b96-41a3-9b6a-f2505c4d9894", "text": "Ninsun lowered her voice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "93ae5458-3c28-4fc6-8c54-df974e1ad84e", "text": "What else did your father write?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "abe5b46a-4935-4893-b583-3757a2e1a6f0", "text": "Zik looked at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3a39191b-896b-4d27-aa4a-43294b15eeef", "text": "The darkness beneath her eyes had deepened since the archive. She had copied the map until her fingers cramped, then packed the copies as carefully as if they were royal decrees. Mud streaked the hem of her robe. A loose strand of hair had stuck to her cheek.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f08718c3-18ab-4822-9bb4-aca5cfca09e7", "text": "She had followed him through a wall, across the roofs, beneath the city, and into fields where animals appeared without footprints.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "53c7a133-9aa8-4607-9a3d-99de17ede698", "text": "She still expected honest documentation.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b18a5f1c-c36e-4f24-a978-3ca0e787cbee", "text": "Zik almost admired the stubbornness.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "10371043-39f3-456c-b6c8-6d25078b6be9", "text": "He wrote that he was wrong about the depth,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a6183488-7205-453d-819f-10056fcfdfcf", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "c5895650-50e9-453f-86ec-258edd9fb5fa", "text": "We know that.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5e31418d-91f1-415c-89f5-8b2f7d793ae3", "text": "And about who was looking.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "46bb405a-4b32-45c6-b3a5-81e8e5423ad8", "text": "We know that too.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "aa3e983f-7297-4b35-9172-ede8335352bc", "text": "That is everything.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9495c1a8-d475-40d8-a6dc-67998b9077c7", "text": "Ninsun watched him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b8e7388b-9593-41d4-9a4a-945925117762", "text": "The journal pressed once against Zik's ribs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "37acd2ab-103c-4443-b30a-79997c568c30", "text": "Slow.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
