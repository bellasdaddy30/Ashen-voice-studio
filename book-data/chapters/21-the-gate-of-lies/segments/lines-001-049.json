[{"id": "2ef3a657-3a51-4fda-ba2e-ddfbee616938", "text": "CHAPTER 21", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "baa8c94c-ab82-49aa-b1fc-05cd5bd49670", "text": "The Gate of Lies", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "e0572e09-9996-4505-8845-f2f66c582c26", "text": "They started walking.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9cb53d1f-25e4-410d-9c39-357a48af3e3e", "text": "For the first hour, Uruk remained behind them as a black interruption in the western sky.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "155603c3-fbc5-47b1-b21c-720a396cf22f", "text": "The city wall followed at their backs, visible whenever the land flattened and disappearing whenever the old irrigation ridges rose between them and the torches. From this distance, the watch fires looked pinned to the darkness. They did not seem to move, though Zik knew guards were pacing above the bricks, looking outward for enemies and inward for citizens who had discovered unofficial uses for drainage channels.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2597d394-ae3b-4f43-b87e-58048a992be1", "text": "The ground beyond the wall was not yet desert. Abandoned fields lay beneath the darkness, divided by dry canals and low embankments. Thorn scrub crowded the old channels. Rainwater gathered in the deeper ruts, turning dust into mud that clung to their sandals.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a5027711-b88f-4205-b4a0-9c05a144db23", "text": "Balag walked behind Zik, breathing heavily beneath his pack.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f7f6ea12-b6f8-4132-82c3-29fc08007c63", "text": "How far?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8d77cea2-db1a-411a-bcf9-709ae46351d5", "text": "You asked that already.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e8d425e8-7111-442b-9dc4-5b57be3780bd", "text": "I disliked the answer.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fce273ee-26a7-4072-93c8-5eb907e320ed", "text": "Another half league.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6de00223-444e-49b1-89b6-1ef03ddecbb1", "text": "You said that half a league ago.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "803caf93-d30f-4b89-b11b-aabe6a0746fd", "text": "No. I said we would not stop until sunrise.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b9d04dee-5b23-4734-bd7d-ee2f2857f5b5", "text": "That was worse.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ed36d7aa-7400-4b9c-98e4-85578bd02aee", "text": "Ninsun stepped over a collapsed section of canal wall and nearly lost her footing. Balag caught the back of her satchel before she went down.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "45ff858c-48b4-4b28-ac4f-fc34f0bb0df9", "text": "She twisted around.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "665de4b3-b2a4-4e5a-8503-9ae13edaa8b3", "text": "Careful.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ba5b7da2-912b-4b19-8cff-10ceaac4a21a", "text": "I was.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "15f201b4-1ae9-48ff-91a1-ea1ca9db2268", "text": "You almost fell into a ditch.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "39a31fa6-6181-474e-aa69-58525df22e25", "text": "I identified the ditch before entering it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "590bffd3-8181-4b7b-b410-6fce1974cd6f", "text": "With your foot.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "02140a06-c79e-4f0b-a877-55c57c666f3e", "text": "An archaeologist uses the instruments available.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "672f242f-195a-4b96-b012-3f6ce7586ea8", "text": "Balag released the satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6ca98d23-a466-42c1-8e89-b6380a415e20", "text": "Next time, use your eyes.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9934bbdc-493c-404e-9e02-248ba7db4ebb", "text": "Enhedu moved ahead of them, barely visible except when she crossed a strip of open ground. She had removed the pale wrapping from her hair and replaced it with dark cloth. Mud had dulled the lower half of her robes. One hand remained close to her knife.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3a16380d-d93a-4a33-b0b9-d8ef20622f97", "text": "She stopped at the top of an embankment and raised two fingers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5960e01e-7cab-477b-b0e8-d4c5f32d4056", "text": "The others halted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "92ea9775-d254-4fff-bd09-eeeee140bd6b", "text": "Zik listened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "21ec16ba-12c0-47dd-a9ef-d01e7be6dc64", "text": "The night carried small sounds farther than daylight did: water dripping from reeds, insects clicking beneath the thorn, Balag's breathing, Ninsun trying not to breathe loudly enough for Balag to comment on it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1b7ea2c2-d0d0-403f-9fa6-62275c5eeba1", "text": "Beyond those sounds came the soft creak of leather.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6a71df3c-f345-4f39-ac2f-b39ba729b240", "text": "Then a snort.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6abb66b4-6294-466a-873b-3a955b67f7e3", "text": "Balag's hand moved toward his axe.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a28bba83-a2b1-4dd0-85f6-0ce1ca4181ce", "text": "Enhedu crouched, peered down the far side of the embankment, and looked back at Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "efe7d62c-5bcc-4da3-9eab-aec43ddd90d6", "text": "You arranged animals?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e836ef5f-4450-4daf-9d4a-8874ea381f63", "text": "Two.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "05c2f47b-fc6e-434a-9272-2e375c357e6c", "text": "You did not mention animals.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3996d3ad-9570-405c-8d7c-cef0828ccf91", "text": "You did not ask how I intended to cross the desert carrying four lamps, a hammer, two ropes, and Ninsun's private library.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b8949beb-e6b9-475c-b37b-ca26f8420deb", "text": "Ninsun adjusted the satchel against her chest.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7b9e5646-4872-47b4-8aee-7a2c76aa2a34", "text": "It is not a library.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0a519c7e-5cd7-419b-a330-38d49c4c9819", "text": "Libraries usually have fewer tablets.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d1b5e43e-ee52-4e0c-a003-7a3544c98da6", "text": "Balag climbed the embankment beside Enhedu.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "313886e6-93a0-4132-b1d5-ea0d741641e5", "text": "Below them stood the ruins of a small field shelter. Three mud-brick walls remained. The fourth had collapsed into the dry canal. A roof of bundled reeds sagged above one corner.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4d4ce2e0-de6a-4c2c-8018-fd7b1468287b", "text": "Two donkeys waited beneath it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4a723700-0352-4929-a9f5-70604d70f3dd", "text": "One was gray, narrow-faced, and watching the group with immediate suspicion. The other was brown and already attempting to chew through the rope that secured it to a post.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f2fe187d-a724-4a6b-8a1c-bbd138557693", "text": "Balag stared at them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "54226dbb-4bab-4c08-8ad4-9a7042487c0e", "text": "You left animals outside the city wall.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cd0c5bc1-4248-4a67-a2fa-bd48c27d9109", "text": "I paid a farmer to leave them.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e127a1cf-d37d-40a0-94e0-ab8b6129c986", "text": "Which farmer?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b55657a4-5e97-4d62-9ed1-b43a8bbb5955", "text": "A reliable one.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
