[{"id": "e834151a-f71a-4e4a-85dd-a3a834252741", "text": "What does it say?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d55ea734-e596-4147-9ccc-2cc697746fa5", "text": "Not enough. The beginning is broken. The surviving portion describes a descent through seven gates.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c39e536d-a046-42d5-b436-634d41e485cf", "text": "Balag gave a quiet sound in his throat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "869988d1-f054-4467-bb64-6efdeca3643f", "text": "My grandfather told stories about seven gates.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "66fceef6-56e8-4714-9774-03e856362dd0", "text": "Most cultures have threshold myths.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b1df7917-1325-4fdd-acfc-9233586b60a8", "text": "My grandfather called them warnings.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3434e7fb-c15c-4451-a269-8c3c90cbfd0b", "text": "Most warnings become myths after enough people ignore them.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e65d625f-bfd4-465e-9eaa-48cb6009c0b3", "text": "Zik secured the last waterskin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9c47f312-02f4-4f40-a700-c86c5d3c6ff0", "text": "What did each gate do?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b7a8a9bc-af6a-4605-a013-ba27def7e0a4", "text": "Ninsun ran her thumb above the copied signs without touching them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7f8d9305-395e-4ab8-a6dc-6216976d14b2", "text": "The traveler surrendered something at each threshold.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ec0b6c87-ce0f-4396-9176-4425c8fc482b", "text": "What sort of thing?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6ff61ac4-8a84-4604-9523-dda25bce6f7a", "text": "At the first gate, a covering.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e9a2873a-5e23-4d73-a755-67d7a046cfea", "text": "Clothing?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "db72dd51-9ad3-44c9-8376-f2b760d40a43", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "c2b4caf7-1c9e-4cf3-82bb-57848127a63c", "text": "Possibly. At the second, ornament. At the third, rank. The fourth passage is damaged.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e7e636ec-10f7-4b91-a794-40c8f6fcbddc", "text": "Balag looked toward the drainage channel hidden beyond the fields.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e4fe7d76-30af-4a05-8b26-3f2f7e0095a1", "text": "Four knocks.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1315d016-9ce6-4e32-a1c2-440480c0dcbd", "text": "Ninsun nodded.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7bd91971-64ac-4789-87fd-4c63b5ac3a08", "text": "The surviving sign can mean name, declaration, or recognized identity.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d0bba616-9c35-4ea8-969f-c8b28ae4a933", "text": "Zik touched the pouch beneath his robe.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7745e592-0fcb-44c7-9529-aefc0358ff92", "text": "The bronze seal lay cold against his chest.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "31522d00-15df-4b14-b1a0-b0157a591570", "text": "It tells the door what stands before it,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ff2ebae8-e73f-4916-b1d9-dbf381b0026c", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "c4443e0e-878d-494d-a360-4cf231c8024e", "text": "Ninsun looked at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6176934e-f0a4-4088-bde0-e881fa1ddb39", "text": "The Collector's words.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "35e3e51d-777b-4521-8a70-bd9a280f4016", "text": "The seal has seven lines.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "af3b63d6-4531-4e39-a49e-b637244c6c17", "text": "And an empty center.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "635b9d04-1144-467a-8e25-464bb64019e8", "text": "Enhedu held out her hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ad72c0e4-50cb-448f-af6a-6629a41d8d93", "text": "Show me.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "85152619-9265-4e04-866e-dcc5168d33d9", "text": "Zik did not move.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dcc23c09-ff23-4923-9aa1-d851b8fba683", "text": "You examined it already.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d85c0fc0-c62b-4c07-af7a-529f1dbb6c99", "text": "I examined it in a room where a man had climbed away with his hands pointing in the wrong direction. I was distracted.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "544e8cb1-6bbf-41ef-a31d-001125f066f7", "text": "You seemed focused.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8d6f1b80-928e-44d9-87d4-cf6d6f7254ca", "text": "I can be both.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5699915d-c03f-4d55-83eb-adcea8e8698b", "text": "Zik drew the pouch from beneath his robe and removed the bronze seal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "87a3a17f-43db-4d82-93b2-0f2ae82a9f68", "text": "The lines remained dark where they had changed beneath his marked palm. Mud had dried around the rim, but the grooves were clean.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8828b414-f90c-4ca6-80d7-2181521febc0", "text": "Ninsun took it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b14d3d7-fe73-42ec-b215-c4df2a19ff5b", "text": "She turned it toward the east, where the first thin suggestion of dawn had begun to separate the sky from the land.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6d1ad9fa-d3ed-401d-b8db-e1c82692c2b0", "text": "Seven descending lines,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "430535ca-4151-43a1-8700-5b062ecebe20", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "7c1c7620-0c53-4366-bcff-bd33465b8cba", "text": "Seven thresholds.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "313b405d-1402-4a4e-8c41-a19391faa0af", "text": "Balag came closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "90dae446-1405-4159-b42a-a9a585bd3d1c", "text": "And the empty center?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ef6d878a-9fb9-43e9-badb-f92bc3014cc5", "text": "The place beyond them.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d637a723-b2d9-4ea3-8946-28c225c16412", "text": "Or the thing they surround,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ff3fc329-e12e-4d89-ae7e-0b19c50c9061", "text": "Enhedu said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "e7aa0395-94a2-4b20-b6ae-62b31cc0c1a5", "text": "Ninsun looked at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d1c340dc-e47f-46c3-b6dc-55de3dd182ab", "text": "Yes.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
