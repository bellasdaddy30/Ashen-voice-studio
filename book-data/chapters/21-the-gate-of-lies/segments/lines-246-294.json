[{"id": "eaf8ee5d-d6bb-4871-a036-5571cc2302c9", "text": "Balag rubbed his beard.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c1e1a876-0849-47f2-970f-0e8ff386b7cb", "text": "My grandfather's version had no clothing.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cc0d0dea-0927-416e-b88a-8e6eef447fa8", "text": "What did it take?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "83e8f184-9f05-4540-8061-6c1e9ec3154c", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "0be48de2-3f29-4ef3-a9a6-54ab19e6a764", "text": "First gate took a man's shadow. Second took the voice people knew him by. Third took the hand he trusted. After that, the story changed depending on how much beer my grandfather had.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "009d8223-abbe-4de5-a8d3-43c5dec10f9a", "text": "And the fourth?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0fe32836-7a14-429b-89ad-d86a99c35db2", "text": "Balag's mouth tightened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "749d89a5-5c3f-4040-b534-5d76fca6899d", "text": "His name.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6e96c385-e10b-47d0-b31b-b0a8a424c729", "text": "The gray donkey shifted beside him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e8ff3694-09cb-4fdc-96f5-f34415d6dcd9", "text": "Its hoof struck the ground four times.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0868fc4a-8aa3-4475-a497-1a55f9726347", "text": "Once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "44e1a5ab-3bc5-4a65-8656-6cf8cfe3ffa8", "text": "Then twice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "40a6af19-9812-4ad7-b86d-4ba029835731", "text": "Then once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ec2f36bf-0f4e-42af-9e54-53c95a7a39d8", "text": "No one spoke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6cffcfa6-038f-4ea7-8d03-abe362c78749", "text": "Balag took hold of the animal's halter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6569103f-dc47-4692-b625-2f89a7e19064", "text": "It has mud in its shoe.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "120f2eef-89ba-4de1-ac7b-527a5d23a44c", "text": "Donkeys do not have shoes,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e6dc0220-d00b-4928-bbb1-7b53cd1ed148", "text": "Ninsun said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "f859ee0a-5e6e-40a1-acd3-9942962ebdbc", "text": "Then it has mud in whatever you call the part I need to blame.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "18c6557c-8925-493d-8a46-37fb0e098587", "text": "Enhedu looked toward the fields again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dc64fcc2-2486-4786-a6dc-c2e6118580f7", "text": "The story ends how?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5c734f9f-9cd4-483b-b4f1-5ce3b32acbe2", "text": "Balag stroked the animal's neck until it settled.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "de699735-b9c2-48ff-b7c5-d3f8c4085adf", "text": "The man reaches the seventh gate.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fe758a4e-369f-408d-afb8-a80c68c6da48", "text": "And?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9fb22b46-d062-446e-b027-316db123a739", "text": "He has nothing left that the gate can take.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "81425b83-71b6-4dfd-8af1-eb863f6df2ab", "text": "That sounds useful,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "edc6fd4f-66f2-4f06-a6f1-f72731168b2e", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "aa35dbc8-930a-43ac-bc2c-a85f283164e4", "text": "No. It means the gate takes what is left.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1a5e85ac-d009-4a3e-8940-74b7eb33a598", "text": "The eastern horizon grew paler.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "502bf9d1-a554-46b7-9a54-8b62cefcdf16", "text": "Shapes emerged from the darkness: dead canals, thorn clusters, the low swells of abandoned fields. Farther east, the cultivated ground thinned into scrub. Beyond that waited the open desert.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f582252b-e550-445f-aa08-35fbce9bc059", "text": "Ninsun handed the seal back to Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cd9211fb-8e01-4378-a49f-4c98decaf271", "text": "The lower archive contains other fragments. Some say clothing and jewelry. Some say memory, title, ancestry. One version says the final gate requires the living traveler to surrender the last thing that separates the living from the dead.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "184cd8af-1552-4c18-9c1d-2da46e37322f", "text": "Balag glanced at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "34ea82eb-c91d-4048-a0bd-440718e18326", "text": "Breath?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "95f07ec3-fa7e-40a8-bdf5-4838fbd97158", "text": "The text does not say.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "53a23016-da5e-477e-8654-dd10b1f947e2", "text": "Soul?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b4def8f3-daf8-4887-9f40-045815f36dde", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "aa61e7dc-e968-4b22-a7ed-f7c8ec996329", "text": "That word is not present.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c999e525-df6c-444b-8a31-b5038c9fdba2", "text": "Good. I was concerned it might become specific.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b555475f-1932-41cc-a78a-0d32ceee5719", "text": "The translations may describe ritual disarmament,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "16c1b090-ed27-4ffc-adaa-09ff59bc5736", "text": "Ninsun continued.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "bad665a3-b466-4148-a986-325d2d22c135", "text": "A ruler entering sacred space is stripped of rank and visible authority. Each gate removes a social identity.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0fcea92d-b3c4-4ae8-99fb-d153843b0833", "text": "Until the ruler is only a person,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "58537a49-8193-4c75-8d0e-66bd2487d5d5", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "6a3bec03-2765-4cc1-8fd1-642f183c3df6", "text": "Possibly.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "24d96f61-96fd-4738-bccb-9d40c8ffc98f", "text": "And then the last gate kills him.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "faee9996-d2f4-437c-aece-abf987d068e6", "text": "Possibly.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0e9d23d1-6b5c-43e4-b80b-3b5df4ccf950", "text": "Balag gave Zik a flat look.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "914e8555-1862-4d79-b96d-c82a5d207fd0", "text": "You sound pleased.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
