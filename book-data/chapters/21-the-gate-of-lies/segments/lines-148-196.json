[{"id": "74cbf35a-815a-402a-a55c-0d1e4885d721", "text": "Deliberate.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6864b282-4896-4648-adef-180811526a65", "text": "Her eyes dropped to the satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4b2e19be-3182-4b94-a4a3-4556864c9322", "text": "That was poorly timed.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "42675e7e-724c-4290-8d4d-e69d8d216c77", "text": "It has no manners.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5dced730-e44c-4623-8d02-0dbcc6cd1c7a", "text": "What did it say after we left the city?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f738c9d4-0cc2-47df-a75f-ff5b9830c9f7", "text": "Nothing.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "aad038cd-b84c-40e1-ad55-1a9560fb8270", "text": "The journal pressed again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1829d3c7-659c-44f8-81f2-3b6aee5e13bb", "text": "Ninsun folded her arms.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1b0e51f7-cd8b-4a07-a507-7c04030d5204", "text": "Balag resumed pulling at a strap that required no adjustment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3e2fc9fe-e947-436b-af7e-8e6e6961847b", "text": "Enhedu spoke without turning.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c2f82778-0dc5-49cf-855c-ccb4fb1d4fb9", "text": "You should lie more carefully around objects that contradict you.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3d616608-b6dc-455d-8aa6-f4b368b84817", "text": "Zik put both hands on the brown donkey's pack frame.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ae37350e-56ed-4c1f-93db-1ce66047489d", "text": "It did not write.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "02b5234f-1149-4135-96aa-1867e54d9f71", "text": "What did it do?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dc0ea20d-e0cc-48ce-946c-9a9acabab85d", "text": "Ninsun asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "212eb3fb-84e1-4544-a435-b3a7a9de9c82", "text": "Knocked.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4f1f0ca3-6255-4077-a514-4926f58457ef", "text": "How?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3c0ec2a3-ee85-4cd2-917a-507eac5aaf35", "text": "Once. Then twice. Then once.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "27b11ac0-5ff5-4c83-bdc3-ead7c4403c2f", "text": "Beneath the wall?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "36153ac5-01c0-41f0-bd52-745f2eadfdc4", "text": "Yes.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f48dab45-25f3-47ad-857a-6660c4dfaff5", "text": "And something below the drainage channel answered with the same pattern.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b66f131e-b6d5-43fa-896f-cc84b8c5f90a", "text": "Zik looked toward Balag.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "040055ef-9575-4b87-98a2-c0d37b8ea375", "text": "Balag tied off the strap and avoided his eyes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "772aa151-476d-4ef4-b9b0-4bc9b1acb52c", "text": "Ninsun's face changed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4212c0a4-1e8a-4b08-b57e-c296d1bf5d53", "text": "Not fear. Not yet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fc4f8da3-ae60-4943-a805-b327d102075b", "text": "Recognition moving toward fear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "744673bb-fe54-4751-a38f-46b2449feef9", "text": "Four.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "07969250-7682-45e5-9a8b-a56a44b6cb9d", "text": "What?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "eff3c334-e0e3-4594-b345-bfd15f7d45e8", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ecb834e0-2d42-43e8-a64a-52f029e0f78a", "text": "The sequence totaled four strikes.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0cc290db-518d-4a86-9e8c-47b655d19f7a", "text": "Balag looked up.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "64f4159f-5599-4514-9804-daea6dd0773a", "text": "And?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6f389a9b-d815-4185-ad25-5ed2cc751aa7", "text": "Ninsun opened her satchel and began searching through it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ce8a9c38-3b11-4fa2-a80f-e4a8cbdba5d0", "text": "Do not unpack the tablets,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7cac588a-c2e2-4509-bf4c-790a8e597b9a", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "44077e1a-1899-475a-bc52-316857968b52", "text": "I need one.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a81b2aa8-e146-4d61-8224-930008f579c6", "text": "You need all of them. That is the problem.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "21f9f9d2-2af7-4c75-b34b-59793f1c34b5", "text": "She pulled free a narrow clay copy wrapped in linen.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2d532425-a04d-4070-a3c9-95c5042fbc2f", "text": "Balag looked at Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4fb6c57f-5e87-4922-901e-8e1215263394", "text": "You knew about this?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7d0a5044-7eea-4076-87ca-9849f31ed19e", "text": "I have stopped asking what she carries.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fef51b25-41f6-4a42-8ebb-a27a1c41f0a8", "text": "Ninsun unwrapped the tablet and held it close to the faint starlight.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9ea193b4-8fac-470b-87d4-26fc29fc5e01", "text": "This is from the lower archive. A funerary fragment from the Old Kings period.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d132aa01-0324-4807-ba4c-3f6557af643f", "text": "Funerary?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9499921e-b912-4e74-940f-7cf00845d8c0", "text": "Balag asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "e20a81a0-6a44-4bf8-a50d-b5337e31d5a9", "text": "That was the classification.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "06fdc836-81dd-4b92-abce-edde00b82815", "text": "You disagree.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "70255d66-b7e6-4d78-83a7-e0c058645c97", "text": "I think the classification was convenient.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c59effe6-7a60-49e7-80f7-752aaae33b9d", "text": "Enhedu left the shelter's edge and approached.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
