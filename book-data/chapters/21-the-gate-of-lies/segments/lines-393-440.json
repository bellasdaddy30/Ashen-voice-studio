[{"id": "1cc1e3e3-11b5-403c-91fe-96f8be863a35", "text": "Ninsun stared at the word.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7e7a9bef-df44-47af-8b83-a8fcac1d9d74", "text": "Paid with what?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9e4fdda8-cf7a-4d4c-9469-b6fd083029de", "text": "The page remained still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "43367aec-7a80-4e2e-a6e5-bda0e286fa13", "text": "Enhedu checked her knives, then the dark cloth around her wrist, then the small pouch beneath her robe.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "61c39609-5f01-4a22-9589-2733a3e00c83", "text": "Balag touched his throat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4d3cf03f-5e5d-429a-a29c-4ba541686a49", "text": "Ninsun looked down at her tablets.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9ae80344-209f-4ad1-b1ca-9e51abc307fb", "text": "Zik searched himself for an absence.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e302ee3b-1337-4452-b963-9ff66d0adb21", "text": "He remembered his mother sleeping in the repaired house. The archive. His father's face. Kurash raising the hammer. Uruk behind them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ab0a36a8-248e-4f41-bb22-c2fc4337b9e0", "text": "Nothing seemed missing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b5f48d63-1b0f-4f6c-afcd-7454ebff9972", "text": "That did not reassure him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4cf855a1-bd77-4286-93d6-fc6867a13ba0", "text": "Balag looked from one face to another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "691e53cb-16ea-47e3-a073-5862312f9644", "text": "We count everything.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "14c79fcc-7679-4169-a445-9293e16c3be2", "text": "What?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2d8be0c5-bd4a-4f3e-923d-5646af05b78b", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "25a844c4-4c87-4896-bff3-235998531583", "text": "Names. Memories. Fingers. Whatever the stories say these gates take.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "606c5dfe-57ad-43d9-ad4e-26e106991f6c", "text": "You would notice a missing finger.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6b0f2e66-6d32-4f4a-8824-bb3b1f7f863c", "text": "I would prefer to establish that.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "aa6bbfa5-25dd-40a0-9da6-4007805d4ef1", "text": "Ninsun pressed two fingers beneath her jaw as though checking for a pulse.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9a34650e-8ec8-4794-b174-ba629ca64f57", "text": "My name is Ninsun Etana.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "df1b5116-8f6b-4ccf-902d-f8fb6e294223", "text": "Balag,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "73759821-4001-4651-bd3d-5b3752ad5825", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "0ec3769a-6b38-44d5-9d18-9f66f6f4e880", "text": "Enhedu looked at them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "49a3c5ed-b16f-41b9-8d14-d7d187aec764", "text": "This is foolish.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "19a5cbd2-c591-41bb-a69e-6f03ffbc7ce6", "text": "Name,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3dc01b15-5821-4f56-b6d0-b792b30742e9", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "f2b4d4fc-6b7b-4fff-bb1c-c21a7d7aaa3f", "text": "You know it.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "54bb7022-ed17-4785-bbb8-ecbcfe42064a", "text": "Say it.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9256b62b-2816-4a7b-9a39-45030ca3121a", "text": "She watched him for a moment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c4ef6be1-d995-4854-9971-81197e3eee4e", "text": "Enhedu.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4dee7443-7a9d-41da-9665-1585dbf6b039", "text": "Balag looked at Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0da54ff1-a1f4-4c65-b8fb-a9efce60a549", "text": "Zik closed the journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "82d9c7cf-8b8e-405e-8490-634dfa7f2bbe", "text": "Zikir Ashur.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cb094a2e-7de4-44c3-ad68-78803f265ce4", "text": "The journal knocked once between his hands.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ac55ceb8-0c12-4be9-b3a1-4fec315f1763", "text": "No answer came from beneath the ground.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e541b053-1c69-477a-803c-9ce888cc358b", "text": "The sun broke over the eastern horizon.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "88362596-a648-466c-a932-0ab247515bb8", "text": "Light spread across the fields and reached Uruk's upper walls. The city stood behind them in brick, smoke, and gold.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b62b6759-8c12-40bd-a56e-b6a58def9bbd", "text": "It looked permanent.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8b0d0852-ad9e-4cb7-90d8-af0614209367", "text": "That was the first lie.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "44f8d8ff-31e7-439a-80c4-24c90d1a1c02", "text": "Zik wrapped the journal and returned it to the satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9faba32a-a3eb-442e-b392-a2d5645e0d30", "text": "Balag finished loading the donkeys. Ninsun secured her tablets. Enhedu climbed onto the brown animal before it could object and settled the reins in one hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7b8d76cf-21f2-48d2-a884-65916ab9ac44", "text": "Zik mounted behind her pack frame. Balag took the gray donkey's lead rope and walked beside it, refusing to ride until he was satisfied the load had settled evenly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f18f1e9f-1b03-49f4-9c75-e6bc779b5360", "text": "Ninsun climbed onto the remaining space behind the waterskins.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5d19a1d8-c49d-4d15-a909-a1fc1457a2b2", "text": "They turned east.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6ea8ac87-af39-4dc6-9b4f-8c6cab7c7313", "text": "Behind them, Uruk disappeared one wall at a time as the land rose between the city and the desert.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "66dcb3b7-8728-4a63-beaf-eb5eeb4ee201", "text": "Ahead, the old road ran through dead fields toward the dunes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6486eab6-b710-4737-a1a2-0724fa9b4696", "text": "The journal rested silently against Zik's ribs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "27ebff3d-63c1-4d05-8d21-79fa9b35dd8e", "text": "The first gate had taken its price.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7f81f3c6-c438-4c92-ba63-5d5deb08370f", "text": "None of them knew what they had paid", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
