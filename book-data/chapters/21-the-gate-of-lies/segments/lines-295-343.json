[{"id": "0cdc7e87-75e6-4407-9e58-4bc4545128cc", "text": "I am relieved the ancient priests may have been murdering kings instead of feeding doors.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6232da20-198a-486a-9b8b-356609d6a5a1", "text": "That is the lowest standard for relief I have heard.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "412c6141-ab49-46d0-9c42-ded5cdcd6f7b", "text": "Enhedu rested one hand on the hilt of her knife.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "86081743-a882-44cf-91a7-87d9e6c2a633", "text": "What if it is not ritual?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "79d0bc76-6210-4622-bb72-96bdae2b37ef", "text": "Ninsun looked toward the east.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b60c3c47-4031-44f7-8514-2fa322807663", "text": "Then the stories are instructions.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7505ca55-2904-4793-9150-6a777bfbb95f", "text": "For entering?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "94754980-4359-48e0-bed8-cc7c0d40818f", "text": "Her gaze shifted to the seal in Zik's hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bcfdd8e3-1c52-4cce-b369-b8a515c2b2ba", "text": "Or for preventing something from leaving.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "75776368-23fc-4b51-bd7e-0b48644f1e55", "text": "The wind moved across the fields.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cf263a33-74e8-4bf7-abc2-a8c072632c82", "text": "It came from the west, carrying the smell of wet brick, smoke, dung fires, and river mud.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "518d8171-8e63-4999-9826-fe9f123da31d", "text": "Uruk.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "526c566f-47b4-4e4f-aa93-b18e2a94a1b8", "text": "Zik turned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8e40d5e9-2125-4f13-b40d-b9deefbeefe0", "text": "The city had emerged behind them with the dawn.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bf22095f-0881-41d8-aaa4-af2683345169", "text": "It rose in layers above the wall, rooftops pressed close together, smoke already unwinding from ovens and workshops. The temple platforms caught the first light. Their upper walls burned red while the lower districts remained blue with shadow.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1da4917d-2283-4b4f-9d9b-adbde4c3039b", "text": "From here, no cracks showed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c191b58f-56a0-4c18-9719-7f8fb92fda58", "text": "No false doors.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f011eef7-9283-46cc-8360-beffe0073e03", "text": "No rain climbing walls.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "151db2f4-d055-4880-8a4f-f6660aed1548", "text": "No narrow figure standing between torches.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8eaacaf3-f703-4021-b947-849b8a8db2d5", "text": "Uruk looked ancient enough to have invented permanence and arrogant enough to tax anyone who copied it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "79ecc8af-52c6-45f0-9ca9-fd7a0614f21f", "text": "Ninsun came to stand beside him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e06d1a21-3992-47f3-8583-b3f548b2fd93", "text": "The texts call the place beyond the gates a city.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f1444506-16da-4865-83a6-d26916eeffa6", "text": "The First City,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7f5e5dc7-fad7-4f82-8064-2c0c7dcfd662", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "9dc92825-c8f1-4e66-87dc-8c8f57b8e335", "text": "Not necessarily.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9f17793d-1b1a-4f23-ab1b-0af26a841690", "text": "Zik looked at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "46473630-88e6-4f20-8653-ef35d601179d", "text": "You crossed a wall, a roof, a drainage passage, and three miles of mud to correct us now?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "48b07ff2-fc79-4693-be8b-bb143616b0f7", "text": "The term translated as city can also mean ordered enclosure, inhabited foundation, or place under rule.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1ee0f894-6a74-4ad3-a704-80d9c6f01e65", "text": "Enhedu joined them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cd72ea20-2673-4a14-a42a-3c2ec154741d", "text": "Can it mean tomb?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2df7194e-9e3c-4a71-baf7-a0adaf0c741a", "text": "Sometimes.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "263e4734-7bef-4644-b2ab-d994fa6e1f38", "text": "Prison?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9c1072e8-9eac-4a60-8ccc-778712de448f", "text": "Ninsun hesitated.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "64575d34-41ce-4256-92e4-2353f9549d61", "text": "Yes.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "883a03a0-7373-4ba5-a798-21504c9610fc", "text": "Balag looked east.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "28f08984-9ae3-436e-a8ef-9503594d005c", "text": "And lid?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "498baa8d-9d25-4b15-a71d-473bdcc14a99", "text": "Another pause.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "57038a48-7f9a-4c5b-9305-8f8ee35a8faa", "text": "Yes.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "71f58d3a-106a-419d-90a3-738f72a19e64", "text": "Zik felt the bronze seal warming in his palm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8f0bab7a-b8bc-49dd-8457-53d455aca393", "text": "The Collector's voice returned to him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f3bb1860-76cf-4eca-8475-6a40bc4bc0a3", "text": "The City is not a tomb.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Memory echo of the Collector's voice.", "generated": false},
{"id": "0a36d3ad-7655-454d-be4c-fb4e17a76efa", "text": "Zik had dismissed the rest as a threat shaped to fit an old fear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c1f81a2f-e8eb-4ab0-9a4c-da10f8ce167f", "text": "But the old texts had been written before the Collector. Before Bel-iddin. Before Kurash raised the hammer over the black floor.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f61bfc90-e892-47fb-8ff6-3ee00195df89", "text": "Ninsun spoke more quietly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fd9aa7a8-9a20-40e5-a9ff-9a4de10d9bc0", "text": "The accounts do not describe people building the First City.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "31e637fa-b0e1-432f-a0e2-87c2b0bb8d95", "text": "What do they describe?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "21bdd227-543e-4453-8d0e-2096ec99a10a", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ca3fefc4-c0e5-4914-89dd-a66e10cd3e15", "text": "Closing it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4c2405dd-8767-4d60-ac0c-95b5dec04a56", "text": "The gray donkey snorted behind them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
