[{"id": "db538261-3493-4838-9a0e-a187a0dcd434", "text": "Enhedu looked around the abandoned fields.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4990d295-5586-49a4-86fe-d551cba2b264", "text": "There is no farm.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "51ba5601-7bb5-4275-ad0d-0a4728e4ea65", "text": "He is reliable because he understands distance.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "330b0961-2830-4543-b31f-198de38e97e1", "text": "Balag descended the embankment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "753d1c41-317d-4ccb-9ec5-1ef8abfaf0a8", "text": "The gray donkey flattened its ears at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6b9bd406-332d-4d60-a3a5-f690f5064122", "text": "He stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f239c455-92c1-4f34-b2a0-9b6393aaf51b", "text": "You selected this one?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6a85cd3c-360b-44d7-8227-0ba85917a435", "text": "It selected itself.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3db718f3-4abc-46b4-8957-7405a292a433", "text": "It hates me.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0f92265c-e057-437a-b47a-20030342bb9f", "text": "You have that effect on thoughtful animals.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c8b807b6-9dbf-4b3f-9d20-5e97559314c2", "text": "Balag held out one hand and spoke softly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1ec0672f-3c99-499f-af30-96172c34a52a", "text": "The donkey considered him, then allowed him to touch its muzzle.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "37fc0630-3b5b-435c-971b-ab6e6ebc88ad", "text": "Ninsun climbed down after him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9820528e-1600-40d3-bab7-8bab8ab3a291", "text": "When did you arrange this?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "24231873-d4e1-41e2-9ce0-4ac111d23949", "text": "Before we entered the archive.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6dbc4f84-f455-4224-b36f-b282cd1bd0ef", "text": "You expected to flee Uruk?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b4a5321b-6a8b-42b6-a424-1cc42739ebab", "text": "I expected Uruk to become inconvenient.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1971a76b-4d2f-42c0-bb2a-db72b1591294", "text": "That is not the same thing.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e4b6e919-d13c-41b8-9341-ac1666104287", "text": "It is in my work.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c0050d13-60dc-43a8-9db3-e465123f10bc", "text": "Enhedu entered the shelter and examined the shadows beneath the remaining roof. She checked behind the fallen bricks, beneath the reed matting, and inside a cracked storage jar.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "373b4a80-d093-40fd-8e42-d44e10c86437", "text": "No farmer.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dcbb2705-1fd9-490e-aa3c-b54be39972a0", "text": "He was instructed not to wait.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "463fdade-fa43-490b-b6b4-c7cf9f7a3907", "text": "No footprints either.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8062e199-d2c8-4513-a02c-a14aece39f5b", "text": "The rain.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1d23552b-9e63-4850-8909-cac55718c187", "text": "The ground beneath the roof is dry.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "378f42a6-d363-41e2-a1f7-bf31c5510868", "text": "Zik looked down.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4f2deb42-dfc3-468c-9c19-e61a604827e4", "text": "The animals had churned the dirt around the post. Their hoofprints overlapped in circles. Beyond those marks, the floor of the shelter remained smooth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4dfba7ed-82ba-4d06-a0e6-158762c5d4f3", "text": "No sandal prints led in.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2d96e780-1b00-4331-adb9-8dcff8b93749", "text": "No prints led away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f0ac08b5-78b5-4cd6-9464-74a256995d82", "text": "Balag ran his hand along the gray donkey's flank.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "18369d58-d01d-49c9-ab91-fcf87f99a604", "text": "They have been fed.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0076a952-3cde-4f45-a13d-eaec0b11c1a5", "text": "A bundle of barley stalks lay between the animals. Half had been eaten.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0eac35c4-9076-4072-be15-99461571125b", "text": "Ninsun crouched beside it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1c369501-7fa3-4504-a2ae-e0c709d49a90", "text": "The cut ends are fresh.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b0e4a961-6785-4859-b404-bd668fdf3891", "text": "How fresh?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b2fe42dc-6487-4f8f-950d-753409802bd7", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "04285d28-c12c-4835-bb3f-02a82ecc92b6", "text": "Hours.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2f5f6d9f-40f6-4419-9b73-0f27bc8dba33", "text": "Enhedu looked toward the dark fields.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cd548c7a-ff53-415a-84b8-9fbdd3a71f82", "text": "Your farmer came without touching the ground?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c6aacd20-1fb8-490b-801a-a0db433ba171", "text": "He was always light on his feet.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "556bda3f-ed02-4b46-8803-59a393bbea5e", "text": "That was weak,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b4657958-7560-41ab-8d9f-feddc3521b6f", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "86d79d8d-0af5-4fa8-84b2-898ae6d20a18", "text": "I am tired.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9fe803d3-c447-4276-843e-15d30d80b72e", "text": "That has improved nothing.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "52fa09a5-3a5d-4470-addc-7af9ddae8fbe", "text": "Zik moved to the brown donkey and untied the rope. The animal immediately tried to bite the bronze fitting on his satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bc4c1286-d9a9-4deb-b6f0-ad469d5ac968", "text": "He pushed its nose away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e06018ca-d648-48a0-a97d-95137f9b7e10", "text": "Do that again and you carry Balag.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e1709228-30f7-47a0-9c17-ecb573288aea", "text": "The donkey looked at Balag, then stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "03bd4401-a716-47ef-9db2-2d1b6c443fd5", "text": "Balag pointed at it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
