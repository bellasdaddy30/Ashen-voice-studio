[{"id": "35feef43-4ab3-4f33-a45a-41fb92641e49", "text": "Then where?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ca5d8933-e5c2-4882-ab16-b81ead2b1394", "text": "She pointed at his hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "41690668-9df2-48c5-99d1-43efff4e3ad1", "text": "The mark knocked again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6a21ff2e-f46a-468f-a6ad-51fb68fc8134", "text": "This time the answer came from far below the City—faint at first, easily mistaken for settling stone or the ordinary shifting of ancient foundations. Then it came again. Three measured strikes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "31132be1-288e-445c-833a-fe04e1dc4ff1", "text": "From somewhere beneath them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "31b17e5b-6290-4d36-8dab-3b1acbea7185", "text": "Zik's face had gone completely still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fd2ac3b4-3bc1-48f4-93ee-1ecc615c0d7f", "text": "The man opened his eyes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2047f132-d68a-49a2-9868-bc35936e7c7c", "text": "And somewhere far below the First City, something knocked back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
