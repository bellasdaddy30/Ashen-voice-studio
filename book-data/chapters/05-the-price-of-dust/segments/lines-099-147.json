[{"id": "594db0d8-9aa2-440b-b3cf-dc0bdaa98b2f", "text": "One boy looked up as Zik passed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "83c07c03-363d-4ece-b3ed-adf88bda6f7b", "text": "Master Zikir.", "speaker": "Apprentice Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4010c8ca-b4d8-46a2-ad56-785d3c814f71", "text": "Zik stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b77939a6-fd4f-4ef0-9072-b622c851b10a", "text": "The boy couldn't have been older than twelve. His fingertips were stained gray with clay, and one side of his face carried the unmistakable imprint of having fallen asleep on a tablet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d3ad69a8-b503-47cd-936f-75ec0ea27ee8", "text": "I know you?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c82b8cbb-d342-41fc-b419-867cb418a1b3", "text": "No, Master.", "speaker": "Apprentice Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "de5f0267-0646-44cc-8aec-a0afed9904cb", "text": "The title still sounded strange.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3e8d1774-0b7e-4a19-9371-2bdbfb7b0c0a", "text": "But my instructor does.", "speaker": "Apprentice Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "62d0d5ff-6245-4ac9-96c6-29324576eba9", "text": "The old scribe finally looked over, squinting against the afternoon light.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6075d8e2-d110-40cd-a239-18caa1c0170f", "text": "Recognition came slowly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e93c413f-2515-4024-83c3-815e14bb3f72", "text": "…Bel-iddin's son.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cc5ec559-c23e-4b1f-9316-54682a18cb80", "text": "Zik inclined his head.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f78d7197-8283-4a13-a48a-df66e333450b", "text": "I am.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c556f700-01ca-44ea-86fb-c65221422d52", "text": "The old man studied him for a long moment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "28f2546f-caca-47f4-b155-cd751ea0e3a4", "text": "I thought you'd left archaeology.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0339c822-9ac8-4dce-bad0-342fb055de88", "text": "I've thought the same thing.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8f7d092b-cc33-46af-9e00-a75c87df7b3e", "text": "That earned the faintest twitch at the corner of the scribe's mouth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "931cf8e6-49b2-41af-8658-74c2e34aab51", "text": "He used to stand exactly there.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "61c4f6a7-6180-413d-bb43-0b5ac287fe14", "text": "The old man pointed to a worn patch of paving stones outside the school.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e200ee48-6855-4282-bf1a-a37a343fb686", "text": "Every market day.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "006b5b62-3593-494f-be2c-8b4dc74af9eb", "text": "My father?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d2b03a9a-3c9e-4492-abd0-707b2d76a8ab", "text": "He'd argue with anyone willing to waste an afternoon.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "09f14a1b-fc1f-496f-aad6-727eed1d5938", "text": "What about?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c5785232-911b-4b07-9cce-ce2fc52131c1", "text": "The old man snorted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "14bb9f10-a504-453f-b30a-9e9dabfa0f9c", "text": "What didn't he argue about?", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4c4400cf-4cd4-44aa-b372-277348f61ffc", "text": "He leaned more heavily on his cane.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b865f9e-6b72-44a8-927f-cb12cc9e76d9", "text": "Mostly history.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c45046b9-1073-466a-b5c2-dd6165924e41", "text": "Enhedu folded her arms.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c50172d9-1601-48c4-879d-d9c255dac77b", "text": "History?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6883db05-ac5b-443b-be28-8ce0d7150cfd", "text": "He claimed scribes lied.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "61afd85a-3935-4327-8f15-0723fc285657", "text": "I never said that.", "speaker": "Bel-iddin", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "The old scribe imitating Bel-iddin so precisely Zik almost turns. Use Bel-iddin's voice, a little rougher.", "generated": false},
{"id": "a223b416-bc05-4ba8-bc38-1a0236290c93", "text": "The old man's voice shifted effortlessly into a rough imitation.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "31a23043-5374-4db0-85c6-8d655dac5461", "text": "Scribes don't lie. They simply decide which truths survive.", "speaker": "Bel-iddin", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "The old scribe imitating Bel-iddin so precisely Zik almost turns. Use Bel-iddin's voice, a little rougher.", "generated": false},
{"id": "7c23bb96-ff1c-4477-88fd-5319558f08d8", "text": "The imitation was so precise that Zik almost turned, expecting to find his father standing beside him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8d8d458b-c9f2-4801-9d81-fc3e28d7ff74", "text": "Instead there was only the old man.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1d10d982-28af-47d0-9de8-ae68a27cebb0", "text": "He said that often?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9e637db6-72fb-4ade-95b7-a42b9e7a2904", "text": "Often enough that I stopped inviting him inside.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2a281681-32cc-48a8-9533-e742b9821ba7", "text": "What happened?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "34d9b6fb-5a90-4e62-9167-6a55c8d26625", "text": "He disappeared.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6c814a8b-f585-4c7c-a941-f8d103883f38", "text": "The old scribe shrugged.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9adc7cbc-9ac0-4368-9eaf-17903f9e1ed1", "text": "Before that, he stopped smiling.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "896f992e-1c1c-4e68-b512-74da591d0e6c", "text": "Silence settled over the narrow street.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "61d3a2e6-6c7b-4701-82ed-6571ca852f8c", "text": "One of the apprentices finally dared to ask,", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cf2616d5-b349-4b29-bf76-55b65850a266", "text": "Master…", "speaker": "Apprentice Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d65a0b11-61dd-45e1-bf70-b839fb604cf4", "text": "The old scribe waved him quiet without looking away from Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "663cc725-6ce9-42d0-9196-e8423db7c0d0", "text": "I always wondered whether he'd found what he was looking for.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5f71ddff-d319-4a6a-817b-676d00a6eab6", "text": "Zik rested a hand against the journal hidden beneath his tunic.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "aff319f8-31b1-4701-aed3-635c28722f35", "text": "So do I.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "90ae5c7a-034f-43ee-bc6e-78e32237edc1", "text": "The old man nodded once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
