[{"id": "c29df601-46d4-4958-b74f-6ce856fcc125", "text": "If you discover the answer…", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "29e450a2-635a-4c05-93b3-bf270a37e3d0", "text": "His eyes drifted toward the crowded street beyond.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3208fc93-492d-47c7-a6dd-96dbfdeae3cf", "text": "…write it down before someone important changes it.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1da582c8-8042-497e-bf93-77fd16f0e7f8", "text": "Without another word he turned back to his students.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b02d32d1-bbad-493c-9d2c-5b6fa9e7659f", "text": "Again.", "speaker": "Old Scribe", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ca65c843-1eb6-4874-bb44-9fafd17348d7", "text": "A chorus of groans rose from the apprentices as fresh tablets were passed out.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3b7c42c8-c958-4ed4-8553-4a5f85fbea65", "text": "Balag waited until they had walked half the length of the street before speaking.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9b3aedb9-fc09-43fd-9aaa-0bc46d712b7a", "text": "I liked him.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "638d1d91-c26f-4081-920f-d04995cedde4", "text": "You don't know him.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "67fe27a0-d2df-4801-be73-b9d584bda045", "text": "I know anyone who annoys scribes that much can't be all bad.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c3634c84-d4ee-4ae6-86cf-03aae22bb7de", "text": "Enhedu glanced sideways at Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "66c9d406-5782-44c1-b0f7-660fc6fe0375", "text": "He sounded like your father.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "12b45940-cad0-4ae1-91a1-a94615e31996", "text": "He did.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bb1065eb-408d-479b-a737-104300c24c7e", "text": "You smiled.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9118d8d4-4385-4e3e-8be6-642002a28c7b", "text": "I did?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "61a8c083-6f0c-4950-9b24-9ad1e779ac62", "text": "For half a heartbeat.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3f1dce4b-a903-4819-8871-353382455189", "text": "I'll try not to make a habit of it.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "85fc791f-04b5-4590-8378-4915f26ddb90", "text": "Enhedu walked beside him now.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a1ce2002-9463-49ef-bb2b-23cac2267280", "text": "That room didn't want us there.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bb07afb4-f2a1-48a7-895f-fd21bf088237", "text": "Zik's expression did not change.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b6931e92-e0d3-4587-b3bd-2a75b56ca567", "text": "And it especially didn't want you.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5cbf2fa1-b327-450f-baf9-2e10aa04f984", "text": "Desert tricks.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "765de06c-a50e-4af1-8b9c-aca07e90383e", "text": "That's what you said before.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "843c3ae2-1c75-4903-99be-00376565c8b0", "text": "Sand, heat, imagination.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2e52148b-9d8d-4506-b8c3-84b1f3ef538c", "text": "You forgot the dead king.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a54d7d5d-eae0-47fe-9480-04e0b45cc0ea", "text": "Zik stopped walking.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4eee4428-34e7-4bc0-9052-50cbbf495e29", "text": "For a moment the noise of the market seemed to press in around them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "60797b88-f0d0-4367-9669-2747e41f4be7", "text": "Who told you?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "88f322ca-b273-4ea8-9422-3ae83f03bc91", "text": "Nobody.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c589562f-6cef-400d-846d-17d1258ed88d", "text": "Then how do you know?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6a39cb4f-5b10-437f-a33e-78679dfe92cf", "text": "Because you came out of that tomb looking like a man who couldn't stab what he had seen.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8fc92352-6978-4522-bfec-5334012a642f", "text": "Zik stared at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "243df935-ce50-40b2-8e2e-23f7c42efdf9", "text": "Enhedu shrugged.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "74772e14-55b7-48a2-a582-a2160b198017", "text": "It's a distinctive expression.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2f201104-4fe8-4cac-b271-278fb1059f9d", "text": "He started walking again. She followed. Neither of them mentioned the dead king after that.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0eb3060e-b0c5-4a7a-971e-60ad64ca818c", "text": "Zik's mother's house was a single cramped room above a potter's kiln. The heat never left. Even after sunset the walls radiated the day's warmth into the room, and the air smelled faintly of smoke, clay, and the bitter medicinal herbs his mother had begun boiling more often than she admitted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "688f0869-1fe2-4bcd-adf1-12b2671c9833", "text": "She was thinner than she had been the week before. Zik noticed it immediately. He always noticed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a96fa95e-0cc2-4409-87d1-abeca90d3b84", "text": "She sat on her pallet beside the small window, wrapped in a faded shawl despite the heat. Her skin had taken on the dry, papery quality of old parchment, and the hollows beneath her eyes had deepened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8f418d11-c2ae-4059-a654-864c124aa84d", "text": "Zik set the medicine pouch beside her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "49990c75-3f09-49e3-b891-4f3746c08915", "text": "This should last you another month.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3c1be971-e12d-4cd4-b6d0-b4140a9e0c8d", "text": "His mother looked at the pouch, then at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "71f9fb5a-0854-412a-b092-167dda4a60b9", "text": "You found something.", "speaker": "Zik's Mother", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "59cc2d81-ca7c-45ef-bd29-b30ddace69e5", "text": "Zik removed his cloak.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "10444fde-db14-4ebf-a143-5e8b353f6a01", "text": "I found enough.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4e5fb58b-fdfd-4b93-bef2-dd707b625cd5", "text": "That's not what I said.", "speaker": "Zik's Mother", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bbbacdcb-4747-497e-9570-3ace82a7913e", "text": "It is what I answered.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bfb35723-a43c-4d1c-a7e3-a1227d2414ca", "text": "She reached for his hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7ce85ad9-ecb6-4093-b0fa-b504b00fe688", "text": "Zik moved before he thought about it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "71dda8c2-7fc9-4de4-9c4f-0f33dc5c4960", "text": "Her fingers closed around his wrist instead. For one terrible second neither of them moved. Her hand was cold. His skin beneath the linen was burning.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
