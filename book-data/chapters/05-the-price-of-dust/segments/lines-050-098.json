[{"id": "0b765b0a-8268-4c2a-99f8-72ba83fa7d61", "text": "It survived three thousand years.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f0359b90-a18a-42cc-a507-3cdbfac18a1f", "text": "It barely survived you.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0b3a8769-4f2f-49f4-99d3-327f03e14660", "text": "Zik leaned one hand against the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "de1900f6-554c-4372-9f55-c1d5c6bcf16b", "text": "You've already decided who you're selling it to.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f406c9d3-af61-4f22-8934-027bd0a12c41", "text": "I've considered possibilities.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "909d15f9-5a95-45a3-97b3-450795afe961", "text": "Temple collector.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c3abd26b-dc16-4fc5-ad51-e4dd40a528cd", "text": "No.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "90d82b25-0a2c-4ff9-bd9b-33b9bcf11df9", "text": "Foreign merchant.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "59eac83b-2020-4ad9-bfdf-fdb456b0b76e", "text": "No.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2428e218-97bc-43e4-8738-a05eeb1d6cc1", "text": "Noble trying to impress a second wife.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4e775e2f-9d84-462c-b6bc-ee2886edc346", "text": "The Collector smiled.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "53038bd0-bd0f-4a87-8a23-26585c5c537b", "text": "Closer.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "343ec2fb-48d4-4ffb-9563-9eb8a36ee6f8", "text": "Zik nodded toward the bronze.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3396557a-9974-4dd2-af64-afd52d622941", "text": "Then stop pretending it's worthless.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0a533d55-ac8e-4bc4-9a53-5adb60c2038d", "text": "It is worthless.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ffdae93b-b5a6-4500-b7b3-40f60d390ade", "text": "You just called it desirable.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9eaf2d92-77b1-4421-b23b-b085ecdd5d47", "text": "I called the buyer foolish.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "551a4384-fead-4a07-999e-f545e04c5ea3", "text": "That's a valuable distinction.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "206211b4-cfbd-47ac-9a0c-7aea9fe59490", "text": "The Collector reached for the cylinder seal instead.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5fc132c3-2463-43d6-bd46-7d7dc90e5e69", "text": "This one I like.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "033ee075-cffb-4b6c-a3b1-f2b2d03c0ec6", "text": "I know.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "552e4a1d-1fe3-4dea-a589-5e64cab265da", "text": "Unfortunately.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d9091aa7-0ba3-4dfa-879f-f5b6f3e39131", "text": "So you'll pay for it.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4ad618cd-9afc-4110-b459-0147329f5dfe", "text": "I'll pay enough.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4fddccdb-b1f0-4dc1-a8f7-577bbd7153ac", "text": "You'll pay honestly.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7af2a5cd-c354-4e76-8dea-78e2ed7238ee", "text": "I've never done that.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f6877a54-e132-42b6-bb06-2be6bb77e91a", "text": "I know.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c2b23e83-df74-4dda-8bc9-22e8ecfc4147", "text": "They haggled for nearly twenty minutes, which meant the Collector offered half of what the objects were worth and Zik threatened to take them elsewhere without ever naming another buyer. Neither of them believed the other. That was the entire point.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "31f74ba5-156c-486b-98d1-f644c4957115", "text": "In the end Zik walked away with enough silver to keep his mother in medicine for another month, enough coin to replace the supplies lost in the desert, and enough lies to keep the Collector from asking the questions that mattered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "07f35ed1-413e-4a07-8461-e1f331a60661", "text": "He was almost through the front room when the Collector spoke again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0ebfc7d5-ff17-4bdb-b782-c52917d75d48", "text": "Zikir.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8bf1578e-7a19-4b50-bed9-6bdef5c33a29", "text": "Zik stopped. The Collector had not used his full name in years.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9e22e606-b388-4e7a-9743-df930ff225a4", "text": "He turned slowly. The Collector was still sitting behind the table, one hand resting on the open ledger. His gaze had returned to Zik's palm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "80132b39-77d8-4ae0-a8ca-00d9aa3173c1", "text": "Where did you get that?", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "405f262a-e7da-47fe-a744-fe19193e9c84", "text": "Zik looked down at his hand. The linen concealed the mark completely.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c33a3382-c0d2-48bf-ae5e-0d02a5eb8e98", "text": "What?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7b6d29b2-ddac-454f-a43a-d133f8cea623", "text": "The Collector's eyes narrowed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f4f6ae15-2acf-4509-89d8-23d619f49273", "text": "Nothing.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6a19aa49-b5a9-414a-9ebf-5a3a4b5f3613", "text": "Zik held his stare for another second, then turned and walked out. He did not hurry. Hurrying suggested guilt.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "11b89d5d-f4ac-466e-bb12-46432f947896", "text": "He waited until he was three streets away before checking the wrapping. The linen was still tied exactly as he had left it. Beneath it, the mark was warm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6aa63b1b-d549-40fe-a17e-0e23642d4800", "text": "Enhedu caught up with him near the Street of Scribes. She moved through the crowd like a knife through cloth, slipping between merchants and customers without apologizing to either. She was smaller than Balag and far less imposing, but people moved out of her way more quickly. Zik had never decided whether that was because of the knife at her hip or because of the expression she wore when someone did not.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a4bbf3a6-b317-4e2c-a78f-e46d14137c8d", "text": "You kept the good stuff,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4eb1ef04-03e6-4543-9120-a3af859a8d8c", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "2b1ddbac-764f-4505-9837-1ff6021915df", "text": "Always do.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b371b649-ec17-4791-bcc9-b79e45716057", "text": "That wasn't an accusation.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6884ffdb-4aa2-46b9-841c-a22de8e1fe2c", "text": "It sounded like one.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0816ba9e-73f5-4271-83d8-888cfa7be1f6", "text": "Then you should have heard the version I didn't say.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "95a334cc-3690-4673-a2e4-aef3cbff9909", "text": "Zik kept walking. The Street of Scribes opened ahead of them, narrower and quieter than the main market. Clay tablets sat in neat rows beneath awnings, covered in the wedge marks of contracts, inventories, prayers, and curses—the kind of writing that turned ownership into something people could pretend was natural.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d53a80f6-387a-4dbb-af05-b4beaab4c0e4", "text": "A line of apprentices sat cross-legged outside one of the scriptoria, each with a damp clay tablet balanced on a board across their knees. A gray-bearded instructor drifted slowly behind them with a reed cane tucked beneath one arm. He didn't strike anyone with it. He simply reached over shoulders, erased wedges with a wet thumb, and made the students begin again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
