[{"id": "fe67c738-cedc-49f2-b67f-44227921a6f2", "text": "No change.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1f473c66-35d3-4069-a02b-160845d86a47", "text": "Beside his knife.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "62725a0d-abd5-4832-8960-be28a8035b3c", "text": "Nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cd15b77e-f3b0-4309-90ee-2b540be6de63", "text": "He fished one of the bronze beads from the leather pouch he'd kept hidden from the Collector.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5de10046-9c4c-4e7d-800d-7a94bd420d24", "text": "Still nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "be6dfc28-c4b7-45e1-b4af-7a6ec8602b79", "text": "He tried the cylinder seal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c61d31ef-228f-4295-9b98-0545f902025f", "text": "The needle quivered for barely an instant before sinking downward again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ddad423a-9107-421f-a495-b1bfa8350f08", "text": "Hm.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "061da2fb-9ebe-480d-a867-16eadf18b7dd", "text": "That was interesting.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "09f486ee-33a8-4387-836f-7d07f816e099", "text": "Not useful.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a163ecfb-7df8-486a-98e3-556395ddbaa6", "text": "Interesting.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7d82d39c-04ab-43e1-a6ce-326c3866adfd", "text": "He opened the journal and laid it beside the compass.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f709d933-4bca-4a91-9749-72e898d2381e", "text": "Nothing happened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c87dab1c-f3a2-4193-8634-899dbb0e8c48", "text": "He slid the book farther away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "19420944-7c72-4c6c-80ef-65d38e7eaa0d", "text": "Still nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d1862d50-262d-4294-b318-eed7541c4b8b", "text": "His fingers drummed absently against the linen wrapped around his left hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1d153a91-4d41-48c7-bc2c-7fe4cbb87565", "text": "The mark beneath it burned faintly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "be73ba9f-109c-47a2-b64e-45bb1f0e94c2", "text": "Without thinking, he rested that hand beside the compass.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4685d500-395a-467d-a681-e8f9f37759dc", "text": "The needle twitched.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ec37e55b-beb9-4c11-9f6a-5e520231b6fd", "text": "Zik froze.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "395413c7-9aef-417b-9363-cad916cd7656", "text": "Very slowly, he lowered his palm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6d04af68-c2c6-417d-b059-83deaab0a2ac", "text": "The brass needle climbed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "518660da-4b90-4666-be03-240fccf3c5e2", "text": "Not toward north.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "968ccb44-fa8d-4d24-b4e1-cdbf8e2b8a85", "text": "Toward him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "48f2df42-0494-4c2e-bda2-6501019509a7", "text": "It stopped directly beneath the center of his wrapped hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2e13dd7b-8d3e-4172-b64e-bc2ee3075f76", "text": "His pulse quickened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dd8e4b2e-07f4-460b-b0b8-361b221d6bc2", "text": "He lifted his hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "05328058-b72a-404b-a8b0-1d29a043cc8f", "text": "The needle dropped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3bf06e38-0d02-48fa-8443-ffcfd0e1482b", "text": "He lowered it again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "721aa6d3-5f37-41c2-9f89-c06b38112c6a", "text": "The same result.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "faaa5ae6-0ada-4fbe-b690-3ccd755aa3fd", "text": "Again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e5d6db8c-28df-4786-a0a8-c3301fc8613c", "text": "The same.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4fc62abc-c455-4848-ab60-f050b593462e", "text": "He unwrapped one corner of the linen just enough to expose the edge of the black spiral burned into his skin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b1629338-c571-441b-837a-aee08bf8bc77", "text": "The mark pulsed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "323305a5-7cd3-42e0-b531-bbcc4079b383", "text": "The compass answered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "26f94d07-5da5-4217-87ba-647283ae0559", "text": "The needle snapped upward so violently it struck the inside of the glass with a tiny metallic click.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d09b6112-9202-466d-a755-12a81cad8b69", "text": "Zik stared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5694e78a-9317-4d7f-b5f4-f47710175782", "text": "He wrapped the linen back over the mark immediately.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5d9144ee-6c59-49ab-9aa0-833c618fa184", "text": "The needle drifted downward once more, settling toward the stone beneath the house as though nothing unusual had happened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "608873a4-cdf4-467d-bb57-2f0476bb743a", "text": "He sat motionless.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "efec13a1-5c1e-40e0-a74b-f07eaa4b8649", "text": "Whatever his father had been searching for…", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e610942b-1f89-4ab4-96cd-599dd7a2d4c3", "text": "the compass no longer believed it was merely buried.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "997e177d-a9e8-49f7-9559-e7d33c44beff", "text": "It believed part of it was sitting on the roof.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cb67d2d1-2115-437c-a379-f8bf90e48434", "text": "He told himself it was broken. He almost believed it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b818995c-38ac-4c8c-b887-feee3d664e1d", "text": "The journal lay open beside him. He had not read the new lines again. He had read them enough.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f12fca7d-7ec2-4a3b-ad28-c5b3593c26c1", "text": "IF YOU FIND THIS, DO NOT LOOK FOR ME.", "speaker": "Bel-iddin", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Recalled journal lines in Bel-iddin's hand.", "generated": false},
{"id": "324434e6-8566-4086-970c-7534e1e75e95", "text": "FIND THE CITY.", "speaker": "Bel-iddin", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Recalled journal lines in Bel-iddin's hand.", "generated": false},
{"id": "cf4dbe6f-4cfd-4a28-b9b3-6f8306b21912", "text": "He had spent twelve years looking for his father. Now, apparently, his father had spent at least some portion of those twelve years trying to make sure he was not found.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bfba5c00-5234-475d-aebe-bf07683750c4", "text": "Zik closed the journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
