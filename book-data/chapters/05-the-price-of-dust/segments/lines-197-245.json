[{"id": "5dd4ae5d-6670-465c-b31e-43e0f86ffcbf", "text": "His mother looked down at the wrapping, then up at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "01ab71c8-a43c-4407-8158-eb679aaac25d", "text": "You look like your father when he came back from that last trip.", "speaker": "Zik's Mother", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "50d3c7fa-11dd-4fe6-bed6-123b9b39687d", "text": "Zik gently pulled his arm free.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "85ffbf34-0dbd-4d2d-8e95-265f605052ed", "text": "That's unfortunate.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3cb13bbb-9da6-4a2d-b765-ba871a1350bb", "text": "Same eyes.", "speaker": "Zik's Mother", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2327f9bf-f688-4d8d-9aca-06824fb19744", "text": "People have eyes.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8d4af8fe-c5cf-4b1b-8b97-2d3c0d7e0d40", "text": "Same lie.", "speaker": "Zik's Mother", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "75763333-a6cf-486b-8564-7dfbd6028d28", "text": "Zik turned toward the window. Outside, the city was settling into evening. Lamps appeared one by one along the streets. Voices drifted upward from below, blurred by the heat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c2a08d12-a7fa-486c-a9f3-9e098899867f", "text": "I'm not him.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e69d8246-3e04-4e1e-a089-a258bc585d42", "text": "His mother was quiet for a while.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9e8e4612-d5c2-448e-8ef9-767bc643cdfb", "text": "No,", "speaker": "Zik's Mother", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d179626e-0ac1-4e97-82e6-ac2b16bb2e75", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "207b4888-e5d5-492c-93a9-00f87e29d1f1", "text": "You never were.", "speaker": "Zik's Mother", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "59c8264d-d8e8-41f8-80a2-151e3363cd63", "text": "Zik looked back at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "60920419-2002-4c4c-9572-eca4360816de", "text": "She had turned toward the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9edc9daf-3463-4fab-9822-d64f008608b9", "text": "He believed some things should stay buried.", "speaker": "Zik's Mother", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e601b95f-d699-4b02-a2b9-52d5414b9a57", "text": "The words sat between them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a56cde6b-f30c-42b2-9559-b1f977cb2380", "text": "Zik touched the journal beneath his tunic.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "76e495a4-735e-4f59-bf7b-8b67b7b76e9f", "text": "You think he was wrong?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "10f64bd8-e7db-4e1b-a0b2-de2a0eb2ab8f", "text": "His mother did not answer immediately. When she did, her voice was soft.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "88bf8286-1dbc-4e04-b66d-4831a04728f0", "text": "I think your father believed that knowing gave him the right to touch it.", "speaker": "Zik's Mother", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "747bd939-7f70-4e3e-8dda-69b144bdb950", "text": "Zik said nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f83bef2b-2f5f-4d65-8b1f-0f38f9e6f370", "text": "She coughed into her sleeve. The sound was small, but it seemed to fill the entire room.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1ebcc2d4-9c53-4815-b8c1-2078476ebb04", "text": "That's not the same as being brave,", "speaker": "Zik's Mother", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d248b57d-3964-4705-8a1d-f78e66555a25", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "8272c5cc-e451-4ff6-a282-226012fe311c", "text": "Zik looked away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8b45307f-4f2a-4000-97f7-87be87a6b6f8", "text": "He left without answering her. He never did.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0e7d4333-158e-42e9-bad1-64a5e76b5e19", "text": "That night he sat on the roof above the kiln with the journal open in his lap. Uruk stretched beneath him in layers of firelight and shadow. The city was beautiful from above, if a person was willing to ignore the smoke, the sewage, the screaming, and the fact that most of its wealth had been built by people who had never been allowed to keep any of it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "25360186-0a51-4c20-93dd-75322286a604", "text": "Zik pulled out his own compass and set it beside his father's. His pointed north. His father's pointed straight down.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f9738447-b124-4395-aaac-6574d3003dc8", "text": "The needle trembled inside its brass housing as if it were trying to drill through the roof.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d7b9b337-023b-4aae-b72d-b4e1245dcc50", "text": "Zik frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6afe016f-e628-4002-bc96-bf84bd73fc08", "text": "Broken things usually behaved more honestly than this.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "83909f0c-f380-4f0a-a26e-fa1d1c1b5212", "text": "He set both compasses on the roof tiles side by side.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f5e85138-472e-4b68-aff3-a3d06e23d54e", "text": "His own settled almost immediately.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "74fde26b-b26d-420b-bb36-1cfed6b39b4e", "text": "North.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "47c70164-cad1-45dc-8705-6ed21536effc", "text": "Steady.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dcf303d3-9dcb-4f3b-8321-ea186fc667b4", "text": "Predictable.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "aea89139-c881-497e-82e0-16811e0a369a", "text": "His father's wandered in a slow uncertain circle before dropping once more toward the earth beneath the city.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6ea5c8a0-f1c8-4f5c-b537-0e4d761c5545", "text": "He rotated them together.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "86cad4a8-426c-41ab-b64d-f14f5756a9de", "text": "North remained north.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "38e65a2f-7400-478d-bf31-f80e3d78be1d", "text": "The other ignored the movement completely.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b2934ab-5343-4533-90f7-c7cc8e5a6a4f", "text": "He turned them again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4153404f-688a-4b48-a6ec-54bc9aea1401", "text": "Nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d9ba479d-0834-4ec7-bbb1-771b11030222", "text": "The second compass refused every rule that made a compass worth carrying.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b083a552-9ca1-496f-8aef-35da0c5d714c", "text": "Zik picked it up and listened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6eae56e4-9019-4821-a00a-4d2746e5d936", "text": "No loose weight.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2db83583-d8c3-4578-858a-2d6710aaa1a3", "text": "No broken pivot.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0a5d0b75-4f51-48b5-843c-a5fad9b901c7", "text": "The needle moved too smoothly for damage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0243d4be-0899-4b17-af5b-e77c762b44f7", "text": "He held it beside the brass buckle on his pack.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
