[{"id": "63e5a8e7-50f1-4153-a59a-229164a7bbc1", "text": "CHAPTER 2", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "e5ac5009-c6dc-4fc4-aeb4-b1eb00cae63f", "text": "The Weight of the Share", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "d3d811b1-63f7-4384-b5e0-190a39afdf12", "text": "They left the tomb at dusk.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f4773ceb-7ef1-42b1-9347-8786eaffaf88", "text": "The desert wind had already begun erasing their tracks. Sand slid into the open stairway behind them in soft continuous sheets, as if the ground itself preferred the hole filled. Balag walked ahead with the two remaining donkeys, spear across his shoulders. Enhedu kept to the side, knife loose in her hand, eyes on the darkening ridges. Zik brought up the rear, the journal and the compass both heavy against his ribs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7e925b3d-e45e-4ee2-8b6b-2ce9fb26145a", "text": "No one spoke for the first hour.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1ce60f71-e45f-426d-91c0-512b12946107", "text": "The donkeys noticed before any of them admitted it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bf773981-b3fa-42da-ba64-42270d1483bb", "text": "The lead animal slowed every few hundred paces, ears twitching as though waiting for the familiar whistle that always came from somewhere behind the line. Kurash had been the one to soothe them when they grew stubborn. He talked to them more than he talked to people, inventing long stories they could not possibly understand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "01787e69-c91b-4b13-a72c-f5ac92584c91", "text": "Now the lead donkey stopped altogether.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5eb12a8b-c447-475d-a7c4-b0b9e930bc1a", "text": "Balag sighed through his nose and walked back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c789994d-6b76-453b-a8f0-21a35daf12a5", "text": "Come on.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a0939c29-7797-4a5d-bdb9-72def1af5b68", "text": "The animal planted its feet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "95c51e25-49a2-4263-ab27-743ed1e67132", "text": "Balag tugged the lead rope.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f7d1ddb6-0917-4bc2-a5e8-d1b18e4f702f", "text": "Nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "75c3c72c-b1b0-4b0c-9077-b4945b64dc92", "text": "Enhedu watched for a moment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "84547c6b-8845-4ea9-9ffd-62b1dbb5ff35", "text": "It keeps looking behind us.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fcf0941e-11fa-4fce-9707-54998c28548d", "text": "It smells him.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bee2603c-1570-4649-ab57-92145ba8ee7d", "text": "No.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c1df8da7-28a4-497e-ac91-517e40de77bb", "text": "She shook her head.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6265e0d9-c511-44d0-abd5-fc3af61ef68d", "text": "It smells that he's gone.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b4dfd61e-ed5d-4934-a819-1102dc7a07df", "text": "Balag gave the donkey another patient pull.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e8c39682-a4c0-4144-a7da-79f8e47a729c", "text": "I liked you better when you only corrected my archaeology.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "676a6408-1391-4324-bcbd-0fb7620f3130", "text": "I've never corrected your archaeology.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5af8d76a-62e7-409f-b227-ac5ef9ee094f", "text": "You've corrected everything else.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "db35b6bf-f769-4fa0-901e-b1ba1486517b", "text": "That earned the faintest curl at the corner of her mouth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "39786f77-ee8e-4ca8-85ed-2b10dd6eb695", "text": "The expression vanished almost immediately.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6ac4ed36-2b91-428a-89fb-a59b567ff369", "text": "Balag rested his forehead briefly against the donkey's neck before trying again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "79db040b-6e2a-4232-8f78-0ff96b224248", "text": "Stubborn beast.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "607608f2-77d3-4acd-a053-c7540703b128", "text": "It learned from Kurash,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fa18a99b-5898-4b61-90eb-3880e2bfea2f", "text": "Zik said quietly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "60a1bcb6-3889-41df-a57e-0b6939f17572", "text": "The words surprised even him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a2a7f7d8-2707-46cf-bf55-21245b746ae8", "text": "Balag looked over his shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1f46388e-d87d-4863-b075-0e3fc282f823", "text": "So it did.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "68b75cac-fb26-4a53-be52-b15234b0d8c5", "text": "This time the donkey started walking without another protest.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e3dac034-2480-4127-a8c2-112b6664b2c6", "text": "For several minutes only the sound of hooves disturbed the desert.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "96d3432c-754c-4a10-872b-d0ba09f62229", "text": "Finally Enhedu spoke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "33b74dbf-b40b-4152-87d1-bb3c9576ea0d", "text": "My brother used to whistle.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7f87e5c6-2809-4afb-b2a8-5296826db603", "text": "Neither man answered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3a8a4b77-c511-4f10-8ffa-9627259e0b48", "text": "He couldn't carry a tune to save his life.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "32209843-100a-4449-a8af-9ca268cdacda", "text": "Her eyes remained on the horizon.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4eec780a-c0bb-468a-8407-603a7f7f38ef", "text": "My mother always knew he was home because every dog in the neighborhood started barking.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ac73af6a-91da-4ff7-911d-ab5ad5aa3256", "text": "Another stretch of silence.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2933c651-4f8e-4400-a9ed-fc753a304de9", "text": "He died before he turned twenty.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1735d28f-84d7-4b3b-bc12-134c07ab2b5e", "text": "Balag glanced sideways.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0c9f6f92-fe0e-4004-9f89-c727090db111", "text": "You've never mentioned him.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8f2284d1-c5a0-49ef-b6b7-cb3ed8e8d3fe", "text": "There hasn't been a reason.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3006e898-4e2d-4088-9def-b0d3f5cdc530", "text": "And now?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1056d3e5-9edd-4abb-9c71-bd7b3809b1e3", "text": "She shrugged.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0986be92-8b78-4c18-9012-20455a19840c", "text": "There still isn't.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5fc08015-0bc5-4d79-a4b4-99824d47159e", "text": "But Kurash reminded you.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
