[{"id": "2459d559-ccb2-4429-b2e1-da4cb9a20396", "text": "Perhaps whoever drew it was a poor surveyor.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "124827ec-17ca-4014-adec-b1e8fc2d4791", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "46935756-0feb-480a-9c9a-cec4aad0f7f7", "text": "Ninsun tapped the journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a47f837c-ce1b-4470-b72a-7e83bbfd049e", "text": "The measurements are too consistent.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "477959c7-a3fd-4f98-b965-47078ed9948f", "text": "So what's wrong?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "acdac1f3-7e12-45f4-b104-4629ea0e2c54", "text": "We are.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7dda948a-2394-4c1b-9a0d-b6065ec86b51", "text": "Silence settled over the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "782617e5-0123-44ce-9cdb-c90827243506", "text": "Ninsun turned the journal ninety degrees.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0d45d7d4-fcf0-4290-8f16-abbe473fc8cd", "text": "Then another ninety.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a19b0206-19b2-4de2-9557-6f51aa25b449", "text": "Nothing changed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dd5aeb0a-f155-422d-96a5-1e1ecefac722", "text": "She looked at the drawing one last time.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b5da4d64-ae3d-41e2-8d3c-d72c014a376c", "text": "Her eyes widened slightly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c804ffd5-7c0a-42b8-a8a3-8f793731973a", "text": "It isn't meant to be viewed from above.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1b22e7ff-0c54-4f77-8175-b965b4e0340e", "text": "She turned to Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5655bd7d-e838-4c3f-9672-69e04c95bd3f", "text": "It's a section.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "509ab1e0-c55c-413c-8bf9-ab014db24cac", "text": "The ink river turned downward in a wide spiral. At three points, channels split from it and entered separate levels beneath the city.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1f1d47e5-191c-40c5-b4ca-d4ade46ba359", "text": "This shows depth.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "35589640-a5c0-4f86-98ff-be75a4bcba9e", "text": "How much?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "39add67b-1119-4d06-8c66-fd3680bc6084", "text": "I don't know.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e93007e1-33b2-49d6-bba2-7ad11628e09e", "text": "You just called it a section.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3ac4d2a8-b956-42a9-bede-133808daa2c1", "text": "A section requires a scale. This has none.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "aa4e5357-2cbe-4a32-a344-d92ff8e5b967", "text": "She traced the outline of the east-side wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6dee0355-be4b-43af-8105-cf7f3741b0ab", "text": "A line descended from the defaced spiral-drop they had copied that morning. It passed through two buried chambers before joining a circular structure beneath the tanners' row.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d32ecf80-a246-4d08-9f92-0cf70bd63642", "text": "The boxes Ninsun had drawn on her map—CLAIMED, COST, LIMIT—corresponded to small black marks along the descending line.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "14c3c8ec-a655-4c39-802f-14518fa3aca1", "text": "Enhedu leaned forward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "765ba610-968e-4fb1-a301-b3c512c4d7aa", "text": "It has our passages.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bc559a5a-fb1d-4986-963d-c044869b5ffc", "text": "Ninsun's face hardened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "639f206a-712e-4af1-8862-fc4d91e44b89", "text": "It has more than our passages.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c1b4420c-4e3a-4f3b-a6d4-c2e163c59b5a", "text": "Below each known shifted street, the map showed additional routes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "53fdffd0-b401-45a1-99ad-0f34630332c1", "text": "Closed corridors.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0e8ee4eb-1a57-45cf-94c7-8bb948c54add", "text": "Collapsed stairs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5dc4165b-4996-45a4-a672-1c5c1c319b86", "text": "Rooms beneath rooms.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e9e0e76b-94ff-47a3-b596-9abc67fe96d7", "text": "Some paths ended in black circles. Others joined a large spiral that continued below the bottom edge of the page.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ba72c779-fed3-44b6-a469-d931dcae611b", "text": "Balag looked over from the courtyard entrance.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4225e8c2-2998-47fc-85e9-233b4b66c9d8", "text": "Does it show a way out?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "01f9959c-4c38-47b3-b99a-e167cd45c2dc", "text": "It shows too many ways in,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a3e6d5da-b4b1-492a-98a2-ebedd561c06a", "text": "Enhedu said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "acf90308-ed9e-4dd6-a1ae-f5db4bb394b9", "text": "Ninsun leaned nearer to the page.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7d31be6d-ae19-48fc-8435-3dcda1faf0af", "text": "Hold the lamp behind it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d923e08b-da39-4606-9efd-4db843e0a362", "text": "Zik lifted the courtyard lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4e6a0931-e5e1-4335-9d8d-43fe09bdaa15", "text": "The light did not reflect from the parchment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "63bdda14-779f-42cf-b23d-124a19560675", "text": "It sank into it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c3a55637-cf50-4d53-bd92-c0e471fbfb98", "text": "The sheet became faintly translucent. Dark fibers appeared inside the material, branching beneath the surface in irregular patterns. They were thicker near the binding and finer toward the edges.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b6b2842a-1d55-4bf7-a31c-81708bca9dc9", "text": "Ninsun stopped moving.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f78786d6-29ff-47ec-b63c-9a29b0cc3401", "text": "What?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "903f6a5a-7331-440c-896d-0da46fc4119c", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "27df1614-970e-41ba-81dc-2c281624d16e", "text": "She pointed to a pale ridge crossing the lower corner of the right-hand page.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5ee0df80-cc5f-40e8-ba06-0e18e2d270ca", "text": "Turn it slightly.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "088fd78f-2d0b-4803-b116-fc11be450eb1", "text": "He tilted the lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
