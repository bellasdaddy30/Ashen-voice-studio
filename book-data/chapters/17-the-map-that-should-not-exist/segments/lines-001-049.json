[{"id": "2c20713a-8f8b-4cba-9ef4-1f6760ed7aa2", "text": "CHAPTER 17", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "b4ffcf71-757d-4935-92da-88aa4a907642", "text": "The Map That Should Not Exist", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "a57d0d5b-efe4-4701-85fc-9bf1cedea854", "text": "They met at dusk in the shaded courtyard of the inn, long after the heat had bled from the stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "96240c9b-4e81-4e50-bfab-b8a5f7b3eab6", "text": "Zik set the satchel on the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "944fb941-9340-4c22-aa7e-221b5701e10a", "text": "For ten days he had not opened the journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "32ce951a-e570-4395-b5e8-e812e051829f", "text": "Nine days had become ten that morning. The refusal had felt precise. Deliberate. A clean edge drawn between himself and whatever had begun writing in his father's hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "478535fd-6539-44ef-9fdf-84b427c746a0", "text": "Now Ammaru's words were disappearing from clay.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "05e153e2-6d5b-4b83-b3f2-82222e02733e", "text": "His father's name had waited in a drawer older than his birth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e0bfc52b-8bad-4ee8-a223-c65b1bdad007", "text": "And the journal had followed them through a drain where water climbed uphill.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "94602887-96a6-4f7e-9737-04f5e15cc3cf", "text": "Zik unfastened the satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5067cb6f-cf7c-4131-b058-da915d630765", "text": "Ninsun leaned closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d26a16ff-cf75-4632-ba1f-0d387ac9cb23", "text": "Do not touch anything until we understand what changed.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8dc89ae0-2c02-4a16-987d-177231da8351", "text": "You were the one asking me to open it.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dd9bc86f-a6cd-4e63-ae6b-17537a674abe", "text": "That is not permission to become careless.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e9f17a57-8c87-4f94-8778-c2a62bcf431f", "text": "You have an interesting relationship with consistency.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9ab1ad2b-9111-490d-a701-7ebf38d7aca7", "text": "I am consistent about other people being cautious.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d89421a6-16e4-4fac-b0c0-1a9b10672405", "text": "Enhedu rested one ankle on her opposite knee.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "afae0209-116d-4262-ab5a-73491cd409cb", "text": "Open the book before it finds another way to complain.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "70029a03-799b-4208-b271-aa64b695623d", "text": "Zik reached inside.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "71528db5-3f09-49ca-8870-3c9a3e18ef82", "text": "The journal was warm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c85c3e64-e098-4c27-8445-793533a72828", "text": "Not warmed by his body.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1f9418ce-77d6-49b7-baa1-f4e03af7452c", "text": "Warmer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ad441110-e8cc-40ab-805c-153a0272bde0", "text": "The cover flexed beneath his fingers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "36e649e2-f12d-4a92-a309-ab263a6203c1", "text": "He pulled it out and placed it on the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "606a389d-0731-47f8-a519-6184acfe906b", "text": "No one reached for it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f5770459-b8aa-45b9-9925-43df170c4f73", "text": "Rain whispered against the courtyard canopy. Beyond the wall, someone laughed, the sound muffled by wet brick. The journal sat in the middle of the table as though it belonged there.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "add56e0e-a640-48e7-8dfd-985227a639ab", "text": "Balag folded his arms.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8f6ff8d8-849a-4230-bc6a-4dec07968afb", "text": "Well?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3cb33cc5-3077-45a8-9e8d-5f162001fe8e", "text": "Zik looked at the cover.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "81764222-0775-4e38-ad1f-c0bf58b74fac", "text": "Nothing happened before.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "591f16cf-dd91-43ff-a456-e590dfbfcf4f", "text": "That's comforting,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "61e25792-3389-4abf-9fc3-c586fa0d4721", "text": "Enhedu said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "3cc63a9c-84c4-4cf7-a782-843058ef1b27", "text": "Most terrible ideas begin with those words.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a41cd5ab-2d9c-4c28-bfb8-b769876c9589", "text": "Ninsun leaned closer without touching it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fe9668d8-cc31-4044-9f89-cca640bc7cfa", "text": "The leather changed.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c9b50633-900a-4c49-a497-f50dc4bac183", "text": "It was always dark.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "effefe45-5d07-4e97-9e48-095820683046", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2be60aea-a3e6-4694-b886-5dc33221ecb1", "text": "She pointed toward the spine.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c9579357-dffd-44e6-a505-09fee3dd39a1", "text": "The surface has stretched.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "58cf3011-d9b3-4533-b4f7-d7e609692743", "text": "Zik frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6c9785e2-175f-4cf1-ba73-d06bb6ef6e2b", "text": "I don't see—", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c2fd3cd1-2dd2-4858-893e-11f77963f2c7", "text": "The stitching.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6ddf2e92-b0da-423d-873d-ab47391fd1d5", "text": "He looked again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7932a984-81d2-4c5c-9338-01312ffa9216", "text": "The thread along the spine no longer sat perfectly straight. It rose and settled almost imperceptibly, as though something beneath the cover had shifted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a61a3df9-16dd-439b-839e-0a4bb3ba164d", "text": "Balag noticed it too.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "836694e0-fe98-4e79-844f-aadb068d0cfa", "text": "I don't like that.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e79a9d7f-af98-43ef-847f-1cd23decc993", "text": "You never like anything,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cde038cd-d5b8-4621-b501-c19d2f6bcc4d", "text": "Enhedu said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "270befe8-b1a2-493a-9768-e3cdf6dd0a46", "text": "I like walls.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
