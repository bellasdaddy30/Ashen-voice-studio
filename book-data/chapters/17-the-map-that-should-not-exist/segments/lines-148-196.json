[{"id": "36fefbe9-8eb2-498a-9f72-a1743b5cedce", "text": "The ridge became clearer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8901e1ec-5209-4dce-a9f3-19bf22d5c264", "text": "It forked once before ending beneath a cluster of newly drawn stairs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "40a574ec-1cc7-4329-ab89-983466bb3a49", "text": "Damage?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "74926b10-fc01-4d58-8318-4065f9b4e129", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "a55982fd-a7e4-42ea-b282-cb15578e23a3", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "420b1ae1-3661-4d0f-bd63-34eaac7bcc07", "text": "Ninsun lowered herself until her eyes were level with the page.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e9a0752f-7996-4ccb-9af2-df85111fa620", "text": "The tissue thickened along both sides.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a72c7f3f-edcf-4b17-864c-d8bd0a691b1c", "text": "Balag frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c3ce0371-daad-4d42-9b68-c5b2642d4965", "text": "You can tell that?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "08d6e5b2-ff82-453d-b51a-81e5e342bb0f", "text": "Parchment damage splits fibers. This closed before the material was cured.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1e274721-0c29-4434-90f4-6a2c98a8dab0", "text": "She looked at Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "14c98da5-ec32-4e73-b4c6-6b539065c78d", "text": "It healed.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b8d4af91-d367-4ae5-b7b2-1cf019f36716", "text": "The musician in the alley played the same three notes again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a048d15d-944d-4dee-a68f-64528d51f5aa", "text": "The last one failed entirely.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5f6cf200-7692-49e2-9eea-e57950f99045", "text": "Ninsun examined the dark points scattered beneath the ink.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4dfaa476-0486-44f4-99d8-b95fc1ec6d89", "text": "Follicles,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a3485276-3163-40ce-8b9d-dd64111a5ccf", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "0e23c0a7-a37d-46ba-936e-9eb8db5cc512", "text": "Zik looked at the page.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4690d6c1-88fd-4788-b1c3-86318ec6bb34", "text": "What kind?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "abf66155-b2c2-4287-8f2e-9bcce6831d19", "text": "Too sparse for goat. Too irregular for sheep.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "339a510a-374e-4cf1-af28-38df71796d96", "text": "She moved to the opposite sheet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "56a78a34-43e9-4522-9646-d1160ff0e2d9", "text": "Another pale mark lay near the outer edge. Not a cut this time.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9c5a9717-14e0-4708-9e8b-7a230d090f0d", "text": "A small round depression surrounded by puckered tissue.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0de5097c-c44f-41fa-932e-07678a1a8e07", "text": "Ninsun's face lost color.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "281b6c37-32e1-4fde-863b-dac5645fb431", "text": "Enhedu saw it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "342db7c7-ef97-421e-9768-57cbf7bd3f08", "text": "What is that?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "48bd9884-de9d-4787-9bf1-c9e3aed3e296", "text": "A burn scar.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8f57b402-e888-4ff3-a55a-e895c1623fb2", "text": "Before or after?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fb6f8cd5-28ff-4731-86e0-3d622bc20cec", "text": "Before.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1957706d-a52f-43eb-adde-b22c483d5bbe", "text": "Ninsun straightened slowly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bdc87846-53e3-4735-9b5a-5605396e05b9", "text": "The scar belonged to the body before the page belonged to the book.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "69fb2c12-ff1b-4017-b37a-c8c8c2f13b94", "text": "No one spoke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fe880044-5433-4072-be94-5a104f964176", "text": "Zik looked at his father's old handwriting between the spreading lines.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "534471a2-8c39-4d90-882c-470e8b8be9ff", "text": "What body?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "71f35d2c-7268-4d8f-ba42-f0357b6caaa3", "text": "Ninsun stared at the parchment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "222512a7-978b-4f12-9eb9-9791edd647c5", "text": "A human one.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "63210cd3-96b1-4e48-a7a1-f61d741737e5", "text": "The carters near the well stopped arguing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "08b7ef59-7b47-4e9d-9ee7-bc2cf991fb65", "text": "One lifted his head.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eefba4b2-32fb-49f3-959c-0265d71ddca4", "text": "Enhedu smiled toward them again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "df691f9a-6cb6-4236-a14e-cbbe66830100", "text": "Funerary accounts.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9f64ede6-e17c-4657-959c-d52e4c249485", "text": "The carter grimaced and moved his game pieces farther away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3b1c795f-8601-4514-af87-41d35750d28a", "text": "Balag stepped from the entrance and approached the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "78a52f7b-763c-47aa-b373-05f7783500b9", "text": "How many people?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a61c48dd-0242-43ce-bd30-31c0f0a7c5df", "text": "Ninsun looked at the seam where the pages met the binding.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0af7a584-70d9-4cb7-bd70-2abe27beefb6", "text": "I cannot tell.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8235d469-42c1-41c5-9224-dd922ff607b3", "text": "That means more than one is possible.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3e3abae4-e47e-4b05-a3f4-089c73b7e989", "text": "Yes.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fa881561-2d42-48fe-8f88-2d8efb2480db", "text": "Does the book know?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1bec4859-2698-413a-9f05-8e8e8569d926", "text": "No one answered him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
