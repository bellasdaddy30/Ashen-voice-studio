[{"id": "9c7eaf64-178d-4e30-b40b-b9acfa141557", "text": "This one may become one again.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0e142897-854f-45de-95ca-bbb66622c47a", "text": "Zik rested two fingers against the cover.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "780306e9-abce-4b4b-904b-23e69056f251", "text": "Warm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "093fdb99-9d77-4967-a820-acb0dd525343", "text": "Not the warmth of a book carried beneath a cloak.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d970f47f-fbdf-4bc0-aa8c-6f482dbee896", "text": "Something deeper.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "339394f6-f9f7-4a5c-8324-098564b85ea5", "text": "He slipped a thumb beneath the edge of the leather.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "39ae1682-4559-4e6e-b44f-e74afb93b6ae", "text": "The cover resisted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "147fbc79-9610-42e6-a5f2-ff1fb88d8532", "text": "Then, before he could lift it—", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4a7e7b7a-e9a4-4363-84aa-b8fb0f27773f", "text": "The journal opened by itself.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bf7ad628-c6af-479d-8246-a2626c4f69aa", "text": "Its front cover lifted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "423a0d4d-2bf3-43cc-957d-39273630759e", "text": "Pages turned in a rapid dry flutter, though there was no wind beneath the canopy. Blank leaves flashed past. Old calculations. Bel-iddin's survey notes. A fragment about the western tomb. Lists of names Zik had not yet studied.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a1234a3d-7c6e-4a2d-9aa3-16a3a944912a", "text": "The pages stopped near the middle.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8aa7f10a-8c05-486b-8b83-7d00f4e208f0", "text": "Across two facing sheets, wet ink spread from the binding.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e8f823cf-fdf7-4b2e-83bd-c5f96f52407d", "text": "No pen touched it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "19b1d720-4800-4c07-8aab-bb683d5538c6", "text": "Lines extended outward in thin black threads.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "23fd4708-6ae6-4b6c-9f89-7fe88be3814b", "text": "Ninsun bent over the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "74b9220e-b238-45c2-a801-020fb9a51cdd", "text": "Her fingers hovered inches above the parchment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "48eb6119-f231-4d8d-ad1e-3d898bdf6ea0", "text": "This is not possible.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "514573bd-5dab-4151-bf52-de5750a07629", "text": "Welcome to my life,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cb09dc63-8678-4bd3-8dde-8234523a0dbe", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "74a052f2-0738-41fc-b26b-117c5263ea0b", "text": "The map continued drawing itself.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4c5ed977-7873-4d50-b4f2-4dd59c9d1131", "text": "At first, the strokes formed the broad shape of Uruk.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fc7c40fd-dd52-4fb5-9cfc-84bcd7d1a8f7", "text": "The river's bend.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f38ee78d-1f39-4db8-abf2-95a5f0dea815", "text": "The east curtain wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b7a11fd0-6504-4f07-a22f-e38dcc94bb7b", "text": "The temple district raised above the lower streets.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b668dbdd-c9ca-451b-a148-dbd8427c83c4", "text": "Old roads disappeared beneath newer ones. Abandoned settlements clustered beyond the walls like broken teeth in the earth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "25adc686-29d3-4e0f-b28e-289e644b91f5", "text": "Then the lines descended.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "747dbe22-e2da-425b-95ac-ddb3aa4d385e", "text": "Ink bled downward from the familiar geography, creating shafts, chambers, stairs, and inverted towers beneath the city. Some structures hung below others like roots from an overturned tree. Others occupied spaces that could not exist together, overlapping without crossing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "41045fb9-7e5d-402e-8c3f-2c8af335f779", "text": "Ninsun moved around the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "306378ea-55ef-472b-9ba3-b7e1f82c8a84", "text": "It is not a surface plan.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "107b5649-2386-4128-9301-91f4338db8c3", "text": "Zik leaned closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0366e7bf-f236-4f28-8770-62304a4707bb", "text": "Old surveyors liked details.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0e8fd2bd-c541-41ed-8b3a-f3f00f0f939d", "text": "She frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b034bf08-ac9b-48a1-8b95-7f243c7bb375", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2c21cf10-5ace-4629-8734-875c1f9cb057", "text": "Zik looked up.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "43fcfdff-d13c-4bc4-bc14-e69957179313", "text": "No?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0e7e86f7-0cfd-468b-b93d-c0e99ee2b39a", "text": "I answered too quickly.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c38336f9-7811-4ccb-8ff9-8df1d8c39086", "text": "She pulled one of her own tablets closer and began sketching the outline beside the journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8322aa2b-589e-4173-ae83-a13342acb4a4", "text": "If this were a city plan…", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "71d0b166-8368-45ea-b408-a3c7f9106be7", "text": "She drew a rectangle.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7baafda3-04a9-4808-8b48-d040d8d36840", "text": "…the temple should sit here.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "49bcc155-af25-40e1-8167-5364fc28dda0", "text": "A second mark.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a2cd0ef5-d16e-4caf-b6c0-ab96ebed550d", "text": "The river…", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5859c5a3-029a-41c5-9ea3-8d59c7a158e1", "text": "Another line.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c4da3ee1-7398-40ab-8764-fb93d453c246", "text": "The gate…", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "802fe223-a3f7-49ba-90f4-66da90146541", "text": "She stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1ed81877-3a7f-453b-b242-8309be57834d", "text": "Her stylus hovered above the clay.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "71c4013a-2a47-48ce-b469-5e5fcf1068cd", "text": "It doesn't work.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dd43514c-14f6-4c45-9a99-a1a762559f33", "text": "Enhedu leaned over.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
