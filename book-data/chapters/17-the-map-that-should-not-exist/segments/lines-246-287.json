[{"id": "1ca68464-fc40-44fb-9f89-6afd7bc1fce5", "text": "A surface at the far end that reflected no lamplight.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "365959c0-4a79-477b-8217-6f26215b0386", "text": "Not a wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f79e5fd2-25a0-44d1-9f08-492833653c67", "text": "Something smoother.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "47ff1378-ed75-4d7c-b3aa-49619e076ee5", "text": "Something that had seemed to move when no one looked directly at it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c737a85f-6215-4b5e-9026-167f77cd43a4", "text": "Ninsun watched him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9ecc43ee-9732-4a3d-8976-48dd2ba7819a", "text": "What did you remember?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2080f339-00a0-4a90-92a8-c17befb039dd", "text": "Zik looked at the map.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ec51c303-8850-4c2b-8510-cc857e8cf0e5", "text": "The ink around the buried structure thickened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1547c035-e6a0-4e53-83be-e3d01de14f11", "text": "New handwriting appeared in the margin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "311cb44d-9a87-40e2-9e7b-5a1eb3917617", "text": "Cramped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4ecbcf0e-8c6a-418b-abb7-128b6115af25", "text": "Jagged.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7914f6b2-920c-4b8a-acde-11263d385c24", "text": "His father's hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fc41360c-a551-4bc1-b2d1-92fd1b816ebd", "text": "The ink appeared one drop at a time.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3870900d-77dc-4a2a-9907-3cf1075be74e", "text": "Not falling from above.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "433e14c5-299c-4cd0-a555-c26aa2bb6761", "text": "Rising.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e92d0c3d-3eda-4f07-9188-43a67a6107cf", "text": "Darkness gathered beneath the surface of the page until a single line pushed upward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2911fb5f-3fdd-4f5a-be2e-b9cec5089c58", "text": "Nobody moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d26329a3-2908-46b8-9a3f-f020e4c21fa1", "text": "Enhedu spoke first.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e5fef441-1d46-4fc4-ae23-b2fd7be78202", "text": "Is it writing?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d22c4ff3-6ce6-4f41-ab5b-d5a30ecf3fbd", "text": "Another stroke appeared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cb6b8498-1c95-4868-8d41-ff7c18d1f339", "text": "Then another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b0225b39-deaa-4fb0-b677-663b5a685851", "text": "Balag stood.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f7d79c61-1926-445b-8788-c653d0730e5a", "text": "I preferred it when books stayed books.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e2752040-4808-43ea-b023-d675c496cab5", "text": "The letters continued slowly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9c6a7e19-7ca0-45c6-8719-245a3f949460", "text": "Each one seemed to press through the page rather than settle upon it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1997c548-ee0c-4913-a15c-fe10849c87cd", "text": "Zik found himself holding his breath.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e4948938-57b9-40b8-bbdd-0ede22e69494", "text": "The sentence completed itself one word at a time.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fd340fe4-a94b-4a51-a9cc-055a29bb691c", "text": "I WAS WRONG ABOUT THE DEPTH.", "speaker": "Bel-iddin", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Writing rises through the page in Bel-iddin's hand.", "generated": false},
{"id": "ce1e161a-d7a9-4859-b3fe-e754f2d35645", "text": "Zik shut the journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b66b9596-3d48-4242-8cd1-d7c290052b3f", "text": "The sound cracked through the courtyard.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ef024eef-8b04-4c45-b8c6-259822b9aad5", "text": "No one spoke for several breaths.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8396bcbc-9c4e-406f-a368-dee5975defad", "text": "Rain dripped steadily from the reed canopy into the basin beside the well.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2e05cfbb-cd21-4e29-b189-48eb937adddc", "text": "Balag finally broke the silence.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4943d3a2-62b7-44e9-8729-553dcc770f01", "text": "Back to the place that killed Kurash?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2cbafa28-5944-490f-8d9c-6a9b4db0f503", "text": "Zik rested both hands on the closed journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "94e5ab6c-3127-4622-9e03-09b2682378e3", "text": "We never reached the place that killed him.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e34dfbbb-83fe-43f5-82bc-e833bedaf7b3", "text": "Ninsun looked down at the leather cover.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7e075cc7-63ad-43d5-a251-cffab63af7fc", "text": "We stopped one level too soon.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0a5b1c5c-ed80-424b-b50e-2eacad78d784", "text": "Enhedu's voice was barely above a whisper.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5215122d-011e-4e8a-897e-0671a6c6655e", "text": "Then whatever your father found…", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a32c4c5f-6e3b-425f-b42c-9aae4277f332", "text": "Zik finished the thought.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "29188ab7-7770-4a9c-b1e9-669a1f6c1d14", "text": "…is still waiting below.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
