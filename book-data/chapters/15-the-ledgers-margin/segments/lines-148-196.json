[{"id": "f0218c6d-0296-4774-a036-990dc08a9b5f", "text": "Here.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "885226dd-22d0-488c-9139-63410ec93fe7", "text": "The tag read:", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f798d567-2a3a-4b33-8c69-61d0adebacfd", "text": "EAST CURTAIN DISTRICT—PRIVATE HOLDINGS BEFORE CONSOLIDATION", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "b9183a8f-4452-4097-a113-79c550fd738f", "text": "Enhedu took the lamp while Ninsun untied the cord.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b0176b51-9b00-4da4-b65e-ce2554b25a5a", "text": "The first tablet listed three warehouse owners.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "40180421-202f-408b-82d0-1d94ea102ca1", "text": "The second recorded a dyer's yard absorbed into temple property.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d65650c1-513a-4c98-af2a-22e11156657b", "text": "The third had been scraped smooth and reused for grain tallies.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2cb5ce79-3ac1-4610-af30-90b21b542fb0", "text": "Ninsun's jaw tightened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "823466e1-1281-4926-91c8-5e256b463f60", "text": "They overwrote it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3e6f76f7-87af-42d4-b4eb-783cb670753a", "text": "Can you recover anything?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "eabf52a8-5b67-4038-9797-3d4e6e2327e0", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "1976740f-b27f-40dd-97c8-894d19597fa7", "text": "Not without daylight and hours.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ee0c52bf-c75f-4ba2-8e02-2545af9aaf56", "text": "We have neither.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a698ac13-2020-4a1f-ac5f-1c68d31a2038", "text": "She moved to the next.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2d4ad4ed-3bee-4604-8905-67617f4b8111", "text": "Then the next.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3698fc06-00a1-4d62-9129-8e84caf37a25", "text": "The records changed halfway through the bundle.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c6625017-2dc3-465c-834f-7f45058ead11", "text": "Names vanished.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c2fddab8-67ca-4435-8158-2419ebe7e854", "text": "Plots became numbers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3e3a1821-7e8a-47a4-a4ea-df6fdae7c6ea", "text": "Private holdings became temple allocations without purchase sums or witness seals.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fe8417bd-92af-46ee-b654-a6ead69226cb", "text": "Enhedu read over her shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2c878214-3c0b-4698-a20c-ea79d51d573d", "text": "They took the land.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c3041a36-d9f5-4692-8657-87985a919a72", "text": "They regularized it,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8db0e744-2956-4d10-93a3-f6425d75e654", "text": "Ninsun said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ab9c081a-0077-4324-9150-9981b6a9da89", "text": "That is the same thing with a cleaner robe.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3132ced1-13e5-4ef5-ae1b-cf472961ce6d", "text": "Balag listened toward the stairs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "86cf931c-71e1-46ef-ad69-7250a096643d", "text": "Find the name.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "609201dd-125c-4e8b-b10e-120fe7e7943c", "text": "Ninsun kept turning tablets.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ce018853-0169-49c1-8664-af8f3a0f972a", "text": "Her fingers moved faster.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fe8338c9-8424-44b0-aa30-c0943888a88e", "text": "Then stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1a4be578-a933-4059-8575-74a0bfac7ad7", "text": "A narrow ledger tablet lay beneath the others, its face crowded with tax figures. Nothing unusual appeared in the main columns.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "666eaf06-6057-422e-9623-e44ec358e3b4", "text": "But along the left margin, someone had written three smaller lines.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2af329a5-2368-49e5-9c39-88a173cb132b", "text": "Ninsun brought the lamp close.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7f8062b1-7198-49a0-95ed-78ee80eada07", "text": "The first line was a correction.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2ae15f94-10cc-4604-9ebb-578b2e4532bf", "text": "The second recorded a disputed measure.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dfc7eedc-4fab-43e2-9bdf-7cb0c3fc969b", "text": "The third contained the name.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "baac5fc4-2b88-4cd1-8aaa-f10f5b39480f", "text": "Ammaru,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "db6b4ffb-f639-4985-ad24-cbf2cd0dc8a2", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "00929908-64ac-4f9e-9166-61188c7686dc", "text": "No one moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fe5da2a9-a3b4-4075-9b88-7c295dff8c44", "text": "Zik crouched beside her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e489e596-4ca9-4948-b00b-97b493558a3e", "text": "What does the entry say?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0e8e5811-691f-4f59-9b41-3caa12ed896d", "text": "Ninsun read carefully.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "153f543b-1edd-4efb-b5dc-dce8b178ccbd", "text": "'Ammaru, son of Dagan-ili. Potter by trade. Keeper of the lower cistern stair by hereditary obligation.'", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a78644bf-077a-4ba5-a2ee-775977baf4f8", "text": "Balag frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7bff4665-74e2-4a6a-a359-47148b731a51", "text": "Cistern stair?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6930e874-01f1-4833-af13-e10f8f6f90d3", "text": "Ninsun read the next line.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bf9fd031-5c22-46df-b2d5-8f3b7e2da2b1", "text": "Her face changed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7fa59e53-039c-493c-b02c-589d34fd0b46", "text": "What?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ad156cac-e1c9-4884-8221-34e8d7816bd6", "text": "She translated more slowly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0ab849e3-2a0d-4b49-bd76-aa8b810e06b3", "text": "'Property exempt from levy while seventh access remains sealed.'", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
