[{"id": "f008ae21-34b1-4c1c-86c2-e3a57dcfbc81", "text": "The storage room held cracked measuring jars, sacks of outdated weights, and stacks of waxed tally boards tied with cord. Rain drummed against the roof. Voices from the public chamber reached them through the inner wall, flattened into meaningless sound.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4f0695d7-0519-43cf-9131-6cfef6691846", "text": "Ninsun moved to the far shelves.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "82a1a2a6-0419-4cc6-b386-36cded2e9e07", "text": "The lower ledgers won't be stored with current accounts.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2c1b5d90-1404-4907-ba35-bc98128ed498", "text": "Why?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "33578c7e-1087-4fe4-881f-c2acdcf6e307", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "827d0963-5b48-4562-a527-264cc5226a90", "text": "Current records are useful. Old ones are dangerous.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "52ab3f91-1d00-46b6-8315-4043a5d137ab", "text": "Balag lifted a sack and looked behind it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ffde59b8-df0a-4f62-81fb-e472acf9b73f", "text": "Useful distinction.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f167e206-c23e-4d49-b36f-56e30d0c1b39", "text": "They found the archive door at floor level behind a stack of broken scales.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "207cf005-fbb5-4417-b12d-b2210a261022", "text": "It was smaller than Zik expected. A clerk would have to stoop to enter. The bronze lock had been polished recently, though dust covered the surrounding bricks.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c7668687-8086-421a-bf76-4aea1f84a680", "text": "Enhedu crouched beside it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "22a8532a-ce80-4784-a138-ac963aed7c25", "text": "This gets opened.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4e4a2ab5-e4f6-417a-becb-8775c3ea9a69", "text": "Ninsun nodded.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9cde46ca-33b7-4393-a33f-e9cac8fa87c7", "text": "The Collector said the drawers stay locked. He didn't say abandoned.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0a4c3622-308e-40e1-8b88-829d9dae6719", "text": "Zik looked at the lock.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "06422100-2539-40da-acbf-60a693cce7af", "text": "No scratches around the keyway.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "620e132f-31a9-44ae-9217-a2f1eb3d32ab", "text": "So whoever opens it has the key,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3501c73b-952e-430e-9665-411a1660bec3", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "73eca25e-37ea-4a0e-b217-0cdf370c5da3", "text": "Or doesn't use the keyway.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b54ae377-329b-446c-8063-f545712d0371", "text": "Enhedu pressed her thumb against the lower hinge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2d596336-ceae-40d7-9425-c1093a550716", "text": "The pin shifted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7a218c2e-2018-414e-afb5-b74d54ca4f3a", "text": "She smiled slightly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9d93caf2-115a-46ee-a27a-49d965f8301b", "text": "The hinge was installed backward.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b957049b-c1cd-4388-8ece-6e30b8b1f5a6", "text": "Balag looked at Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bc4875e2-86fe-4809-9486-6877bd4e9001", "text": "Other people being worse at their jobs again?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2a2b7933-d76a-4774-a2aa-572a2c0c76a2", "text": "This time we owe them thanks.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4eeb2583-6f0b-4cf5-bf2d-cec7cb27f8fd", "text": "Enhedu worked the pin loose with the tip of her knife. Balag caught the door before it dropped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2b92d385-0af4-4d42-b72b-925958167194", "text": "The space behind it descended three narrow steps into darkness.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8e093b1f-9847-4782-9ac0-097d9e339ce0", "text": "Cool air breathed upward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8d73f85a-5eb6-4adf-a37a-66f7a3da65e8", "text": "Zik felt the mark beneath the linen warm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d1dbd7d6-c1ca-49f0-bae0-44e5f99f5021", "text": "Not pulse.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8efc8028-5d0f-4bb7-9eab-93c7ed107d3f", "text": "Recognize.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "26fb7994-4740-4583-bfff-58e18a6427f6", "text": "Ninsun saw him flex his hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "124f181a-cccd-4e23-8035-963c4035d64d", "text": "You felt something.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9b404966-c7a2-4965-9e62-55f2151161b7", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4e60428b-0caa-4a9b-884f-c0b3e0fa7e59", "text": "You're a poor liar.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "517b620e-d6ec-4c89-a1f7-13494fe68343", "text": "I'm an economical one.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "607c39ba-bab9-43bb-bf48-cb4cb9efb402", "text": "They went down.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bab61455-723e-4b41-b542-90d251d0684d", "text": "The archive chamber was long and low, its ceiling supported by cedar beams blackened with age. Clay tablets filled wooden pigeonholes from floor to ceiling. Some were stacked openly. Others sat inside sealed bins marked with year signs and district codes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f5685d59-58f8-4913-93a6-df2458e4a088", "text": "At the far end stood seven narrow drawers fitted into the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "29564006-25eb-462b-a447-5e3e465e77f2", "text": "Each had a bronze faceplate.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "76f2987f-89e0-44fd-888f-d114839f53eb", "text": "Each was locked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b2110275-032f-4597-ae61-447ffc78d490", "text": "Ninsun stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "58f67b2d-0e3c-4384-8393-4474172fe5cf", "text": "The Collector was being literal.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7d48bee4-fbc7-4deb-9865-4b5f588bd710", "text": "Balag looked back toward the steps.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "229d40cd-23f5-47d2-b38e-0654efc5ff53", "text": "Can we be literal quickly?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4a1e645b-df21-4977-871e-a940a47574a4", "text": "Ninsun moved among the shelves, reading labels under her breath.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7aba4e1f-3680-41c1-ba93-53ae56c9ac0f", "text": "Pre-plague property levy. Grain exemptions. Inheritance disputes. Boundary tax…", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2b76dd98-00fd-4110-970b-67ee5bd017b6", "text": "She stopped at a row of tablets bundled in rotted linen.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
