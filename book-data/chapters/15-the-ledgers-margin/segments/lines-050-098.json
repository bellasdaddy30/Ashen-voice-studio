[{"id": "769b3037-f217-49df-aabe-f614430d49b5", "text": "It stood between a grain warehouse and a public cistern, a low administrative building with a roof pitched just enough to send runoff into the alley. Water streamed from the carved mouths of two clay lions above the entrance. Beneath them, porters waited with wet sacks over their shoulders while a clerk shouted weights through an open window.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9782b065-2188-46b0-bdeb-714c778357a0", "text": "The front doors were still busy.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bba6dc6d-a0c0-4bdf-96cc-fe6741977dd4", "text": "The side entrance was not.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e0ce6912-72c3-459b-b570-d5c0119e7e15", "text": "Zik led them around the rear wall, where broken amphorae and discarded tally sticks had collected beneath the eaves. A narrow wooden door sat between two storage bins. Its temple seal had been pressed into a lump of clay at shoulder height.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "95b5c4a9-8b8b-47e9-b20f-9fbe2fade026", "text": "Balag looked at the seal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4c5675a0-a0bf-488b-b7ba-de2419680dca", "text": "You said the night clerk wouldn't check it.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fe983453-4f54-444d-bd46-4e6aba53aaf4", "text": "He won't.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cdb0edfa-55af-4970-9439-c2007a22ee7b", "text": "It's still sealed.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4549b111-e902-4af2-a27e-8e1bb1267e35", "text": "Yes.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fdbc2f0b-b151-49ae-91b0-741423c2e61b", "text": "Balag stared at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "19f15a0c-5125-4f9a-9703-14685a45c1c7", "text": "I'm beginning to suspect your plans rely heavily on other people being worse at their jobs than you are.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c8d4f630-5471-4d33-b81e-2c09ae54be66", "text": "They usually are.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "50acf5ea-67b7-453f-9107-7eb6eedbeb8f", "text": "Enhedu leaned close to the seal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c8080902-fa48-41c1-9632-735f9cca791a", "text": "Fresh clay.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4da8de8e-b087-44ce-b6ad-18eef701d30d", "text": "Replaced this morning,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1ab9342d-e0c0-43f7-ae88-b4d3e09c75e0", "text": "Ninsun said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "c378f7ee-8490-4dae-9e46-003a8d7cb51b", "text": "How do you know?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b00de40d-4c4b-4114-a6c3-c663bb80c39c", "text": "The impression is sharp, but the edges have started taking damp. Four hours. Six at most.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2c5ff343-092d-4096-a9f5-8c6af1a061e9", "text": "Balag lowered his voice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5a2ec53d-d72a-44c3-a0cb-5d4358cc45d7", "text": "That helps us how?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "08d7e5bf-b614-45a3-bd74-a0859361a72f", "text": "Ninsun removed a small wrapped packet from her satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "24d2f7d7-79f4-4e7e-8707-b0ac91a49304", "text": "Inside lay three clay seal impressions.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d44a13e0-e5fb-4053-b51d-4b5410542965", "text": "Enhedu looked at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bd41d027-d549-4b29-ad3c-d22c00a42291", "text": "You brought copies.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "84130e15-41cc-420e-b056-18bd64789a77", "text": "I brought possibilities.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c648a534-ba7c-4bdb-9c5c-a88e37817d42", "text": "You copied temple seals.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2baafd60-3f62-44d1-8f65-00ecd8869d7a", "text": "I copied errors made by temple seals.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "89302581-991c-43a5-b461-f1a56563210e", "text": "That answer would not comfort a magistrate.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "750f21e7-4700-44cc-9d8e-16af09da4788", "text": "It wasn't prepared for one.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "904d9bbe-87a9-4cc6-b69c-5efe16b89cb0", "text": "She selected the closest impression and handed it to Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "edbca0a8-157d-4ba7-aea8-70b5302ba806", "text": "The copied seal matched the clay on the door except for a tiny break in the outer ring.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "99565a03-6804-47fd-b89e-8fadbec47098", "text": "Zik examined both.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "67496a78-aecd-48c0-9b53-2f8f00a9cd06", "text": "This one is older.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4bbe067c-5224-480b-bec6-1cb5e28a6811", "text": "By three administrators.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9aa1d898-332c-40d9-8a12-199d1aa974d7", "text": "And they still use it?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5d07474f-a6b1-4b2d-a93f-72a1b435aebf", "text": "The third district is not where competent officials are promoted.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "278ab139-9700-4446-bf88-ff427ccf425e", "text": "Balag looked toward the front of the building, where another weight was shouted through the rain.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6d6159b4-5124-458b-a057-a1bcfbaf3d84", "text": "At last. A weakness in government we can depend on.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bea99072-e110-46f6-a667-095604eca79d", "text": "Zik drew his knife.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "131b0c3c-b567-4aba-a906-f950e534eecd", "text": "He did not cut through the clay. That would leave an obvious break. Instead, he slid the blade beneath the lump and worked it slowly away from the wood until the entire seal came loose in one piece.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b880790d-d4d2-474d-afd7-bd301ec31024", "text": "The door opened inward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2fc7209d-fe8f-4390-9392-25ad47c21885", "text": "The room beyond smelled of dust, wet rope, and old grain.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9df2120d-4b7b-4c0c-8733-3898803990a5", "text": "They entered single file.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1b05f157-bdcb-4c73-8314-a892b509abe0", "text": "Zik pressed the original seal back into place from the inside. It would not survive close inspection, but it might survive indifference.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "de93e1ac-3ce5-4071-b20d-f00be45aa8e4", "text": "Balag watched him finish.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0415a77d-e55a-4199-9d96-38b6095ad07b", "text": "You've done that before.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8acd619f-ec7e-4d38-b3e0-8e7da597e627", "text": "My father disliked locked rooms.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0c42a17a-2313-458c-80a2-4b47930ce82e", "text": "That is not the same answer.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0e74788c-5d2d-4f57-8353-e58ebbd8dc37", "text": "It's the one you're getting.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
