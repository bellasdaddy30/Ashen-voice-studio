[{"id": "ad5c7246-e35f-4208-b4e2-3344e8c01415", "text": "The archive seemed to contract around them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a7063097-000a-40c4-9539-e474da602729", "text": "Enhedu looked at Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "671ea8ac-60da-4d4a-9d75-d6ad7b40706e", "text": "Seventh access.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "04cd9bb9-79be-41bf-952f-37bb92656275", "text": "The basin had seven divisions,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bda27911-676c-426e-807a-8cfced10eeec", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "7291a936-73eb-403e-a5d0-6c80e9d1b10f", "text": "And the boundary rubbing,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "48445791-f520-4d33-bf7b-bf287906b9de", "text": "Ninsun added.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "958472fa-ab10-4906-a11c-7d599f24e0b0", "text": "Balag pointed at the tablet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2eedeead-9cff-4e32-8587-e0b0ef277372", "text": "What happened to him?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "603f17e1-cc5a-4616-8bbc-dd862982cf34", "text": "Ninsun turned it over.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f2787779-e698-47bb-b3e7-fe798713331b", "text": "The reverse had been scraped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "abcd3e4d-dae7-401b-9e3a-a2e8b1029d67", "text": "Not cleanly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "51a52029-2e90-4354-9ce6-b77d8818d98f", "text": "One line survived near the lower edge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "11a11507-854d-4e3a-9b5c-91022af70ca2", "text": "She tilted it into the light.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d869bfec-f535-424f-9782-7845f555dc56", "text": "'Exemption revoked after keeper refused transfer of the name.'", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2f63edf9-4d87-4df4-9166-5bb825ca1685", "text": "Enhedu's expression hardened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f216eda8-9803-4f79-870a-a1a078255b30", "text": "What does that mean?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8839a8db-0d1e-4fed-b801-d12fd5871467", "text": "I don't know.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fed2a2dd-28cf-4fe4-ae5b-257218c791b2", "text": "You know what the words mean.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3d80d462-5069-4612-96b0-232ce4f3ec6c", "text": "I don't know what they mean together.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1ec27d6e-adb8-4d89-a1ad-c2e7cb89517a", "text": "Zik examined the margin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ab2fe3f6-33b2-491a-8446-98a04fb920b4", "text": "The main text had been written by a formal clerk. Straight wedges. Even spacing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "24eac2cd-1027-4d70-9b7e-ce7e30e02309", "text": "The note about Ammaru was smaller.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b5c0a4f5-868b-4bd4-87d8-f84a402a0b35", "text": "Compressed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "78fc9761-1927-4991-91fc-12178d81df99", "text": "Written in haste.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bd59fade-dae2-4113-9fd5-3fb0645a9603", "text": "Someone added this after the ledger was closed,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c66d47be-9fa2-4963-90ce-eb795baa10f1", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "84e8f72e-cc8a-4ce4-a350-d8d42a580718", "text": "Ninsun nodded.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5cf3c1f6-cb6f-45fd-8983-12577c0269b7", "text": "A clerk preserved it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bdb6c935-a235-4857-9bec-4050b797d8fa", "text": "Why?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6542bf48-4d4a-466a-8f28-cc5655002d22", "text": "Because the official entry no longer did.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "45f77239-5bb4-493e-b24d-440155678463", "text": "Balag looked toward the seven locked drawers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "95e8d1a2-9cdb-41b1-bfa5-baeebf9c48c3", "text": "Then whatever came next is in there.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9ff7c337-9613-47d2-a69b-a1dd0e3e8f9e", "text": "A sound came from above.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "33b777c0-b881-4c15-88e7-9933d22fade2", "text": "The outer door opened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2df4eff2-6f0c-49eb-bba5-fb5ea34742c8", "text": "Footsteps crossed the storage room.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "03f79882-153d-49bb-a11d-63bcb216f34f", "text": "Not one person.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b47ebb31-d5b7-44ed-a1a6-2ec18082ea44", "text": "At least three.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3b083d21-4ad5-4688-ba2b-1932f865a729", "text": "Enhedu extinguished the lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f38eeede-4402-497c-9fd9-d0f0893dc03f", "text": "Darkness closed around them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bb4ee852-d80d-4b7b-bf18-9f4a90a26d14", "text": "Someone dragged the broken scales away from the archive door.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b5864974-2954-4906-a3df-5344fa0fea8e", "text": "A key entered the bronze lock.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "79c872db-f144-4b9e-ac1f-fc7fae84109f", "text": "Ninsun held the ledger tablet against her chest.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9c0809ea-d158-45c7-861b-857933125b8b", "text": "Balag raised his spear in the dark.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5f113656-d76b-4795-b20d-6779e369b021", "text": "The lock turned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
