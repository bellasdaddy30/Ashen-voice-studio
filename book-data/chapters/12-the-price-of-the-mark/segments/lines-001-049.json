[{"id": "efd9cd26-bcc0-4740-88d9-c3ed7ae8c9ed", "text": "CHAPTER 12", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "6019191c-03c2-4cb5-ab07-d887e1ad7605", "text": "The Price of the Mark", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "d8984837-2c81-4694-9ea6-b128aeb3e4df", "text": "The first real cost arrived two days after the warning note.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ac5c691c-36f1-46ed-b975-eb1aec2b16f6", "text": "They had been working a narrow cut behind the tanners' row—two notches of their own, no forged third, nothing that should have drawn attention. The passage was short and already starting to close when Balag's spear found something soft under the dust at the far end.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a6b3e9d1-4302-4204-ba39-5774b64088bf", "text": "He stopped. Everyone stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ec1048fd-7226-4444-bc14-14213f90b84a", "text": "It was a pack. Ordinary. Canvas and leather, the kind any lower-district porter carried. The straps had been cut clean through. Inside was a water skin, a half-eaten loaf gone hard, and a small clay tablet wrapped in cloth. No name. No identifying marks. Just the ordinary gear of someone who had expected to walk out again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bb9b8587-8f59-4f18-93e6-56bb91012466", "text": "Ninsun unwrapped the tablet. The writing was hurried and already fading at the edges, as if the clay itself had decided the words were temporary.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dbf5ea9b-69f8-4baf-85c4-af1ce7ea1d9b", "text": "Three lines:", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d807c318-9666-410b-888e-02c6ecc3b515", "text": "THEY ARE CUTTING THE WALLS", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "d8aa01ec-8acf-480c-a2b6-6dfb021eb0ce", "text": "THE CITY DOES NOT LIKE WITNESSES", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "7c450735-75ff-4c8a-902b-f50e149c3414", "text": "I SHOULD NOT HAVE FOLLOWED THE MARKS", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "fdf93ae9-9089-4523-9539-408e22568e57", "text": "Enhedu exhaled slowly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "01203889-a762-4b1b-9d10-7f06f554bcf2", "text": "So we're not the only ones.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "678ba399-9df1-4d95-9cb4-f1dafe2d9b4c", "text": "We were never the only ones,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fa7033b0-97ac-4a38-92b5-49684bca08ce", "text": "Ninsun said. Her voice had gone flat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "f36d207b-f1dc-480b-a1c5-a5f1a18c0674", "text": "We were just the ones still walking.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "956946cb-9e14-4680-a32c-6a565c24b0c2", "text": "Balag turned the empty pack over with the butt of his spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "f97e96f7-4652-4179-8e8f-e7200833eba5", "text": "No blood. No body. Just the gear.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f156eadd-c64d-4c2d-b3e6-1a179a98a68e", "text": "Zik crouched beside the pack instead of answering immediately.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f8d87f8c-07b6-4602-b0f7-493858ac855a", "text": "The canvas had rotted at the corners but not enough to explain its condition. One strap had been sliced cleanly through. The other looked as though someone had started to cut it before changing their mind.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bc692476-c1cc-4be5-8a85-c3ba4d580542", "text": "He lifted the water skin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fd13e20d-6520-4096-a7f0-51976d60aa9c", "text": "Still damp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1ec71a47-4bd4-432e-bb73-6e85a1946e19", "text": "Balag noticed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ef771eed-cae3-4580-8d8e-007e047ba44b", "text": "That's impossible.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0a58fd95-8f5c-4900-a3e3-f241118bec0a", "text": "It shouldn't be.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "eb8b9a3f-ea30-4c41-9be1-828513f01d6d", "text": "How long has this passage been here?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f3616057-961d-4edf-ac4e-5dfe9cfe65a0", "text": "This one?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c17a26a0-5dc7-4cd8-8bb4-52d67bddc494", "text": "Zik looked around the chamber.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "19bc930d-467a-4505-b0f4-db7dcfb5fedb", "text": "Hours.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f3514b36-83c4-419c-8259-6d0dd1d36c77", "text": "And the water?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b53ed847-9fa4-4168-904d-08fb5232fea6", "text": "He uncorked the skin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bfc8e86f-dff6-41a0-ae13-0ee0fec60161", "text": "The smell was fresh.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f2b800cc-5192-45ec-aed7-83fb7b2d0427", "text": "Not stagnant.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a6fb725b-9c63-40e0-b58e-a0fcd4364c47", "text": "Not sour.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fe4dd9ec-9be3-4fed-b785-432467211f3e", "text": "Fresh enough to drink.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "51be8b33-48d1-4211-83a8-23de763232b6", "text": "Enhedu frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b89e79bb-9f6c-4bab-9ece-7228328967cb", "text": "So whoever owned this…", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b1b213bf-ef43-4bfe-ab6e-3ad7e545988b", "text": "…was here recently.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fb2f273e-5d1c-4a0e-9a80-bf59761b904a", "text": "Ninsun looked up from the tablet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "03de6506-cc52-4a2e-9c56-be412e843051", "text": "Or recently enough that the city hasn't decided otherwise.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "134da512-6879-4fe1-a36f-f48545a519d0", "text": "Zik searched the pack more carefully.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3c89c6e6-d30b-4ff6-bd37-8de532659ebc", "text": "A bronze needle.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d0edc7a9-345f-4e53-a73d-63aaf3f6c7a8", "text": "Two fishing hooks wrapped in cloth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1bcb1427-de48-4d07-933f-2c9d600d4caf", "text": "A length of twine.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "05023aab-6849-4e2b-a496-e4a191cae399", "text": "Nothing valuable.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "18cbfa17-78fe-40dc-8ef8-660a2c144b42", "text": "Nothing worth stealing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a11b6d37-7b30-4339-a358-e5bd9240642b", "text": "Then his fingers touched something hidden inside the lining.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cf43d3f8-e2ec-4bf5-a121-40892f206bdd", "text": "He carefully split the loose stitching.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "62124cbc-a518-4794-b25a-30d24e646bb8", "text": "A tiny clay token fell into his palm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
