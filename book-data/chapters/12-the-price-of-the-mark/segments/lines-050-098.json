[{"id": "2bb15606-5976-4051-ad8f-d419b1b7e6d9", "text": "Round.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "44196f42-063f-4f40-8d94-7033e107c0ca", "text": "Unfired.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7195832f-dd95-4bd5-b0b7-e580786f17f2", "text": "Pressed with a single seal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4f0318b6-c50d-4692-968a-a0ed33a061b1", "text": "Not the spiral-drop.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1c07afeb-9bdc-4632-a349-3a5a1e90b083", "text": "A simple reed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3ef1a371-2094-4186-bb33-ee3e454afe2c", "text": "Enhedu leaned closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e0817c30-5768-4f32-b3c8-a593bb1dfbd9", "text": "Meaning?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5a52e3af-711a-44f7-8078-6231727e9ced", "text": "I don't know.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e22fa904-42a9-4811-8fa9-124e62e52a5a", "text": "Ninsun took the token.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c5b81c46-2138-4a84-beb0-578f07b0de1a", "text": "It isn't a merchant's mark.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "00d5160e-cf8e-4cc9-b291-7b6d73d4b840", "text": "Temple?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2564aa97-e53c-46e1-a873-6400013a7306", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "17e266fe-75f8-4d09-bac6-8075b8aec4e2", "text": "She turned it over.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "87b23331-e52c-4c60-b614-b783555bdbab", "text": "It looks personal.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "94addce2-5607-4b9d-bb29-f577b444e688", "text": "Balag scratched his beard.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7b4fff95-9abf-49be-a9b6-2d82102cdf49", "text": "So somebody expected to come back.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e5cef87f-eeaa-4e89-9ddb-e0783138191b", "text": "Zik looked at the carefully hidden token.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4f6b6422-2466-4061-97d5-eed680022c35", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "722bf3f4-f33b-4474-95ae-91bd41a5035d", "text": "He folded the lining back into place.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "128831ce-9b1a-4ce3-8592-4512281c6d50", "text": "They expected someone else to.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "57db057b-e687-4c5a-9f11-c99e68ff7f46", "text": "Nobody liked that answer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e64fb3ff-9ed3-4686-8f01-56ab9cafea09", "text": "That's worse,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5e1ad361-04bf-4c15-8568-bb21c41965ea", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "881cac3c-43fa-4847-805a-84d30270c02d", "text": "No one argued.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9fcbb582-cb60-4137-bdba-0cb495d85fd3", "text": "They took the tablet. They left the pack where it was. On the way out Ninsun cut a fourth notch beside their original two—deeper, angrier, the kind of mark that said this place had already collected its price. Zik didn't stop her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bfc79b61-7710-434f-9540-49d0eac32082", "text": "That night the cheap room felt smaller.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "475c564f-8c77-4a4a-8492-bb6a3336825e", "text": "No one unpacked immediately.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "db2149f3-7b97-422b-83d4-070f1e83d90a", "text": "Balag leaned his spear against the wall but kept looking toward the door as though expecting another messenger to appear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4546647c-224f-4754-9efa-e01f3102409a", "text": "Enhedu poured water into four cups.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2c171dc0-4b0e-4168-9d93-c758313effba", "text": "Only three were touched.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5bd0d07b-eed3-441c-b775-57514916aa8c", "text": "The fourth sat untouched beside the abandoned pack.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "24d4787f-4f32-4342-8a75-f911c5dc5e4e", "text": "After several minutes Balag pointed at it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b3207ca2-a9bf-460a-9cd2-38a0a1eafcb9", "text": "Who's that for?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6e18b96a-3778-4d4c-98bd-ceabaf8053c6", "text": "Enhedu looked down.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6d438f1f-ec39-4968-a78e-bede2cece0cd", "text": "She hadn't realized she'd poured it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1c24d616-7c0b-42c4-b931-6c6f289c573f", "text": "Without answering, she emptied the cup back into the jar.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0de5df44-0ea6-446a-8033-122c4a0793b7", "text": "No one mentioned it again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5eabafee-1b27-45b4-830b-2106b9d2c7bc", "text": "Ninsun finally broke the silence.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "81d03cf7-506b-413b-9423-c857445ff0e8", "text": "I'm trying to remember every name I've ever found scratched out.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6af59e94-1096-48c4-a4bb-e2bd03301555", "text": "Why?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "76f5b9b4-0b96-4db5-80b9-42f8e06b2276", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "e8940da4-5b2d-4b15-b777-2fbefb7fb30f", "text": "What if one of them belonged to him?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1ec57ef0-097c-4a21-9b1c-617f6975a990", "text": "You don't know it was a man.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0287556f-1a27-438c-968e-c0941eb40b48", "text": "I don't.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9a84be05-f147-4e7f-acaa-87fbf10728d8", "text": "What if he never found a shifted street?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9dccc2b6-a82c-4494-a8d4-d3d16cf563ef", "text": "He followed marks.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "297a180e-e08f-47dd-9742-cda46d9e6ced", "text": "She touched the tablet gently.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3171688f-4ad8-4cad-8289-ac74612412ee", "text": "He wrote this.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "938ed991-6d20-48fa-9d38-29c17ba79eda", "text": "Balag sat down opposite her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
