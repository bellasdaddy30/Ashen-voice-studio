[{"id": "1cb06aef-8bd9-4c30-aab6-83aa01525fbe", "text": "Nothing moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "12b60019-b44d-471a-8657-ff70b73c24e8", "text": "Then the wall bulged outward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "88c578c8-57a1-4553-b2f0-da981000ddd2", "text": "Just once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e5df6a49-52e5-43e3-8934-37d96f3ba0f0", "text": "As though someone on the other side had placed a hand against it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6e557f8d-fc58-4ea2-96f6-34535129ee4a", "text": "The bricks relaxed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d805b9b9-84bb-43a6-a838-9337057d56b5", "text": "The recess vanished.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9c99e961-000c-4522-a9a7-c63d437edcbe", "text": "Ordinary wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bc1cf1b8-8b20-4762-b38a-7b7a605740a7", "text": "Ordinary street.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4dc1b8c3-e513-49b8-82e9-1fb576071368", "text": "A woman walked past carrying folded leather without looking at it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3173b156-7aa5-4e9b-b633-8917d3facc40", "text": "Enhedu waited another few seconds.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bcb641c1-99ab-4c28-b857-c32887073b9f", "text": "What do we think that was?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "90b1040d-4606-44d3-b09d-ab534623ab03", "text": "Balag answered immediately.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "41a18fe6-98ee-455f-a6b2-c88293833507", "text": "Someone disappointed.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a73f2370-6caf-4091-a510-025a5f523f37", "text": "Nobody laughed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "04bf113d-2a67-4061-b628-1736fd8ecbd8", "text": "They resumed walking.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eeac951f-f007-433c-b153-cf94dc0060ae", "text": "Only Zik looked back one final time.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "03ecb33f-ae6b-4f84-9686-5957019ab7d9", "text": "At the base of the wall, where the three notches had been—", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "104abfba-a71c-4f57-9e63-0180a2a522d1", "text": "there were only two.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8b6b0122-9323-431d-8ea7-c8e90dbe545b", "text": "The third had disappeared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d25251fc-c0c2-4ad5-99a1-68e8dfff388f", "text": "He said nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
