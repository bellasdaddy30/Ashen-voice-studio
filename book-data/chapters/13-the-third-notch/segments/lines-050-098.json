[{"id": "0df0c62e-9b03-4b41-ba92-64e65ee9e5e9", "text": "Enhedu glanced at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "8cfa48a8-8069-4b3d-a764-73bfec802cd8", "text": "You're the one who decides the jobs. So decide.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "19c36bd9-1c3e-4665-88d6-81d8d83def34", "text": "The street behind them kept up its ordinary noise—drying racks flapping, someone cursing a late delivery, a child crying over nothing important. The four of them stood in the small pocket of quieter air the open passage had made, and for a moment no one added anything else.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "94a5d606-2847-4fa7-8f52-716d70b7c52f", "text": "Zik looked at the three notches. At Ninsun's face. At the way Balag's shoulders had set. At Enhedu already calculating whether the risk had a price worth naming.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a01bd05e-af10-454e-ac75-8c976db87d16", "text": "We don't go in,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c2176c0a-ccbf-4a15-8f79-16543af789f1", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "82f9010b-2df8-41ce-8197-6fade0a3c121", "text": "Ninsun's mouth tightened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8269e9b1-6594-4895-94b0-7750ff12e60b", "text": "We don't go in,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "87bcb034-1819-4e15-928a-4e05b0431e4a", "text": "he repeated,", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "50e2f9f7-bec2-4b24-9546-92c8f4ea7ccf", "text": "and we change the rules right now. No more following marks we didn't cut. No more open cuts in districts we haven't walked twice. If a passage already has three notches, we leave it. And if we find another pack, we leave the tablet where it is and we walk.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9bca9a27-f49b-4deb-b13e-05e2d3a34b98", "text": "Silence held for two breaths.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5c5a9c35-1583-4908-94f1-74b9bc2b0e4b", "text": "Then Balag nodded once, short and final.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "6832e4ba-2ec8-4e1d-8d70-167d30388352", "text": "That's not stopping.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "492131ed-2c83-4246-bc7a-75bff6e1b2a5", "text": "No,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e74710cb-a1f7-411d-ac08-a1111abb8158", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "361b9571-0ba5-48e3-bdb4-dae86943bbde", "text": "It's refusing to get stupid about it.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "79963d90-6916-4476-93f9-bd9e6f9c0ece", "text": "Ninsun stared at the third notch a moment longer. When she finally stepped back, the motion looked like it cost her. She pulled her map free, found the tanners' row, and wrote a single word beside the passage in the same tight hand she used for everything that mattered:", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "792ddcac-fc1c-4a6e-b6f4-1f017ec3d337", "text": "LIMIT.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "9d9ae000-0217-484f-87dd-8a55543c85be", "text": "She stared at the word for several moments.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "69d7887a-81ae-4c3d-a951-21c6479bf636", "text": "Then she crossed it out.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b714e073-955b-4d96-b8fa-361c8d620b94", "text": "Balag frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2ca03955-6954-41ef-b5e5-842a02cccbdc", "text": "Changed your mind?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "db836570-886b-4cea-af27-01f8b3d3422c", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6d21cddc-8749-46f5-abf0-1f6b95b3608e", "text": "She wrote again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d77acd82-b8af-4eaf-83ea-7722ae2dfc4f", "text": "Not LIMIT.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "adc79df0-4516-45dc-a285-f7e24baeb168", "text": "RETURN LATER.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "7661261b-6d99-4bfe-ac1c-bc727c0303c0", "text": "Enhedu looked over her shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "512c66ac-44f5-4bf9-8d7d-068da489909f", "text": "That's not the same thing.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9f15248c-78de-4549-bdea-76837ccc7c8f", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b22d2b43-ab9d-4376-8571-337d04b4ef40", "text": "Ninsun capped the ink.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "82cadedc-0b45-4d29-9e5e-36fd592b86ab", "text": "A limit means we're afraid.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a2fd0419-7e4f-4bc4-a775-f4272ece371b", "text": "She folded the map.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ddcca8a2-b56d-4b01-a9a4-891cea070143", "text": "A return means we're patient.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1e07f755-e153-4259-a8d2-f9d3fd6111be", "text": "Balag snorted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7c1ef45f-c838-4f0b-acb2-b775d000cfc7", "text": "You found the scholar's way to lose the argument.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6692a129-06a9-4ba4-978b-966ad0335a99", "text": "I found the accurate one.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e2847e6a-1ce2-4d8f-81d6-ab7dfc25a016", "text": "Zik smiled despite himself.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8e97ffca-88f7-4e95-af82-b72de809baa3", "text": "Only slightly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bd61e95c-00cd-4216-a32c-2ce40f8ab92e", "text": "Leave it.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "18df4dda-1706-47c0-ac16-88a3cd6310e4", "text": "She did.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bfa401a6-4b7a-49bc-ad79-507ac5759fb7", "text": "Enhedu exhaled through her nose.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "d1314ac0-0f85-451b-bda1-213955e63afb", "text": "I'll take the limited version of dead over the ambitious one.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8ab17eaf-a24e-4e0e-9702-8f1c3e0d972f", "text": "The passage had already narrowed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "51d223f5-ed3b-43c4-877c-87bd30ae316d", "text": "Not loud.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "41196a79-3558-4d61-8016-b88750d817d6", "text": "Stone settling.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d69e59ff-9e0d-4870-b534-ba26d353bf3d", "text": "Then another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ab9fc36f-f6ca-4e5a-b14f-541c2b038437", "text": "Balag stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "555f1f7c-5c97-46e1-8341-c6ac7b697bc0", "text": "The four of them turned together.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4d99e2a7-c9b6-4771-bd4b-bd383a297c61", "text": "The shallow recess remained.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
