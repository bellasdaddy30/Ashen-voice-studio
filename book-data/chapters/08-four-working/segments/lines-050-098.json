[{"id": "eb1d6436-734f-4547-a3b0-85692fa88792", "text": "Everyone stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1d7645e8-a26d-4e46-b75c-5283bc629e9d", "text": "A long horizontal crack ran through three courses of the left wall. Not fresh. Not old enough to ignore.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6ab7a633-1f8e-4f38-9625-80dd271c1bc2", "text": "Balag pressed the end of his spear against the lowest brick and leaned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c3424191-935d-493a-9f5d-3af3798b5dec", "text": "Dust whispered from the seam.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d65841a1-b4b0-43a8-8a4a-946665c13955", "text": "Load's shifted from above,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1c0f85f9-fbee-4c75-bc55-bb7297950dcc", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ee122e0b-65ca-4612-b3e7-744bc59d5f30", "text": "Ninsun spoke before Zik could move.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6de378b2-676f-40bc-9640-ce876f86241b", "text": "The mortar's different there. See the color? That's not the same mix as the rest of the wall. Someone patched it once already and did a bad job.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c736b9e5-f0ad-4659-aa57-17f7ce6644ff", "text": "Zik looked at her, then at the crack.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "04aa7de7-d7d9-403d-ac25-7972245ca5d4", "text": "She was right.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e4a6e30e-af00-4090-bf34-7e775fb901fe", "text": "The repair was older than the settling, and the original workman had used a weaker lime. Worse, the patch had been laid over soot.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "074fd086-2a1c-4f11-a27e-99a7043e0942", "text": "He scraped at the edge with his awl.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "48ac6262-269d-4b33-8dc3-a800e26d6c36", "text": "A thin black layer came away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "743db98c-e80f-49cf-8882-e23abb01402e", "text": "This wall burned,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d99383f3-6025-41a2-a24c-55d6b4ad0959", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "2015922f-9a1b-4baf-a441-b1c0862611fb", "text": "Enhedu turned from the passage ahead.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d74a2bd6-f036-4668-b36e-a1b5d47da70b", "text": "Recently?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d1bb4106-3c9b-4850-8481-fa10f2d5b061", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f49387e4-b89f-473b-95dd-7953f9a74ada", "text": "How long?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c0761f02-06ec-40a1-acbf-86db38487494", "text": "Long enough for someone to rebuild over it. Not long enough for the soot to wash out of the joints.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7d1d96c9-67cf-42f6-9cd8-e52bfc3d90f6", "text": "Balag looked up at the low ceiling.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6a208867-0d4f-4a49-95b8-3f6609699274", "text": "What burned underground?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4c82f29f-f1f0-4738-a22c-d9b8bcf4b937", "text": "Something with air.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c9d462a6-f977-4970-9f59-22d8d1bb70be", "text": "That narrows it down.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d220b626-89f9-477b-ab0a-8c307cf6e0a4", "text": "Zik set his pack against the opposite wall and removed a short timber, a wedge, and a coil of cord. The timber had been cut for tent work, not masonry, but the grain ran straight and the wood was dry.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c64e0faa-f7e2-4ef5-92fc-db098b15931c", "text": "He positioned it beneath the weakest section.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d158a8ba-d5f4-4b7b-84ae-f8a8ae1c6131", "text": "Balag held the upper end while Zik drove the wedge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2d682ebc-578c-425f-acbd-dda682622eb0", "text": "The wall gave a low grinding sound.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5fc8bad6-8467-4c91-844c-52799c71cb0a", "text": "Everyone went still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c2d2432d-d09f-4209-944b-a10aa84aec6f", "text": "The crack widened by the thickness of a fingernail.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "278b836f-2f00-4e29-a5fa-6faeddfb2b85", "text": "Then stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7cb874bd-ebe0-4d8a-8896-480cb4a7d460", "text": "Balag looked down.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b5aca3bb-1e80-4d07-b11b-bec17c507bb3", "text": "You fixing it or persuading it to kill us faster?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a2d5a8e5-4226-47b3-a971-5a5286dd4df5", "text": "Still deciding.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "404fa9e9-2d0c-4bed-b572-af4ffd2c4a28", "text": "Decide away from me.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6645b0af-774e-4709-b894-81b0bc9c3556", "text": "Zik adjusted the angle, drove the wedge again, and tested the pressure until the crack stopped complaining.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7539eadd-0b2e-4ad6-9d9f-42e0ae540d60", "text": "Temporary.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bf44de4a-2524-4826-9126-5c7daf6c7c27", "text": "Sufficient.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dda72a39-e8e7-46f8-8af0-374698001af7", "text": "Ninsun watched him finish.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "00795130-b72d-44e3-81dd-f6d072aa845a", "text": "You do that a lot.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "414df2fb-8da4-4831-a12e-e4fa2651d68c", "text": "Fix things that aren't mine?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8cf8f517-6c05-49ff-bde5-c3e241a32128", "text": "Yes.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "44e84ae3-0445-4fb7-ae2e-89ffe7c85075", "text": "Zik wiped the dust from his hands.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c4d6775b-74b8-41bc-9056-4ab4de86099e", "text": "Things that aren't fixed have a habit of falling on whoever's standing under them. I prefer the people standing.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "57e6f48a-d312-442a-a51d-689646d68df3", "text": "Enhedu's voice drifted back from farther up the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e44042f1-58b1-4d16-8f34-4fc3ec8a3389", "text": "Some of us prefer the people paying.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d081501b-8704-4738-92d9-48bd0cc625a6", "text": "Balag snorted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4058b890-46b7-4eed-946c-aded3637f86d", "text": "Some of us prefer the ceiling staying where the builders put it.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "63309c0a-2f58-494d-9ecd-3d59af415831", "text": "Ninsun touched the repaired mortar with the end of her stylus.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
