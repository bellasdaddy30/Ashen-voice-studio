[{"id": "876f336d-880a-4721-ad82-3821b42a6bab", "text": "Ninsun noticed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "33cace4c-1758-45d1-b11b-a2561253e2db", "text": "What?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a376c0a3-3d1a-44a7-b73f-564d26386071", "text": "Nothing.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c707502b-f6f0-41a1-b051-4cc4f4faf680", "text": "That is becoming a very specific kind of nothing.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1be12685-6af5-47cd-902d-115d2c646eee", "text": "Enhedu stepped closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c02fce3d-f255-4efe-8a26-b9e6a8e663a3", "text": "Show us.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1ffd995b-eecc-48e5-97a9-a8b99d7f8a6c", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "56159de7-6e8d-4117-add7-b08a5852cccc", "text": "Balag planted the butt of his spear beside Zik's boot.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a600fc61-3b02-4894-a7bc-11e7d33384bd", "text": "Excellent. We've reached the part where everyone lies.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "38710bc5-dcc2-4dfd-a57f-061d9a9a6dac", "text": "Zik ignored him and tapped the floor with the bronze awl.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "73e048d7-fd8b-44dd-bcbe-4d8f4185e779", "text": "Solid.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a0bf3a38-b1dd-4e0b-8eb0-702cc5f8f1bb", "text": "He moved six inches and tapped again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "368f47a0-9a5c-4ba7-bb1d-b242500ce2bb", "text": "Solid.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d71f4a7e-a8f0-4b51-9206-6f0c5a369b76", "text": "A third time.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "001012d3-7320-483f-b78d-e4fac6427092", "text": "The sound came back thin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b58b691-a20e-4620-8f08-c0d34b1ee541", "text": "Ninsun knelt beside him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c3c49f93-5249-4828-9b6c-24da3550a34a", "text": "There's a chamber below.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "be77c76a-d40c-4706-a282-d21f2dcf3bc0", "text": "Or a drain.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f23cfe19-b853-42f6-a86b-42cbc8238800", "text": "This far beneath the flood channel?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6bf0a6b3-bcc2-4ba2-87f2-5b050c8d336b", "text": "That would be a bad place for one.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7c41638d-75d5-47eb-8368-923a2eb89cb8", "text": "So naturally the city built it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6f697586-5ab8-4616-aacc-c6df022f9f06", "text": "Zik tapped farther along the slab.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a99308ae-5ccc-4dd3-bac7-a4d5a3a915cc", "text": "The hollow space followed the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "67163801-73e2-4eb1-a7cc-98dbda554e94", "text": "Not a chamber.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "44622475-f09a-4021-b5e6-051df2f00c9b", "text": "A second corridor.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d1e9ce78-4cc8-4ba4-94fe-0d539177d274", "text": "Directly beneath the first.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "471c4992-89cd-46ba-83b7-b1ee6232869a", "text": "He stood.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e373e473-ba43-43d9-a705-1c30cc1d96cf", "text": "We keep moving.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e5b68a46-9608-49be-bcdb-1a84e4196245", "text": "Balag looked down.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "837a7162-2778-4ac6-a379-64916621b55a", "text": "That's the plan?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "20b45a6e-d31f-43bf-b6a4-b7f4089afc80", "text": "It was already the plan.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8e601fae-05db-4041-abad-3aaa30734f0b", "text": "Good. I worried the invisible corridor under our feet might complicate things.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "63c03ebf-fe74-47e7-b25d-c64f5e7f9ed7", "text": "It did.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "42dd92a4-0ee2-4e87-94ce-90ec0845e34b", "text": "How?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a73d0f1f-a39c-4d0a-8eb7-f724d5f21fdc", "text": "We know it's there.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cc0a7f30-7e31-49ea-90c4-54ca83a9733c", "text": "Balag stared at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8c2cf3ba-1a44-4644-9f0c-5b78f92104b9", "text": "That is not a complication. That is knowledge.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "831f145e-77c5-443a-91ba-d6b5846cceaa", "text": "For you, those are usually the same thing.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e99a213f-0030-43be-8079-6bed75bb260a", "text": "Enhedu covered a laugh with a cough.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9be0fad3-ffdb-4326-a920-28db49ad5252", "text": "They went on.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4c8af3e6-893c-4c79-8ac5-f36a0a71cf7d", "text": "The passage ended in a small square chamber that should not have existed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "45b73ec7-705b-4bb3-b84b-3d0624421a29", "text": "Its proportions were wrong for storage and too cramped for worship. A single doorway had been blocked with bricks of several different ages. The faded remains of a painted boundary stone had been set into the floor, its upper surface worn nearly smooth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c2231327-c633-4b67-a491-7c92e040416c", "text": "Ninsun went straight to the stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bfe480cb-8c98-468e-977c-e66baf654198", "text": "Enhedu checked the corners.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c3c717df-cef4-4a2f-a083-fde8144732ba", "text": "Balag tested the blocked door with the flat of his hand and shook his head.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f49e6acf-186b-4f38-9e41-d5f048afdcce", "text": "Solid.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "82c3c9d1-3012-4201-b1fd-0f2304e29c80", "text": "Original?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3f6241dc-0a07-46be-b39c-8ce9b5898612", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "01fd940f-3730-4232-a770-1734d528e305", "text": "No. Doorway's older than the fill.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
