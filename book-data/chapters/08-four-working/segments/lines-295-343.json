[{"id": "414f7c65-efe3-455d-a580-411efe153af5", "text": "Enhedu backed toward the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7d0299a1-3738-4ad2-a2b9-a83b01d8c371", "text": "Ninsun.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "84f65fa4-14c7-44e4-b4ef-7851b2f62d17", "text": "She rolled the parchment at once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "291f6526-0139-42e3-a9d2-c89c264278a4", "text": "The third knock came from beneath their feet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8887893d-9d42-47b7-b1fb-80b2f0a5fea5", "text": "The fitted slabs shifted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6c443ece-f73d-4eda-a924-0e9fa6912dc7", "text": "Barely.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "86823c73-fc79-4321-91a8-e575c2c8b9c0", "text": "Enough for a thin line of black moisture to rise between them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "847275ce-776c-47cc-9006-6895d6c0c820", "text": "Zik watched it spread.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "03bc594b-1ba8-4c3b-aea2-81a549e502b9", "text": "It moved against the slope of the floor.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "19811edc-a78f-4978-bfc7-6f9e83f483b4", "text": "Toward him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5910764e-7cfa-41f6-a2f9-3d2a84384d2b", "text": "Now,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f421b410-9490-48a6-bbe6-d38be177c96a", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ac37dca3-10c1-4be4-a5d7-53c9e79ee150", "text": "They backed out the way they had come.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b1df9c32-0f7e-46ec-aec6-d436a4d8c0c4", "text": "Balag went last this time, spear lowered toward the chamber. The black line followed until it reached the threshold.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d26e7c23-8f7e-4351-9bf3-1d8b86c5b205", "text": "There it stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7643f0e9-1671-4d94-950e-5752fdbc79ca", "text": "Not because the floor rose.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8e3085d5-577e-4455-aadd-f51033942661", "text": "Because the water had chosen to.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f805d591-c987-4762-b799-4013c597c2b9", "text": "The braced section of wall was still holding.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f14fbb8e-c649-4695-9840-44981c50f2ec", "text": "Zik checked the timber as they passed. The wedge had sunk deeper into the mortar, though no weight pressed visibly against it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1b92def5-3cf4-4fe5-880c-2556203644ed", "text": "Ninsun glanced back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "80ab2a6a-5430-4a26-8966-9b2ecaf93ed1", "text": "The wall wasn't cracked when we entered.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8ab4fb20-06ca-4bc6-bfb7-b3a7c60714b7", "text": "It was,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e27ca076-e24f-4b6d-91b9-c43a325468e1", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "c838fdd1-f05e-4ef9-b54c-0e8dc585cd7b", "text": "I drew it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "332e7ea4-4b53-461c-a4b5-cac1144f869a", "text": "She held up the clay tablet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5eb3fbbf-498e-454b-8033-216b31569d74", "text": "The copied seam was gone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0eb881d9-c86e-42c4-81fb-7f9b1773559d", "text": "The surface remained damp and smooth except for the first lines she had recorded near the alley entrance.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "757da024-a043-4297-be05-fd5c14b63b7e", "text": "Enhedu stared at it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8bd32744-d32c-4b46-99ad-afa25f2516a8", "text": "The clay erased itself.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e9d819cc-4589-461d-a137-58b43dd94b9b", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f551ab2a-cb9b-4f3a-a8f8-f8d5b21b2fb9", "text": "Ninsun ran her thumb over the blank section.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c777d053-5b3f-46ea-97f1-8716d77f64ce", "text": "The clay remembers something else.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ea0a6751-8c14-4055-a8e0-c2b1c27dfa21", "text": "Behind them, the timber snapped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "21b92955-a1d0-481a-80f0-1db141d9e007", "text": "The sound cracked through the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "660e54da-814f-488f-9af7-ad447c725b18", "text": "Dust burst from the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b6b1d1c4-b64e-4fc5-bddf-18a16d7ca71c", "text": "Balag shoved Ninsun forward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e594d193-7792-4f1f-9d1a-76da72936faa", "text": "Move.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "80be430d-d3da-44a7-8141-d2b5084321dd", "text": "They ran.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dd32601e-4520-4ab1-8668-ca104c635fba", "text": "The floor tilted beneath them. Not collapsed—tilted, as if the passage had become the side of something much larger turning in its sleep.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ef90a05f-f946-4428-b590-fc869766ac57", "text": "Zik caught the wall with one hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0e8fb8ed-f9c3-4206-b425-ce9ccbeae7b3", "text": "The spiral mark flared under the linen.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b7980bbc-b292-46c8-b649-92ab73ef3a9a", "text": "For an instant the dark bricks became transparent.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a58b9319-0d7f-4876-9d7c-8c35b4636dad", "text": "Beyond them lay a city beneath the city.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5eb57722-24e6-4070-b720-cbe6fe7bff4f", "text": "Towers descending instead of rising.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6d672493-f467-4ffe-817a-308413ab9c6e", "text": "Streets filled with black water.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c21ef940-99d4-42d5-92d7-a05db9c9199e", "text": "Figures standing motionless on rooftops, all facing upward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b0568a73-a13b-4002-804d-c09ea83f1702", "text": "Then the vision vanished.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2ba2f618-5619-45c8-83e6-e6cf8433747d", "text": "The wall was only brick again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6acd08ae-0b7b-4ca3-9324-4fbb71142b37", "text": "Enhedu grabbed Zik by the back of his belt and pulled him onward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
