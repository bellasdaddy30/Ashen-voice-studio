[{"id": "8b6ce801-f28b-45b4-a68f-a52e2518820b", "text": "Someone had opened the doorway.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0145b1a6-b875-4c04-91cf-79e4bd14cba4", "text": "Then closed it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "22a6730d-1949-49c6-b8b4-215784c5d411", "text": "Then opened it again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "277d9484-ad4b-463f-9b91-bffad8512a01", "text": "He crossed the chamber and pressed his ear to the bricks.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "04d5b29f-675b-4de6-a87f-3e114651f710", "text": "At first, nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a410f9c7-878d-4b6e-9d60-d21c3f9019db", "text": "Then a low sound moved through the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a56da5e0-2357-4126-80a5-9ee7ba9a0273", "text": "Not water.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "29de41e6-35d3-435f-b203-98c03c42f629", "text": "Breathing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0c4505fa-669f-4d74-af15-ed79969d5272", "text": "Slow.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1d7022b4-1799-4b4c-bc98-86f73bd6f8a0", "text": "Deep.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5229c36c-4017-4078-bb58-aca0687295d4", "text": "Too large to belong to anything standing on the other side of a doorway.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "64e59335-aa60-4d79-83c3-16940b9c475b", "text": "Zik stepped back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "90d1adb0-e0c5-4be6-9fd4-721ecdc63266", "text": "Balag watched his face.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c9c4254d-8b25-432c-9ea8-ee1cdf5ae7f3", "text": "What?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1ce26a21-25f9-4090-a077-b9a58ff718e8", "text": "The wall settles.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6961de96-5e28-426d-b2ff-74c349b3a978", "text": "Walls don't make you look like that.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f79ee4f9-9f6d-4ee3-a96e-ecad161e6424", "text": "This one does.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8883a499-96e6-4498-81c5-fbecf3b4a04f", "text": "Enhedu came beside him and placed two fingers against the bricks.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "30858fe3-1df4-463a-97d8-6265dafab6f4", "text": "The wall inhaled.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "255ed781-9ca5-4793-baba-5ad800dcc5f0", "text": "She removed her hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f1efda8d-0d28-45f5-937e-90b53f98b72f", "text": "We're leaving.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ca722ef3-5603-4b94-ab15-42926b6c198c", "text": "Ninsun was still examining the seal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "038fab21-567b-4ce1-a2ee-abb94d48b257", "text": "We need a rubbing of the boundary stone.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "17687e05-26ae-4e5f-9e98-7437ecaef463", "text": "We need distance.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8a5e3038-5cb6-4045-a12a-c5b80637e8ed", "text": "One minute.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9e18bb48-9a87-4642-8ecd-cd211e963719", "text": "You have half.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2073555e-edb4-40d2-ac42-cac4b6e12232", "text": "Ninsun moved quickly. She placed a thin sheet of damp parchment across the painted stone and rubbed charcoal over the surface.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a147de24-2299-4d9f-9229-42d736aa2f56", "text": "At first, nothing appeared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c0cc783e-e56c-4c80-bfab-16425231df78", "text": "Then pale lines emerged beneath the black.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b858cd09-67a9-4495-ad20-b8d061fef149", "text": "Not writing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "64c92121-1b54-4aa0-9243-a003a3b05d0d", "text": "A plan.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3b1d5d8c-a23f-4ca1-bd06-ffd1c846fcb7", "text": "Four streets arranged around a central square.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ad3a986c-2f54-45e5-9d82-5cf3453ab04c", "text": "The chamber they occupied was marked at the edge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1235de5d-7cb3-41c2-8935-afca3e3ca883", "text": "Beneath it, another shape had been drawn.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "469328b3-7531-43a6-ad76-4111bcf8bd6c", "text": "A circle divided by seven lines.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "252de42a-743c-41ae-b58a-a674057a38a6", "text": "Zik crouched beside her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "537068e7-acf2-45c3-8bb7-1bb2610478ab", "text": "That isn't a district map.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0d2c5e5b-0373-4dd4-ba67-de2a7bd9bde6", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6f893ed6-fcdb-4ccb-83b8-5d243b8ffab3", "text": "What is it?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7122a481-ac00-4399-afd6-2639e4d39b97", "text": "Ninsun stared at the seven divisions.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9196c43f-c8d5-47f0-8ecc-e653c878b316", "text": "A gate plan.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7c8e0aa8-d49a-4fa7-bdfc-de8433f0ac09", "text": "The mark beneath Zik's linen burned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "912017ad-ea6a-496c-9bbb-7d9576e17cfc", "text": "He clenched his fist.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "87dc0eaf-e306-46b0-8fb4-5c3fa72eb9f4", "text": "The blocked doorway gave a soft knock.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2f927be9-464a-494c-b3f8-90470e13d47f", "text": "Once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "559f90b5-6fed-4a3d-bfcf-c4b5e188d377", "text": "Balag lifted his spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e716d45e-79d5-4ec5-a169-fcd749e34172", "text": "A second knock followed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fe7fbc42-4df6-4b62-8151-e760ab29b2f6", "text": "Lower this time.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f55d54c1-9445-42cb-9f58-1559a46fe455", "text": "Closer to the floor.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
