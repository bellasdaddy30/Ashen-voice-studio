[{"id": "1fce7509-ee64-41f2-8a15-d777ed790e2f", "text": "You noticed the soot.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "20f4e5cd-0a68-48fe-b0df-6f850bce505a", "text": "I noticed you noticed the mortar.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8bde4942-a908-46fa-836f-aa2016741b80", "text": "That sounded almost like praise.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fa300cf2-27bf-4638-a4a0-9b8a136d1808", "text": "It wasn't.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "835b577c-f6c4-457a-a3c4-800e0f8e4897", "text": "Good. I'd hate to misrecord it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b440dae8-5fbd-41a4-a064-b336947a91f3", "text": "They kept going.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9ec8d8ae-d1a4-4f8f-b11b-c39d22b77b07", "text": "The passage widened just enough for Balag to lower his spear. The floor changed beneath their boots. Packed earth became fitted stone, each slab cut in a long narrow rectangle and laid with a precision the city above no longer bothered to imitate.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3e79540b-1b7e-470a-9b23-b87ccb69ccc4", "text": "Enhedu crouched.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "69015bac-c7a2-43b9-9456-cd7adf991bc3", "text": "There are marks here.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8bf45b10-a484-49ab-abb5-e2e97d1ea334", "text": "Zik joined her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fc8f0ef9-7092-467b-9fea-40757b3ed0d8", "text": "At first he saw only scratches. Then the pattern resolved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f9cd7e54-4249-4e0a-b96c-f714d57018e7", "text": "Parallel grooves ran along the edges of the slabs, shallow but regular.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9236b35a-ce4a-44a5-9fd4-034136b95e00", "text": "Drag marks,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c2116568-3502-4565-bc6e-28750ca1851b", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "6afe5103-c687-4a10-9ce6-d3c075be2864", "text": "Too even,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "37c2425b-2b01-407a-8f65-25eb52b5032b", "text": "Zik answered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "27db9670-f7e3-452c-8aca-cfbefdc39323", "text": "Ninsun lowered the lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d115b524-535f-4c1d-b930-ebd734394163", "text": "The light caught a second set of grooves crossing the first.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "61af3dec-af53-4b67-8258-f58f84a15b86", "text": "A cart route?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "910bd847-b53a-405e-b944-41e777feb068", "text": "Underground?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f38f6e86-38a2-4ddc-ab9a-b43351f2e6df", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "9ab4a86d-f359-4bc6-bfac-b0ad541723ea", "text": "Zik ran two fingers through the nearest channel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9b2c0fb2-5d22-4726-a126-79759adb897c", "text": "No wheel hubs. No hoof cuts.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cef65b9d-7ff3-4b0e-86c1-e0a098b41867", "text": "He looked along the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4f649a6a-fe88-4868-8504-83eb594419a7", "text": "Something heavy was moved through here repeatedly.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "06925e82-d0e0-4481-a284-8e3a7a03440b", "text": "Balag's gaze went toward the darkness ahead.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2edbd05e-a30d-4249-9de2-2c41c84ce1e3", "text": "Toward us or away?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "db6235fe-ea55-4b5d-a0c9-ed221fdd1511", "text": "The grooves don't say.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "83993713-6644-4939-b1d2-df05a6ff627b", "text": "They should learn.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1a2b7e95-3f34-4587-a4c7-5d6ccacb5569", "text": "Ninsun copied the pattern onto her tablet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "72c81f91-ef6d-4499-aaf0-c4b0dca0dbed", "text": "Enhedu stood and dusted her hands.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c2120fbc-04c2-421a-b600-e0976eec639e", "text": "Maybe the stone was quarried somewhere below and brought up.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "aefa1b8d-02d8-47af-94b2-ff3bc1deebc9", "text": "Then the edges would be chipped,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a2776d53-40c0-4d87-9d41-b1d9a09b5274", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "93bec9bd-6efe-477d-a40c-e5a3f147e4f8", "text": "They aren't.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bcdf3b37-28c1-4e8f-a2e9-6aee381e28a0", "text": "What was moved?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3161111c-03e2-4178-8495-39b6cef0865b", "text": "Zik looked down at the grooves.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e1b3f895-3f4d-4198-b8f6-6b22a8b13306", "text": "Something the builders expected to move again.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5ceae42e-3a74-4599-b3bf-73a52721658e", "text": "A drop of water struck the floor ahead.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "20276896-068a-4a3c-9e87-8d94c8615869", "text": "Then another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a18ff2ed-ffa4-4da5-a816-202d12b4d265", "text": "The sound did not echo correctly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6ff9cb03-d741-40b6-90bb-9268f7ae5079", "text": "It returned twice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "57cbe9fc-b533-41ae-a083-6bfeac46ff02", "text": "Once from the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a875c290-059a-41ee-9e5b-c372850b130a", "text": "Once from somewhere beneath them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4cda8794-0951-489d-a732-d829d71f488c", "text": "Balag heard it too. His grip shifted on the spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "470eea10-f038-4bcb-bfd9-f89e47a00e4d", "text": "Floor's hollow.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9cec8a57-723a-4b06-ace0-971c7ec301bf", "text": "Zik crouched and pressed his palm flat against the stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b4a6ec8-5668-4703-92e8-c1259458dc58", "text": "The mark beneath the linen warmed at once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3ee4180f-cdd7-4755-b99f-38a9bc3c9186", "text": "He pulled his hand away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
