[{"id": "aeb4f908-addb-470b-926e-908b01406398", "text": "Whatever you're looking at, look faster.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ae966486-2ea7-4eb8-9e10-2ba7893b43b8", "text": "They reached the final turn.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fe881f97-d221-4b4b-816c-241e48ae68d5", "text": "The ordinary alley waited ahead, bright with daylight.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dacbeffc-2c43-4461-a22d-bfcfc7e2954b", "text": "Balag crossed first. Ninsun followed, clutching the rubbing and her tablet to her chest. Enhedu pushed Zik through just as something struck the passage behind them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cd68126a-f748-4ffc-9e75-3401a514cb8c", "text": "The impact sent cold air across his back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "769997c9-5955-4a2a-915a-5e8f75a29319", "text": "Then the sound of the dye-works crashed over them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "28aff4c0-f6f4-4ec2-b290-8e2876a57c68", "text": "Workers shouted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "18a219a2-df14-44e9-ba65-1ced6448e7e6", "text": "Vats hissed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a068c72a-c9c9-4a74-af53-afb3646ccaa2", "text": "A donkey kicked at a tether post.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "38a1b293-3228-4df7-a090-9b41e3fb0946", "text": "Zik turned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c274607d-5c6d-4e22-b2fe-269787d9ff07", "text": "The narrow descending passage was gone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d134b6c2-4ea0-4373-b560-ac92bd9222f6", "text": "The warehouse wall stood where it should have been.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "76054705-f0c8-4e50-8787-c33fed380784", "text": "His chalk line remained on the brick.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b4a390af-38d1-4457-b767-ca7df4232cce", "text": "It ran vertically now.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0a8271f0-843c-4962-a149-be92ad8b8b83", "text": "Balag bent over with his hands on his knees.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "544446b5-ee08-40f7-8d3a-526eb7e330f5", "text": "I hate this city.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f10ccb72-badf-4a95-80e4-18efc1a2b900", "text": "You live here,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1a2d0b66-d4ae-430f-866e-103be289905e", "text": "Enhedu said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "019de92c-999c-4ffc-9695-e5a8a63c6940", "text": "I can hate things nearby.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "670d704a-f77c-4656-abbc-37004d83656c", "text": "Ninsun stared at her clay tablet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fa1c29fc-3290-4df7-a2c4-f57493419995", "text": "The copied seam had returned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b02b0769-4e6c-4d8f-99a4-a0988028a9d3", "text": "So had the plan of the chamber.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "167ca139-3d37-482f-9532-904600110d84", "text": "Beneath it, new marks pressed themselves into the wet clay.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3f5c2323-d65c-45d8-a30b-484b737012a7", "text": "No stylus touched them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "033af808-f7d9-4eee-b69a-109221254ab6", "text": "Seven wedges.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "40a7a140-8e1b-4b34-8428-b8c0a3e43a6e", "text": "Then a name.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "39bb6160-2432-45e7-ab83-6eee54c84e0c", "text": "Ninsun read it once and went pale.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9185ddd7-1299-42f6-bc05-ba21c4ce556a", "text": "Zik stepped closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7fa291f5-f83d-4c83-b752-3792c15ccb56", "text": "What does it say?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c149cc59-5b8a-44a4-b9e1-75e295188028", "text": "She turned the tablet toward him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "35d98386-6066-4d0b-b452-2c14e8723731", "text": "The signs were old but legible.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a0f50911-1ee1-4686-a0b1-ec2fe0b236bc", "text": "THE MOUTH REMEMBERS WHAT THE CITY FORGETS.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "2dfd645b-ae72-443b-8da8-9c83b48862d0", "text": "Below the sentence, another line appeared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1efd7fa5-7e27-4964-8d4c-ed14eec0be58", "text": "Four small marks.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f0b4fad8-8173-4de1-81dc-290227f0f23a", "text": "One for each of them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6b911e78-b9c4-4c1f-bc31-1267d86a36c7", "text": "The fourth was incomplete.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3e94208e-987c-43d5-9c83-d3f05849a8d4", "text": "Enhedu fell into step beside Zik when they started walking again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "30892e44-8cb9-4ec1-aebf-45d184916bf7", "text": "Four shares now.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "391ee489-109a-4aa7-811b-a7550222f055", "text": "He glanced at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e9f4f54f-2ac2-4b92-a63c-45829fe1018b", "text": "The scholar's cut,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "13da9d30-f347-4b81-b386-09217d0faf22", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "08b881c8-ff3c-4813-8326-7714d5d9b3fe", "text": "Assuming she doesn't get us all killed chasing blank tablets.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "db1b6a1f-cc1e-42cb-b44f-df74dbf7c181", "text": "Ninsun, walking ahead with Balag, did not turn around.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "76d53cce-d4d9-4feb-9fc6-b3b62021b0a8", "text": "I heard that.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "93c22b74-5a5c-4471-bba4-0af801cf13cb", "text": "You were meant to.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3f7c1edc-b165-4f87-a1a3-0956bedbee58", "text": "Balag looked at the tablet under Ninsun's arm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "278de371-7a85-4867-b1f3-689f452a6135", "text": "I'm less worried about the scholar getting us killed.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "42ec74d1-5792-442e-ac7b-325df4ca6aa9", "text": "What worries you?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "841f8e82-e1a0-4379-88b1-d9a1c98f5bb1", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false}]
