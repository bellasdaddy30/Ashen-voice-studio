[{"id": "9f815554-a01b-4269-b467-78bda3b6dc5c", "text": "Zik stayed near the entrance and listened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "64461bd5-265f-49e0-896e-42d5aeec6fa3", "text": "The city was quiet in the particular way it became when it was paying attention.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "064a7961-a9ca-47aa-8dba-b5302d593332", "text": "No workers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "93742a77-a417-4517-822b-792e625815ce", "text": "No carts.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "074e456a-d152-4d2a-ae71-b29ba326843d", "text": "No voices.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c1483676-f44a-4b35-ad55-14abe6aae41a", "text": "Only the slow drip of water and the faint scrape of Ninsun's stylus against clay.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "946a4c35-6b97-47a8-8e13-cda2165d8f4d", "text": "She crouched over the boundary stone, brushing grit from its edges.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "64c17f2a-7d2d-4d93-b07d-b51e641d57f3", "text": "This district used to have a different name.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d6f812a4-d5ce-46b4-b34b-3ef1c5b1e707", "text": "Which one?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f63f7d28-744e-47c1-9db2-37c35ae13209", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "495a4bf8-62b6-47ce-8dd5-9354ecdacafd", "text": "I don't know.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7fd36bbd-d914-445e-9154-f3c5be7252b5", "text": "That is an inconvenient detail.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7c7078b5-e4cc-4510-969e-8738953860de", "text": "Every copy of the tablet that should have held it is blank.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e00f8aec-e773-4cd2-90e0-93ff15bb7408", "text": "Enhedu, still crouched in the far corner, held up a small flat piece of bronze she had worked free from the dirt.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8243cba0-c354-4a80-b659-86b83612e149", "text": "It was a broken seal impression, the kind used on private contracts. Green corrosion covered one edge. The symbol in the center was only half there, but the remaining curve matched the spiral-drop on Zik's palm exactly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2aa3e6f0-f05b-4136-8442-576822719cf2", "text": "She turned it so the others could see.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "046295ab-8bfe-4086-9f6a-a7a0e0f345b8", "text": "Whoever sealed this place the first time used the same mark you're carrying.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1f2e38a1-af9f-4c18-a914-af4ef4d8fadb", "text": "Zik did not move.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5631076e-d346-4425-8534-b679c1bbf968", "text": "Ninsun crossed the room and took the bronze carefully by its edges.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7ca227a4-6c33-47c0-9a6c-3f61f6f056c5", "text": "Not whoever.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "eecb7f1b-2c04-46a8-aacf-fff125139a9c", "text": "What?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b037f8a9-74ac-4a19-8eba-7daefeec9a74", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "4b6f2a53-754d-4c67-ae20-476e42955e28", "text": "This is an administrative seal.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b30b3612-7228-4bf1-8179-07bac0a23b0a", "text": "Ninsun angled it toward the lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f8fb66eb-d80e-4f31-a3a1-e7ed68e8a1c3", "text": "The border is doubled. Private contracts used a single line. Temple inventories used three.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "684647be-65e7-4abe-89b3-a18c0b779321", "text": "Balag frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f2cbe6fe-c191-4dbc-b790-5b99a018efca", "text": "So?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "de8a76d2-3b54-4d18-8285-46cd30b488d1", "text": "So this belonged to a civic office.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2a82959c-83ec-45ba-89a0-2cdb6869ffa3", "text": "Zik stepped closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d5be12ef-124c-4fba-9f9f-c446264eca0e", "text": "Which office?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e7275bac-a807-4ab6-ac4f-22fd976d6401", "text": "The legend is broken.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ca82358d-1999-45b0-ae51-ce71455c3a35", "text": "Ninsun wiped the bronze gently with the edge of her sleeve.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "78c1aee9-5cc1-4b70-b1fc-9230a8e4cb1f", "text": "Only the final sign remains.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1868a91d-b4ea-421c-88c3-a72f791e00b9", "text": "She stared at it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f78e90fd-9192-4e30-887d-6046e77df1a4", "text": "Her expression changed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f1b037f5-9750-4860-b0a3-df97b4de1dcf", "text": "Enhedu saw it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eb1e424c-1e92-4f4b-b43c-2667e6dd728c", "text": "You recognize it.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "07feaae7-91d8-4eb5-8911-aff40ab99ba1", "text": "I recognize what it might be.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c94e162e-5538-421f-aa14-67146b4f05f6", "text": "Balag sighed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eae4daf0-ec14-42c6-86a4-50fe702206f9", "text": "I dislike sentences built that way.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "94623e97-4376-4cf5-8645-b9e969d5482f", "text": "Ninsun pointed to the surviving wedge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "627a7ccb-b418-42fb-a2aa-5a1205f02781", "text": "This can mean boundary.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8820ee58-9cfb-4a0c-b7c3-89eb73333cce", "text": "That would fit,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c17b70a2-3ad1-405c-ac45-8ba31b6fdf2a", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "3b381f30-1cc3-4613-a6a4-d459349f0558", "text": "It can also mean mouth.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7a2c704d-adfe-42d0-9347-827e29592092", "text": "No one spoke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8c6cc246-ccb5-4ae0-9cb9-8072fb3a0549", "text": "Balag looked toward the blocked doorway.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "29f24e68-8a0b-42f3-8054-dcec70c98fb8", "text": "That fits less.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0494c473-98af-443b-be39-f5bca98c20d2", "text": "Zik studied the brick fill. The oldest courses were near the edges. The center had been rebuilt several times, each layer set over the last rather than removing it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
