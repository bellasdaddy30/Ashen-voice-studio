[{"id": "f446936b-a5ff-400f-b54d-fb3925258823", "text": "Ninsun took the page and held it nearer the vent.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "716a80b4-0a24-452d-9f6c-c01a98a95857", "text": "These measurements were made at different points in the chamber.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "64a69194-3bcc-4fb2-a3dc-07256b26b543", "text": "How can you tell?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "47e1c41e-e744-4d80-be29-02118e158a71", "text": "The notation beside each count. North wall. Central slab. Eastern threshold.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cc1422a6-2e87-4a49-8df9-65834477ef3a", "text": "Her finger moved between them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "af19329b-2c9e-47c6-b31d-7cc7e50b08f1", "text": "He was testing the floor.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "71224b63-4e1d-470e-857f-900fa89c97ec", "text": "Zik remembered Bel-iddin walking the chamber with his head tilted, tapping the stone with the butt of a tool. At the time Zik had assumed his father was looking for cracks.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0e56c11d-e51c-4bbb-a37f-f1545c84c133", "text": "Bel-iddin had been listening.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8bc822f7-e348-4b49-a43e-ddff6b3bd9e8", "text": "Zik turned the page.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "76bae1b8-d2bc-410a-adef-f72caa8fd01b", "text": "One sentence occupied the center.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "edda6e2f-9bc8-413c-b999-54368061b417", "text": "Do not strike the black floor.", "speaker": "Bel-iddin", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Bel-iddin's field notes.", "generated": false},
{"id": "a204185a-8553-40ca-b578-0b463fd3c5a3", "text": "Beneath it, written smaller:", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4c515dda-e140-4ae6-a4e3-024eb0123b18", "text": "Kurash thinks it is stone. Do not let him test it.", "speaker": "Bel-iddin", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Bel-iddin's field notes.", "generated": false},
{"id": "f65c7b32-a935-4b51-bf3b-d224e56caf5d", "text": "Zik read the words twice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1a786c0d-2585-4c4e-a3c1-7a340d8c40ee", "text": "The room narrowed around him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1ce4b58d-ee48-4e0f-8578-f5635896a016", "text": "He remembered Kurash kneeling beside the smooth black surface, dust streaking his beard. He remembered the hammer rising.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "53e7da6b-ade3-4221-ae40-714ec627b68e", "text": "He remembered Bel-iddin shouting.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ca718db4-416e-41b2-a487-ec274f1f5763", "text": "Too late.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "990c640b-ce31-4d56-bdd5-cc32b313d07a", "text": "He remembered the sound that followed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bed354bd-a692-4fa1-8c29-a3e302515b87", "text": "Not a crack.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fba56212-4cf4-478f-986b-02a95ad09683", "text": "An answer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fb9ee90c-4c9a-42c4-aa5e-906769dc2245", "text": "Balag took the page from him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "aabb8aae-9793-4757-bafd-f8751ed326c2", "text": "His eyes stopped at Kurash's name.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d1c44869-3842-41b7-9fa6-edeb36883913", "text": "He knew.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8989d7f5-0d70-42b8-9b6e-471c79694604", "text": "He suspected.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "96a5fd5b-af9a-4d88-b072-1982b415132d", "text": "He wrote the warning.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "46387020-08a3-462d-989c-86fe321eb153", "text": "We don't know when.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "33525796-1950-4d81-86b7-31b42e4cff0c", "text": "Balag placed the page on the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "459e785e-9423-43e2-a83d-586aa3de6a8e", "text": "You always find somewhere to move the blame.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "65cb4324-da62-4e44-b366-a18e0a11fc91", "text": "I was there too.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "69825a8f-10b1-484a-bdf9-fe862b03263e", "text": "Yes.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0516510f-7195-492e-b7c1-a2ad49eede9d", "text": "The word landed without force.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "88e94aba-392a-46b0-86c0-6125ca294644", "text": "It did not need any.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e7fcb34c-74c0-4c68-b91b-b2ac7a6a6644", "text": "Rain whispered against the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4aee2e62-228b-4dc5-86df-afff12086a1a", "text": "Ninsun folded the warning page inward again, then changed her mind and carefully separated it from the binding where the stitching had already come loose.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "95d401a2-f4d2-4186-9865-6c7317a3b103", "text": "We take it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dcd57e82-ab20-4308-8ec5-5d43357dc28b", "text": "It says one thing,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "70a4f82c-dd9f-4148-8baa-dc144e2624a2", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "864ba2c0-a1c4-4dee-a875-7a9bc2b86129", "text": "It says the one thing Kurash needed.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bb1cc240-799c-425d-95d7-7fe59c5ac1b0", "text": "A footstep sounded in the alley below.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "72e25694-9fe4-411b-9739-36c29504b158", "text": "Enhedu extinguished the lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a74f0cdc-6dff-4be6-ab30-a980aef47ff1", "text": "The room went dark.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2793ded5-eb39-4618-a99d-f49ea92a9ecd", "text": "Another footstep.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4c817112-bb28-4116-a528-46d5630a8a00", "text": "Slow.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cdfb89bc-a422-4f9b-8d4f-d59714306817", "text": "Unhurried.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "256c32e8-d2c1-49e9-b9a8-dc2fa5649967", "text": "Then silence.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f9d2abd8-ae6b-4f2f-a599-7f0278d04e1a", "text": "Balag reached for his axe.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2cd570b1-b0df-4257-b10a-c87724e9da66", "text": "Ninsun held the wet clay strip against her chest.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fd20d0d9-bb2f-4425-9bc5-23de16c79479", "text": "Zik slipped one hand into the satchel and pressed his palm against the journal's cover.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
