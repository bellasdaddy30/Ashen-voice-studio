[{"id": "ff45dd41-d5ad-48eb-840f-9e7bbd16a645", "text": "She turned it toward the vent.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "24344cf0-6165-4a8f-9d99-475541afeb8a", "text": "The fourth was added later.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b37fac89-cc22-46e3-8671-ad8c60c5f175", "text": "Balag leaned closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "99145663-4a49-486d-809b-fa1873895d7f", "text": "How much later?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7432eb6d-fbff-4441-97b6-af14a4b2c165", "text": "Long enough for the surface to begin drying.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c81c2c4f-19cd-41fb-9b9e-47559f65fb8b", "text": "What does it mean?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ebf0f86c-edd2-45c6-bf74-1429be7dd4a5", "text": "It means whoever entered wanted us to find it,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3d54c927-bf00-419e-91a3-add36e0faa99", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "91e40c7c-8f14-4de2-89da-576b5e6085cb", "text": "Enhedu checked the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "635b5954-6d25-4967-8d19-ebb653ab9426", "text": "Then let us disappoint them by leaving.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a809cae9-f950-43fd-9ac3-3cb76820a327", "text": "They moved quickly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "16c6893a-cebf-42ed-b9aa-1086287d0522", "text": "Balag laid the equipment across the floor and divided it into piles.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ddec7da8-24af-45ba-bee7-e2d7f75b63cf", "text": "Two ropes. Four lamps. Spare oil. Wooden wedges. Bronze chisels. A hammer. Waterskins. Barley cakes. Dates. Bandages. Resin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7677e329-afb4-48e3-8522-3013b339898c", "text": "He lifted the hammer, glanced at Zik, and set it beside his own pack.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d7eacabb-5557-42df-bae8-e8cf994432b5", "text": "Ninsun added measuring cord, pigments, styluses, two clay tablets, and her copy of Ammaru's vanished ledger entry.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b80d618b-7bea-4f9b-83fa-a0bc682b1f22", "text": "Balag removed one tablet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f3b0f09e-2065-491f-bfa1-b4e0b45f5edb", "text": "She put it back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c38e6865-d453-4a5d-a743-a43b60c86b44", "text": "That is a record.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cc13759b-b993-4fef-92c5-a963d1627673", "text": "That is weight.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "84cf3f65-ab95-4568-87cb-c78cb64bcfec", "text": "It is also mine.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e49190b8-43e9-41bc-8190-0157249dc8c1", "text": "That will become important when you ask me to carry it.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c2ede245-6645-4a2f-b82b-ae0990b6a34e", "text": "I will not ask.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2d9aec62-99c1-49da-b902-1297373caeb7", "text": "You will place it beside my pack and stare.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7873f860-35e3-4195-87a9-bddacc8c61f7", "text": "That has worked before.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "64763a59-31d9-4bdb-9e31-4cd29ac6d238", "text": "Enhedu packed knives, wax, cord, two mirrors, a narrow saw, three hooks, and several tools Zik could not identify.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6b804da8-1bbe-418f-aad3-e5f043d6d378", "text": "He pointed at one.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3fa25c51-126e-42d9-8275-bf18b07fda21", "text": "What is that?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7481eab3-0d0d-4678-8102-a8a6b1f56a5b", "text": "For locks.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1a119c57-a0aa-409c-a779-e012add8bea0", "text": "It has teeth.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "382ece4e-62d4-4def-99a4-348403ea77b6", "text": "Some locks require persuasion.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e2c946c7-3024-4ccc-ab47-260530e6e6c8", "text": "Zik lifted Bel-iddin's field notes from beneath the cloth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5c16c28d-d36b-4123-a1aa-cf97007449b7", "text": "Near the back, several pages had been folded inward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "284d528b-7842-4617-b1cf-e363c87da9fb", "text": "He had seen the creases before but assumed they marked damaged sections. Now he opened the first fold carefully.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "30abc15c-5853-4246-941b-c07c765d97e2", "text": "A plan of the tomb filled the page.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6d384f41-88ab-4015-9c0a-2bd12e0bdef5", "text": "The burial chamber occupied the center, drawn in his father's precise hand. The entrance passage extended from one side. The shaft where Kurash had fallen was marked with a small cross.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "12c71834-dc97-427b-a860-996be35f2acf", "text": "Beneath the burial chamber, Bel-iddin had drawn another room.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bf5e2a16-ad17-49b0-98e0-a4ee6f7242eb", "text": "Then crossed it out.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "261925b6-df40-49b7-99ac-19baa86e58a4", "text": "Below that was a second.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "73b7b0c0-e0c9-42cf-85c3-fb3096367dc8", "text": "Then a third.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f63792df-cf88-4953-8c72-c886904f3472", "text": "Six chambers descended beneath the one they had entered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "44438ad6-ab1d-4d74-b2ba-8616255a1cda", "text": "Each was narrower than the level above it. Not stacked cleanly, but offset around a central vertical line, as though arranged along a buried spine.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "937191fa-1435-4ccc-9469-13b76352c8ff", "text": "At the bottom of the page, Bel-iddin had written:", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "06942f0a-7ce0-461c-8a4e-b30336599cde", "text": "Sound returned after seven counts.", "speaker": "Bel-iddin", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Bel-iddin's field notes.", "generated": false},
{"id": "bf703bbc-91e4-4af3-a95e-05cded2b4af8", "text": "Ninsun read over Zik's shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6715e9f4-fb39-4259-87e0-e42000b4043d", "text": "He heard a void beneath the floor.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c3f5f701-9734-454b-b9f6-5d62f03bbd8f", "text": "He heard several.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ae6ea8be-b762-4c27-86b4-b98d5cd7456f", "text": "Or the same void at changing depths.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7e3816c4-fba6-49c4-b1c7-3f7843c042c5", "text": "Balag tightened a rope bundle.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "39157668-a3b6-4d50-b688-93ec087f8a8b", "text": "That is not better.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
