[{"id": "98521467-7a20-459b-bf7e-0c9beb5a6c24", "text": "A bundle of onions dropped from its hook.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1e54bb55-a1a8-47c8-9634-3295e8c9c7a7", "text": "The boy cursed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "40586fb2-dd6a-4896-ba2a-6bed85c6bfdf", "text": "The cook turned from the hearth with a ladle raised like a weapon.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "223650d6-e16e-4196-bd04-5f2c381d7028", "text": "Out.", "speaker": "Inn Cook", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e7d77a68-fe08-47d5-9264-1371f6dd369a", "text": "Already doing that,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b99336a0-347e-4368-b196-460cc8621c52", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "057df06c-6332-4dc5-9f5b-0564ed97239c", "text": "Something struck the courtyard wall behind them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6b28b2bf-b60b-4d8f-9686-7a07fe287826", "text": "Stone against stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "45b20b51-f522-414f-b7c2-a9737639d571", "text": "The pans overhead rang softly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "df8937d1-2cb1-4907-ad82-ca00565c28f5", "text": "The cook looked toward the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f5c525cc-d2e8-47a3-b3a9-c982bf0c298b", "text": "What was that?", "speaker": "Inn Cook", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8f9862bc-bfd4-4f19-801f-758a53510ed3", "text": "Renovation,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dc0540e8-a1c8-447e-9fdf-7ea216f1e742", "text": "Enhedu said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "45b8ac66-0560-4437-a8e5-bf440ecb1f58", "text": "They pushed through the crowded front room and into the street.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5d3ba767-6362-4e5b-9fd8-0e2216c7c1e0", "text": "Wet evening air closed around them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eca1be4a-55e2-4877-90c4-a4279da7e2da", "text": "Merchants folded awnings beneath the rain. Donkeys crowded beneath overhangs and snapped at one another over dry ground. Two children splashed through the gutter while their mother shouted threats neither appeared to believe.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2a2503de-69f8-4587-b01e-94627ef56d24", "text": "Behind the inn's shutters, stone struck stone again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "571555dc-a546-49ff-bade-b553a9806ce5", "text": "Deeper this time.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "96901ab2-bbf2-4466-8986-70bf99d5be4d", "text": "A grinding impact that Zik felt through the street beneath his sandals.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "588f8bb2-579e-4f8c-9a6a-6f16f927e035", "text": "No one turned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f140f1f1-35f3-4d12-a6d9-f4f18e7f6df6", "text": "No one stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3317af3b-07dc-4a23-b1d0-74d8f9d858d3", "text": "A wine seller continued arguing over the price of a jar. A porter shoved past them with a basket balanced on his shoulders. A priest lifted his robe to avoid the gutter and stepped directly into a puddle.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "42d5332c-49e6-4e8e-a136-28a73ab1e087", "text": "Balag looked back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f8c8ba0c-51c2-4f51-838b-a9c9e5f850a1", "text": "That bothers me more.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "286e2298-2f4c-48bd-bb02-5fbbd293b36a", "text": "What?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b5ceea63-cdc5-438d-9145-f27f21e096fe", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "0184dbcd-42b6-469d-bf12-49260c94d7af", "text": "That nobody noticed.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b2732d7d-083d-4a01-9f0c-b7b6c16e9a65", "text": "Uruk has high standards for public disturbances.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f93b35d9-8d03-43df-90a3-efac674fe5e0", "text": "The satchel shifted against Zik's hip.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "52df70ee-25f0-489d-8c43-6fc4297f3322", "text": "He pressed his arm against it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a55ac233-823d-49be-9cf8-c6762b1b5b09", "text": "The leather went still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bac4af06-987a-4b41-b198-4ab9a4ca82ea", "text": "The room,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9a86593d-f083-4915-b911-d1381494bf38", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "a456ed4e-7b80-45d0-b872-ba4375051bc6", "text": "We take what we can carry, then leave through the drainage breach beneath the old lime kilns.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4cb1d53c-ba0b-4b32-8360-89972f81321d", "text": "The east gate will be closed,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "94664b5f-13da-4d29-b08a-19caada2c6a4", "text": "Ninsun said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "8b25db9b-d19f-4070-a46f-569a4c4fc660", "text": "That is why we are not using it.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "621b2663-1e0d-4263-bcce-57fad3c515df", "text": "Balag adjusted the axe on his shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ba0deea2-b073-473f-99d7-0cf80151e69e", "text": "You know a great many illegal exits.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "67c7ba1e-0b05-4f0f-b35e-4f4c75627d8c", "text": "I have been asked to leave several places without assistance.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "410856a3-eb61-47ff-8e1d-2219d0572a19", "text": "They entered the crowd.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "47da76d6-38ac-491d-9576-aca58c8d869a", "text": "Zik kept them beneath the awnings where possible, though the rain had already darkened their robes. They crossed the potters' quarter, passed the shuttered stalls near the fish market, and turned west through lanes that narrowed as they approached the outer districts.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c2428735-81f4-4fb5-962c-bfae613f8b75", "text": "The journal did not knock again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9b09bf21-2530-4ae6-b37a-13821aba0378", "text": "That made Zik trust it less.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ec5f471a-53cf-401b-8577-7ba3572e860c", "text": "Their rented room stood three districts away. By the time they reached the alley behind it, the rain had weakened to a fine mist.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e382c8bb-35e5-4e8a-8027-bb565a0e90b4", "text": "Zik stopped before the corner.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9f95fb73-c116-47e5-a4a2-a368c696d0b1", "text": "The door appeared undisturbed. The upper shutter remained closed. No guards waited beneath the awnings. No temple scribes pretended to study wax tablets.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1480a34a-1bed-404e-8c91-e3fb326504b6", "text": "Enhedu studied the building.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7a09a56c-30ed-482a-8c23-7eedc572d31c", "text": "Again.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
