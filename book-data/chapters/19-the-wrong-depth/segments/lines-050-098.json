[{"id": "24e1e4d2-c8f0-4e3b-9cd7-f858d6432e36", "text": "Balag pushed away from the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d6839cfc-b625-48fe-84b7-0984de24e5f6", "text": "Did anyone follow you back?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d557cf57-1476-4c5b-8fa4-e9580c2220fd", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a4ac8b36-4a6b-45f7-81de-12c06a823869", "text": "Enhedu looked toward the entrance.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f698a41c-3095-4de3-ad1c-f8d2d03bc969", "text": "You are certain?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0fd322ee-7946-4e83-a05e-e257c4b3e9eb", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d27debc0-31e8-4813-a80a-127e263fdd1b", "text": "Better.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "26f2a6ea-016a-43bc-8adf-14aee2c099d7", "text": "Zik placed the satchel on the table but kept one hand on it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "776c8c4d-0271-4ca4-8593-61859a6a0ce4", "text": "The crew leaves before dawn.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "37db41c2-6d78-4e42-946c-45a0bb039a0c", "text": "Balag did not move.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eedf2711-cb1f-46e5-8733-5dad1797a13f", "text": "The crew?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5b950986-e8b7-4249-a296-38e22388f034", "text": "The four of us.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4f6a004f-bf03-498a-ac80-3a69ab410eb6", "text": "You make that sound settled.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ed13ec4b-69e8-4b4d-ac1b-f044e772fe4b", "text": "It became settled when the Collector told me not to go.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f77d39fd-28c0-407e-82ea-02a420041641", "text": "That is not how warnings work.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "66d809aa-26c9-49b8-a842-9b06b4b75430", "text": "It is how his warnings work.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2fae61a8-af3d-4ecf-a63d-88b79f93c107", "text": "Ninsun drew her copied notes into a stack.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a9e1da6b-149f-412e-abdf-24eff05b6dd0", "text": "We return to the tomb, locate the seventh access, and determine whether the lower chambers correspond to the map.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3681ebe1-6333-4a17-a39d-0a8d41829478", "text": "Balag looked at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "62defcdc-efb3-481d-be5e-d2d9156e1944", "text": "You say that as though the map is a survey and not something drawn by a dead man's skin.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b6f8f698-3b11-43a0-8bbe-9a4b23e5f021", "text": "The material is irrelevant to the accuracy.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "305c528b-d4b6-46ce-8348-1698b5a4efc2", "text": "The material had scars.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "207b4556-f65d-4d8b-af2d-9350337c22de", "text": "Yes.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d0a430c1-96ea-4497-872e-246fa478ec81", "text": "And pores.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "31da478b-2452-4380-9397-896553111618", "text": "Yes.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4b1ed2a4-abd5-430e-a405-31763232a3e0", "text": "And at one point, presumably, opinions.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bed46079-e651-43c8-9fe8-7b9b8c496915", "text": "Ninsun considered that.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e1501073-8556-4e5e-8f8d-748cf0c844ca", "text": "The opinions are irrelevant to the accuracy.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1ed915a0-6063-4091-9448-215a806ab382", "text": "Enhedu gestured toward the journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "96304e54-e9f0-40cf-b848-638f7a53a1f6", "text": "You are both assuming it wants us to reach the lower chamber.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c50f55fc-501e-4fab-b133-c37139fab0c6", "text": "I am assuming nothing,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f04158b7-02af-4c0a-8123-a81bf1d66a20", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "b7b5d6a5-7ddc-42f3-b046-b37261112053", "text": "You intend to follow the road it drew.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cb447ff1-dc08-475c-9947-4ec03d11a3e1", "text": "I intend to reach the site before the Collector does.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b1b1a55b-73ab-445a-ac5e-c94faff4d98d", "text": "You think he needs the map?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "815869e2-d884-45f5-b5d0-23c5edf73a50", "text": "I think he may already know where it leads.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3294b612-bb38-487c-b30a-d03b86aef2a4", "text": "Balag turned toward the courtyard entrance.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f4f9cdc0-1ff8-4c58-97fe-67dd4dc851b3", "text": "The musician who had been sitting beneath the awning was gone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "64471486-9c9f-4d19-834a-56eac0b74081", "text": "His reed pipe remained beside the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ec376a7b-4b71-4bd7-be70-ecf0062ce9d1", "text": "Balag stared at it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "933d7d80-44a7-4490-a28c-9e91775fdb99", "text": "He left his instrument.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "61cc0b46-f659-4339-80fb-ceb667b355d9", "text": "Enhedu glanced over.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f01a5088-c8df-4e26-831d-49aab135491b", "text": "Perhaps he finally heard himself.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "58907142-de47-45d5-a57d-fa5042ef0486", "text": "He was there when Zik entered.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "83891e60-16f7-4cb1-9cbf-1cc294f99588", "text": "So?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "48e66140-487e-4338-aadc-8d549307f948", "text": "I did not see him leave.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ad49e54d-1acc-4607-abc7-a6c354b1eaeb", "text": "The reed pipe lay where the musician had placed it, sheltered from the rain beneath a shallow niche. A few drops clung to its polished surface. The stool beside it was still angled toward the courtyard.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6022e799-5fcf-4b3a-9c00-c22a5eace4bf", "text": "Zik looked at the alley beyond the entrance.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "92846470-9f68-4489-8bd7-f3403f818c63", "text": "People moved past beneath cloaks and woven mats. A porter hurried after a donkey carrying twice its own width in bundled reeds. A woman held a clay bowl above her head as though the rain had chosen her personally.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
