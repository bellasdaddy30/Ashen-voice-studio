[{"id": "b7ec4f86-3729-4eb5-a8c1-53fdb3b5dff6", "text": "No musician appeared among them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d00f2498-505c-4659-a1e3-f7b761e7e48b", "text": "Zik had told himself the answer beneath Uruk might have been imagination.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bd818de0-68b3-4bd2-9a13-3d6201f842f0", "text": "The mark had burned. The journal had moved. The city had continued around him as though nothing had happened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8fd7fb80-73b8-4c59-b780-0a7e2f768420", "text": "He had almost believed that meant nothing had.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0060aa3f-3a15-4eeb-8bc6-4962136a890b", "text": "The journal shifted beneath his hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "55995105-0bc7-4f5d-b876-2658525b1033", "text": "The cover lifted slightly against his palm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3331011d-4bec-4309-874b-209bddd8bf12", "text": "Zik pressed it down.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "47ba4637-0590-49df-9d60-63a9c00d7288", "text": "Ninsun saw.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7e32f460-88de-4809-a3f7-fc6cf9e59018", "text": "It has already decided where it wants you.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "616f0b41-9ecd-48e8-a365-0a12ca4233dd", "text": "That does not mean I have to obey.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c2d1b785-51f3-496e-b540-cbf759a9b892", "text": "You returned here carrying it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5a694244-bd9e-474b-bdb4-5d5ff15a9dbb", "text": "I considered leaving it with my mother.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "91b8b367-648f-40f2-8805-c7da91e17f3a", "text": "Balag looked at him sharply.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1a0fbb09-1e03-497a-ad0f-71b65ea92554", "text": "You took that thing into her house?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8cf1cc2d-b274-4794-bcf0-d941c58e185d", "text": "I did not open it near her.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "66a466e3-0402-4228-9d7a-80f75a5b9aa2", "text": "That is a distinction only you would find reassuring.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ffdb1c34-f99c-4305-bcce-587947f3c79c", "text": "The journal pushed against Zik's hand again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4e248271-07fd-41c1-a99a-732b638d10d0", "text": "Not upward this time.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "40c07836-6268-412f-a74c-7de776ec981e", "text": "Inward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "261fc72f-4758-4ea5-acfc-01c21c37f29a", "text": "Something struck the inside of the cover.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ecd33e35-4f33-4975-868e-8dd63e720812", "text": "Thump.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d12c7d7c-0d05-4517-8929-58976ac3b4b8", "text": "The sound traveled through the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8f128a5a-7a76-4e0f-a383-c869daf68027", "text": "The carters near the well stopped their game.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b927546-c9c5-4d7d-959b-5ceddf2cc007", "text": "One of them looked toward Zik's group, then quickly back at the knucklebones.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3d9fa882-2ee0-4418-a800-a184896405e8", "text": "The journal knocked again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9e77a8a7-f5e8-4a30-8959-4debef1f9a9d", "text": "Thump.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "94527403-bc68-4af9-a736-dfd892be94ab", "text": "Enhedu rose from her stool.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c92f5981-e0e9-4f76-b4b1-d0a45f426d18", "text": "Balag stepped closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "850ded52-d4da-47a4-80e5-5a48c5fb1ad0", "text": "What is it doing?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9b7cdbca-014e-402c-9bb4-d0d877cea569", "text": "Zik reached for the satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bd38b452-f141-4b69-aec7-505a8db5c47b", "text": "I don't know.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0b17e4d0-db90-42fd-b7be-f0c68940b582", "text": "That answer,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a49be13b-1fa7-4652-a24f-93306d2e8379", "text": "Ninsun said,", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "0abd5383-44bc-465e-b1c8-28108ea0d9dd", "text": "has become exhausting.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3ea781f9-531c-484d-afed-763d4b684e78", "text": "The journal struck the table twice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "09015f62-d30c-41df-bb30-93f0148b2680", "text": "Thump.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "230c679b-3ba0-4d2f-986a-faa3345d94d7", "text": "Thump.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5ed30fce-111e-4c2f-b3cb-da2655fef033", "text": "The lamp flame shivered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9024b1ec-3471-4d37-8800-a1bf2bd5671f", "text": "Not from the wind. The air beneath the canopy was still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "63f9f7fa-2d9a-467a-90fc-aea54abc1d3b", "text": "Balag placed his palm against the courtyard wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4d2b8ae7-88df-4a3d-83c1-29f4d81a4e0f", "text": "He pulled it back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "acb5a16d-141c-4d2b-8b69-51578052d02e", "text": "The stone is warm.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "58744fed-8864-477d-9677-39bba6e6aec0", "text": "Enhedu crossed to him and touched the masonry with two fingers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d1b8c2c2-9928-4c79-a9cc-1648d9c9e851", "text": "This wall faces the alley.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3ac5520f-9910-4d5d-888c-2a3f9ee6073d", "text": "It was cold when we arrived,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "499c53d7-4cad-47b2-8fe5-9188dcd12611", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "10e35bf7-e0d4-40e8-8ae3-58fd3f591aac", "text": "Rainwater struck the paving stones near its base.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "60f36fd5-6951-4ec0-be69-931456707de2", "text": "The droplets did not spread.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ec7c926a-15d8-420d-86cc-049cdd68d0a3", "text": "They trembled where they landed, then began to creep sideways.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
