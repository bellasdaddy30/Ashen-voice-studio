[{"id": "6ffb44a4-cc4b-4ec1-8f1b-fae846b09b8f", "text": "CHAPTER 19", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "f03e4696-ff78-4eac-9040-28a24ed566ec", "text": "The Wrong Depth", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "b71bb8ca-c752-451d-98e6-cc4569a77cf2", "text": "By the time Zik returned to the inn, the rain had begun.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "53734901-cc5e-42d9-9412-69ccf73eb315", "text": "It tapped against the reed canopy stretched above the courtyard and ran in silver threads from its sagging edges. The basin beside the well had already overflowed, sending a narrow stream across the paving stones. Two carters sat beneath the driest corner, moving painted knucklebones through a game neither appeared to be winning.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "94827662-c542-451b-89c0-1f7bbbea7d07", "text": "Ninsun had covered the table with notes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "aea4f3ed-5dcc-4ec8-ae5c-e2cc0354902c", "text": "Copies of Ammaru's vanished entry lay beside her sketch of the impossible map. She had weighted each corner with a cup, a lamp, or one of Balag's knives. Enhedu sat sideways on a stool, watching the courtyard entrance. Balag stood beside the wall with his arms crossed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "70dc9a10-b8fa-426b-9483-4a06c783cb2d", "text": "All three looked at Zik when he entered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6001ac5a-e37d-4a0b-99fd-3acdcb5a3cd7", "text": "Balag's gaze dropped to the satchel pressed against his ribs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e926b157-f2a3-4e92-9cdf-57563ab23fa9", "text": "You took your time.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "19791e3f-8d73-428f-9c39-9964ca76b337", "text": "I was followed.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "513326ab-acf6-4426-a9fd-1fb18c0f6778", "text": "Enhedu straightened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b75dd039-d1b9-4e88-b65e-6c789e806b22", "text": "By whom?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e36d07b5-4dde-4714-94ad-0039bc1e9f98", "text": "A temple scribe.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4cc0de4a-1c1e-46f1-b177-f78a48e39c59", "text": "That is disappointing. I had hoped for someone competent.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1da8fb36-4925-4025-bcf2-0a30774c2846", "text": "He carried a message from the Collector.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7af59628-87c8-4abc-8782-4c222cbb8654", "text": "Ninsun set down her stylus.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "33d51b4d-860b-49cf-b75a-f737c4e479b4", "text": "What message?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "19d5b16f-f013-4497-822a-feeadc09cc12", "text": "He wants the journal.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d36a974e-b707-4fc4-8422-f672aec3b938", "text": "The rain struck harder against the canopy.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b809cbb5-cb69-4b7b-8328-c75ff1413b17", "text": "Balag glanced toward the satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6ecbce36-d3ee-4fe7-94e4-1f02da35452e", "text": "He knows about it?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0dca0695-df37-459c-a4ef-6cf9e188f0b5", "text": "He knows enough to offer ten times what he paid earlier.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "eb40c9cd-be95-4f6b-9ce9-bf33ac29753c", "text": "For the journal specifically?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e4a9a1a3-ff62-48c2-8be4-9cd3feabdc6c", "text": "Ninsun asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "1e0e3893-5571-497f-bfa3-0839e688daa2", "text": "Yes.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fabf2907-4795-4b59-b491-dfac62fa86af", "text": "And you refused.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2c6c69e2-ede6-43e6-b9e6-1c934ae9675a", "text": "Zik pulled out a stool.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "68900b4e-aa6e-4896-b0dd-68ecd2513f3b", "text": "I was overcome by professional pride.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bf526289-1f19-4dde-84cb-783267e0c508", "text": "You own none.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ac57eb28-ffd9-445a-92fc-f9a26a1164f9", "text": "I borrow it for negotiations.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3e4a595a-213b-4c8a-977e-6c6d52e90ee7", "text": "Enhedu leaned forward, forearms on her knees.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8659701f-5621-4a2d-80a3-571eb13c6069", "text": "What else did the scribe say?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "14bdf304-177a-47f9-8229-62d9f4c6486c", "text": "That we shouldn't return to the site.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "83215279-7c04-4094-a747-c6d27788ad34", "text": "Balag's expression remained flat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0f549c94-bb87-4a6d-b382-237c74320fe7", "text": "For once, the Collector and I agree.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a58926c7-ffb9-4ca1-ba57-e8b1824b610e", "text": "He also said the mark announces itself to people who have seen it before.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3eb1efdd-ecc4-4c2c-b9d7-630d0e843b51", "text": "Ninsun's eyes dropped immediately to Zik's hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "644b5770-277d-42f0-90b4-27177e93affd", "text": "The discoloration beneath his palm had faded until it resembled the shadow of an old scar. Zik could still feel it pulsing. The sensation had not stopped since the answer beneath the city.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "56da9e14-46ad-46e2-9371-c0ebf571c60b", "text": "He recognized it?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a60adba5-9998-4b20-92de-aa0b54db7a2e", "text": "she asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "63544879-c540-4dbd-a319-9a2d956b1374", "text": "The scribe did not say.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b39cb5bb-4b81-40d9-a37c-1432161ad7ef", "text": "But the Collector has seen it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "79f98658-1c02-4448-9e08-835928f2b087", "text": "That was the implication.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5e139f97-a6a9-4f87-8f8d-7ae614d3eeb1", "text": "Ninsun reached across the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e4b1d7ff-4fbb-432a-9df7-692b6e4b1558", "text": "Zik pulled his hand away before she touched him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5a613a49-45c9-4bef-8966-d07380835aaf", "text": "I am not going to scrape it.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ee7f8ba7-26b0-4d95-a974-38e063819259", "text": "That is exactly what a man says when he knows I intend to scrape something.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ed9587b9-5b94-4720-aa8f-104e66abe047", "text": "You may document it without removing any part of me.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f969765e-f1e3-4ca1-aaaa-0fd2c08f525f", "text": "Your objection is noted.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
