[{"id": "919df97e-29c7-412d-82d4-6fda75c5d19b", "text": "Finally she touched the last impression.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8718e080-4c09-43e4-a274-b2b41c82c729", "text": "And then…", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "50a82ad3-194a-45f0-b68a-57fd4499914f", "text": "She looked up.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "422cdfe1-0d15-4902-a514-011808662141", "text": "…it disappears.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2beddcf7-e476-46b6-aa38-47062ddd2805", "text": "Zik's eyes remained fixed on the clay.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fd04ad4b-b653-4a51-b178-404555810af7", "text": "But the kings are still there.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "166c42b8-8932-4f87-a538-93e37e8ad6ba", "text": "The kings survive.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a47e54e0-c768-40be-8b22-5e57e5f1e76d", "text": "The symbol doesn't.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c7f676c5-6d5d-4596-beda-092a39028fdb", "text": "The official symbol doesn't.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "77c99ae2-ad49-4d3a-8032-263b7af74453", "text": "He looked at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ac215c66-21f8-4626-a2ea-562439de3bac", "text": "You think someone erased it.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1077a8ff-1d7c-411a-8685-1082065f1f3d", "text": "I know someone erased it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4786e4c6-71aa-40d9-a772-d96199ede490", "text": "How?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6a959c66-162d-47d6-b07d-39dbe08c927b", "text": "I've spent four years copying tablets that no longer agree with tablets copied twenty years earlier.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2a148670-3a29-4286-a4b8-f4638c8bd32b", "text": "Balag frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a9c732a7-a08a-41cc-b19a-d34c730f89da", "text": "People make mistakes.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "993e1b70-d67a-4912-b79c-f95063aefcf9", "text": "Scribes do.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a0fad81f-9816-49e2-bb26-a4a1f944b997", "text": "Ninsun nodded.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f2fc612a-2331-4765-a141-eaad1227107b", "text": "Kings don't allow the same mistake on three hundred different tablets.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f6c0e1e7-7693-408f-9d01-5bdbc32f328f", "text": "She reached beneath the table again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0d0663dc-c33b-42dc-976e-34954690297d", "text": "This time she produced a broken fragment no larger than her palm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f4f2e465-56ad-490c-9edf-620a2fd0806a", "text": "The temple archives catalogued this as an inventory.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f874cb29-775c-447e-ac29-97f7a7034382", "text": "It isn't?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "012d9207-694a-428e-badc-c0479b518d27", "text": "It is.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "26994aec-da53-4f15-9d72-40fe9d4254b0", "text": "She turned it over.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "edf70a91-eec8-4a24-a71f-9a7ccb35014a", "text": "The reverse side carried faint scratches.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8e7aa36e-4f5b-4dad-955b-8fcb6d0c6d2a", "text": "Not cuneiform.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e2a88aeb-56e1-4458-8483-43f551eda403", "text": "Something older.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0a4a5b29-1c0e-488a-986b-1b4313b8634b", "text": "The same spiral.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "65045f9f-da08-400f-9a16-891c11c4d49a", "text": "Zik stared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "56e889e7-bbd5-4f69-a8bc-0948a49ca292", "text": "I've seen that carving.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4296cd2d-66fd-46a0-a91f-9e49418ec5f6", "text": "I know.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "62a7ba92-929e-46c1-8090-89d5fa2d6ee9", "text": "In the tomb.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fda636ed-bd6d-4c96-a6df-b0df0bab95a4", "text": "I know.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0a1ecab0-18d4-472a-afd9-3ca177534d4d", "text": "He looked up sharply.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bda4fb32-27d3-4869-b305-1e45a22e5d26", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f609d380-c75f-4144-ac81-bb1bc07a30c9", "text": "You don't know.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b8dd8d9a-b3ea-4771-8ff6-266f480e498a", "text": "I do.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "816561ff-ba7f-41d7-9ea7-4264f869d68f", "text": "You couldn't.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "907fa89b-8c65-4f07-9ec4-da95898f6e9c", "text": "I couldn't…", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "71d826f9-a575-420d-997f-1765c1d63cb2", "text": "She smiled for the first time.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fbf0754a-8901-4878-98c6-205619dcd1be", "text": "It wasn't pleasant.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8febb6a5-97e7-4633-b56d-e72a3c8a1aaa", "text": "…unless I've been following exactly the same trail as your father.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ad524c8e-cef0-45d2-bf1b-eeead2bb94c0", "text": "The room became very quiet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a54a8927-37cf-4a3c-a571-c0058308d93d", "text": "Even the lamp seemed smaller.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2106b866-0b62-4755-9408-0442b6c45007", "text": "Balag looked at Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6aa7212b-9754-40e7-9d49-5451c0ffd61d", "text": "You never mentioned your father.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "60ff5aca-75a3-4969-a94c-e797bd5a7645", "text": "I didn't.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "54e0ca20-fd9b-4aa8-8166-3b49fee80a65", "text": "Ninsun's eyes stayed on him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
