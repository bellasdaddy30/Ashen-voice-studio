[{"id": "e70280ab-1516-43f1-b241-9003cbc8bc24", "text": "They are.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c03baed9-0d36-4a48-8a54-e584f7f34fb6", "text": "Ninsun pointed to the first impression.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3cbcda48-bbc5-40e9-a39f-449f72923c18", "text": "This belongs to King Lugal-Ane.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "940e57b6-ce96-45b7-9cec-96ade0c160dc", "text": "Her finger moved to the next.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "08d377a9-b5e7-4708-9306-cf4ad00f42e2", "text": "This one was catalogued as belonging to his grandson.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "15f4d5a3-e62e-45a3-bb51-9fc369f2cfba", "text": "Then another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dd3642e9-b220-42a6-999c-1750f2fb48f8", "text": "Different century.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bb2e84e3-1ed3-42ac-ba27-11591d48515b", "text": "Another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1c1774db-c588-4589-85df-2f4c5087d0dc", "text": "Different dynasty.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7b0f4278-e856-45c8-bac3-3b196b189172", "text": "She looked at Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "09ccd027-01e4-49bd-8cda-28b2bf60fcb9", "text": "What do you see?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1bf65d29-664e-4e8a-a56a-54a7030df9c5", "text": "He studied them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d4dc7427-44aa-428d-9eca-a7c399801d96", "text": "At first glance the spirals appeared identical.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "730628c3-0618-482a-8f7c-abe46f5af617", "text": "Then he noticed the tiny variations.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f257e133-d411-44ef-8f4a-3f6c252d6308", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "766ade10-adf5-4996-8235-75ea44420e40", "text": "He frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "78da84fb-8685-4131-ae87-402248d00ce9", "text": "They're changing.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "531b2a9c-c1ef-44ec-b934-8bcdbb718322", "text": "A flicker crossed her face.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0d017b07-1e8f-4135-9748-2a618f9504e6", "text": "The closest thing to approval.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "84edcfef-9397-441d-aef6-6565f7c872de", "text": "How?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "72298b07-01e3-465e-87ac-fd67f65790f5", "text": "The outer ring.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7fa171a9-715c-4394-8fa7-338db98979bb", "text": "He leaned lower.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f2495ce8-3819-438e-9e22-81cc7702da5e", "text": "It grows.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9619f402-ae91-4447-bf01-11632d8786fa", "text": "She nodded.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "be7cfe40-68cb-4cc3-9ade-2decf29a54aa", "text": "Again.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c1dc293f-f4f2-43a4-8beb-b2d945fcadcf", "text": "He looked farther along the line.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4cd11957-364a-4b76-bcee-ab01bf542bf9", "text": "The center loses a turn.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "200cb535-d38a-4d30-86b3-eeb788981c74", "text": "Again.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a96250ee-fdfa-458b-a003-3e7e38d8eaa7", "text": "The spacing…", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "995377b4-b060-4a5b-85f7-c48b5da84a0f", "text": "He stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "661775f9-3a80-407d-8314-178f440cf467", "text": "…they aren't copies.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8dd4b541-e3dd-4f5c-886d-f5dbeb1f4e68", "text": "They're revisions.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2fb72ede-998f-4db0-b4a3-1d69f2959f2b", "text": "Ninsun folded her arms.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1c72b649-9c03-4c19-a23e-84f5e39c3377", "text": "Exactly.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "96de16b1-697b-44de-8a70-1ed9b7ed3aec", "text": "Balag looked from one to the other.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a43246f8-5ee5-4932-a787-0a4987478a4b", "text": "I feel like I'm listening to two people discuss sheep.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "efcd5b43-661a-450e-975c-41facbeb12fb", "text": "Enhedu ignored him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b918e1fc-28c9-4c44-8758-2b695ba74e6d", "text": "Why revise a royal seal?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ce188c89-fa98-4a01-922a-0d7712bf64e0", "text": "You don't.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ab92ec6a-51ec-435e-a1e8-7f0a8e05254e", "text": "Ninsun answered immediately.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3e2faaed-e314-4790-b185-2872bb14e785", "text": "You revise a story.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6afc3bdd-bb8e-4f50-b7b4-d857ce9704fe", "text": "She tapped the oldest impression.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9cc0954a-8261-4e27-bf30-bde32e9b7785", "text": "This symbol appears nowhere before this reign.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8542a1e0-e6b0-486b-b0f2-91ed7dc3bb01", "text": "Another tap.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "945b5bcc-a437-4581-82df-3e0a04a36c1d", "text": "Then it appears everywhere.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "727b32ff-5c54-436e-b454-cbeeefb1d9b1", "text": "Another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "534b760c-c128-473e-9248-87ec3383ca9e", "text": "Then less often.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "670be965-8e08-41c1-ba27-034e5f1ea839", "text": "Another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dedea298-1645-4d62-b127-ec3ef58f1c55", "text": "Then only in private records.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
