[{"id": "dc50166c-7ad5-41cd-b491-e12e343c437a", "text": "CHAPTER 6", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "d5909ee3-60aa-4955-b3ca-9a3d0c82eece", "text": "The Fourth Share", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "4aecdf68-5017-45f8-ac51-5386c740d3a3", "text": "They found her in the lower archives district two days after the Collector paid them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "791de930-71b5-4ee7-a325-1a787652c7ca", "text": "The building was half-sunk into the slope above the old flood channel, its upper rooms rented to scribes who couldn't afford better light and its lower rooms left to the kind of people who preferred not to be found. Zik had come looking for a particular copy of a boundary tablet the Collector had mentioned in passing. Balag waited outside with the packs. Enhedu had already decided the place smelled like unpaid debts and was keeping one eye on the street.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fa30658e-e109-433c-aeeb-5e50cad7b3c4", "text": "Ninsun was in the back room, seated at a low table covered in clay tablets and scrap parchment. Ink stained both wrists. A small oil lamp burned with the kind of careful thrift that said the oil was more expensive than the work. She looked up when Zik's shadow crossed the tablets, and for a moment neither of them spoke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5343da02-c8c2-4a59-8ba4-c61a1e7e4d6c", "text": "You're the one who came out of the sealed tomb,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d1ae4301-3a07-492d-a299-859e950472d2", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "e7392f3f-0636-4de2-93b5-c3209378e5e0", "text": "It wasn't a question.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "54921ffe-7054-45ab-836e-f74871f00555", "text": "Zik kept his expression flat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "f9c9d617-e836-4474-9176-190faceb5f71", "text": "People talk too much.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8d5d101a-628b-4832-8abe-5e46439f78db", "text": "People talk exactly enough.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "488b5fab-45fe-465d-a0d7-d9ccd2cd0332", "text": "She set the stylus down.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "4805cc10-e930-44e7-b6a1-63f187a9cb5a", "text": "The mark on your hand matches a symbol that appears on seven private royal seals and nowhere else in the public record. The same symbol that shows up in the oldest underworld fragments the temple pretends not to keep. I've been looking for someone who actually saw it in the ground instead of on a tablet.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "80f50293-d446-41fb-a3ec-c7b350ed9c42", "text": "Balag's bulk filled the doorway behind Zik. He didn't speak, but the way he stood said he had already decided this woman was either useful or a problem.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "60542c77-7182-4d82-86b3-6b56b00a8abe", "text": "Enhedu drifted in last, eyes moving over the tablets, the lamp, the ink-stained hands.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "6cfdb995-75f3-4af4-9f64-93dec14a3456", "text": "You're not temple.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c6b738e7-94e1-4a78-ae3f-68604913fe8f", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e020f3c9-e941-4fe1-ba43-ae0022dbe444", "text": "University?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c4318fc4-3148-440f-b7d8-bff661cbf1f5", "text": "Not anymore.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3bcf4f45-c02e-479e-91ba-932648257665", "text": "Then what are you?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "63f35079-c807-4029-a9c4-e073270fd6f0", "text": "Ninsun looked at each of them in turn.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "e6180ac3-bded-42aa-84bd-baea8d253788", "text": "Someone who spent three years watching a district rearrange itself around my sister until the city records forgot she had ever lived there. Someone who is finished being told the old texts are only metaphor.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7e0e1309-f9b3-43b2-b033-c687dc8bb895", "text": "The room went quiet except for the small hiss of the lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7a7197bb-7125-48ec-9cf2-3444c5f03d22", "text": "Zik let the silence stretch.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "98dfd6d8-0169-490f-9f83-f341af3ace42", "text": "People often rushed to fill silence.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "29466575-300f-46fa-8a10-cb300d17ad02", "text": "She didn't.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e67dcc88-2d7e-47d2-9d0c-5781dc9cfe64", "text": "That interested him more than anything she'd said so far.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "86e6dd87-1c6e-415e-b577-5a6e39547494", "text": "Finally he spoke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3b6d4191-328f-42c1-865b-6b36d435c77e", "text": "You've seen the symbol.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6722e401-5840-4339-8009-406f07200971", "text": "Yes.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d8a3d434-2fb9-405c-94f5-5418872a2dbd", "text": "Where?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0adc3d69-33c0-44e7-bd52-2de64194de95", "text": "A dozen places.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6ea0b904-8bed-4819-b3c6-5dbea0e27e94", "text": "I asked where.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8c6e98f7-8c1f-4642-8c77-12bca69c43be", "text": "Ninsun reached beneath one of the stacked tablets and produced a narrow wooden board wrapped in faded linen.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "498f92b1-c274-4053-bc73-98cdd1f44b8b", "text": "She hesitated only long enough to brush dust from it before laying it carefully on the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5c5a502b-92cd-41be-83ef-82caa905e409", "text": "The linen came away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c5429b42-207e-4d45-80c4-d3b0741b6efb", "text": "Inside rested seven clay impressions, each no larger than a man's thumb.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "352181ef-bf72-4a70-b3e4-3929043567e0", "text": "Cylinder seals.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0aff4183-be4f-44e4-be53-0086b8fa7bfe", "text": "Old ones.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "41bea4ac-ed80-4ed4-a59e-dd33936ca01a", "text": "Very old.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c750d69d-42f5-4fc6-96f8-0583db66dbf9", "text": "Balag stepped closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b95ca51c-8d7d-44e6-8e29-ee415ca6935a", "text": "You keep those here?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f3e95419-03d2-4248-92a7-027e4650cd6c", "text": "I copied them.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2010087f-c83e-4614-b243-66faef5bd37b", "text": "You copied royal seals?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8d317988-4717-4a8c-ab5d-ec7e98340c73", "text": "I copied the impressions.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "986f7650-69af-4e73-9e35-6564d344c52f", "text": "That's still illegal.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "55913eea-586f-4451-be6c-09812ddc5e9c", "text": "Only if someone important notices.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4a0a31b2-0a0f-4c66-8295-11d53fbf25de", "text": "Enhedu leaned over the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d4fe41cc-d178-42f7-a0c0-2a6d53ae37c4", "text": "They're different.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
