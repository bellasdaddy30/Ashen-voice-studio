[{"id": "b05978d3-deaa-4285-a9fb-6e3897781a37", "text": "Even without the reason.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e032a37e-ee2f-4e39-8484-812dff412ac6", "text": "Even without the reason.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e41cb92d-64bd-42ef-ad44-b84cd628982a", "text": "She was silent a moment. Then:", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "1baa6f06-1992-4add-98c4-340b6e689fcf", "text": "The City will not stop at one payment. You know that.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d1e0ff86-74f8-49db-95b2-3caba193eaf9", "text": "I know.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "31914930-c713-4cfd-813b-1610a8407cf4", "text": "When it asks again, what will you give it?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cf99667c-2719-4f93-8938-70dba149b316", "text": "Zik looked into the dark beyond the chamber's edge. The mark under the linen on his palm was warm, patient, waiting.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b8c4bbfa-0874-44ad-8cdc-6036bcf9414b", "text": "I don't know.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "44aefbd2-46d9-4cfe-91b5-125a2241f511", "text": "They stood in silence while the City breathed around them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6f47c8e1-7a5c-404a-ab0f-4108ddf94ccb", "text": "Then Zik stepped into the dark, listening for Ninsun's next breath.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
