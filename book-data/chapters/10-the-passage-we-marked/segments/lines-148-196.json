[{"id": "0aa86f1f-28eb-41c0-97a2-a9b8614f3323", "text": "Zik studied the scattered marks.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "98c9e18a-d429-4231-9428-59d5f8ba9bfc", "text": "They're moving west.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9e11c2e9-039e-466b-bd95-54ca6d229198", "text": "They were.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "40bb040f-0371-4236-9e1c-4b63d0e48c0b", "text": "Were?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bad3e00e-f789-4f51-81a4-17982ac56896", "text": "Yesterday they moved south.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9bad5a6f-fdad-413c-b95c-fe8319fd402c", "text": "She rotated one sheet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "63d47524-d0ca-455b-81ee-b69542dc5a9e", "text": "Today they moved back toward the flood channel.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "14a7a0d8-54df-458c-bd92-72601d660785", "text": "You think there's a pattern.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cc75b9cd-e095-4d20-9668-e4abd1320931", "text": "I think patterns are what people call confusion when they want it to feel temporary.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ae5e9de2-5ff1-4d60-a2cf-8064591eb927", "text": "Zik adjusted the lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "45307106-9910-4ac6-9b6c-224f3efb00ef", "text": "The shadows of the parchment edges shifted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a6d68be4-2c90-4bc9-a268-015577272a08", "text": "Several marks lined up.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "27a89d71-634c-413d-a564-2c2e5ba37a9d", "text": "Not streets.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6aecedcf-3c37-4e99-a2b0-4ceb1c6a8684", "text": "Not a route.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "be8c723e-203d-4fb2-af59-76b64da7ab61", "text": "A curve.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "69de3b3c-524f-41d5-9364-0ff226fa56e0", "text": "Ninsun saw it at the same moment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "faa60eff-1e98-4de4-8cb7-6c93ffa7fe8b", "text": "She pulled another scrap beneath the first.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "03a9b408-2216-47eb-8883-9d57320a2688", "text": "Then another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bfb439e3-4cab-40b4-8e6a-2aeb73fd260b", "text": "The separate curves joined.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5c8ff52b-dd0e-4099-abc6-31e54aabaeb1", "text": "A spiral.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f0350087-db7f-490d-ac10-04786718b8b2", "text": "Zik's wrapped hand tightened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9c91f28f-8da8-4298-9e34-bf70f762fb75", "text": "Ninsun noticed but did not look at it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "02463e2d-307e-413c-9ef5-20b0808176e7", "text": "The passages aren't appearing randomly,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bea21c96-c48c-4ada-9e9a-7713b5726e50", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "d7da7b20-89ee-4145-ab24-ffc9ddd48ba3", "text": "What are they doing?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "af109cae-ae28-4732-8cb6-445cc94599b6", "text": "She drew the final arc in charcoal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d14b7f15-c475-421c-9c30-9d3233e47949", "text": "The line curled inward toward a point near the center of the lower districts.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "90025eba-0857-49f8-b5df-c4a878dde416", "text": "The old flood channel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "08db1697-de54-479d-b4a4-73d64cb897e6", "text": "No,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4ac72144-f7b9-42ec-a2e6-3a5a5a5cb9d6", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "83e4ad13-70da-45f2-bca0-48eb1612765f", "text": "Ninsun measured the distances again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bcf5bf06-0222-4a74-a958-65aee1699942", "text": "They're tightening.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a2fee76c-ed61-4ac3-b639-076aaf872a0e", "text": "Around what?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "69b53eae-fecb-4fb8-bff9-c4b57fdbd821", "text": "I don't know.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6d56cb8d-3f25-49fd-8ca3-acde545857f0", "text": "You know where.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "49b15686-8d1e-4d7f-bbf2-9b4d81484a40", "text": "That is not the same thing.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cf007334-9169-4920-8f5a-294be8a02ddf", "text": "She placed the tip of her stylus at the spiral's center.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "57a815a3-d256-407b-9e91-52cd377d5c5d", "text": "The floor beneath them gave a faint knock.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b707511-3957-4be3-aab2-4c5bcca613c9", "text": "Both of them froze.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0eba1d34-57ee-49da-918a-24cbc4606f33", "text": "A second knock came from directly below the map.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "23ec7751-87e1-4220-8270-d7477b6b50b8", "text": "Ninsun lifted the parchment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6c30d954-ce3f-41ca-a72e-fab16c3f1056", "text": "The floor was bare.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "50b19eed-2184-4022-b7b3-2b5c56680bc9", "text": "When she set it down again, a new mark had appeared at the center of the spiral.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d892d325-21ba-42ec-804e-967c94e0d617", "text": "Three notches.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "208a0a6b-d30a-436a-a809-5fbfff757882", "text": "Zik took the lamp from her and held it closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f99e8d6e-a4f1-4bff-8422-962a20243935", "text": "The ink was wet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f6b47703-e6eb-4843-b457-7cf77c4c9d9a", "text": "Neither of them had drawn it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "096cfdda-dea9-4bc3-80fb-38d43c5c0492", "text": "Ninsun reached for the map.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bb2c7b29-658d-427d-9a34-b97046983e39", "text": "Zik caught her hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
