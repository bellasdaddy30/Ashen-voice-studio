[{"id": "b03046c4-8fb9-4bb3-a5d5-47ba90e83945", "text": "Don't.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bbbb8148-29a8-45ab-9cde-b8605e83fa5a", "text": "It's paper.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "52f30bdc-a395-4574-b98e-973b57e63479", "text": "So was the journal.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8eca867a-70ca-450e-89fc-bb066af5e1c3", "text": "Her eyes moved to his satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4ba00a96-802a-4c61-b77c-79ae76c20bbf", "text": "You haven't opened it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "da0a632f-4dc1-405d-89d8-2d11a75c634a", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1faf9a9d-3d2d-473f-a2b0-d21e31268ac2", "text": "How long?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "17c71f3d-7f93-448d-ba93-137982f8f0a2", "text": "Four days.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "69829aa4-2e8d-40ec-80eb-e0d8eaeb9b40", "text": "Why?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5c415225-aab7-4c83-9100-50767dc8e591", "text": "Because every time it tells me something, I do what it wants.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "628a0e14-1961-4107-ab43-6532f37354a1", "text": "Ninsun looked back at the three wet marks.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8bfc19fb-9b78-494a-940b-7b9752e00898", "text": "And what does it want?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b2f80c42-2c0d-47f8-800d-edaeb196f0a8", "text": "For us to go down.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b5893871-440d-4489-8e63-b5858fd3ff58", "text": "The floor knocked a third time.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "89bbe42c-bfa0-4489-819f-6be78a0a40e9", "text": "The lamp flame shortened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0db2cf6d-6390-4229-978d-f1df86d249a5", "text": "From the room next door, Balag's voice came through the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8f581ecd-d6c2-4adf-afab-df90ad99d28d", "text": "Whatever you two are doing, stop agreeing with the building.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f9b5cc83-3597-4fcf-9833-9c1c9450671a", "text": "Enhedu added something too low to make out.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f31fa6f4-105c-4bbb-8a73-8342298a7423", "text": "Ninsun slowly withdrew her hand from beneath Zik's.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c5c43be1-954c-4e7e-955b-d23a62f4ca1e", "text": "She took a clean sheet of parchment and laid it over the altered map.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "af17cb4f-0ed1-464d-bdef-3da88e58fbe5", "text": "What are you doing?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7b34b242-7e64-4671-a77e-0c3a707446f7", "text": "Copying it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d57dfbec-de3b-4e0a-b1fa-08f3ea8a13ad", "text": "You just said the city might be writing through the map.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3b66ff2c-2757-41f1-9484-b4e621013ee0", "text": "Yes.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4d33c327-4d7b-4798-b650-3792834def68", "text": "Her stylus began moving.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "60c646ec-7d7c-4d63-8b7d-03d7e72743d9", "text": "That doesn't mean it gets to keep the only copy.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "32a274dd-bc01-477d-b3af-a5a2a0be44cf", "text": "She kept working.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9c9aebb3-7e95-4d55-9675-4143310afeb2", "text": "Outside, somewhere in the lower districts, another alley was probably opening while they slept. Or closing. Or deciding which names still deserved to remain uncrossed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bd8a0a2f-800b-4adf-850d-9abc088d4212", "text": "Zik left her to it and checked the linen on his left hand. The mark was warm. Not urgent. Just present.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f0ea88b5-3c3f-4c6d-a510-245d5790bd5e", "text": "He did not open the journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6381cbf1-7574-4ba6-a00b-c040ee223d9d", "text": "He had not opened it in four days.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ca83ffc2-4e55-43e8-81ee-4eac8ff7c41a", "text": "The decision still felt small. He was starting to trust that about it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
