[{"id": "c2d41e96-a637-420b-9675-7c27f38522c5", "text": "CHAPTER 10", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "0f96b22d-2c26-44e2-a356-f6370a847d9d", "text": "The Passage We Marked", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "cb637ef3-81bc-4b8f-bbe8-0a8020bfe424", "text": "They started marking the shifted streets on the fifth day.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f5dd4d2f-298c-4ad3-941f-13c6ea50f118", "text": "It wasn't Ninsun's idea, though she was the one who made it permanent. After the second uncrossed name and a third alley that closed behind them before they finished measuring it, Balag simply said,", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.3, "delivery": "neutral", "generated": false},
{"id": "2b32a8c6-7609-49f7-88be-c724fc1f60fe", "text": "I'm tired of walking into the same fucking hole twice,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0ea1e479-db1a-46bc-804a-47d6bff7df3f", "text": "and that settled the argument.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "f14d1212-abcc-4270-9e96-bcf34eb5ac93", "text": "They used chalk at first. White marks on the older brick where a passage had opened. Simple. Visible. Temporary.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a3032121-948e-45ee-88c6-861edcebc58e", "text": "By the second afternoon the chalk marks were gone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "aa2222ba-f381-4da0-9d3d-e411db960e49", "text": "Not washed off. Not worn away. Simply absent, as if the wall had never accepted them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f1ebbbd9-6aff-4e53-85f8-c65bd33379fd", "text": "Enhedu crouched where the latest mark should have been and ran her thumb across the brick.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "6aeba42f-e44d-4f96-9a8b-b93cf76d442d", "text": "It's eating the chalk.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e9595942-79c5-41bd-9c9e-c59256b8da68", "text": "Or deciding the chalk doesn't belong,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d0eada8f-a609-4d10-85b4-b355df6efcd2", "text": "Ninsun said. She was already pulling a thin bronze stylus and a scrap of harder stone from her satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "e4ac5f81-4535-4cc8-90b9-cfad5c04e01d", "text": "We need something it can't ignore as easily.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dcfa86d8-ec72-42dd-81c8-edf82d86d727", "text": "Zik watched her cut a small, precise notch at the base of the wall, low enough that most people would miss it, deep enough that weather alone wouldn't erase it in a day. The sound of the stylus on brick was sharp and final.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d9fad4c1-a4cc-46d1-ac67-fb6ad97365c1", "text": "Balag tested the notch with his boot.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "6e014b5e-48d0-4c4c-8b83-23ffe9586dee", "text": "That'll do until it doesn't.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "19359e31-ba17-4993-b55c-3232165c76dc", "text": "Same as everything else,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "42d35ad3-5cdb-4387-bd5a-c005b42587cc", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "72ea9c08-c6b5-47d1-8f30-5675ae82884a", "text": "They kept the system simple after that. One notch for a passage that had opened and closed. Two notches if it had shown names or objects worth remembering.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ac0bb427-480d-444d-bd86-8474554c35d5", "text": "Three if it had tried to keep them. No one wrote explanations. Explanations were for people who expected the walls to stay still long enough to read them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7e86eaeb-01cd-4542-81ba-ee6cb4f610d1", "text": "On the sixth day they found a passage that already carried two notches they didn't remember cutting.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fecf9e82-ba79-4897-b55d-6719873bbc54", "text": "No one spoke for a while.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9efde22f-1052-425c-b2d0-5a019a175e6c", "text": "Enhedu was the first to break the silence.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "b72ea90e-e0e8-4cb2-8922-f20c86538947", "text": "Either we're forgetting our own marks, or someone else is using the same system.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4cf6c131-e385-4a17-90d2-9a2ddd5429f9", "text": "Or the city is,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "eee7d6de-1cfc-4ae4-a853-03343dd6d617", "text": "Ninsun said quietly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ea6241cf-d754-4379-bc77-127d26ce15bb", "text": "Balag spat into the dust.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "00ebfb00-6e6a-4d0a-9da4-ae165adad513", "text": "I hate every version of that sentence.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "371134d7-7b5b-4458-918c-b38a57820d2a", "text": "Zik ran his fingers over the two clean notches. The edges were sharp. Recent. The same depth and angle Ninsun used. He looked at her. She shook her head once. Not hers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "660ce45f-807c-430b-b5c5-902476410701", "text": "Ninsun crouched beside the marks.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9243c428-0202-4e67-9f44-4409589ef3d5", "text": "Give me the lamp.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a72d5260-6a3e-4348-b279-b735ec52000c", "text": "Enhedu lowered it until the flame threw the notches into sharp relief. Ninsun took the bronze stylus from her satchel and held its tip against the first cut without touching the brick.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b8fd35b0-0634-4197-bdfa-de2d92e021a6", "text": "The angles matched.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5a25da28-26ea-41b6-8638-2360c17527b3", "text": "Not approximately.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5bdae0e3-f79c-41cf-bed2-389195a5d1f9", "text": "Exactly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8b987fbe-da77-497c-be65-165fe940055d", "text": "Balag leaned over her shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f6e49a81-f9ad-45af-a18a-1cf664fe6fad", "text": "You said they weren't yours.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4d5a6d6b-ea2d-45b1-86e3-2e2c1c6fa92d", "text": "They aren't.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "486bb601-0592-4aa7-984d-a8087277da28", "text": "That tool disagrees.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f3253b4b-14d2-4672-865a-bdad8831fe01", "text": "Ninsun rotated the stylus.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5ef992dc-5557-4270-a6af-e605bbf4504c", "text": "A small chip marred one edge of its point. Zik had noticed it the day before when she marked the passage with the basin. The flaw left a narrow ridge in every cut she made, faint enough to miss unless the light struck from the side.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7a1edc61-d54c-4756-9302-5715ef6b8308", "text": "Ninsun moved the lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "76e8f742-0d9e-446f-a31b-59a9e68b87e4", "text": "A thin line appeared inside the first notch.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "48c68c80-82eb-425a-86d8-399746da691d", "text": "Then the second.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7a2265e3-554f-43fe-8e39-b39eba30a80e", "text": "The same ridge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "44e1dbbf-853f-4ce9-b0c2-6c8e1706db7a", "text": "Enhedu looked at the stylus.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "51b1b085-6ece-44eb-96f7-dba09c6818b4", "text": "How many of those are there?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "85ca6be5-ca97-41f0-8c70-6fdc262a50e7", "text": "This one.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
