[{"id": "5210fefb-1f19-4e62-bed9-3f18b6beebeb", "text": "You bought it recently?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2cb9235c-a610-4235-812f-9f87c7d07cee", "text": "My sister gave it to me.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8308377d-6750-4fe1-8c06-3dd01c6f5276", "text": "No one spoke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "35cc99ab-926c-41cc-aca8-431e1d341237", "text": "Ninsun pressed her thumb against the chipped edge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "294648b8-00ab-4e4b-a18c-d6414e526d85", "text": "I have carried it for six years.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c2ba82aa-5dba-4193-8255-c7764c1d4b58", "text": "Balag straightened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3e64f207-fa3e-436c-8262-e65799919c12", "text": "So either you cut those and forgot—", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9277c54a-e0b2-4050-86f4-99f4aa6337e5", "text": "I didn't.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "47965b99-2f47-4090-ab79-263a4f3b9404", "text": "—or someone borrowed your stylus.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e4148e78-2250-412c-8684-bc03784a57c0", "text": "It has not left my satchel.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8c2a0062-62c5-4838-9439-85db900efaef", "text": "Things leave your satchel.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "55d0c748-4918-4d3f-b67d-9feedf2019b0", "text": "Not without opening it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "22f48a74-4685-465a-b703-6d4d61c13c5c", "text": "In this city, I'm no longer certain that matters.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d527a160-4ed0-4f1e-b4bc-7f4172e5a126", "text": "Zik examined the ground.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9700bb35-65e6-4cc2-b1cd-a6087e39396e", "text": "No footprints marked the dust inside the passage. No disturbed grit. No scrape where someone had braced a hand against the wall to make the cuts.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5a8eb3bd-347e-4012-902a-b622798b4076", "text": "He looked at the second notch.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "43220022-be47-4ad3-9a3b-f632fec9e0d1", "text": "The lower end curved slightly to the left.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e428373f-8a2e-44fb-92c5-4f7cc0b70699", "text": "Ninsun always did that when cutting downward. Her wrist turned inward near the end of the stroke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8a88786b-aeb0-48b5-b58c-882b36413a6f", "text": "He had watched her make the same mistake eleven times.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "630aa5a7-33a0-4c5c-89d9-d3c08ce72434", "text": "These are yours,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a3732090-10b8-4d88-9df9-f663b51aa94f", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "6b36c623-a2d7-405c-9562-9bf1fe4e5378", "text": "Ninsun looked up sharply.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "121865f2-5fbb-4d1f-979f-167a10d0d635", "text": "I told you—", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "03eaf6ff-7209-485a-b6e0-8c07ac341022", "text": "I didn't say you remember making them.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ca8c9594-2162-411c-840d-01d8f9af068e", "text": "The passage breathed cold air over them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f9154f2f-5410-486b-a3e7-4fe96347358d", "text": "Somewhere inside, stone clicked against stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b34b3c88-be90-4ca7-9881-74cd43a7fee0", "text": "Once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "55085b93-dc67-4e60-a7d7-f204bbe0b444", "text": "Then twice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c8073c95-f307-4eed-b752-3baa9da5b87e", "text": "Balag lowered his spear toward the opening.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1abb54fb-f2b0-462b-9c20-1b7f848cdd2e", "text": "It knows the system.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d4043d2e-3c8d-45b9-9af8-d05d68ead854", "text": "Or we come back here,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "81e54f5e-0af2-4975-afe1-1fa238eeb8c8", "text": "Enhedu said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "62e42c9c-e93e-4e25-92b4-538b8f3af191", "text": "Ninsun stood.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8632f1e2-4f7c-4983-94e1-82c894486ac1", "text": "We haven't been here before.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6d5a1142-ce0b-4f9e-9a20-38a67b8ef26b", "text": "Not yet.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "db9d9c68-37d6-4c7f-a52f-54b160ec91d6", "text": "Balag looked at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a0fa94b0-f763-486c-bd65-6f0b11d108ee", "text": "I liked you better before you started saying things like that.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7be8de49-e78e-416b-9a5c-f7629e12046d", "text": "A shape moved at the far end of the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2802f3e0-18f9-473e-97b5-a18ca18d896a", "text": "Not close enough to identify.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bdf9f3b8-f1e5-48e7-8379-eed74cd19864", "text": "Close enough that all four of them saw it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "793d121d-4aa6-4aee-97e3-1f64a89b6d32", "text": "It stood with one arm raised against the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "91689bb2-218c-49e7-af7d-670e54c41a64", "text": "A small sharp sound reached them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d1575123-43e8-46d4-828a-ba593c4e21f9", "text": "Bronze cutting brick.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bae67a49-cf29-433e-b40d-546759c6d41c", "text": "Ninsun's hand closed around her stylus.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "446e4316-e84a-48cc-8bc9-f1916a4dcb56", "text": "The figure made one stroke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e243b9d8-173f-4f60-a861-71a15254cfde", "text": "Then another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c7e47752-cfa6-4c23-8838-c58f17d93682", "text": "Two notches.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4ab759b9-f510-4fff-adef-59abe800a390", "text": "The passage darkened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "20831e2c-6003-4986-b9ed-55db1599ece7", "text": "The figure was gone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
