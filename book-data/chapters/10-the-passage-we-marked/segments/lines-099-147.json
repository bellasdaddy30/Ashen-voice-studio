[{"id": "9be2a4d9-fe32-441b-8ffa-61b66fac70bf", "text": "Balag stepped backward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "19681897-1001-4560-af84-92ab126bc3ee", "text": "No.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1bb59908-8228-48fa-8e21-474c21d78ca1", "text": "Zik kept watching the place where it had stood.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cbc0501d-c02b-485b-9bc6-06508aff68fa", "text": "We could follow.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d34fbdea-d339-4dc5-bd9d-d7f47a2d0b13", "text": "We could also drink poison and save ourselves the walk.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b7a2bce9-c7c5-428e-8f0d-19ec6f7517a3", "text": "Enhedu studied the two marks beside them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d49c809f-dd9b-4127-9004-0a7376a8d21a", "text": "If that was one of us, entering may be what causes it.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3390b8ac-c778-4ede-9782-1c7ccb403bed", "text": "And walking away may be what causes it,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "66c61edb-4b81-4df9-b718-a9063f2be58b", "text": "Ninsun said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "604aa4b6-a4a6-4fb0-b72c-d777258b50d1", "text": "Balag turned to Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1b90524f-edb3-4acf-812c-b674fef19f01", "text": "You make decisions. Make one.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "25aca4e8-d82c-44e8-960f-16cd1afd3802", "text": "The mark beneath Zik's linen remained warm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "49331c29-41c5-45f8-9acb-02e4f9213dc8", "text": "Not pulling him forward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "13852fb7-2bc1-412c-9c8e-511deb31d4f9", "text": "Not warning him away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dd08e3e9-083d-4cdb-8ff1-450753d4c00f", "text": "Waiting.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a9dc4776-aeba-411f-ae6e-a9462ec0251d", "text": "He thought of the chamber that had learned Ninsun's name. The black water bending toward his father's journal. The city producing evidence faster than they could understand it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1a4e8c95-6db7-4c8d-827e-c9814bed1aa8", "text": "Three notches,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "20d06d3b-c69f-4958-9c50-55fe235f2c84", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "211f7224-a8e7-490c-aa82-70164855adfe", "text": "Ninsun looked at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7b36e437-538d-4343-9e0f-aa282b3370ab", "text": "We haven't entered.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "06a70dbf-cc6a-4951-b403-5aa7e5e1f712", "text": "No. The third one is for a passage that knows us.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0052815b-ca13-42e6-a880-f14ff7fa83b0", "text": "She placed the stylus against the brick.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8b771d7b-d276-4f16-be45-21aa9be8ef1e", "text": "For the first time since he had met her, her hand trembled.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d21a94c2-12c9-41dc-b15f-d5e21fe3a946", "text": "The cut came out straight anyway.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5bd8df3e-8e3b-4b35-af47-fd717bd48c68", "text": "They walked away without entering.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "81f3e362-b45f-4ff2-8e53-758e7015223b", "text": "They did not enter that passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8db9e8dd-39f5-4a77-b694-6ae044743efd", "text": "They cut a third notch beside the two, deeper than the others, and walked away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "79c2050b-8027-472c-ac46-30e1888e9c9b", "text": "That night, back in the cheap room they were using as a base, Ninsun spread her scraps of parchment on the floor and began transferring every notch location she could still remember onto a single sheet. The map was ugly, incomplete, and already out of date in places.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "36f2b07b-b57c-415d-80bf-fbaa9488c3b3", "text": "She worked anyway.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "934118c5-8fba-4829-8e85-177ae4572313", "text": "Zik watched from the doorway.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "af806038-467f-45e7-9a4c-444c3e10ca64", "text": "You know it's going to change again the moment we trust it,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "09e62d81-5e9f-4a6f-89d5-44fb599ef63d", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "5407e37a-134d-4398-83b0-c1b3edc12cfe", "text": "I know.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4278f5fe-41a6-4a52-b57f-da493473eb7a", "text": "Then why keep it?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "af0835f8-0132-439d-8911-b0a4f77b4093", "text": "Ninsun didn't look up.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "fac77fe7-b8d5-4d6e-bcd4-40feb29f0f0a", "text": "Because the alternative is letting the city be the only one writing anything down.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7bca4fb3-f32e-4d8d-970e-521d90a9cd38", "text": "She drew another line.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "272ccbe5-166b-438c-b36e-ad7dd1485bf0", "text": "Then stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d3724f41-f55d-427b-b889-4732b310ba57", "text": "Zik remained in the doorway.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "990e0f64-c84a-4c9a-91e8-0b20af968bac", "text": "What?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "09b46fd2-2282-4a3a-8197-0057248db31c", "text": "Nothing.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "818a5ba5-853e-4650-bcc9-614c5e1b7ee2", "text": "You stopped.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5728c901-e2a8-49a0-9ac4-a73ee8455a1c", "text": "That doesn't mean something happened.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "65a29208-3ea1-4d31-9d85-fc34b21eb42f", "text": "With you, it usually does.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c1656a3d-93e4-4957-a82c-77a9ad75482b", "text": "Ninsun shifted three scraps of parchment across the floor. Each held a rough section of street, copied at a different scale. None aligned cleanly with the others.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "595d4316-1ae6-47f0-8bd3-db3f0abcc6ef", "text": "She placed a clay cup on one corner to keep the papers flat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "88fd4ef5-27e5-49d6-be8c-13ff77826ef3", "text": "Hold that lamp lower.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bfafa08c-fcb4-4acd-aaf6-525b6e4773da", "text": "Zik entered and crouched beside her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "56190956-046b-45d9-b7c9-3cd189500b29", "text": "The room smelled of lamp smoke, old plaster, and the sour beer Balag had abandoned near the window. Ninsun had marked every shifted passage with a short black line. Beside each she had recorded the number of notches and the day it appeared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
