[{"id": "3912defb-a41e-4a45-a271-7bf8b466d598", "text": "CHAPTER 4", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "ad628db8-a85b-4625-a13c-f889657a08fc", "text": "The Edge of Smoke", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "e7a41c79-b60c-47f5-b366-2e28fcc0f15d", "text": "The desert didn't end so much as it thinned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "734bf5c2-7388-496c-bd8b-3bf28f16359c", "text": "By late afternoon the dunes had flattened into hard, broken ground scattered with the first signs of people who lived too close to nothing: a collapsed sheepfold, a half-buried boundary stone, a scatter of broken pottery no one had bothered to gather. The air carried the faint greasy smell of cooking fires and the sharper edge of river mud. Uruk was still hours away, but the land had started remembering it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d8d5300f-d559-4de6-bd6d-8343d6852f44", "text": "They walked in a loose line. Balag kept the donkeys moving with short clicks of his tongue. Enhedu had fallen a few paces back. Zik stayed near the middle, the journal still in the pack where he'd left it the day before.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a4186dad-bf24-48bb-8f02-eb3ced8482f6", "text": "A low mud-brick wall appeared on the right, half-swallowed by sand. Someone had tried to keep a garden once. A few dried stalks still clung to the soil like they hadn't gotten the message. Balag stopped the animals and walked the length of the wall, testing the corners with the heel of his boot.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "05512eab-f2cd-4fb4-ab40-3a30204e7ab8", "text": "Someone put real work into this,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e3c7ba39-1ac2-413b-b46c-ba32395d6014", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "fb4636b4-ade8-46e3-9285-192819957a85", "text": "Foundations are deeper than they needed to be.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "da7bd091-a6f0-43ab-8f99-8e03fd9f1eb6", "text": "Zik came up beside him. He ran a hand along the top course. The mortar was ordinary, but the joints had been laid with care. Whoever built it had known what they were doing and still lost the argument with the desert.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "286b6cd9-f927-4c19-a65e-9f5962ad3891", "text": "One section near the middle had slumped. Two courses of brick had shifted outward, the mortar cracked into a long jagged seam. It wasn't dangerous. It also wasn't right.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "46c5b48f-9f4a-4c75-9ce1-d8365328b13f", "text": "Zik set his pack down, pulled the bronze awl and a short length of cord from the side pocket, and began working without asking anyone's opinion. He scraped the loose mortar free, tapped the shifted bricks back into true, then bound the seam with the cord driven through fresh holes so the load would sit properly again. It wouldn't last another season. It would last longer than it would have if he'd walked past it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2f5f1c86-0826-43f6-b33b-f764c3ba4d13", "text": "Balag watched for a while, then said,", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "47a08417-c2ec-4b5a-8b79-6e96802b80f8", "text": "Why bother?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9fbabf1f-e85d-42f0-a897-a9571a5644ac", "text": "Zik didn't look up.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "af5d8209-2875-4bc1-8e92-a314b797ce95", "text": "Because it was built right.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7632f529-2204-42ef-9ac5-67483d9ba7ae", "text": "Balag stood beside him a while longer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "15bba500-8f4f-4dc9-9dc6-0ecc79b6b675", "text": "That's not an answer.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2c2119e6-0067-48ee-a463-50d0ddf436f8", "text": "It is.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9788f56a-e431-4aa5-83e2-e9cb55ceffa5", "text": "It isn't.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fd30a81c-4a6c-4ca8-9351-cbc441f532a3", "text": "Zik packed fresh mortar into the seam with his thumb.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9fe0e3de-24b1-4027-97db-a981cd2ff7fc", "text": "The people who built this wall are gone.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dee2e7a4-20a9-4881-b6a3-1d5600d20a38", "text": "I noticed.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5d735dc4-d07b-40ef-80aa-711c95764ef3", "text": "They spent days making sure it stood.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3f94d471-748d-4bed-ad98-40b43793fcdf", "text": "So?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9534714f-1cca-4dde-9ed6-0cd6a3c6d4be", "text": "So somebody should respect the effort.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c09f6a62-29b0-4695-9056-58914271ba1a", "text": "Balag scratched his beard.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d3423c3d-522b-44e8-8122-410f7dafd0a7", "text": "You think the wall cares?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3cc75f4a-ce77-403d-995b-79684687a893", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4e5a9e8e-d5eb-4ee3-a8e3-99a4bd60edfa", "text": "Then who?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "375d7651-3d05-43e6-9a35-a0393fd98772", "text": "Zik looked along the crumbling length of brick disappearing into the sand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f120b2bd-aad8-4b68-967c-ed57b3c37553", "text": "The next person who leans against it.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "380b4b60-2532-4539-8dc5-20f5a20670a7", "text": "Balag was quiet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4d6c3bb6-c0b9-4eb6-b705-a293b3094713", "text": "You fix things you'll never see again.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8b9c8192-3a21-4b89-ab1e-9d78873c09f8", "text": "I excavate things no one remembers.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "672659f2-6369-48da-a2fa-c2ba1d0d8d4c", "text": "That's different.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d8afe5b2-ec03-45d0-a967-5d1382d98e14", "text": "I don't think it is.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d1c10b5b-c4d1-4871-acca-7fb452e2c946", "text": "Enhedu brushed dust from her knees and joined them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ea4da084-b3ec-4e0b-822f-5dcb17b07d75", "text": "My grandfather repaired irrigation ditches.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3385987b-389d-443d-82b5-15b02d3e3a7c", "text": "Neither man interrupted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7b04007b-aee9-4c50-82c3-af88208247ce", "text": "He'd spend weeks fixing channels on land that wasn't his.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a6840415-fa45-4726-b318-3b2e8d031bc7", "text": "Balag smiled.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "89f8d413-26d4-445f-b7ff-6bebb2cf2d3d", "text": "I've met farmers.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "915f94f8-64d9-4ff7-a267-dc00d0cd49c0", "text": "He wasn't a farmer.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d616c254-de6a-47c8-9cb8-d20d30556a2c", "text": "No?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f3fe1a24-6208-413e-a17d-23ffb6f22dd6", "text": "He copied contracts.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4dc37c5c-0828-4f5d-adcc-caaeae42239f", "text": "Balag frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8b466c68-6a1b-4f89-8abe-6d7b25555b32", "text": "Then why repair ditches?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dd6fd52f-a01a-443c-8ecd-cb5a7bb2014b", "text": "He said the water couldn't read ownership marks.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
