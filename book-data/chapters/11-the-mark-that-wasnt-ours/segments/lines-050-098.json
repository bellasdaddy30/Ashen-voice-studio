[{"id": "aea455ae-14db-4978-b43f-6796f67dd51a", "text": "The man didn't.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6395e8ba-34c6-4dd9-b2f9-2c6debc1642b", "text": "Ninsun looked up from the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4bd35a32-d7e3-4898-86e8-d4c94796be36", "text": "A scribe.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6bacca82-9de9-44e9-8a85-4b4d21a6cdbc", "text": "Maybe.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "446dd421-98fd-460a-90d0-0c89071dcacf", "text": "The boy shook his head.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4ed2ed23-8d1b-41f5-9ee6-209cdd751bdb", "text": "He didn't walk like one.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "db3d14e6-b445-4863-bd23-0335cc2bd240", "text": "Temple?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a05c79b4-9759-43a8-bdff-f49a45f0b12e", "text": "I don't know.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2fb65d37-4ff6-46c0-b680-ee543e95bec9", "text": "Merchant?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f5b948e2-542f-4448-88b3-838968c08149", "text": "I don't know.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1cf8f06d-1509-4639-b446-a02ad80fd420", "text": "Soldier?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ab4da3fe-b7da-482d-bb12-389f2b50f0e5", "text": "I don't know.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1744eda5-5f7d-4526-9f48-0a52cf83aa0f", "text": "The boy looked genuinely frustrated now.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d1b2fb7b-82f8-4577-aa67-645a85d1c978", "text": "He stood where the alley bends.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6ebf9f77-9197-4f23-96db-66487342c913", "text": "Waiting?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7464d158-7951-4ec8-ac7c-4168a0dfb69f", "text": "Like he already knew I'd come.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7ef55730-801b-4fa5-b5fc-79ee94e6b596", "text": "Balag exchanged a glance with Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eb4afb25-9e01-40bd-8bc4-2879566e248d", "text": "Did he watch us?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9bd6ce6e-2335-4fe4-a84a-1427d5a5f942", "text": "The boy nodded immediately.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f73fe734-6df3-4590-9552-ec0fa3c84046", "text": "He knew which room.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e19419cb-5650-4280-b5e2-99fec7d85c62", "text": "Zik's expression didn't change.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "22853bb6-5e56-4efe-a7b9-99b620edfb67", "text": "Did you tell him?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e03ed1aa-036b-4a43-8795-d0268d949abb", "text": "No.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ca282177-a056-4896-b22b-c950693f0ebf", "text": "He guessed?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e132914b-d9f9-4d64-86e4-47ab6273e446", "text": "He pointed.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5ca833f3-8e98-4fc5-ae4a-68024e1bb315", "text": "Before you came upstairs?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f510362b-9564-4a54-b4bd-58f5b7da79ce", "text": "Before I crossed the street.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "831b14ea-9ce4-450d-b08d-0b93aaf6042b", "text": "Nobody spoke.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "708ea76e-3f27-42a0-a324-2dca20dfe1a4", "text": "The boy finally accepted the coin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "705c5236-2ff8-40e8-9db2-795dad71c764", "text": "He also said something else.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bd48fa99-5fee-4ba1-b563-033650ecadd2", "text": "Balag stiffened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4d2cb14b-9541-4e38-ace3-200ff16b2f58", "text": "What?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ea2fcc6e-bf62-4270-921f-b52d68b72d59", "text": "The boy frowned, trying to remember.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c6891a88-db07-41fc-9248-cb44cf43e3e4", "text": "'Tell them…'", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "43a5f2fd-f5a5-4431-b5ec-2c15a7dda0fa", "text": "He looked at the ceiling.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c653714d-d057-476f-9e8d-656b9dfc3c47", "text": "'…they've started making the wrong marks.'", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ecbd985d-b5e7-4fa1-b8ef-c960a3e0b819", "text": "He shrugged.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c9271ce6-47dd-43fc-a854-6b4c2337801f", "text": "Didn't make much sense.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b2797450-985f-4246-b387-867dfd1f4ad8", "text": "He hurried down the stairs before anyone could stop him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c024dabe-34ae-457d-9548-9bbe915bf3e0", "text": "Balag remained at the doorway until the footsteps disappeared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "13785628-f1c7-487c-80dd-4c48b78cbf8d", "text": "Then he quietly slid the bolt across the door.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f54ec989-6ee7-4f3a-8b93-1737fcb16b58", "text": "He didn't wait for payment. He was already gone when Balag stepped into the lane to look for him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "57b3f81d-8c5f-4f09-8c24-988d9626829b", "text": "Zik unfolded the scrap.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f44c7fe2-26aa-4f7e-8b5b-4582576a32e1", "text": "One line, written in a neat, anonymous hand:", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "745a7a4c-2ee0-48a8-bad1-7ac05cad111b", "text": "STOP MARKING WHAT DOES NOT BELONG TO YOU.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "10946f56-95ff-475a-973c-1ea9512b2a6d", "text": "No signature. No threat beyond the words themselves. The parchment was the same cheap stock the lower scribes used for temporary notes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2a96600c-e425-4003-8e25-92d944adeebf", "text": "Zik turned the parchment over.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "716a7eb3-e460-448e-8765-b0d751188573", "text": "Blank.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e60e55c5-8b88-4645-af9d-c1959089fa1a", "text": "He held it toward the lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
