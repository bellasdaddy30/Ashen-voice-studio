[{"id": "cd0cab19-9b19-4267-9eee-c2d859c0f1f3", "text": "CHAPTER 11", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "f803a75f-67aa-483b-9770-864974308ed0", "text": "The Mark That Wasn't Ours", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "b5bba879-86d7-41ec-bb8d-ccdddbf885dc", "text": "They found the first forged notch on the eighth day.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "36dacf5a-8610-4697-b9cf-463e78128825", "text": "It was in a narrow cut between two dye-houses that had opened overnight and already started to close at the edges. Two clean marks sat at the base of the left wall, cut at the same depth and angle Ninsun used. Beside them someone had added a third—slightly deeper, the edges still sharp with stone dust.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c7d43ef1-5211-4348-b919-e00594592d46", "text": "Balag saw it first. He stopped so suddenly that Enhedu nearly walked into his back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0bcaa7f4-e190-458f-955d-5bb2fd3e7563", "text": "That one's not ours.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f2dd97de-d18e-4a7d-8909-6a93b1d5bd70", "text": "Ninsun crouched and studied the three marks without touching them. After a long moment she shook her head.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "e699e66e-6b6e-4800-bbd6-98c391d778bc", "text": "The third isn't mine. The angle's wrong. Whoever cut it was stronger in the wrist and less patient.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3c42a677-c655-4cff-ad26-2a1a71e49a1d", "text": "Enhedu exhaled through her nose.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "3a34606a-8c9f-4879-8d5f-31822c41ec35", "text": "So either we're not the only ones marking, or the fucking city learned the system.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "456b5eac-4cda-4005-90f4-cb30e15c07da", "text": "No one liked either version.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0affba20-959c-4afc-bb78-2fe4bf38f8e0", "text": "Zik ran his thumb along the third notch. The stone dust came away clean. Fresh. Maybe an hour old. Maybe less. He looked up the short passage. It ended in the usual blank wall that would probably be ordinary brick again by evening.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7ee51ba7-3ae0-4d80-bfb6-a3434b190a95", "text": "We leave it,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c6977026-d2be-46d2-a25d-853dfa6bee21", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "c0c04016-8cad-429d-9ef7-160ea9a44d98", "text": "Balag frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "23eaee8a-2e59-4582-aba1-28101bb210f3", "text": "Just walk away?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bfa94809-2570-4310-8d71-3dc27809226e", "text": "We mark our own and we move. If we start chasing every cut that isn't ours, we'll still be here when the streets forget our names.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e76b566e-2c72-41d5-ae1e-934271c3c462", "text": "Ninsun carefully added the location to her ugly, incomplete map, noting the forged third mark with a small cross. Her handwriting had gotten smaller and tighter over the last few days, as if she were trying to fit more city onto less paper.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "702cf9d2-89e9-44a3-a9e0-2e2c3d455fb0", "text": "They backed out. Behind them the passage had already narrowed enough that a man would have to turn sideways to enter. By the time they reached the main street it looked like a shallow service recess any local would have sworn had always been there.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0a281648-2405-4e7e-b287-4e345754b62d", "text": "That night the consequences arrived.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c696d4c3-79a8-4a80-b572-5640f75643de", "text": "A boy from the lower market found them at the cheap room they were using. He couldn't have been more than fourteen, all elbows and caution. He held out a folded scrap of parchment like it might bite.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c0ad5546-9b5f-4708-9a73-618896e0b58f", "text": "Man said to give this to the ones cutting marks on the walls,", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1263da8e-72ca-4bc2-a055-bbf17fc86bca", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "84db86f2-af85-4255-b24f-1b955afbf17c", "text": "Said you'd know.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f445895a-4bf3-4708-8a17-dc8783ee1b7f", "text": "Balag crouched until he was eye level with the boy.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d31e3c41-1832-4879-ba01-cc395811aaf0", "text": "What man?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b1c3a72f-4170-4890-8456-c002ea639ff5", "text": "The boy shrugged.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9a1c8acb-4616-429c-8d91-4119c54692c3", "text": "Didn't say.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "317e01e7-8f3c-478a-8987-7c06edf16c13", "text": "What did he look like?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "85a95f33-aff3-4ab1-aaac-2c9b198e62a0", "text": "Another shrug.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "08c71a89-a57a-4516-a418-7aaad8f2aae6", "text": "Old.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a6912be8-36cc-4e91-b197-84278d4cfd4e", "text": "How old?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1604645b-2166-4d9b-8035-34e1a5ff8717", "text": "The boy frowned as though the question itself was unreasonable.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f57f3df1-78fb-4288-90e5-92671a09d1d1", "text": "Older than me.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "805ebe6e-8e42-4244-8dd7-611893885b10", "text": "Enhedu snorted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f35dc1ac-8512-47f9-817c-d28faa971459", "text": "Helpful.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3dc71a9a-efc7-4768-95df-d6413469d835", "text": "Balag reached into his pouch and produced a small bronze coin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d330df56-b826-4f34-8753-9f5b7ed8195c", "text": "Try again.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b74cd477-2948-47d6-8ddb-2e259e5215e9", "text": "The boy looked at the coin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "620a15d9-c213-4bb4-8899-81c69736a8e3", "text": "Then at Balag.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0690e2dc-214d-4791-9f01-4ca6b2ac4fb3", "text": "He had clean hands.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "98d8031f-f064-471f-887a-c237eab10219", "text": "Silence.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "767e4b3d-3eb6-449a-a197-4656ee5042a3", "text": "Balag lowered the coin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "38ff9fba-6fd2-413e-b913-aa1a0dd3a708", "text": "What?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "93b30769-1e7e-4613-af7b-e5e35528ec26", "text": "That's what I noticed.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1237489b-8be7-4f12-8c39-e14f7f70357a", "text": "The boy scratched behind one ear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7061d14e-18da-4a44-ad5d-8ddd28f661c1", "text": "Everyone around here has dirty hands.", "speaker": "Messenger Boy", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4332d974-f078-4b07-914e-bccd0c1a309b", "text": "He held up his own fingers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9c91c911-9761-4e17-bd9c-b548334cd26c", "text": "The nails were packed with dust.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
