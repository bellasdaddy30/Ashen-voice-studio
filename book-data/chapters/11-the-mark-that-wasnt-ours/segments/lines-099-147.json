[{"id": "5c6dd9c8-9af6-4119-a962-32b8ac1b0368", "text": "Nothing showed through.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a6354f72-2cf6-40ae-8eb3-5b1b3cf6a3c7", "text": "Enhedu reached for it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "517e66d6-6636-440e-a2fa-d012678047dd", "text": "The handwriting.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "53cb39cc-ad68-4c96-bb01-2b48ee58c02e", "text": "What about it?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "78a7ad02-a898-4b0c-9246-072cf527d12f", "text": "It isn't hurried.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c07f7503-afc8-448a-bddc-9e9bbd4428bd", "text": "She studied the strokes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a7e62be4-000b-4c0c-9eaf-9bd1a9289706", "text": "Whoever wrote this expected we'd read it.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8c7111bc-8307-475e-ae7a-32d02aa77b2a", "text": "Balag frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "15862386-78a8-440a-aa29-e73263af0881", "text": "People usually expect that from letters.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "315ebbbe-0177-4bcb-bc17-786b8f074fe5", "text": "No.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bdaf1fdf-c744-4a86-81ab-2532f59f9b3d", "text": "Enhedu tapped one corner.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d12ffc31-9d34-4295-9eb1-7332ad1df01d", "text": "They expect we'll understand.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3efd3f10-efc2-4cb5-9a33-9a102791313a", "text": "Ninsun stood and crossed the room.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "41e834ff-9d86-4f91-b1d3-bd5d5dbaadb2", "text": "She took the parchment without asking.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e13f4e09-de70-4277-8a3a-a86c86c82e97", "text": "For nearly a minute she said nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9753c146-c7fd-4034-91b9-9bbb70d3199d", "text": "Then she reached into her satchel and removed the map.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b8476e50-1438-4857-b721-ed8dffc4cef3", "text": "She laid the warning beside it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7e7f145e-93fe-493e-96fb-2c0b473c9bf0", "text": "Zik watched her eyes move between the two.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6cdf21b6-ab01-4da8-967a-cfff503fef38", "text": "The spacing.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bf0e0582-846a-449b-9189-5b481a19389f", "text": "What spacing?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "309f16d1-811c-4beb-be3d-c278258877db", "text": "Balag asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "e2b60dcf-89c2-4722-ba60-351c9c359421", "text": "The margins.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "928558bc-8900-434a-9fd0-6d595a82dcdf", "text": "She pointed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a2344f00-8be6-479c-8221-ac34fc70c3bb", "text": "The left margin matches mine.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3c24ac91-b032-46ad-b97d-f24c090132d3", "text": "So?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4b087e8b-bd4b-423d-83b7-f1a473b41bb6", "text": "So does the line height.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1a7b2304-c187-457a-8f8a-b67ecd593e32", "text": "Balag blinked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bf6ff587-fc95-4a26-9049-8e63d44a3310", "text": "I feel like scholars are inventing reasons to be frightened.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3e3ba300-6c47-42e8-82a3-ce608c73f01d", "text": "Ninsun ignored him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7fe8160f-a1cb-4f75-a2d5-bfdad173283d", "text": "I leave exactly this much room at the top of every page.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "29401291-d21f-4866-9927-9ddb2a3ff389", "text": "She demonstrated with her finger.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cf10bcb7-c157-4afe-8777-4aa5313f6e71", "text": "So does whoever wrote this.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "24484708-69f6-48ff-b078-00d5509a2e2f", "text": "Lots of people do.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6c6d83d4-6341-4be2-9b57-9db03aa12be0", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cc9c91ba-1421-41d8-925b-c879a1be8e5d", "text": "She looked up.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a089ac23-0c15-463a-bd71-3e198b50174a", "text": "Not by accident.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1677916c-92d6-49c7-8963-f16cb3b57381", "text": "The room grew very quiet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ff51da2f-e470-4591-b3bc-2221a78ee2ce", "text": "Zik picked up the note again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dee4f004-1595-4897-826d-40ea69936e72", "text": "You think someone copied your habits.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0ddb7d69-84d9-4a9e-b2e3-dfdbc93d072e", "text": "I think…", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f469a258-7bd2-4cff-a713-db5818570363", "text": "She hesitated.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "043463b5-7e3c-45f4-aa37-e3732b8961d1", "text": "…someone has seen enough of my work to imitate it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "77f0d45a-6dd8-4de4-a92c-e8e02446dbe9", "text": "Enhedu folded her arms.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "45636de6-c004-476f-ac4b-30f39d55f545", "text": "Or you've seen theirs.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bd180d68-c1c3-482f-8032-30dab7fe19b1", "text": "Ninsun didn't answer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5cf391a5-98da-4d8c-bc0d-c9eef3695e18", "text": "That silence worried Zik more than anything she could have said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eddb1c20-5468-4f30-8da5-3c09b1a74ab7", "text": "Enhedu read it over his shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "408aed13-cdfa-4516-9219-f8558d9ec880", "text": "Someone's territorial.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b17285c6-0ec4-4a76-8d2e-60774809a501", "text": "Or the city hired better messengers,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
