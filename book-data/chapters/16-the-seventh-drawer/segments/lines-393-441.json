[{"id": "44b8c61f-ddbb-43d9-a56b-26dd104a59db", "text": "What does it say?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "62d1804f-90b6-4a6a-8a72-53c0b90671fe", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "4a4081dd-343c-4529-bdf3-15f987c0db84", "text": "She wiped algae away with her sleeve.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ce60a7e1-b412-47ca-b8a0-7869b703be5b", "text": "'I kept it closed.'", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "72ce1ab6-03ca-44fc-8200-476056a41ade", "text": "Balag looked back toward the chute.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ea0e1b7e-14ac-4d40-9955-8cf81635d2a4", "text": "For how long?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7c1b4985-fcbe-4349-bec7-931c6b6da61f", "text": "Ninsun uncovered the final signs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "60966bb0-20a1-4d2b-a692-6ea741e3ed56", "text": "'Until they used my name as the key.'", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f9c56dcc-038d-40d4-97c4-a1f1ac815ac5", "text": "The water surged.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "926fdab9-9541-41c0-8188-d5b69badd362", "text": "Not much.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8c2b1351-9007-400d-9fdc-71bd0297b00c", "text": "Enough to strike their knees at once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5f3fed2a-1244-4e81-92cf-b1f79201fe33", "text": "The lantern flame bent toward the dark ahead.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "afe8d93d-3915-42b8-99a5-ba390bfe678b", "text": "Zik's satchel moved against his hip.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "09bec214-c501-450e-a326-87428e732817", "text": "He stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3835a2ab-fba3-48c4-84d9-7cc855ebe710", "text": "Something inside it had shifted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c6c4e66c-8ecf-4303-9ebf-90ce22668779", "text": "Enhedu looked at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "40016201-093b-45cc-99d6-7a6dd4ec6015", "text": "What?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3c3b3eba-49df-4c66-ab17-14fbd1c753fe", "text": "The journal.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "92112211-c10c-4506-8d2a-f9c37c3f973b", "text": "You haven't opened it.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e9bf6c65-6177-44fc-9172-ebc02e6b7c5a", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "70025f3e-bb91-4bca-8d96-692a4b5968cc", "text": "That did not answer me.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "eac467fe-f7f2-4b9f-8a82-e5428fc565fa", "text": "The satchel struck his side again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "447a1024-c500-4383-b041-4cf7df47b300", "text": "A dull, contained thump.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "680e4acb-aa75-417e-acfc-13871480f8b3", "text": "Balag raised the spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "25ca7faa-6b16-4139-b43a-678509a2ec1c", "text": "The book is moving.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "df4d4326-01d5-43cf-b484-60e0d7fb1bf3", "text": "It's a book,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5609f9b5-d495-42b6-ba5f-320f0580e215", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "11e1d156-6595-4625-9ca7-2c56e5c9a0c6", "text": "The satchel thumped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d7eabe0e-ba41-4c6d-8f90-d7f9012d5505", "text": "Ninsun stood.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7bdc8892-dc7d-4cda-ac93-3c2e99cc3c77", "text": "That argument is losing strength.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9eb0c797-37e9-4577-afab-7d2979676497", "text": "Behind them, voices entered the drain.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "51922e61-febc-45d4-aa17-3c3aebefba25", "text": "Faint.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "518e544a-42ae-4a74-ba14-4ed4ac147ed8", "text": "Distorted by brick and water.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6d1f08fb-3566-4b97-b2a4-95ab57ed7ded", "text": "The guards had reached the chute.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9e6bdf01-f1cb-4a9b-9ff3-5f0bff64be0e", "text": "A lamp appeared far back along the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "23d6731a-7e19-4835-ab20-b28917e6d0c4", "text": "Balag turned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "88334d79-82cd-4d0c-8276-1e948bfedd24", "text": "We need an exit.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f7607a5b-4aca-46cf-b9fb-e0f89036632d", "text": "Ninsun examined the wall beside Ammaru's name.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2e475b59-214b-4a7f-a648-c6cdfb1cfd6e", "text": "The mortar around one brick differed from the rest.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cd5f64b2-120d-45e0-b84b-f67ee4c53e3f", "text": "Here.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9bd2e8ff-c735-4abd-b19b-a512949b1b3f", "text": "Balag shoved the spear into Zik's hands and struck the brick with the heel of his palm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "310bedbe-b7e9-4808-9d3a-8f8c1b632dcd", "text": "It moved inward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f9835895-260f-4109-997d-25cfb67f00b1", "text": "Enhedu joined him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cba91f16-8d50-47f6-9ea9-8db46b781a86", "text": "Together they pushed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3cdfac52-68e0-4d45-84a3-263205cf8330", "text": "A rectangular section of wall gave way with a wet grinding sound. Cold evening air rushed through the opening, carrying rain, smoke, and the smell of frying onions.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "304b0c44-fe64-409b-b180-de1aca4e6bf0", "text": "Balag widened the gap and looked through.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "96bfcfa2-77ba-45cb-8125-836b1624ecbf", "text": "Alley.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "610ba3d4-c09f-4b63-9b9b-e31a68c4a7cc", "text": "How high?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "10cb38c1-408c-49d1-a1c6-bf1ad9ad8895", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false}]
