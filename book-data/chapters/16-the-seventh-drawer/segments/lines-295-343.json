[{"id": "0ab02bdc-836c-47fa-86d4-10cd406abf6e", "text": "A hand reached through before the shelf closed. The guard's fingers scraped against Zik's boot.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5f8cd09b-e31f-4175-b834-bbf78295e91d", "text": "Balag drove the butt of his spear backward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e11d564d-fdad-46c2-a440-1d4a73b662fb", "text": "Bone cracked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "30eddbbb-beea-4fc8-9d17-fa91079babee", "text": "The hand vanished.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e8f3b025-a3f6-479f-aee6-a36f5b87efb4", "text": "The shelf slammed into place.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f8b688a6-7642-4c77-975c-48c8d128c527", "text": "Darkness swallowed them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "31586a93-3c2a-450f-9982-8f7b4940b88c", "text": "For several moments, the only sounds were water, breath, and the guard screaming on the other side of the wood.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "398da604-ed53-4791-96ca-f2d5b2f89aa6", "text": "Then Balag began crawling again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b8d9565c-89eb-4903-84c3-f34286d6f835", "text": "The culvert was too narrow to turn around. Zik moved on his hands and knees, his shoulders scraping the damp brick. Water flowed toward him, carrying grit, bits of straw, and the sour smell of rotting grain. The satchel at his side dragged against the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f0d2722c-0882-45ef-824c-b9932014f81f", "text": "Ahead, Ninsun whispered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "254800a4-4037-4b0d-b5a7-eff1a480cb65", "text": "There's a turn.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7b7a1b2a-7691-4582-bd67-8a274b00f971", "text": "Which direction?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bccf0481-f2c0-4251-9015-f8b4e8c263c6", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "6769e182-b50f-4476-8d81-b4a4c831b31c", "text": "Down.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f8e49d48-45c2-4047-a299-5c4f7bdaf102", "text": "Balag stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4eb6972e-94e4-4f7c-b795-1e856db06e41", "text": "No.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a08faaaf-f479-4b6a-b4bd-9aabb3b80ae9", "text": "There's no other way.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6588eac0-873c-4cbb-8df5-f75d963accbf", "text": "Water doesn't flow down forever.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5f0f0be1-a4fd-4e5f-8f3c-809733d4ec3b", "text": "Neither do we.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c91773c8-3219-4b75-bc87-89b290d0b971", "text": "That is exactly what I'm trying to ensure.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "272d40f3-885d-431a-a906-bd262252da5e", "text": "Zik reached Balag's heels.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9457830b-77fa-45a7-bdcf-90d473c09d6f", "text": "Move.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "92799b18-6bf2-4d0b-9627-ba3342e56fa9", "text": "Balag muttered a curse and continued.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ab5879dd-6fed-4f8d-84ca-7053ff9f8d63", "text": "The floor dropped without warning.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "da9ef0f7-4a0e-4576-acc9-5d36d4f0d865", "text": "Ninsun gave a short cry.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "32bad7a0-a960-4b70-83d8-fa661d3f59da", "text": "Enhedu's boots scraped across brick.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6dd5afb5-bee6-43a8-97b7-bed184d0017c", "text": "Balag disappeared over the edge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c196c4eb-12e3-4f0f-805e-2bd819f5e6b7", "text": "Zik braced his hands, but the current caught the lower half of his body and dragged him forward. His knees struck the lip. He slid down a steep clay chute slick with runoff.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8fb0da39-4c71-4c1b-8dac-29a9db570ef1", "text": "The passage opened around him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ba6a95e4-3cc0-4c18-9d74-ad7cacc6ebfb", "text": "He dropped perhaps six feet and landed in water deep enough to reach his thighs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "49df8b72-4b55-40db-939f-e1cdb6285e7e", "text": "Balag caught him before he fell backward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e4bdc167-6028-46c0-8fc5-fca8f10f9a48", "text": "Quiet,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "Whispered.", "generated": false},
{"id": "ee97c7d2-8db9-4e26-9166-d1d012b928d4", "text": "Ninsun whispered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "f7aba5da-badb-41aa-b259-d8dc83d7f432", "text": "They stood in a buried drain wide enough for two people to walk abreast. A curved brick ceiling vanished into darkness in both directions. Rainwater ran along a central channel, quick and black beneath the weak light Enhedu had uncovered from her shuttered lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f31e1801-2a70-400c-b8b0-1f2b08329a0b", "text": "Behind them, the chute ended in a square opening high in the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2cd4b148-d9d8-4048-8bb7-8eedd63c92ae", "text": "No one followed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "33e33c20-38ca-4daa-8d7e-d906ca2fb4c6", "text": "Not yet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3b6687ae-e2d2-4958-9880-4f5000cd3e31", "text": "Enhedu lifted the lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b19f2136-0e7d-446c-ad51-c56f04b6fead", "text": "Marks covered the bricks.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ebaa4348-ca1c-42d8-83bf-6cc311f58e36", "text": "Not writing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9fd50099-309f-4b3e-9898-badf321271e6", "text": "Survey lines.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c7deb031-75b6-4794-a49b-0ee0a804a710", "text": "Hundreds of them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e79706ef-e11e-454b-a64b-3a578999cd4a", "text": "Short horizontal cuts appeared at regular intervals along the drain. Some had numbers beside them recording flood heights. Others had been crossed out. Newer marks had been cut lower than older ones even though the channel floor had not changed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0b66ae7a-b3d4-4016-939d-69992e2c203d", "text": "Ninsun moved closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "aa2da499-931f-4465-a980-a46c319245d3", "text": "These measurements are impossible.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9e1e1442-bfde-49a2-b333-e930ecdf4346", "text": "Balag wiped water from his beard.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2073de7a-de3f-4f6e-8612-795384c252aa", "text": "I was worried we might find something sensible.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "51f1495f-deec-4f54-9f21-d278892a8066", "text": "The dates go backward.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d45da002-02d8-4aa9-840e-c211b279626e", "text": "She traced the lowest mark.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
