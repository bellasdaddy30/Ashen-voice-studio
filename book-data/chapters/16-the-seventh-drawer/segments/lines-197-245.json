[{"id": "0ac641e5-e8ca-4635-84ce-00ef72b34e05", "text": "The one the temple admits happened.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cc5d7f4f-1fd6-4873-a3d9-5355175201cc", "text": "That narrows nothing.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5037da25-4d63-4a66-95a2-47a3464d4dc9", "text": "Mardu's expression remained flat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fdf45f7c-b008-4bde-80da-5f366f6fbc66", "text": "The ledgers tied with yellow cord.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "14a27f10-cfc9-4bcc-b77b-cec4bdcc406a", "text": "Enhedu found the bundle and pulled.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a340249d-e4e9-4f46-8015-3c7cf522647e", "text": "The shelf behind it moved half a finger's width.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0e005dba-a3d5-44f1-aa8d-de05fe2eecb9", "text": "Balag crossed the chamber in two strides, set his shoulder against the wood, and shoved. The entire lower section slid inward with a grind of stone beneath timber.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bda9119c-15fd-4f01-a82a-8b71d9bffe5f", "text": "Cold, wet air entered the archive.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9947e57b-e5eb-4122-b766-67fda51f9439", "text": "Behind the shelf lay a rectangular opening barely high enough to crawl through. Black water moved along the bottom in a shallow, steady sheet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c0f29fb8-e39f-475a-bca7-ea4a4209e521", "text": "Balag peered inside.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4c4353a9-488f-4fdf-9b52-028adeaef94c", "text": "Smells like an animal died in there.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b67e5d0c-2252-4861-83bd-4739b0f064e3", "text": "Mardu looked down from the doorway.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cc80f56b-cad5-4abb-888b-915e74a3b52c", "text": "Many have.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bfab1558-8af5-48a0-8c3e-6a99f209bce1", "text": "Better and better.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1255c273-a30a-45ee-a79e-0b10ae2dffc0", "text": "The guard above returned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8325315b-d1c8-4549-97df-39a7a54d635f", "text": "Mardu.", "speaker": "Archive Guard", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3328022f-fef3-4959-887d-1e86241e3625", "text": "The custodian turned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9c490e57-4da6-44f5-aa96-1d600537c37e", "text": "The door shifted under a hand from the other side.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "354544fb-2366-4bdb-aa39-a1aa6852cef4", "text": "This hinge looks fine.", "speaker": "Archive Guard", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bccc5db8-429e-4807-9262-f9943c7a6ac9", "text": "Mardu reached for the edge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9e974b1b-3910-480f-8f3a-f02a2e43979a", "text": "To the contrary.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cdef056b-b876-48c1-8f87-95fa615b1b77", "text": "He pulled the archive door shut.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "75e0d019-c46c-42fa-969d-96c1166f8966", "text": "The wedge of lamplight narrowed over the steps.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "16029c53-a585-4c90-9e2a-65db2924c8a7", "text": "His eyes met Zik's for one final moment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c6127ecd-bced-44d7-b1d6-40a499f1d0ef", "text": "Your father did not ask what was beneath the city,", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9d794118-86e8-44cc-800e-0d65e17be709", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "137783ff-53bd-41c1-bef7-c41085e60eee", "text": "The light became a line.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0fad49eb-4267-4e30-b990-8c8d62a09bbb", "text": "He asked what the city was built on top of.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b73644ca-144d-4691-90e8-73d024700a2e", "text": "The door closed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "41a100f6-9266-4fa4-8373-d2d3a30e8681", "text": "The lock turned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c808105f-dd98-48ec-85f5-bad9dbe71191", "text": "Darkness dropped into the chamber.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6c93f299-5aa5-4b85-9307-cdd778283688", "text": "A fist struck the wood from above.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3d34855c-c485-41c5-8ff3-155d8cefb197", "text": "Mardu?", "speaker": "Archive Guard", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "58174acd-8b5a-407a-bae0-e6a8a0bd4ac4", "text": "The custodian's voice came muffled through the door.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ff858dba-4c28-4a05-8f36-c046b78d56c8", "text": "The pin is stuck.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "778e8aac-7f54-486c-8580-dce7b217a76d", "text": "Balag crouched beside the culvert.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "486f1c5f-46ae-464b-87df-6e9d2dcfe67a", "text": "Who first?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8e0dcbc0-35de-4141-8664-ca05a615f5a7", "text": "Ninsun,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e089f937-5ba7-45aa-9241-72aae46ff08c", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "2ef0c75b-88d3-4d56-99e7-234808c37b3d", "text": "She turned toward the locked drawers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7eee9265-ca7e-446e-ac70-d786e27893e0", "text": "The seventh—", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ae0ad0bb-410f-4b8f-bd6a-a83f3570c9cc", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d11598e8-96ed-4b1f-a8f4-8339855a1e9e", "text": "It may contain Bel-iddin's name.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "48e9ef22-10c5-4b96-872e-900a9ad77e77", "text": "And three men are standing above us.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6522fa00-2ff4-4ac4-a55d-613f4d63a9c3", "text": "We came for a record.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0921e7b7-7f33-4848-a563-38a7938ac310", "text": "We have one.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f61360f5-7cf8-4317-9534-579e5d44535e", "text": "We have a copy of a margin.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "51328536-88d3-4d96-890b-6c8dfbf52808", "text": "We have enough to leave.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dc9d9294-bd72-45df-a611-1b066a456802", "text": "Ninsun stared at the blank-faced seventh drawer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
