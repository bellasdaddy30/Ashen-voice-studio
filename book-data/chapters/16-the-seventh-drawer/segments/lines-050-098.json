[{"id": "8a130bcd-02d1-461b-bc16-f9f483fd91ca", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "5eb94946-42bb-4dbc-9460-3b79d8b0b535", "text": "The custodian's mouth tightened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6d595660-7adc-425f-b842-3f815ffe7187", "text": "The true answer has been corrected six times.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8984c7e0-01bb-4045-a668-db917073407c", "text": "Ninsun brought the tablet into the lamp's reach.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "347a89a3-7a80-4824-a291-6be60e60c3ef", "text": "This says he kept the lower cistern stair.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b8bf59dd-ab31-4fa8-8e8f-a0c26763a8b9", "text": "It used to.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0e469da7-6e73-48b7-80a6-db75fe2a782e", "text": "She glanced down.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1bc537bc-8712-4530-8ae2-a381e5abd6f3", "text": "The writing along the margin had softened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "920a3985-e221-49b3-90bd-15ac8f87b5d2", "text": "At first Zik thought rain had found its way into the chamber, but the tablet was dry. The old clay had begun to darken around the smallest wedges. Their edges rounded before his eyes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "36ff18d7-b457-4348-ad1e-99d43faaa556", "text": "Ninsun inhaled sharply.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7b99188b-3cd0-4d2c-98ac-2608464e773b", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bc78654b-139c-4bf1-965b-94087cb2d2a7", "text": "She shifted the tablet toward the light.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "819a39b4-8ebc-424a-aaac-5c9b21e60ff1", "text": "The first line contracted into itself.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "49f41fa7-ec18-4e1d-941b-6038bcade6e6", "text": "AMMARU, SON OF DAGAN-ILI.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "7da19f08-9616-4186-8677-ee3eb337f548", "text": "The wedges drew closed as though pressed from beneath by an invisible thumb. Clay rose into the incisions, filling them without leaving a seam.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f606ed33-c1a5-42d2-8a0f-b1851048d28f", "text": "Ninsun scraped at one sign with her nail.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d4a527df-a1a9-4e22-9eaf-02d5411887bd", "text": "The clay yielded.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "68e797de-87b7-4973-b7bf-78c27e3d93d9", "text": "Fresh.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2da0f7ed-efca-4df9-88d4-91c5721520b1", "text": "Soft.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f17d9630-e29c-4d9d-93cf-149dfabab37f", "text": "Balag glanced from the tablet to the custodian.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c930f6e6-c07c-4780-8a0c-ecde19c89ce2", "text": "What did you do?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "546d309a-b3e9-4a3e-8176-bc6b5391afda", "text": "The old man did not look at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7e11911e-5382-471d-b62b-8c00d2a51a45", "text": "Nothing.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ea136af5-2e06-4c45-b1b4-d373efe899c7", "text": "The second line vanished.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8aa835e8-ad43-4f2b-80c5-fcb4177f0c57", "text": "POTTER BY TRADE. KEEPER OF THE LOWER CISTERN STAIR BY HEREDITARY OBLIGATION.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "2ad4beca-1996-4384-a4d8-066ffb3225ee", "text": "The last word collapsed first. Then the line before it. The clay smoothed itself from right to left, erasing the sentence faster than Ninsun could trace it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4dcb3bd5-9b46-46d9-a52f-17280a80096c", "text": "She pulled her copied scrap from inside her robe and unfolded it with one hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3f25bac5-03b9-4684-a134-8d438e1f6def", "text": "Her ink remained.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "651b0739-6bbb-43b8-9ab3-9b49209e3421", "text": "Your copy will last longer,", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7c04caf9-70ac-4318-9fa0-fcbd51d24dd3", "text": "the custodian said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "b0faeb79-8539-46c7-bc31-1d3b4ccda37b", "text": "How much longer?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "11cf392e-791c-4757-87bd-9a813ce175f0", "text": "she asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "4f04d5c9-9e13-4dc5-a7d4-c61a5d0e0ddb", "text": "I don't know.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "772591f6-b450-4fb5-a4b6-67d4433f6938", "text": "The final line on the tablet held.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bdbd71a7-b8a7-4db1-94f5-6558fba18ab1", "text": "PROPERTY EXEMPT FROM LEVY WHILE SEVENTH ACCESS REMAINS SEALED.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Written text (ledger/inscription/journal, not in Bel-iddin's hand). Cold, deliberate read.", "generated": false},
{"id": "6a918aee-607c-4cc4-8458-0f251bf21ddf", "text": "The wedges shuddered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9f3f99cf-baa6-4f46-ae93-e921b23c5112", "text": "Zik saw it clearly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "63cdaec8-622e-41b9-8ec1-dead430cdc6a", "text": "Not the whole tablet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "23aa467a-bcaf-4488-94b4-0c8758c1eaf5", "text": "Only the writing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0069deec-72aa-41c7-951d-c39ae4f939fb", "text": "The signs trembled in place like insects pinned to the clay.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "660345d6-bd7d-4a01-9613-2c9f74c42c81", "text": "Then they closed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "68dc5eaf-2c55-4361-83fb-cb44a240a88f", "text": "The tablet became blank except for the ordinary tax figures on its face.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "96bc2526-2e24-409f-862d-7276e0196335", "text": "Ninsun stared at it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9b78ba33-d50c-4e5e-afbc-8e9a490f79fa", "text": "The custodian watched her copied scrap.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0a98db33-eebf-4344-832c-9334ae39b952", "text": "That is why the drawers are locked,", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9d70d51b-2a92-4939-8d08-e4d56c74b490", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "928a0a3e-ef89-49ec-aba1-4383fd591652", "text": "To protect the records?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "45785e46-fe63-4b53-84f9-3e3f905a2135", "text": "Ninsun asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ce1c483c-6d23-4fed-b5e0-c2a8e3bbde88", "text": "No.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
