[{"id": "a94a7dfa-ca3c-423a-ab2d-1c127b5d3b2a", "text": "This was cut twelve years before the one above it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9dcce180-196d-4715-a137-74f740929dd7", "text": "So the water dropped.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d52f3162-0248-4db8-9ae4-b26a566e3591", "text": "No. The record says the drain became deeper.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5a074832-8654-4d5d-a225-c215bd25d5b1", "text": "Zik looked along the channel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "edccf63e-1ccf-48e7-940f-5f4fe1fdd71c", "text": "The bricks ahead appeared to slope gently upward. The water ran toward them anyway.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "15e59a16-896a-4d63-a6a3-7c4c55741555", "text": "Enhedu saw it too.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cc0d01b8-f748-42e8-b3f8-ba30020cb49d", "text": "No.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "32ec5ad4-7027-406c-a590-ce7cf4f7e7e8", "text": "She lowered the lamp until the flame reflected in the current.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3255cdb7-400e-4ee0-9cde-f0084271b7fa", "text": "The water climbed the incline in a smooth black ribbon.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e54962a1-7285-4410-a3a5-be3e3b11aacd", "text": "Balag watched it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "aeca6fb7-c7f1-4b3e-8524-474a3173eb79", "text": "I would like to return to the part where guards were trying to arrest us.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a3cd2c59-9692-429f-89b7-421e76637766", "text": "A heavy impact came from the chute behind them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "489fb5db-b656-49cd-a2c8-dd97fb4ae662", "text": "Dust fell from the ceiling.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8651661b-c4bf-4ba0-96d7-9543832b9fb5", "text": "They found the shelf,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "17ec009a-898a-44e5-a318-e1c2d61989e6", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "bab120c0-32da-4ed1-8aaf-78809d4034f7", "text": "Ninsun pointed toward the rising channel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5026a66b-0394-4a6a-a59b-63baeb0c9c95", "text": "That way.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f85d4edd-a706-4c3a-a715-9d8370569bb9", "text": "Why?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1c142824-762c-4de1-bd38-520ab64f3583", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "dc496507-ea1e-427b-bfa6-ce45ff68553a", "text": "The survey marks continue.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c4601221-1a49-4043-ad9e-edf57438d2a5", "text": "Balag looked toward the opposite direction.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c3bcf37d-7989-454d-883a-40f10d47b313", "text": "And that way?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "685d6738-26d9-43f3-b038-2a4e66dbeb82", "text": "No marks.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a3579e93-c6c3-48f9-a768-131fea5b4070", "text": "Which means?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9d474ac1-2877-4222-90e2-3e6361214dd5", "text": "It means nobody came back to measure it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2bfca928-9f20-46fc-9f92-0704f3a8bb88", "text": "Balag stared at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a39d5b91-20ef-47c5-ad2a-0dd4640cbadc", "text": "You do hear yourself.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "25dc3e45-99c4-413b-897a-91aaa98eef2d", "text": "Another impact struck the chute.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7bc3e24b-26c2-477a-9b26-767c7e70abef", "text": "Zik took the lamp from Enhedu.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9875d27a-f1db-4a73-9465-8842c40e2607", "text": "We follow the water.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "093354a9-8694-4fcb-b1ff-3f8803532944", "text": "Uphill,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dec31ed6-880c-4dbc-948f-e816e0c3d2cb", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "600c55c3-ac2d-4854-b188-a5b6dcfab4c0", "text": "Yes.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "227dc8dc-0ea2-4f67-84e1-375a2669c4c3", "text": "Of course we do.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "692b9781-c801-48a4-bc43-0d77e53c543d", "text": "They moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "68bd4748-5163-4680-ad82-e61cc0782f24", "text": "The drain narrowed after twenty paces. The curved ceiling lowered until Balag had to bow his head. Water pressed against their shins, flowing steadily in the same impossible direction.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "21f54434-c9d1-43ca-bf30-d38b6d08e747", "text": "Zik held the lamp close to the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "00ae5be0-53c7-4587-a180-03aa9a6b3aa3", "text": "The survey marks changed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c85d6ba5-e0de-4286-a2bf-fef32ccebc95", "text": "Numbers disappeared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ff13e08b-ebf9-430d-b7db-50dc809ba7b0", "text": "Names replaced them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c651bbbd-3b87-4c48-8e51-22b580f286c8", "text": "Most had been scored through.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e7fd9739-2f1a-4db1-a765-5264a12c49de", "text": "A few survived only as fragments.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "279bfcc0-c05e-4015-831e-1952f23792df", "text": "Ninsun stopped beside one.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ade4f8b8-ba92-4086-a93c-e196b770e659", "text": "Ammaru.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b358f781-b9c6-436d-a53c-61b142052f43", "text": "The name had been cut near knee height.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "606fa8b1-2ea1-450a-8231-a194a92e6152", "text": "Not in the formal hand of the ledger clerk.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a3d91d8e-ed27-46ac-99fd-55023d748afb", "text": "The signs were broad and uneven, made by someone more accustomed to clay than stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b467b5e-8733-43fd-a166-705655c10506", "text": "Beneath them, a smaller line remained intact.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "561f10ed-e158-443b-bbc6-1968d7acb3ec", "text": "Ninsun crouched.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
