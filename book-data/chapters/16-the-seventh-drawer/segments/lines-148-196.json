[{"id": "6810db28-1beb-4822-a10d-47a73109501d", "text": "The custodian raised the lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a4ea5bcb-e3c9-43ca-b154-43a219aaa436", "text": "His shadow stretched down the steps, long enough to reach the seven drawers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ae1504ed-fba0-47fa-afb1-c403578da47f", "text": "He opened it anyway,", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "70d69e27-2e53-43da-bdeb-1990195c8bcf", "text": "Mardu said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "83206861-46a7-4d86-bb8a-b83d25c4944b", "text": "After that, the archive began remembering him differently.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f441b96e-17a9-4b0a-bc37-b3610fb8b125", "text": "Zik took another step.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "053baf42-f5db-4a52-a171-5d4d8d2c7059", "text": "What does that mean?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "82da4b36-089e-4601-9720-3fbca32864c4", "text": "It means some ledgers placed him in districts he had never visited. Some listed debts older than his grandfather. One recorded his death.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3505999c-8070-4bb0-9405-364cf30295d4", "text": "Ninsun's voice sharpened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ecf6cfae-a424-41d4-8261-62723652447c", "text": "When?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ed6a3321-4659-4015-84ca-78ab1f4d31a4", "text": "Three years before he came here.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5e48bb77-26ab-45f3-965e-5f562205ef18", "text": "The archive door moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a28addd9-66bf-4e08-b6cd-6a33891750ad", "text": "Someone above tested it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9c4386e4-1c8a-491d-9eb4-2377ea44b778", "text": "Mardu looked up.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "944cd422-f0fa-4838-bc31-b5389d9e604e", "text": "The guard rattled the handle.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b77bde42-4602-4871-a25c-9f4ae265baa8", "text": "Mardu, open this.", "speaker": "Archive Guard", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4ec4e644-70f1-470d-87e2-210376ec07ee", "text": "The custodian stepped backward onto the storage-room floor and raised his voice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "42e42021-1bfe-4141-9f9f-194c515be464", "text": "The hinge pin slipped again.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bd9cafb0-a785-4f1d-b2c9-c7682805abc1", "text": "A pause.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ca7f82a5-1e62-438e-9a14-93228e56b0d6", "text": "Need help?", "speaker": "Archive Guard", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4fe81488-dca9-41c2-a45f-13eeb828db5a", "text": "No.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5bf02f46-b6d8-4de9-95b2-90e280160817", "text": "You've been down there too long.", "speaker": "Archive Guard", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "49ede861-7ed3-4a5f-b857-a1583ff266b7", "text": "I am old. Everything takes too long.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "41379878-c362-4214-a52d-566901c70f5d", "text": "Balag's mouth twitched despite himself.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bffbbea6-56b6-4a43-85f2-1bfde4266645", "text": "The guard muttered something to the clerk. Their footsteps moved away, but not far.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "116f5d5e-6f3e-494d-b218-a0234bafc2f7", "text": "Mardu looked down at the four of them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cd99041a-4c49-4779-89df-9d2340e837aa", "text": "You have perhaps half a minute before curiosity defeats laziness.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "49132e16-bf3c-4e2a-a0e5-76c13237835d", "text": "Enhedu slid her knife back into its sheath.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "071d5bb7-0d7e-49bc-ad55-9a0998d0fca9", "text": "Can you get us out?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "defaddc1-1a59-45c7-ab56-2e825f3c4630", "text": "I can prevent them from entering.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "55d0e531-d00d-4e17-9a73-2a32a847ae13", "text": "That is not the same thing.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b285e1fe-af80-4b77-9615-5988d984d235", "text": "No.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "46ca2301-6a79-42c4-95aa-c04b77092bf9", "text": "Mardu reached beneath his robe and removed a narrow bronze key.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7a7fde00-5fe7-4b75-a8c5-1f29c61d88ce", "text": "It was too long for the archive lock.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e0c426c2-3e20-4d9f-ac09-8c5ccf3aa46b", "text": "He tossed it down.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8ce2bfaa-bf3a-4900-8b4a-7823ac29baf7", "text": "Ninsun caught it against her chest with the blank tablet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3a78e109-0183-4b20-89ec-3440646a9001", "text": "The seventh drawer?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5f306e8a-92c0-4557-8df4-1530a4293f2c", "text": "she asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "3d0d4453-9355-4242-a899-d15e796bb572", "text": "The drainage culvert.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5802e872-5180-4df2-bd9c-c2fe0c07c85e", "text": "Balag looked around the windowless chamber.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f36d0d47-66e8-4a94-afa3-fa5558aa5ac6", "text": "We're below street level.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "95253844-5b6d-416a-ae6c-d850130cf546", "text": "Water dislikes bureaucracy. The builders gave it a private route.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4bedf02c-4a0a-4df5-9493-818fad416fce", "text": "Where?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "687a1ded-4037-4cdd-b05f-9a4be5aec23d", "text": "Mardu pointed toward the shelves behind Enhedu.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ebe5a55f-d083-43f7-b2b2-c08034f48356", "text": "Remove the plague ledgers.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9d81972d-0266-4a09-8c9d-597c777afad5", "text": "Enhedu turned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "db2fe95f-1428-49ae-b475-2979e9621e94", "text": "Which plague?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c7c8bcd5-3d71-4020-9889-7528b0172f26", "text": "The third.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6935271e-595e-4597-bace-347e73c7a285", "text": "There were five.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
