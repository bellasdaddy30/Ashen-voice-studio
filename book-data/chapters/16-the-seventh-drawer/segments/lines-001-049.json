[{"id": "2c3f3f32-3cc6-41f1-9656-3b37f1857679", "text": "CHAPTER 16", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "959b5240-2df5-4e4c-a242-8212f7d244b5", "text": "The Seventh Drawer", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "8f293b1d-2ec0-4226-b151-6b752c60e1a4", "text": "The lock turned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cc2491c0-0ff2-4283-a637-30e56ebdc9e3", "text": "Balag shifted in front of Ninsun, placing his body between her and the archive door. In the dark, the movement was nearly silent. Only the leather wrapping on his spear gave a faint creak beneath his grip.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "27e19c8c-0a94-4050-b516-2a63b1b35c8b", "text": "Ninsun held Ammaru's ledger tablet against her chest.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "83492f3a-c906-43c5-8c7f-207ee0e4893f", "text": "Enhedu stood beside the lowest shelf with her knife angled down along her forearm, hidden from anyone entering above. Zik remained near the foot of the steps, close enough to see the thin line of light beneath the door.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e66059fc-8125-4433-b17e-7abba1d759b4", "text": "The key withdrew.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "295c8441-fcaf-4efd-9daa-766a764e909d", "text": "The door did not open.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e494866f-76f5-4667-917b-8d44c09df2e4", "text": "Rain drummed against the roof of the weigh-station. The sound came through the ceiling beams and packed earth as a low, continuous tapping, like fingers spread across the entire building.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9ed8462d-53de-43b5-8c87-98a98acbb4da", "text": "For several breaths, nothing happened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7410546d-3976-482c-8bc8-22b85a0ece71", "text": "Then a man spoke from the other side.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fa8f5fa0-ea2d-4988-80b2-8ced32c57289", "text": "You have taken the wrong tablet.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a18171e6-e0ba-4a78-9c08-dbfcb2d405c2", "text": "Balag looked toward Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "09552f5c-d65b-40d4-8d01-a368495f93e9", "text": "Zik said nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f8db02b8-bfd7-4daa-927e-b1bf7ca0afd2", "text": "The voice was old. Not weak. Worn smooth by repetition.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e729b244-021b-4306-893c-7154618f0567", "text": "The grain exemptions are two shelves to your right,", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0931b8e0-0778-45ec-8cde-c3b91b08885d", "text": "the man continued.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "d7be34a5-1c9b-4ad8-836d-f57b8c4a4a52", "text": "The inheritance appeals are behind you. The tablet in the woman's hands belongs in a locked drawer.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "22de7e2b-0821-4afd-8969-3fecc0e8d68e", "text": "Ninsun's fingers tightened around the clay.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c85b08e7-f8c1-461d-9b30-65c10184af04", "text": "Enhedu raised her voice just enough to carry through the door.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "72b76398-2250-47cf-b793-f7c37d30ac8c", "text": "You can see through wood?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "49d6ad3d-a50a-44ae-9623-65020312ae53", "text": "No.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b95561dd-62ab-41ea-a31b-352334b211c0", "text": "A pause.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "31aa5444-8f0d-4275-96a6-b4d86cb82013", "text": "I have spent thirty-one years listening to people become quiet on the other side of it.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5c15bbf1-589c-4264-bddc-ebcca0513318", "text": "The key entered the lock again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a3d1f5ce-5395-475e-81a8-1ea01ed944d2", "text": "Balag lowered the spear point toward the top of the steps.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2463f1b7-46d5-4db4-8a4c-52d843bfd464", "text": "The bolt slid back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "09e111f8-0faa-471a-a59c-496bea346165", "text": "The door opened inward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3ed9f87b-13bb-4f63-8cdb-b19debf49523", "text": "Lamplight spilled down the three narrow steps and spread across the archive floor in a weak amber wedge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "237747fd-49c4-4bbc-8bb2-c2bcfdbe6a64", "text": "A single man stood above them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7cf296fc-187d-47f1-b342-230715426b2a", "text": "He wore the undyed robe of a lower archive custodian. The cloth hung loosely from narrow shoulders bent forward by years spent over tables. Ink stained the first two fingers of his right hand all the way to the nails. His hair had gone almost entirely white, though his eyebrows remained dark and heavy over deep-set eyes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "53f540be-daa4-4894-a352-3c45d501bbb8", "text": "No guard stood behind him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "271c27e1-cfd6-4302-8276-80fdd22530c2", "text": "He looked first at Balag's spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9f2b9260-f44a-480f-a812-a753f39e03fe", "text": "Then Enhedu's knife.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "16cb9ecd-8449-4815-8d46-9a0e53d4db38", "text": "Then Zik's wrapped hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5551ae4a-a3a7-4ef4-b78f-7d5003c6b278", "text": "His gaze settled on the ledger tablet pressed against Ninsun's chest.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f4ca8aa7-784a-4e87-b9f7-4d674fc42d3c", "text": "Ammaru,", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "abd18faf-6311-4734-994a-73f93b73ed41", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "285a26c2-4d9e-4e9d-8257-caa911e432cd", "text": "Ninsun did not lower it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "86cebe6d-4b67-41b7-ba76-b5ff4b9ad51c", "text": "You know the name.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f439e062-a975-44da-ba23-30386ae26ce5", "text": "I know the space where the name used to be.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "626a46a2-d378-4824-ad99-bb90ace3e89d", "text": "What happened to him?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "441a62e4-07de-4b45-b126-d3fc8a366277", "text": "The custodian descended one step.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "11250d09-5910-4e0a-83d5-1cb701300842", "text": "Balag lifted the spear point until it hovered level with the man's throat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "477cf3ba-9edf-4ab2-9d9d-d59beb3a5caf", "text": "The custodian stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3aa35f9e-9174-49fe-b768-cfa875817156", "text": "Nothing happened to Ammaru,", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "20116b1b-95c6-47bc-a1c9-573e8d989109", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "7e70a515-678d-4ebe-9ec5-458d06c4ab22", "text": "That is the official answer.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c6d3102d-4922-4156-92a4-9bcc7f1c8bb8", "text": "And the true one?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
