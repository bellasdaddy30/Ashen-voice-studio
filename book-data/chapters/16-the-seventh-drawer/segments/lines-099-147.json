[{"id": "1b188236-5e71-4789-ab0f-d9d47cc4979b", "text": "His eyes moved toward the seven narrow drawers fitted into the far wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8049fa9b-9cba-4d41-b813-366109c46311", "text": "To stop people from noticing that the records do not remain the same.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6e306159-e73a-47e8-837d-6861495b40d6", "text": "A heavy tread crossed the storage room above them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5726a880-6e62-47cf-bc6e-df7ce2c92e8d", "text": "The custodian's head turned slightly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "46e2e30c-7f17-43e4-bf4c-4be618377837", "text": "Someone dragged one of the broken scales aside.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e07c173a-c15d-4565-9b1b-d7728bb7f7f6", "text": "A man coughed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d9a01fb2-b6d9-4846-b8d6-5af67f5e25b5", "text": "Another voice called,", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "8ca6f894-2ea5-4892-bcbc-dda2331fcc95", "text": "Mardu?", "speaker": "Archive Guard", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "feb6c30f-838c-4027-984b-c58cc6a3b9ec", "text": "The old custodian did not answer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b81f7eaf-ae59-4a24-b756-b25dc4dadd7a", "text": "Enhedu lowered her voice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1b394455-ac0c-458a-8b22-d2edcacf17c6", "text": "You came alone.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8fb7e237-4367-4210-9a14-a6c768d8ba40", "text": "I came first.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d83c9031-12bb-49d0-9be2-9cb039ce5cee", "text": "Who's above us?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1f56ee5b-401d-4996-9c4f-029047fe0ab6", "text": "Two temple guards and a clerk who believes authority improves when repeated loudly.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "50d47972-bffd-4e7e-9aa3-fd8f3397c613", "text": "Balag's grip tightened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c3c93511-169e-432f-b667-bc129e467a78", "text": "How many exits?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d6bcabf0-f218-4815-9085-6b41c9482482", "text": "One.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dbaf631b-0fd4-46a9-a132-504625f642cd", "text": "That's not an answer I enjoy.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7fb48dbe-604c-4021-8917-4570c2d25093", "text": "It is the answer the room has.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9e54f742-5eca-401b-9363-aa40f47cbcc9", "text": "The voice above called again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d19bca91-c0a2-4418-bc17-45ffaf363cf5", "text": "Mardu, are you down there?", "speaker": "Archive Guard", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9b2d33f6-1bca-4e94-87a1-f310b188fac9", "text": "The custodian looked at Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "685f928f-6cee-4b36-9507-5514ca02a94f", "text": "You are Bel-iddin's son.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3c726eb7-86e6-4037-8454-eb30dc029cb4", "text": "It was not a question.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1e24620c-a8b9-44be-9d01-495a780cc7f3", "text": "Zik felt the linen around his left hand tighten as his fingers curled.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "be57a15d-c535-47de-b65a-2d26ff767d80", "text": "You knew him.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b0be7943-14f5-4d03-9f72-89412e357281", "text": "I opened this door for him.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3783538e-fa9d-43d2-aea4-eb806b75437a", "text": "When?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5e7b7100-1bf6-4daf-a493-a569788d45f1", "text": "Long enough ago that I still believed records were safer than people.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2dbb229f-6051-456c-936e-5e55e85b244c", "text": "Zik stepped closer to the bottom stair.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "52f01892-2805-44bd-af9c-509935eece2d", "text": "What did he take?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a774d78a-f019-4926-be60-543502097d39", "text": "Nothing.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "20b59578-d91f-4f17-973b-a46f7bc43ef7", "text": "What did he find?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "09db28f8-4694-4868-afa5-94f710604471", "text": "The custodian looked past him toward the locked drawers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3636c267-9c8e-4537-b624-568d13579dd3", "text": "The seventh drawer.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "76fc3577-55eb-4814-ad0c-0085e14a285e", "text": "Ninsun followed his gaze.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d61affb1-352b-4e23-91bc-18dce744720a", "text": "Each drawer had a bronze faceplate darkened by age. Six bore district codes. The seventh had no writing at all.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "21591410-1790-4c86-9ab9-7bf09f7ad6b4", "text": "Only a shallow depression where a seal had once been hammered flat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8779bda9-b12e-4528-a8f6-343e31e8411d", "text": "What was inside?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4ded0f4c-3257-4b2c-acb2-8eaa6a1f5a97", "text": "she asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ff327437-592b-4b72-93b9-264e02611ebf", "text": "Mardu's expression changed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7a4c55dd-3087-4f2d-a1a3-c0287011297a", "text": "Not fear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "820d7230-96a0-4e2d-88c2-d9c0c89cd53d", "text": "Recognition of it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3f36d66f-e4b0-4943-9bba-312ddd3bc333", "text": "Your father's name.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "27367abb-b3ef-410e-8b48-574f47a4d7f6", "text": "Zik stared at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "66d95d87-b6cd-4b2a-86ec-bc0606f244bc", "text": "He wasn't born when those ledgers were written.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d91ab6f4-ddc6-4b66-a190-4b57ecde958a", "text": "I told him the same thing.", "speaker": "Mardu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3e9719bf-779a-4365-94cf-033e67afe0e3", "text": "The guard above came closer. His boots struck the floor directly over the archive door.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5d617dfc-d1bc-46a1-8c62-e94a3e8fbe21", "text": "Mardu?", "speaker": "Archive Guard", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
