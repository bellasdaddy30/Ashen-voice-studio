[{"id": "98396a1d-4e6e-48f5-ad11-2d655ab68bfc", "text": "The blow against the archive door came again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e3b52fdd-3ed8-4509-b8d2-04638238318b", "text": "Harder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e1200952-08a8-420a-8925-34ee26b9a546", "text": "Wood creaked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "03e511ef-9975-4354-9571-9f65ad458728", "text": "Balag caught Ninsun by the upper arm and steered her toward the opening.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "654dc534-e92d-47d7-bcbb-7139dad5f2b6", "text": "She twisted free.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "77088fd9-6e25-4f89-9dfe-6bef69cbc5e1", "text": "Do not drag me.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "102957bb-a636-43ee-ba7a-db884b3b639d", "text": "Then crawl.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c0fc6d46-65fe-4e19-89d7-b768be6c2be7", "text": "She dropped to her knees and pushed the copied ledger scrap deep inside her robe. The blank tablet she left on the floor.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "526506ca-693d-442b-93b6-8d3513b5cacf", "text": "Zik noticed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6cfaa178-fdde-472e-bb45-ffe6743528d8", "text": "Ninsun noticed him noticing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "91a1f26d-7226-4f68-95e4-8c2f0c3c0980", "text": "It is no longer evidence.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dadf6ad4-09e1-4198-9f43-b6c6e31258ca", "text": "It was evidence ten breaths ago.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1c752fb1-e7d8-4594-a90d-76164535c49b", "text": "That is not the same thing.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "921f1b21-0dcf-4640-b29d-bc7d54d8e32a", "text": "She entered the culvert.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "87b75e21-e100-4432-a648-8af0cc1c518c", "text": "Black water closed over her hands.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e125aa97-aab5-4927-adf8-6f64d4ac402a", "text": "Enhedu followed, keeping one shoulder raised to protect her satchel from the flow. Balag thrust his spear into the tunnel ahead of him and crawled after her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c3992963-898e-4daf-9518-92a1b4acd77f", "text": "Zik remained in the archive.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "29c4b744-4013-463e-9e67-58cb0ed9e542", "text": "The door shook.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b9789557-fa4e-4a07-b17a-b9114bdca8e8", "text": "A crack split down from the upper hinge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a08328c4-e319-4e16-8be9-252d1095955d", "text": "Mardu!", "speaker": "Archive Guard", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "urgent", "generated": false},
{"id": "e94f07c9-ce33-4e18-9294-b2c3633baf03", "text": "the guard shouted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "6e7d0567-a874-4f03-a55e-4dd96e20b272", "text": "The custodian said something Zik could not hear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7e4fde4d-d9e9-46db-9db4-fb2279b15511", "text": "The guard answered with a curse.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ff5088b4-3434-49a5-8d06-64e552fe3500", "text": "Zik turned toward the seventh drawer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a4a76718-e309-4630-b374-598b7c7e7e7b", "text": "The mark beneath the linen pulsed once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dcac72a1-02d4-45ff-90bd-c3e07af4b312", "text": "A slow pressure spread through his palm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e021b5b6-be6e-42d2-9f05-fc43edf18cbd", "text": "The bronze faceplate on the drawer gave a faint click.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d93222b0-c997-4417-974e-b0fae7b5068f", "text": "Not opening.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8083331e-7b57-4a54-8c29-929719fa4315", "text": "Acknowledging.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cd585aac-fa6a-49ac-b93b-289581871059", "text": "He stepped toward it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "11e96736-9d97-45be-9627-8d68fc4ad1e1", "text": "From inside the culvert, Balag's voice came back through the dark.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3044c04e-4414-4438-be03-11ebee60fbf5", "text": "Zik.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0af914f1-af62-4652-b7d4-826616c2783a", "text": "Another crack opened in the archive door.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "08fab4f5-e5db-4dbf-ac5e-7b6c9b24be4c", "text": "Zik looked at the drawer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fcdd7a6e-0675-4e32-8a7e-a0e6d269fc97", "text": "Its blank face reflected no light, yet he could see the outline of his wrapped hand in it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5bbb6979-6974-42d8-a9d2-0758485f9595", "text": "Not his reflection.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a59607ca-6908-4607-b25d-0290dd6b1e1d", "text": "An impression.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "aaf19597-bf01-4cb0-b2ae-e3405669ac2c", "text": "Five dark fingers pressed outward from the other side of the bronze.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "057adf47-166b-4893-b869-f68efa87bfa4", "text": "Zik.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "de842513-6789-4c3e-ba0a-30209fdb6cc9", "text": "He backed away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "23b5ae5e-1fa2-4a32-97f0-2db3451f8476", "text": "The fingers remained.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ffe6e5b8-d2e0-423e-bcef-da421ea536bd", "text": "The archive door split near the lock.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e1128d48-ce33-4bdd-bff3-39e5f3aa1d38", "text": "Zik dropped to his knees and entered the culvert.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2a0fe27d-1f39-495a-808a-f43c213f89e8", "text": "Balag seized his forearm and pulled him forward just as the archive door burst open behind them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ab482bfc-800e-484e-beba-47f008cec62c", "text": "Lamplight flooded the chamber.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a50a9960-da73-40f7-9941-717d8f5957c8", "text": "A guard shouted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "16040f90-0b3e-4c93-8263-7199216db256", "text": "Zik kicked the hidden shelf.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "aebb4a4c-e284-4b59-8f1e-458b40866e12", "text": "It swung back across the opening.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "adb41a18-1dad-4322-891f-8888ccde1bbe", "text": "The light narrowed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
