[{"id": "f9f072eb-d107-4144-ba20-b86f0ffd8275", "text": "I see it.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f8bf6a28-f08e-49d7-aea0-87693c5e72aa", "text": "Barely.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "97b82c6d-7916-4c9b-9025-32af561c8f66", "text": "The survey marks had been cut so shallow they disappeared unless viewed from exactly the right angle.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4f04d63a-867b-4ebf-aac3-1cdbc6e0ead9", "text": "Zik knelt beside them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0b5cc3ca-8c9b-4e6b-9754-04c4504dd24a", "text": "They expected later repairs.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "125b3919-5680-4a12-bf9b-f7523188c049", "text": "What?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6f385832-d876-4a40-ac25-2735366694c6", "text": "They carved them after the wall was finished.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "25e585fd-540a-459f-9b2b-c676d9288913", "text": "He pointed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "57c48426-6ced-42ca-8e79-82e09191945d", "text": "If these were construction marks, they'd be beneath this plaster.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "351e5308-1bdb-478f-b6b6-8594509db9fb", "text": "Instead they sat on top of it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "87ab9001-0890-455d-9e9e-c0af231fff31", "text": "They wanted someone to erase them.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8a40ab88-6ba1-4d02-a9df-b506637508f3", "text": "Balag frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ce2eca61-b1f8-46b0-a627-605ad6831fbd", "text": "That's a strange thing to want.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "22cb659e-b934-49e5-b2ee-dec242dcceff", "text": "No.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9fbab585-af10-4bfc-a6fd-50bf57154cee", "text": "Ninsun's voice was almost a whisper.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f90a9f86-1f02-4fd0-ba0c-fa9423b65273", "text": "It's a very ordinary thing.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9537f67c-9b2f-49dc-8637-3c4b9f8110a3", "text": "They all looked at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a4e4e83b-0932-423b-a920-af7fbc7999bd", "text": "History is easier to hide when you know exactly where someone will try.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6564dfb1-da64-4021-b6fc-d8686256d2a9", "text": "She continued cleaning.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9ced9297-7021-48eb-8af8-8cbaa827bdb8", "text": "Slowly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d7f9136f-4fc7-4b27-a452-05cf02e66057", "text": "One wedge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "693c6d6f-f6ef-4104-bc97-da33463e843a", "text": "Another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a90260c6-4fea-4671-ae44-4292b1a0c169", "text": "Then the spiral.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0710b955-887c-4913-8588-ed0a94429fd5", "text": "Not scratched.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "50015633-1ad2-478b-aa33-cffdcd1173e4", "text": "Not painted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "32631701-533d-4427-b3d9-db9806b30f9a", "text": "Deliberately carved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d1ac7240-6467-4790-b02c-9e4333d1cc92", "text": "Then attacked with a chisel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0e47a7e8-1118-4ca2-ac6e-31ed2a954ede", "text": "The damage had broken the symbol but not destroyed it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "87374f6a-5724-40b0-9a23-982faaa23f72", "text": "Whoever erased it had worked angrily.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "545f9d33-0873-468c-bd21-d900f306782b", "text": "Or hurriedly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cce37e5b-3b5d-4cc1-a1fa-48fd516e7bdc", "text": "Zik touched the deepest cut.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f2add1ff-389a-48bc-bc83-5f3e576506c5", "text": "They came back.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0ce7a46e-4437-4e10-87dd-6cae468c5af8", "text": "How do you know?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "40533e6b-6780-4114-8c1a-538da89cd4d6", "text": "The scoring crosses weathering.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d52a69c6-4516-43b6-af24-5f9fa99349c3", "text": "He looked up.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "87ce61fa-7bcc-45d3-801f-3a1d26d7eb53", "text": "The wall aged.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5e211fa5-c874-4b89-9fdb-f2f2bb34b270", "text": "Then somebody returned years later just to erase this.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1f0916b7-499f-4e05-bad2-929a95ce33b0", "text": "Silence.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c066e60f-0312-4f62-a353-6f76b1a41c08", "text": "Balag looked around the empty survey site.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "73816615-08b0-4cf7-8fa0-afa4c033a84b", "text": "I dislike the amount of effort strangers keep spending on old bricks.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e02069a3-254a-4a5c-b61b-74b74ffa729c", "text": "The marks were old temple survey code, the kind used for private boundary work rather than public walls. Most of it was routine. One cluster near the bottom was not. The same spiral-drop that lived under the linen on Zik's hand had been cut into the brick and then deliberately defaced—scored through so hard the chisel had split the face of the course.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "26e23102-a230-4ca0-ae75-1a507043b17a", "text": "Beside it, in a tighter hand, three signs remained legible.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "173d43bd-aa65-47fe-9f10-0be475e1841d", "text": "Ninsun's voice had gone flat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "7b9f421c-6c7d-4552-b1b0-34f83a6f5629", "text": "That's the same seal language as the broken piece we pulled from the shifted chamber. And the name under it—", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "04b1f48a-9b24-4edf-840a-26ff74b9c896", "text": "She stopped, then finished quietly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ffc572cb-eaa0-4c86-8295-de2f208f2a18", "text": "It's the uncrossed name. The one from the basin. The ordinary one. The potter or the dock worker or whoever the city decided wasn't worth erasing completely.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5934cc9a-e467-459f-9c9f-78ccc265a573", "text": "Balag stared at the defaced symbol.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "e0f54823-807f-410b-9f19-157a2f119d3e", "text": "So the same mark shows up on a royal tomb, a shifted street, and a temple curtain wall that officially has nothing to do with either.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f646d7aa-3236-458d-93fc-22b42660324e", "text": "And on an ordinary person's name the city only half-deleted,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
