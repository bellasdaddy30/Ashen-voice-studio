[{"id": "393f3d53-3807-4a67-a51e-1f3bc515fb71", "text": "Pause.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c802718a-1856-454d-ab92-987ca8e3a353", "text": "Once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "605842ae-8d49-4555-9e3c-07df9300c799", "text": "He stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b1654539-ff94-4105-8b79-d9faf0f31e73", "text": "Balag's hand struck his boot.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "83c2499f-af5c-4ae3-be76-4450246dae74", "text": "Why?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7c75c402-d82d-42b3-bac7-1c016c681a1f", "text": "Listen.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "32486341-261e-482c-9be8-31f6dc542c75", "text": "They held still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "56be1002-d983-42b3-91bf-9f8c8d8ac7c1", "text": "Water trickled through the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d308d94d-5dec-4a9c-ad65-e2485a36ef43", "text": "From somewhere beneath them came a faint answering knock.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f1262244-f923-4548-9213-cc9566d09e0e", "text": "Once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "42576078-b29c-4c25-af8e-d4d2d6a0f83a", "text": "Pause.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "05fd459a-3034-4d58-8695-e32f82cf4485", "text": "Twice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5ff3696e-aa87-41bc-9a7e-b1191c2808a4", "text": "Ninsun looked back over her shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d45abe05-dff9-4948-88d6-00b6fb2645fe", "text": "There is another channel below us.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e9f08b64-5c30-4640-b63d-0b1cb4ccf1a3", "text": "No,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "92cf49dc-2f31-454e-aa0a-a0ab93f465b4", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "6636a1ff-258f-4e79-a07d-d6c1b4620f95", "text": "How do you know?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "08d0e2a7-5a1a-4024-9cd1-a5f2dbb0b855", "text": "The old drainage plans show only this one.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3856e29d-f70a-4506-8150-bcc6cc8ee8fa", "text": "You trust the city records now?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1a8c159d-d3bc-4b64-b386-d6c4269c2a12", "text": "Another knock came from beneath the floor.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4d849f86-5dab-4c37-a3a3-5d322363981c", "text": "Closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3226ef03-767b-40fc-9e20-4ce59bfbb258", "text": "Balag pressed one palm to the brick.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4b2a854c-79d5-48b5-a08b-d585eba106e6", "text": "The sound stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "df3da176-d658-46bb-bd17-606f0e987953", "text": "He withdrew his hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ee088f93-7e55-4589-8ea0-b8721107d0df", "text": "It began again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d1cc9188-1ee0-40fe-a29f-3b187b5c206f", "text": "Once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a855d373-f4df-45a5-919b-401babb52bed", "text": "Pause.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f3fdf821-b8b8-4d0a-a03c-9f0dd5ff7cff", "text": "Twice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "630f053b-01ef-44dc-98fe-ae239d6a1a24", "text": "Enhedu's voice came from ahead.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e4c1c50e-8a1b-4f1d-b6a4-08214f550dcc", "text": "Move.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "aea9c670-e805-47fb-bc41-b71439742f32", "text": "No one argued.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3ddc4297-39f6-45eb-a96a-68cd51b151ff", "text": "They crawled faster.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e159c57d-2674-436c-89ba-408582272906", "text": "The channel narrowed near the center of the wall. Balag's pack scraped both sides at once. He cursed, twisted, and forced himself through by exhaling until his chest flattened enough to pass.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b8ddb4b-ead7-44aa-8bec-ecae55fc72bf", "text": "Zik's fingers struck something hard in the mud.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2ee1ae5c-a1da-40e1-bb78-8578d5e92a11", "text": "He pulled it free.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c65688e0-215a-4ca1-878b-460925d0a582", "text": "A fragment of fired clay.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3f7daa8a-e9ca-4428-a50a-bcc3080ee0d2", "text": "Curved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "efb5ecdb-eff3-4e13-823e-e5569c1d82e5", "text": "Inscribed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4df69003-0d5d-41f7-949d-baba01d44ce8", "text": "He held it near the tiny glow of Ninsun's covered lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a8ab4ac0-7466-48f5-bf4a-289d42cace96", "text": "One sign remained visible.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6e82e082-f90e-4762-bd8e-e5d032e35bfd", "text": "A descending wedge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "13032402-b459-40ac-b1f4-792b4616dd1c", "text": "Then another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "29110565-2c79-4649-b579-db38c4edbc19", "text": "Then another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "385c2052-8d24-4b73-b1ee-52bbc817ee5d", "text": "A fourth had been added beneath them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4ab48224-c875-4f81-84e2-8bc17d20beed", "text": "The same message they had found in the wall cavity.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5b4d86f1-b98f-47e2-a85d-40ba60311b94", "text": "Zik dropped the fragment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ad83df86-dacc-448c-a622-3058c07f9850", "text": "The water carried it backward toward Balag.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ef93d6e5-7ba4-438e-9ce0-35c65c2b4198", "text": "Why did you do that?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "36942a33-8a04-488a-b7f2-56e60f763151", "text": "Ninsun asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false}]
