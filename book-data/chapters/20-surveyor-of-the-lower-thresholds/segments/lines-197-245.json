[{"id": "c02f83b4-9494-4871-8b32-f93429981473", "text": "Some doors are sealed because the thing behind them is still waiting.", "speaker": "False Scribe", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Memory echo of the false scribe's last line. Nervousness gone; suddenly older. Slower, calmer, lower.", "generated": false},
{"id": "027880ca-976d-40ce-9d0b-873814b498da", "text": "You didn't send him,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b01560c4-c0ee-4d88-9b4b-2afb85e4d2f1", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "0bc8fbd7-dd6e-49e2-bdab-de9b18670f75", "text": "Ninsun looked toward him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b5e02f67-ff53-4b3b-9639-b79118d78058", "text": "Balag's eyes narrowed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "800e82fb-39d7-4883-b17e-4f68c3f7a49e", "text": "No,", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bec19caa-0e14-4b52-9746-fc844a64ba06", "text": "the Collector said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "30e2c5c0-7e1e-455d-8503-9e9ac726ebbc", "text": "The room seemed to contract.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6c9ad0e2-61f6-4251-86d8-4d8c4b0aac81", "text": "Who was he?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "99f6c80d-6910-4777-b4c1-a6a4f34aea67", "text": "I hoped you might tell me.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6bdfaac9-a987-4d73-8143-416e7eb2b826", "text": "He knew about the journal.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8f10a2d1-1cdb-4c7f-bbd9-1a04a6c79c90", "text": "Yes.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9998fa1b-18d0-4f87-bf09-db39118122c9", "text": "The chamber.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6c4dfe1b-8858-44f6-997b-f33a85a3c9f3", "text": "Probably.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0280400e-a1b0-4049-aa09-254b8319870f", "text": "The mark.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5aec3092-d06b-4939-8fc6-7068e5202ad8", "text": "Certainly.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "158bdf5d-a66d-4652-a49f-a6421d175dcd", "text": "And he used your name.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "328e37b0-4256-4926-882f-cd606411b47a", "text": "Most thieves use something that belongs to another man.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4c4bb745-9a13-4c82-8e9a-6c949ab66210", "text": "Enhedu moved closer to the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9280b50a-f10f-4313-957d-488db54c6f4b", "text": "You let him walk away?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0a2b20be-9d7c-470c-8de2-5c4960cd75e6", "text": "Zik looked at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7ac247d9-1981-4d4f-af7c-ae12729dd891", "text": "He looked like a temple scribe.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "14cfb2a4-c73c-4b46-a623-703a7f0a3a38", "text": "That is not an answer.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c1367938-623c-44e0-aec2-5dd8a71c8bbc", "text": "He also had a knife against his side.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e6f31546-b760-41e8-821e-663b4ecf1dbc", "text": "Apparently that did not inconvenience him.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "df87ecb0-1c84-4213-bd6f-5c1f159adf1e", "text": "The Collector gave a faint sound through the wood.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4cbcc2b3-dbc7-4e4a-9c3d-60353fb8c140", "text": "It might have been laughter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a367cd84-9798-4852-a28c-1ce409c9d9f2", "text": "Enhedu's knife struck the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8c521436-b668-42bb-a027-2dd9af3d11ff", "text": "The blade passed between the boards and stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8d391a56-bff9-4de4-a006-3b9b7b72c5d4", "text": "There was no cry outside.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "99bb2ff1-fd54-4613-a0be-c2d5e778f661", "text": "No sudden movement.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "63d93ba4-5bda-4224-8530-f7aaa9f06553", "text": "She withdrew it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a14f8025-a696-4d5c-89c6-33b963cd4fbf", "text": "The point was clean.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0520f333-c52e-4835-9ad9-adb8a46b57af", "text": "You are standing farther away than you sound,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "980649e6-bc91-406b-bee0-01950f42c41c", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "f40fdbf5-288d-4fc6-85ba-28dd0754f5a4", "text": "Yes.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "56e59b4e-96e7-4265-9df3-11b176661225", "text": "How?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5b9c55df-78c5-49fa-af67-3692c983265b", "text": "Practice.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "87e58826-679f-4eb3-8b4e-99ded2b82e8d", "text": "I dislike him,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d0005fef-4c11-4ca2-afcc-8edebd4f4aed", "text": "she said to no one in particular.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "2b801d4f-4b2a-42d6-8efa-679ac4092c66", "text": "That may be the safest conclusion we have reached,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2129d2a8-c2bf-4466-bd63-66fa8787c5ad", "text": "Ninsun said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ffc60263-3e88-42e4-853d-19b70a37e7bd", "text": "Zik kept his attention on the alley.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f9b0f106-ab45-4ec7-a175-2736e48a8883", "text": "Why are you here?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "469ae8f0-34b1-469f-a21b-0c1ad434dfff", "text": "Because you are leaving through the lime-kiln breach.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "03a7a263-20c7-452d-b13e-490fb4fce88a", "text": "Enhedu's second knife appeared in her other hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6e0f0e1b-62ca-479f-82a2-952c3f69d145", "text": "Balag looked toward Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6a98e447-bd01-4d71-b270-33707c41b40b", "text": "Ninsun folded Bel-iddin's warning once more.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4dbcf45f-eb50-44fe-8aad-7bedbbbfedf4", "text": "Zik touched the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
