[{"id": "24ce0dfe-6bc7-48bd-8db0-dc176e7f066c", "text": "Good.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "23e19b34-55f8-4821-a153-834d4b68ef49", "text": "Why is that good?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ac30ae77-4b14-48fb-802d-56e73396e005", "text": "I am tired of being the only one who sees impossible things.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0120a151-e24d-493a-83f9-f799d5232633", "text": "They crossed the roofs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "abbc8c03-3eb8-435b-bd42-c08ca0a7817d", "text": "The rain stopped while they moved through the western quarter. Clouds covered the moon, and water streamed from the buildings into the lanes below.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8c25edf8-896a-4b87-a131-718d9e9f3f59", "text": "They descended behind a dyer's workshop.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dbc29be8-7ccc-4c3c-b3eb-ecf7885e92d8", "text": "The vats had been covered for the night, but the air still smelled of indigo, lye, and wet wool. Zik landed beside a stack of clay jars and caught one before it tipped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "523402b9-079d-4262-9108-423d6f5b3585", "text": "Enhedu dropped lightly beside him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1a67cba8-8fa6-437c-b46a-14b76e216963", "text": "Ninsun descended with less elegance and more commentary.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "15598dd8-e463-480d-859a-9ed572daccd0", "text": "Balag came last, dislodging a section of reed matting that struck him across the shoulders.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7fea0403-4f81-4583-96e7-4bf8c236a80b", "text": "He pulled it free.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2ab74d84-358e-4250-b3fc-53870d1de879", "text": "The city objects to my shape.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e7ce1d59-89d6-4cd3-983d-df79e6378c6c", "text": "The city has standards,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "038629e0-cfc5-41c3-8dd1-511ac8b47fcb", "text": "Enhedu said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "abd7d57b-f223-4da1-917a-7b544ca52548", "text": "They entered the street.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "44d0cb19-0755-429e-aa42-36c9274fc668", "text": "Uruk had emptied to guards, late porters, and dogs searching the gutters. A line of temple laborers crossed ahead carrying covered baskets between them. None looked toward Zik's group.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "94f4fb29-fa50-4b1a-848b-189ecb77f1c8", "text": "They kept to the narrow lanes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ad544d4d-7757-417a-9afc-df35fa888ef0", "text": "At every junction, Enhedu moved ahead, listened, then signaled them through. Once she stopped so suddenly that Ninsun walked into Balag's back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bb3d0ba7-a703-4c3f-b90a-3819cc10175e", "text": "Two guards stood beneath an awning twenty paces ahead.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "42ea4e0d-9397-4c09-9f84-e6f5ef2cae42", "text": "One held a lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fed14698-ddb8-40a8-bdc2-9ed371e27136", "text": "The other had a tablet tucked beneath his arm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d0c1c1a3-0a65-4835-b01d-dbd0669b43ac", "text": "Zik looked at the silver seal fixed to its edge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "efd4253a-6908-4d38-b942-2e7f323ab515", "text": "The same seal the false scribe had carried.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "775304a2-abd7-40cf-a528-b365be4608cd", "text": "The mark in his palm began to itch.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "89d571f8-8177-44cb-9350-66db4c930126", "text": "Enhedu drew them into the doorway of a closed grain shop.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "af0474bc-bfe7-4fa6-b6f7-9ba3e49d91ea", "text": "The guards did not speak.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "03d791c8-f4ac-4341-9607-4d7899fae211", "text": "They simply watched the street.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5962adf9-37fc-4e64-8760-0ac06a6442d7", "text": "Rainwater dripped from the lamp guard's helmet.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "20eb2c69-b75e-4c90-b77f-c94a3f5361f7", "text": "His companion turned his head.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d53eeb54-0129-4ee5-973b-0069e72aa39b", "text": "Not toward the alley.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "968877e6-fde5-4330-9ecd-4b6d35f5434b", "text": "Toward Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "90219b3f-a6b4-44c0-815f-aafc569f9b32", "text": "The distance was too great for him to see through the darkness.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1f5d4710-0e38-4ec7-baf6-22535fb21185", "text": "Still, his face aligned exactly with the doorway.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "386abaa5-3a0d-4f8d-8c50-63ebb2725db9", "text": "The journal pressed against Zik's back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d53ec75d-1f07-453d-a8af-314762fc1c72", "text": "Once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cb0adbcd-a3c9-458f-8f98-de2f8db36e6e", "text": "The guard smiled.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eeed834b-8de8-4ae8-8a95-762af8ebbac6", "text": "Enhedu pulled Zik deeper into the recess.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "97ba50a8-9637-4a8e-8dbd-14ac5417effd", "text": "The guards continued walking.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "60392335-27df-4b36-8914-5b4ba1364263", "text": "Their sandals passed the entrance without slowing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "56183c54-b58b-4775-9769-988b4e435a19", "text": "Neither looked inside.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "77e7b2eb-0012-4e89-8f27-184c79c4c0d0", "text": "Balag waited until the sound faded.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eb68da2f-34ef-4d30-99b4-a04738c0cbc3", "text": "Collector's men?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "98aeb970-0462-4129-bd78-d58da366d1cf", "text": "No,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6c992d68-5969-440a-9a1c-0bf2c3a73686", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "28f85d21-1a72-4d2c-ad1f-5385428c425d", "text": "How do you know?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a376f137-fb00-4e36-9b96-945ac14998b5", "text": "He said he did not send the scribe.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "46b297f2-42f2-4a5f-99cc-539ae011a724", "text": "You believe him?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8398f494-f1ed-4d1c-9d90-5a4a8df9d475", "text": "About that.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e3d24dbf-c4e8-4a76-9d36-e0f51f392bf0", "text": "Why?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
