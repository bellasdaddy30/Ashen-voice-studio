[{"id": "5dece6cd-e672-4454-ba70-98a402828f5e", "text": "Records disagree.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e4e80d67-4c41-4d1d-b67a-2c8a97f26cbe", "text": "My father surveyed irrigation channels, burial chambers, collapsed foundations, and whatever else people were foolish enough to build over unstable ground. He was never appointed to anything called a lower threshold.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2661b1eb-8124-4ef2-b25d-4f35a1f2bc71", "text": "No appointment was required.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b00b21ea-8679-405d-a8b0-fabae3bd883a", "text": "You just said there was a record.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e9cc9e79-ce3b-4ea0-91e7-877c20ae8ef2", "text": "Yes.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "69b45344-8dcb-471a-b80c-0ee645cb229b", "text": "That is usually what appointments are for.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "93d3ba6d-552b-457b-bf31-87728e821a21", "text": "Usually.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f1dfa592-c0ec-43dd-982d-e4a84d2202ee", "text": "Ninsun approached the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2d8b6069-4426-41bf-a817-97eb78a6d2ff", "text": "The tablet was older than Bel-iddin.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a8345144-d49c-4882-a5db-48fb71c7bf84", "text": "The Collector did not answer immediately.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "247a0e75-f55f-40a1-a654-736cf91fe913", "text": "Yes.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "64b15004-d060-450d-a0b4-57b17b2cdf6c", "text": "How much older?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "34ee07f6-ea6a-4c2c-9b1b-6e91b681ff96", "text": "Old enough that the scribe who impressed it had no reason to know his name.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5ef3b314-e5c9-46ad-9bde-283142245201", "text": "Balag's grip tightened on the haft of his axe.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e4de1b5a-1ac0-47f1-8c4d-bd2de27d0b50", "text": "Zik leaned nearer the wood.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bc487429-b0db-4629-8d76-6bfc84d075ec", "text": "What else did it say?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e0f23a94-14ec-4293-844f-b6ba2cc16f8a", "text": "The date of his appointment.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fbb408e2-9d59-44d3-a908-9b71c79a114e", "text": "When?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1745ab29-06c4-430b-9ba4-ce65f6746541", "text": "The day Kurash died.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7ab414f5-ced5-48d2-a07d-3008e23156d6", "text": "The words reached Balag before they reached anyone else.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6a37e2be-1eca-47ed-8594-53db2378c2a0", "text": "His shoulders went still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5614f995-db23-4087-910f-951d70f0bf43", "text": "That happened years later,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c1da9b3d-21e1-4ddc-a28c-23f65b5e0a49", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "28cd35cc-6b96-4748-904c-ea2cceb960c2", "text": "I know.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a6ade9ae-bf6c-4484-942e-f3c9ce6f26d8", "text": "You saw the tablet?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5bc544cd-a521-4bf2-b7c9-eba9ddd20aa9", "text": "I saw your father break it.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d71ae7e7-3862-4c13-be8b-703ea1b139e7", "text": "Balag crossed half the room before Zik caught his forearm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "188ccc12-4302-4406-884f-9f1cb0fa75ba", "text": "The movement was silent except for the faint creak of leather around the axe grip.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "62597cad-120c-4c44-9206-1c0b5c402a9f", "text": "Why?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f21165e8-2359-4f54-8999-2532b13cfd16", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "0eb84dc2-f3eb-41d5-93f1-f0d29fe83302", "text": "Because the final line named his successor.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6eb62db2-1b40-4c4a-ac39-d899eb50846b", "text": "The journal shifted beneath Zik's hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1aa0979a-1bb3-46cc-9dc7-cd67bf416fdd", "text": "Not a knock.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0508d6b7-a698-460e-982c-1eca10aa93d3", "text": "A slow pressure from inside the satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "48c1efc5-e45b-4c07-bac0-da5c45c7204c", "text": "Who?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ee1c7473-f475-44d7-a2ad-6ed0c5a45d65", "text": "he asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "69fa76a4-b056-40a6-854c-651ab9c9969b", "text": "The Collector waited.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4671b13c-fdbf-460d-b172-30a255d0ec22", "text": "Zik heard water dripping from the eaves into the alley below.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ed61ceb6-7a39-4a73-8f67-89544408dbc8", "text": "One drop.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "55f9973d-b6dc-4437-a5d3-176c59efe7e5", "text": "Then another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0545e2ed-e278-454b-8d30-bc88229a5bb1", "text": "You,", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fe199b8c-04ef-4e63-abc7-c8b8a2b4428a", "text": "the Collector said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "519894f1-0615-4db3-ba39-04a54a069bcd", "text": "The journal knocked once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "72c11edc-3f34-46ab-b278-ff16f9624336", "text": "The sound was softer than it had been in the courtyard.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cbb7ed5c-c9e8-4f23-acec-cd2e9e45be66", "text": "That made it worse.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2b62546e-ea53-4bd6-9def-a07e4a727a90", "text": "No one moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a07ca9cc-f214-43a9-83bd-0470319f316b", "text": "Zik felt the impact through his palm, into his wrist, and along the bones of his arm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8acbaee3-bfcd-4ca8-9a0d-7fd21ecbe4a2", "text": "Balag looked at the satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e97443ef-881f-4eeb-b74d-c503c7c46643", "text": "Ninsun's eyes had gone to the mark beneath Zik's skin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
