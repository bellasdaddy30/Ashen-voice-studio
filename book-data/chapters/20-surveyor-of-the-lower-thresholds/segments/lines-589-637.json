[{"id": "c699edfe-807c-4b60-b1f3-eb1ec22e1bc6", "text": "Ninsun said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "3c6f4669-ce3f-4636-b0d4-ea2d06621c5d", "text": "Enhedu looked at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b065862b-8295-47e6-a1e3-c4ca4017cb57", "text": "I was beginning to like you.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "42dfa525-9580-4396-ba03-4a8b4ae12d76", "text": "No, you were not.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5f916b69-802d-422f-a327-8734f1e56dd0", "text": "No.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a9f68566-90e3-49db-a7d5-cc91bcc9d74f", "text": "Zik crouched beside the opening.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5ef0fda6-8590-4d57-9ea9-25a344e76a74", "text": "The mud at its edge held a single clean impression.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "484d47ad-068a-40df-bfb6-afce7b231bf7", "text": "Seven narrow lines around an empty center.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "02c17f92-dc42-4091-93e1-6040fb520bd2", "text": "The same pattern as the seal hanging beneath his robe.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b2e342a6-fedd-46e3-a996-440ecbcb2079", "text": "He touched it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "36d41416-2020-4ad0-a283-9486a3d2e933", "text": "The mark in his palm pulsed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "41ea4f4e-f96c-44d5-9962-a7d32b8ab3fc", "text": "The impression softened immediately, collapsing into featureless mud.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4af25836-39e6-4bdd-935c-1c509cde3b8f", "text": "Balag saw.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b8fa1c8c-67bf-4551-bbc7-50d2857e49da", "text": "What was it?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c072e589-60de-4c3d-b8d5-8d05a736f21c", "text": "Permission.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "559456e0-2f2b-44e2-bb53-c3f5e72b3ec1", "text": "From whom?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6b6ac87a-2650-4a83-bbbd-2cdb84f2a572", "text": "Zik pulled the thorn brush aside.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "17cc5355-3fc6-460e-801d-a6bb39cb2f4e", "text": "The drainage channel gaped beneath it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cdcaebb2-e76a-461b-9d32-e599a5964105", "text": "Let's avoid finding out.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bff6d715-c8f0-4906-93fe-05ced761280f", "text": "They lowered the packs through first.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "914d9f3d-816a-4e32-801a-1988bf5b1fcf", "text": "Enhedu entered on her stomach and vanished into the dark.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f4898ae2-e48d-432e-ad27-48bc37aed2fc", "text": "Ninsun followed, pushing her satchel ahead of her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "937f869f-c1d0-46bf-beaa-f256c9fc6b4c", "text": "Zik knelt at the mouth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c9d8750b-6c36-4eb7-8f08-40c04e73c88b", "text": "The passage smelled of wet ash and stagnant water. Cold air moved through it from beyond the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bc8f8f4c-2d62-4588-8dcd-2c20f9e6ed08", "text": "Balag looked at the opening, then at his own shoulders.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "15d3973c-b062-4e52-9e40-f2a6fbe5198f", "text": "You have used this before?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e8b74ffb-91c2-4d29-acbc-70f15d1d4a4a", "text": "Once.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "30ada5f2-e835-4c31-9175-d9e5ff7c3f0e", "text": "Were you smaller?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "87506913-0ad8-4976-bf8f-20380422d900", "text": "Yes.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "eee0e80c-5fca-4c18-aed0-1c9ed71aa583", "text": "That would have been useful information.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3e87b824-6184-4c00-b3bd-0bdf77ae31e6", "text": "You would still have followed.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "233b9fc5-9be8-41d8-b1d0-e7bfb12436b4", "text": "I would have complained earlier.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "15262972-d585-4c1d-a44b-33f3a711c5de", "text": "You have compensated.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "67b485b9-d3f6-468d-bf97-6c8f462d1e75", "text": "Zik crawled into the channel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b19a292c-1ce9-4611-bcde-dc1ed515d25b", "text": "Mud soaked through his sleeves immediately.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e4d0536b-12f8-4c30-b1ab-4c9acc822d6b", "text": "The ceiling pressed close above his back. Water ran around his hands and pooled beneath his knees. Ahead, Ninsun's sandals disappeared around a bend in the drain.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b601949b-0b71-4760-b67d-7b815a644b81", "text": "Behind him, Balag dragged the thorn brush back across the opening.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d9e5bb50-4803-415a-8aeb-c8b006508901", "text": "Darkness closed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2242c051-05cc-4c96-a4ed-3585c3eddce8", "text": "They moved on hands and knees beneath the city wall, pushing their equipment ahead.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ac6c69cc-5430-4884-9625-7e7b9b086515", "text": "Every sound enlarged inside the channel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "434e3cb5-6579-4641-a9ef-046f7daa8240", "text": "Breath.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1f21cb56-f0c8-41f8-94c5-dc37f4eadb85", "text": "Cloth scraping brick.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6ad9478c-bff4-4212-9182-74a2b90c932b", "text": "The soft knock of a waterskin against stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7d0353ac-849f-4aec-952d-b58891126145", "text": "Zik felt the journal shift whenever his pack struck the ceiling.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "15caef0f-26be-451e-8cbf-af2c6043d821", "text": "Not random movement.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "22c78977-b2dc-488e-9639-4af5dee2fb20", "text": "A rhythm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5502848a-7679-4766-8ebd-7908a4d09d44", "text": "Once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0b99bdcc-41d8-4f55-858b-15056cd27b6b", "text": "Pause.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f666038d-0def-4cd9-858b-adffc9969d2a", "text": "Twice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
