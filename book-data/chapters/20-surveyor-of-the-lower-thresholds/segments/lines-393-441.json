[{"id": "c14bc309-ddb0-49b1-830f-59e04d5e5c9b", "text": "Ninsun came to the window with the bronze seal in her palm.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5c208cd1-48d3-4801-bae7-0aee074c82ba", "text": "The handprints ended at the roof.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1615aab8-a5d7-413c-af0e-b2fe85219bed", "text": "No marks led across the tiles.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "956e31d7-e1d7-466e-98a2-bc2eb659e195", "text": "Balag stepped back from the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "03d3f83b-5df1-48c3-a7e0-010d082bb108", "text": "I dislike him more than before.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bd778ead-3b35-4b5b-802f-0a26ae13382c", "text": "Zik closed it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cb58d64d-bb5d-42d2-8205-0b4bd59cbcfd", "text": "That still may be the safest conclusion we have reached.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ebca3b87-fd93-4fc8-aa11-309cb2653571", "text": "Ninsun placed the bronze seal on the table.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "776f7a8c-a251-4699-8752-0ed2aa5e49e1", "text": "Rainwater had gathered along the grooves.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "37f02fd1-61b8-4c10-afb9-fbaa594ffdbd", "text": "It did not spill when she tilted it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d2d86bc8-cca5-497a-b448-b8e14eff8de1", "text": "The droplets clung inside the seven lines, each one held in place as though the metal had become a tiny descending channel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dc85cca6-ddab-44d2-8bc9-1c76145a949a", "text": "The lower door,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0d8de14e-ba47-497a-b2d2-d3a32c9e4b3c", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "8715f73c-e14e-49f5-84ae-edf95bc69495", "text": "If there is one,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "60c740b7-3b88-4ca2-a5e0-cb4d7af56858", "text": "Balag answered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "b046150f-bcf3-4354-a059-8f2158e4c345", "text": "There is.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d9a59597-25c7-4c4b-8cc8-d1b13c19c248", "text": "You have not seen it.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1401aef8-c8ed-4aa6-bac8-14280c766769", "text": "The map shows it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "05cda41f-ab4e-432f-a87e-8e766fae9ac0", "text": "The map draws itself inside a book made from a dead man.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cd97c9f3-838a-4d0d-ab56-8dc680a7cd97", "text": "Yes.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d2e65de0-9219-4988-a0dc-0f6949dce924", "text": "You continue saying things as though they support your position.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "89805cd2-a995-4515-9f3f-603b2a0426cd", "text": "They do.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b93befa3-c70f-4582-9063-241927cda027", "text": "Zik took the seal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "df1625a4-b199-4e8e-973a-bb7c3717fd56", "text": "The metal was colder than the room.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "acf9aa3a-7c6b-4229-a012-85054604ae78", "text": "The instant it touched his marked palm, heat ran through his wrist.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "76070641-acf5-48ab-82d7-4133943b524c", "text": "He nearly dropped it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0afd0da2-8602-4a1f-9e3f-2cc780fa9eab", "text": "The seven lines on the bronze darkened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2f302d24-04ab-4475-b25e-ba3fb92faad7", "text": "Not all at once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3801fdb8-a689-4dd7-85c0-4d0d009f5164", "text": "One after another, from the rim toward the empty center.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "170c6d97-1972-47fb-ab67-f65d05eb83f9", "text": "Ninsun leaned closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "de3cecb0-11ea-483d-a854-55dadeb9d5be", "text": "What did you do?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "aee6f8e1-3ef7-4859-a919-94c331ccc6e2", "text": "Nothing.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6767e0b3-be38-4c06-bf61-3284aef97da7", "text": "That is becoming your most destructive habit.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9117a363-8ac5-48af-ad57-174a15a14cff", "text": "The final line darkened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "be9b4426-e777-4d8e-a3e9-28ad4fff8e0a", "text": "The mark beneath Zik's skin answered with a pulse.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cf0548fe-1d8e-437d-9b7d-12a4efe882e3", "text": "For one breath, the empty center of the seal reflected a room that was not theirs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d62d8ab7-a939-4805-a304-17263f7fd167", "text": "Black walls.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d7ec9ce2-624b-4398-9b8a-d7972c154abf", "text": "A low ceiling.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f51a0974-38dd-423a-aca1-1b96313adcc0", "text": "A narrow door standing open.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9d59b2eb-325a-4e2e-b006-f97e65f5e094", "text": "Beyond it, something pale moved out of sight.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e247f812-50e3-424d-81ff-1bf26ad726af", "text": "Then the bronze showed only bronze again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8fc5b8b4-1447-49a0-83a8-7da3e9374356", "text": "Zik closed his fingers around it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "05d08285-5874-40a8-a1c3-460caad1e8e0", "text": "What did you see?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e72e2520-eecf-4309-ac42-7d4e5b79c31e", "text": "Enhedu asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "b8fb3ca3-1961-4c27-95d4-8e6c986839e8", "text": "He looked at her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dedcd162-8b34-43b6-b14e-7d1ed96004b8", "text": "A door.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "24ae8b55-db37-4e66-8c17-10816114eb79", "text": "That was already implied by the conversation.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "431cf625-7a45-4145-aae0-c65f32255846", "text": "It was open.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e03de9f9-49a7-4457-ae5d-b31864820045", "text": "Balag tightened the rope around one of the packs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
