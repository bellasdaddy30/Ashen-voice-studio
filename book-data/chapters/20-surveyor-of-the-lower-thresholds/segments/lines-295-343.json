[{"id": "61fb0659-c2c7-4a72-85cd-8fe0bad2ee0f", "text": "The reverse bore a shallow pattern of nested angles. At first they looked decorative. Then Zik saw that each angle corresponded to a turn in the descending route drawn by the journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c7a718fe-a1a2-4182-b3b7-53eae614b9db", "text": "Ninsun saw it at the same moment.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "019b9461-332a-4c7a-b050-958cbb8d27a7", "text": "It is a key.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2e365849-62c7-4892-b443-4d79ab3bb697", "text": "No,", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e683ad03-3d04-44be-bd53-d8f4e2d92910", "text": "the Collector said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "393ae260-6905-4b39-8f11-b01d8e971b7a", "text": "A key enters a lock.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "50a79233-77a1-4656-932d-a8c8d5952bbb", "text": "What does this do?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3ec16613-1b03-447d-9b20-e70edfda3e85", "text": "It tells the door what stands before it.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7e848836-8815-4a12-bba3-c8f036c5aebc", "text": "Balag held the seal farther from himself.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e2135016-f70a-418f-b5ec-77c8d988c73f", "text": "That answer improved nothing.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b7202e1b-b66d-4265-b01e-29833aba9d79", "text": "What mistake?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "06689c7e-46b2-4a2a-aa2d-61d6cb18390e", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "1e826c15-9c5b-4c11-a3ed-0d3acd4c1703", "text": "The Collector was silent.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cc4fc20b-0dc6-403f-b22b-fc8b86f22949", "text": "You called it a mistake.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5c0bf289-726f-4871-8b29-63de595878ad", "text": "A mistake I have carried for twenty years.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ebf7cc65-f753-4ea6-8cd5-277071486176", "text": "Zik looked at the seal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a620b608-7421-446f-a1db-1a8d80963985", "text": "What did you use it on?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0bf01879-4f8b-4ed2-bc05-08faf6bd8d7b", "text": "The black floor.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1744992b-a25c-4ef4-a16e-c81a08695136", "text": "The room lost what little warmth it had retained.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9a11d6dd-f319-410d-9f0f-91ecd866e25d", "text": "Balag's gaze went to the warning page in Ninsun's hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9638c4a2-85bc-4a00-9d7a-7171ecfae0fa", "text": "Do not strike the black floor.", "speaker": "Bel-iddin", "type": "dialogue", "confidence": 1, "pause": 0.42, "delivery": "solemn", "note": "Recalled warning from Bel-iddin's notes.", "generated": false},
{"id": "32cec613-9d8e-4e97-a90f-eeddb35d1960", "text": "What happened?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f0aa5f79-b35a-4bd2-bf92-441d6bfb0843", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "2354f503-2d53-43b6-9be5-99b0372970c1", "text": "The floor remembered me.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7423820d-c52f-4e2a-bd8f-b1b627006dd4", "text": "Ninsun frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e68d003e-f2e7-4808-81f7-48904ee972cc", "text": "That is not an archaeological description.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7b342121-dc63-43c2-b915-674df66a0584", "text": "No,", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8e060825-afcb-44d9-a8a5-ac4983627c26", "text": "the Collector said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "41d229c0-c8b8-4ed8-9dc0-0689fb54b8cb", "text": "It is the only accurate one.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "83af376b-58eb-449b-82b6-2069781c4953", "text": "Did it open?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b6578939-60b7-42c1-88e5-665877afa11a", "text": "Not in the way I intended.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a39b3c18-88f1-4cb3-9d6b-6e3cd9d23a40", "text": "What way did it open?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "501f13ff-a42e-48c4-bcfe-c2892ac646d0", "text": "The Collector's voice hardened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e4b983ee-fbc9-4686-98d3-8a059f8a6f1f", "text": "Place the seal against the lower door. Not the black floor.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2e14e76a-7c8f-4b98-8985-2d0bbd9b02b7", "text": "Zik heard the change.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "85a51c51-2298-415b-ad4e-dacdf8963cd3", "text": "Not fear exactly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e2145d65-875a-4337-9bde-15d6b0313e4f", "text": "The memory of it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dd2b597e-b503-45d1-8f3b-ca21c3a59552", "text": "Ninsun took the seal from Balag and studied the edges.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c4d294b4-f9e5-4b2d-9d20-f68d27d280f1", "text": "There is residue in the cuts.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f2530648-238a-4149-8457-931a1c312d99", "text": "Do not scrape it.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c9d1a542-7f33-4aed-99f8-f3223ed9b307", "text": "She paused with one fingernail already against the bronze.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ffc239a9-91d9-4c77-b9e0-43470204b233", "text": "Why?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "847d2b28-670f-4767-abc9-0f8bf11eef64", "text": "Because some of it is mine.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "256fa7ff-932f-4ec8-b112-0f7c6dff1838", "text": "Ninsun lowered her hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "190d709a-35d5-4307-8189-b184cd16e605", "text": "Enhedu looked at the seal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "de74adb0-05d7-40bd-aa6d-b16700693d9c", "text": "I dislike the object now as well.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f7e3b3ef-b433-4f30-a519-ff8e75f935b4", "text": "That saves time,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8c928bb2-1986-4214-9d0c-308caf7798a9", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "3867d7e9-008b-490b-8d4f-0af6fc609382", "text": "Zik pressed closer to the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
