[{"id": "d33b59ee-1d6e-46e0-a74a-cec3b6b9ba09", "text": "Because I have enough messages.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "74477bf1-cecb-4fde-be3a-89cfb117068c", "text": "That was an artifact.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7726f6f3-02b4-4e10-8f84-3db02351047c", "text": "It was following us.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6da37f86-149d-4c2f-a996-c586aeeb980b", "text": "Artifacts do not follow people.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "65b859b8-fc41-4e19-b582-e8086591b745", "text": "The clay fragment stopped moving against the current.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e6c7c373-c516-42b3-bcb5-9efaef869a3d", "text": "Then slid toward them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "42c98d6c-23cc-425a-8190-d0f934c3decb", "text": "Ninsun stared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bca45f3a-c5c2-4a6a-9d85-5ae59803eeed", "text": "Leave it,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "10b95f25-b780-4b29-9908-da6f572d7195", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "55a8468e-ed73-4c22-8c80-888d6a57e513", "text": "They moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6672b822-ce9e-4125-843e-d57193e5fb79", "text": "At the far end, cold air touched Zik's face.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fe556482-9d36-4d5b-bd18-63896a69b389", "text": "Enhedu climbed out first.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3bad1820-d505-4f1b-9f01-b1419e280759", "text": "She did not speak.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "deb91cfa-0b12-4135-8f39-f2417a4e54ff", "text": "Ninsun pushed her pack toward the opening, and Enhedu pulled it through. Then Ninsun disappeared after it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "550f84dc-32c0-4d76-b61b-34e62de52377", "text": "Zik crawled the last few cubits.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8561c12a-c8c5-4c4a-9821-9414de8a3ae7", "text": "Hands caught his wrists.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9d100e3b-bfd2-4beb-a2ba-949d796bbbff", "text": "Enhedu hauled him onto damp earth beyond Uruk.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8838ae3a-7b39-441c-acf7-4f47d53f272a", "text": "The air outside the walls felt wider and colder. The desert smelled of wet dust, thorn, and distant salt.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e3732619-2817-4692-8231-fd272b96cc0c", "text": "Zik rolled aside.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8e96dd62-f44e-437a-8cf8-079952a91705", "text": "Balag forced himself through the opening with a curse that continued long after his shoulders were free. He stood, brushing mud from his robe and beard.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "533eb841-d21a-4922-bfcd-ae0024e5e55b", "text": "Behind them, the city wall rose black against the clouded sky.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6e9bfd07-9a3d-4fba-af55-4463d7341df9", "text": "A line of torches moved along its upper walkway.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "14c8f966-dd95-4a67-90cb-6a161427f65a", "text": "None stopped above the breach.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "64248ad1-4243-4a16-b832-d7ccd42c709f", "text": "Ahead, the desert stretched beyond the reach of their covered lamps.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "988be076-e0c0-40c9-bfa9-c207f325ece2", "text": "Enhedu stood facing east.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "92d44c8c-24ad-4594-a515-c8e2cc6b191f", "text": "Ninsun checked the clay tablets before checking herself.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8bb378da-3ab5-436f-8b5b-5e523c866276", "text": "Balag tightened the rope across his chest.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ba5242d4-a8d9-48d6-8512-9a7a91583acc", "text": "Zik lifted his pack.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ea2baa25-9715-451b-88b5-ef22256e696c", "text": "The journal remained still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ebdb85e1-5a84-4af1-81af-eec9595bbac4", "text": "Not asleep.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0d489329-1cb6-49a6-8c30-f1e7cc115f38", "text": "Waiting.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6f82e20a-9293-4a70-8775-f64e66f4f132", "text": "Whatever had answered beneath Uruk had not answered again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "89630758-b606-40f0-976f-f889349189ab", "text": "He looked back at the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0d83c212-2432-4842-951c-b4674f0ff7e9", "text": "For an instant, a figure stood atop it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2aa31f6b-bc30-4c0a-8bf3-3f058e445e59", "text": "Too tall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d27fc8e6-814d-4ec3-93b5-cbb0116753d0", "text": "Too narrow.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e8e34d28-cddc-4c51-99b2-dc5bbd12e571", "text": "Motionless between two torches.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cf55bfd1-5eb8-48de-9dc2-28ebbab28779", "text": "Then the flames guttered, and the figure was gone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "04172d21-9e50-40d9-b080-993056605b7b", "text": "Balag followed Zik's gaze.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "23544408-6225-44c9-9be5-e59dcc34319e", "text": "What?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bae9bd5b-3e2b-4977-a43c-1eb512c38523", "text": "Nothing.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "be88eac7-ff50-4f50-bea6-4ea6e1c2fe91", "text": "That answer,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f2cc9724-43ec-4f64-99d0-7342072364a7", "text": "Ninsun said,", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "39689db0-248b-404c-8948-e925a075e0cb", "text": "has become exhausting.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3855c5dc-8b9a-4965-b3d4-5d3ef8f5f89e", "text": "Zik turned east.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1048037b-26eb-42f5-b05e-acb7f19aee39", "text": "Balag looked toward the unseen tomb.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eaa6774b-f39b-4e5d-8b94-f719fead773f", "text": "How far before we stop?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a50bd6d8-e219-41c9-ad98-76456430e4fb", "text": "We don't,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0dc5d13f-c305-4eb1-8e47-42429fa608db", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false}]
