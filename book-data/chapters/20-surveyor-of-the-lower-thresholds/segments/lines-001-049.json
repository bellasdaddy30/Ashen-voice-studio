[{"id": "17f6c6ed-a192-45e2-a980-be389328681f", "text": "CHAPTER 20", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "6d4d8cfa-625b-4ebb-a735-d3973ef5ef4a", "text": "Surveyor of the Lower Thresholds", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "e7991af4-e405-4440-bb17-80c1b443c817", "text": "Zik.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c4d26727-d7f1-459a-8667-20ba9c4270a5", "text": "The Collector's voice came through the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f2168861-09b3-4014-a33d-357de304a72d", "text": "Zik kept his hand pressed against the journal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "18c0a7d3-0da0-4679-8fb4-f5edd7f72121", "text": "The leather beneath his palm was motionless, but the mark in his skin tightened as though someone had drawn a cord through it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "44d1e19f-05b2-449f-bcd1-18cb03f4ae57", "text": "Balag shifted beside the wall. His axe came free without scraping the plaster.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d767962f-188a-4221-9c89-92cc04e41a49", "text": "Enhedu raised one finger, warning him to wait.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "064243da-308a-4071-bd0a-b36d0626d33b", "text": "Ninsun stood beside the table with Bel-iddin's warning folded against her chest. In the darkness, the pale clay strip in her other hand looked like a shard of bone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1df69c42-34b2-4bbe-a113-b08bab088742", "text": "Zik moved toward the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2caa2474-f403-4add-808c-b89c2af822ff", "text": "You could have used the door.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9c9e2284-88fe-4abd-9226-ab438e22cbcd", "text": "I did,", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6d07bc45-bb6d-4c86-87a7-6a384d312c24", "text": "the Collector said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "e152d59e-88a7-49bc-8aed-5c16308055d3", "text": "It remains barred.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a857597b-8205-43f8-b723-d36212715016", "text": "That was intentional.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c71b9055-ade3-4a54-aac9-c3ae8c332860", "text": "So I assumed.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dfec280f-c7a8-406e-b0fe-4aade7e90de4", "text": "His voice sounded close enough for his breath to touch the wood, yet Zik had heard no approach after the second footstep. No robe brushing the wall. No sandal shifting in the wet grit below the window.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7469d12a-a1df-4938-8885-2fad246111f0", "text": "Zik stopped an arm's length from the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "82dbd3d6-abcb-4d8c-b71e-ccb78955e567", "text": "How did you find us?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6499f50c-6ced-482e-bad8-1cd3eaeaf1d3", "text": "I have known where this room was since you rented it.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "541afa79-1ea7-48d2-877c-24d5606f64f8", "text": "That wasn't what I asked.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3b721703-d60c-4513-90a8-2a9f7a75984d", "text": "No. It was the answer available to you.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d72e6246-9049-4481-bedb-24a7a19c68d3", "text": "Enhedu glanced at Zik and shaped a silent word with her lips.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "57464ed0-af27-4883-a812-fcb0c667e79d", "text": "Alone?", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dc3d0680-3d9e-483d-82ac-467f3ec5e15d", "text": "Zik shook his head once. He did not know.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9b695fb9-bd32-4478-94fe-a9b153e882a3", "text": "The Collector continued.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5d797f41-dfe5-461d-bd71-95fbe6e3368c", "text": "You found the seventh drawer.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7978bee3-6da4-4a5a-9944-2663552226d0", "text": "Not a question.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0df093d2-6360-4e46-b12a-0ec69f2fed4d", "text": "Zik looked toward Ninsun.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "98a517c6-1a3f-4b28-8ca9-60a98ca00272", "text": "Her expression sharpened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "97d5c0f5-006e-45f7-8392-76c6ff43649d", "text": "Mardu told you?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a510cc3c-bc94-4e0a-b552-59effee71603", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "fc269c79-e2e3-4d9f-8f61-363364ffd24b", "text": "Mardu tells me nothing. It is one of his better qualities.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "10dfb722-c119-4c98-aa97-65e98d238a79", "text": "You have people in the archive.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "806ba447-5178-4021-b54c-1aaf96a7a817", "text": "I have people everywhere men mistake employment for loyalty.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6ded08d5-c289-4fb4-9af7-fa44511346cc", "text": "Balag took one silent step toward the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6f754a10-937a-4689-94bf-36a146712487", "text": "Zik raised a hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e7526122-a5ac-4c59-adef-6bed52c9730d", "text": "What was inside when my father opened it?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "57092363-aedd-49e0-9d4f-8bf69da0996d", "text": "The rain whispered along the roof tiles.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "405f43e9-bb81-408e-a32a-f88baba2fc0a", "text": "For several breaths, the Collector said nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "647ed7eb-1b6d-4a5a-8fb8-ab4666b05744", "text": "Then:", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "00617351-601f-48a6-9a1f-92345af8049f", "text": "His name.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fd9cda45-95f3-4b10-8800-97c25395c45b", "text": "Zik's hand tightened around the strap of his satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0c3ab8b4-94ff-4c46-ace9-ae4e28bd96cd", "text": "What did the record call him?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f3a990a1-7559-4d15-85a7-c73a643cb875", "text": "Surveyor of the Lower Thresholds.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f72cdfe0-d4b3-472f-a620-4756510bad12", "text": "The title entered the room and seemed to take up space.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e6de56ef-4cf6-4e92-822f-05a6d5e025d8", "text": "Ninsun lowered the strip of clay.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ea92d673-cf8d-4e3f-9585-3aa7d5b7a259", "text": "He was not,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1de157cf-dc15-4c35-a55a-8e2a47b97a1e", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false}]
