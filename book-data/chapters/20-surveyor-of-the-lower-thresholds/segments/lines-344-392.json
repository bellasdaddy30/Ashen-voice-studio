[{"id": "479d7d43-dbe6-4c2b-b855-b7848ce24d86", "text": "Why give it to us?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6dd5848b-8f3f-4f96-947a-aeebfb1202d0", "text": "Because Bel-iddin took the other one.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b3186f81-3ed6-4907-8bfa-702f86fa136b", "text": "Other?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "84c057ff-e885-4982-93e6-9ba5801a1655", "text": "There were two.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e2c91e73-2bbd-4cbe-8dcc-cfa216fef36d", "text": "What happened to his?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dd48849d-8009-4576-bb01-c3f0e45da36e", "text": "He carried it into the tomb.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c545c7c4-5d49-46bd-b928-c2e1eed77cf4", "text": "And brought it back?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e2f1e145-d725-45dd-8221-498f12661173", "text": "No.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "499ee7ee-281b-4e76-8148-93c444fe84a4", "text": "Zik felt the journal move again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "71654ee4-d929-4cdd-82f8-982b77636c1b", "text": "A slow tightening against the satchel's leather, as though it had heard something it wanted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0bbbf363-02fc-4e32-996a-d2e96eb3503b", "text": "My father returned from the tomb.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3eb2314c-f010-46ab-a253-c5892525f6e1", "text": "Yes.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "efe1a219-f0de-40dd-a3de-76195b85d1b6", "text": "Then why didn't the seal?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8f9dc2c1-aa3d-4ac6-a81b-435311e39654", "text": "The Collector did not answer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1bacac8a-ba3b-4ef0-bfbd-d1cec1c25101", "text": "Zik waited.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "31e21df7-8eb6-47ff-99be-183aafe9f0c4", "text": "Rainwater ran beneath the shutter and formed a narrow crescent on the floor.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3514aca8-8fcf-4e71-a477-84716db2d827", "text": "Did he leave it below?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b4614c16-b5c7-4b52-934e-8988ec401e62", "text": "Ninsun asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "51012219-edab-4841-aeb0-df3920635f24", "text": "He believed he did.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a213c7c0-8dd0-454f-b4e5-a6745f18379a", "text": "That is not the same thing.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f5cacaa9-09ca-4c2e-b367-29cc9a155149", "text": "No.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "586daeb8-15c1-4c36-a906-1afd6bf533d0", "text": "Where is it now?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dff75543-107b-4e44-b745-1b6d7cc3567a", "text": "The Collector's footsteps began to recede.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b595faea-4e59-4eed-a74c-492df55d04bb", "text": "One.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "322c5c6c-cf09-4a71-a6bb-b85a26062798", "text": "Then another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "157baae2-2a8b-4dc0-93db-ff09c7678086", "text": "Zik lifted the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5f5d154a-2e3d-4de0-aead-b806b125e031", "text": "Enhedu caught his wrist.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "261633ea-b903-42cb-8292-5d660071fca0", "text": "Wait.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "17835284-faad-4362-995b-93dff182bf1b", "text": "He pulled free and shoved the wooden panel outward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2b61dfb6-c358-4d0d-b788-c8e5e4104d7a", "text": "The alley was empty.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ba788f4c-4838-4563-8aed-5535bdd7da9c", "text": "Rain silvered the stones. Water dripped from the awnings. A dog stood beneath a stairway at the far end, watching him with the offended expression of an animal disturbed during private business.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "78b2944a-aa5b-490b-a3b6-47ba75c17922", "text": "No Collector.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "de5c9bbe-bfa0-4eff-b6c1-96681ac95167", "text": "No robes disappearing around the corner.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "157539bc-2a9c-4e6a-ab1b-427ad12b7656", "text": "No ripples in the puddles except those made by rain.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c253214d-6dab-4a7a-82e2-f166516e0a8c", "text": "Zik leaned farther out.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "83f2126f-815d-45f2-93d9-4441b87335f2", "text": "The wall opposite the room bore a line of wet handprints.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bbb43e3f-7f87-4513-9d7a-b92501e06686", "text": "They began beneath the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "72c993e0-8217-4e86-9074-243f09d59805", "text": "Five fingers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a36caf1d-cb5f-4554-bf55-31ac4fc893ea", "text": "Then another print slightly higher.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "37997e09-87d1-46a9-ba91-a4467b44b07a", "text": "Then another.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c2be6913-98dd-4ebf-b69e-997ec6f0dd82", "text": "They climbed the wall vertically until they reached the roofline.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6e4d7e54-fe6f-45e1-a813-57edf5023556", "text": "Zik stared.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "37147dd7-8f64-4471-bc78-5275d563ec53", "text": "Enhedu looked over his shoulder.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "98bcd6ab-c837-4a79-8b06-3c7bd2e34c8d", "text": "He did not leave through the alley.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6663ef48-b7f8-4108-a1d0-c5a3379547df", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0cb071a7-65a6-4ea1-9f9a-f8dac9d0bba6", "text": "Balag joined them.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e839f526-8b69-43ce-9478-d09d024d684e", "text": "Did he climb?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6325569d-8ddf-404b-828d-f6e65c2fe3d7", "text": "Enhedu examined the prints.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f1d49e44-0c55-488a-9303-b43a916dc54c", "text": "The fingers point downward.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
