[{"id": "d23d37d8-8c1c-4920-afb3-ace38953d5cd", "text": "Zik moved closer to the shutter until his breath touched the wood.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "57bdc164-99a3-4a62-a104-a4a209cfead7", "text": "It changed,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "913e75c3-75a3-4b54-9f71-3c2534aa2c36", "text": "he repeated.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "77cf3c2c-a3fe-4841-a310-d462c66a0854", "text": "The date appeared after Kurash died.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f51ce58f-3c5c-4ef7-88bb-f8058250cd82", "text": "The Collector's shadow remained still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fa8d2d2f-c7a1-4634-8dcb-da4d14ca9a42", "text": "That is one interpretation.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dbf2e14d-2940-40df-b5d7-04215a60204f", "text": "It is the only one you are trying not to say.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "687f7781-46a9-4890-97cb-689bd8cb931c", "text": "The tablet was old.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3c7ff570-e8d4-4d5e-9755-38988e0e63f6", "text": "So was the journal. That hasn't prevented it from writing new sentences.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "21d8d172-123d-461c-8ad8-f113db4b2c81", "text": "The mark in Zik's palm pulsed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7e04606e-8dad-4c22-9147-22a995370a72", "text": "For a moment, the Collector's fingers on the other side of the shutter flexed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9aa26578-e012-42d2-a8c9-74aafa60b231", "text": "A tiny movement.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "de5ba57b-8257-4dfe-83ae-15e859dab8f1", "text": "Recognition.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b25c3720-595c-4346-b915-5a6ea0f3f430", "text": "Zik saw it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6efc27d9-f13e-4238-b713-86fe479524c8", "text": "You've seen the journal write,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3e421647-6146-4fd0-9c9d-722e04658bbb", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "b37e4391-56a3-4c0e-ad1c-d3743583f517", "text": "I have seen many things that should have remained impossible.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "617d97f4-d7d2-4c62-bbbd-924c09ce6967", "text": "That isn't a denial.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9ec340ea-9de4-47d0-a9c8-0d1b0420976b", "text": "No.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "faad457a-7316-41f7-879a-58bedd76e754", "text": "What did it write for you?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "16d83ae5-5b90-468e-a2a1-e06daf640abf", "text": "The fingers withdrew.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "5d6c2ee2-184e-4b48-b15c-36f1a19787ea", "text": "Rain struck the shutter where they had been.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "19e20f09-0f47-4d09-95b2-0f3475ed35e7", "text": "When the Collector answered, his voice had moved slightly to the left.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "24a5f5b1-a3d6-414e-a009-c4c96897159d", "text": "Nothing.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1c148d9c-e786-4f99-bd4c-6fd87c109bc6", "text": "You're lying.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "42057e6f-a7ce-426c-8b56-bb0ae9d56e3a", "text": "Of course.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "934dceac-7b19-4775-9a28-edfd2bd706ec", "text": "Enhedu tilted her head, listening.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7323534c-e1bc-4e49-a646-7c60c5ba22fa", "text": "He's moving,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "note": "Whispered.", "generated": false},
{"id": "a4bac91a-98ba-4506-a151-5d30cec442be", "text": "she whispered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "89a9da5d-f855-4102-92b3-8800d2bde0b8", "text": "Balag stepped toward the wall beside the window, preparing to strike through the shutter if the Collector tried to open it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4d87dc48-915a-41cc-b556-304ada28bda0", "text": "Zik did not take his eyes from the dark line between the boards.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "27c6a665-8f72-4852-8951-87b39921ba80", "text": "And now?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5ec3a3af-57b0-4f80-bf0c-c1bd4f97921b", "text": "he asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "bb5c7e0b-6a9c-4ffa-af50-2147a31975c3", "text": "What does successor mean now?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "195dc1f3-a5b7-4539-8b91-b0482e17ffbe", "text": "Now the journal has drawn you a road back.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "97ee6bbd-8ac2-4158-a3ac-4e2a315dc174", "text": "And you sent a scribe to tell me not to follow it.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e09c0d59-6367-4d86-9c68-848e4099b781", "text": "I sent a scribe because approaching you directly would have been noticed.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d9c8c750-a504-41dd-a300-0be4ec9d3226", "text": "By whom?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fd0b133d-89bf-47fc-bf14-fbdfc70932c9", "text": "That is not a useful question.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "37a3cd8a-6765-4fdb-88f3-ba5bff7965af", "text": "It is becoming one.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "39f0e6c1-47db-4f40-8851-2f23126f8406", "text": "The useful question is why you believed the man was mine.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c5229187-7ef6-46c1-8032-09cd208b6046", "text": "Zik said nothing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cfcf4d33-0873-45d0-9642-7a1aa690f762", "text": "The Collector's voice seemed to recede another finger's breadth from the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "02be3b21-9d86-4e37-93fd-ec2e9c3c9a69", "text": "The seal on his tablet?", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fec92813-ef5d-4dc4-8a8e-fef525f4f778", "text": "he continued.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "64e54b65-6ad0-41d7-8b9c-1c31bee9bc33", "text": "The message? The mention of the mark?", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1c0192ae-4d1f-4d2b-a528-10d7689f263a", "text": "Zik remembered the young man's face changing at the mouth of the alley.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7ec9c018-69a3-4bf9-af9a-db5cbf672a84", "text": "The nervousness disappearing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "46dddac3-8da9-475a-8329-f1dca6d4268e", "text": "The sudden age in his eyes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
