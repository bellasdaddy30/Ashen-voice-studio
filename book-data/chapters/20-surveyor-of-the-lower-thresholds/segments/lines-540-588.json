[{"id": "e6438f52-e23f-4161-b6c0-7e0edd8975f6", "text": "Zik looked at the wet street where the guards had vanished.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3f5b16ba-c8f7-4bef-8de8-e0f1f41c469c", "text": "Because they wanted me to know they had seen me.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f43f0ebd-a2aa-4708-a5ac-8aa012f93ec4", "text": "Ninsun adjusted her pack.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7380b1ee-5c02-4d3f-bcc7-bccbf5afdd40", "text": "Then we should assume the breach is watched.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "36bef3aa-8d84-41cd-9eaa-02acbc9c0e3d", "text": "We already assumed that.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "86dcee1c-aa56-4a12-8d45-22fe9e4b83d6", "text": "No,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0256bf20-0e89-4530-bb99-84e778d63bb7", "text": "she said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "f0e2cad4-2404-4e39-93a5-02096218a83d", "text": "We discussed it. Assumption requires discipline.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "acfc7474-4372-4d2b-af7e-ce026a3c4acb", "text": "Balag looked at Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "51a2803d-0f37-42d9-b068-487d7dc5e965", "text": "Do you understand why she annoys me?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f98ab6f3-ff38-4c0f-90f1-42bc75140575", "text": "Completely.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c7674ceb-2c3e-4494-9d1b-ed71cf008ec2", "text": "Ninsun started walking.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9492e820-4a5e-4672-85b5-623cd9f78caa", "text": "Both of you are carrying my water.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6e5c2190-7c61-4526-b026-a57ddb98a327", "text": "The old lime kilns stood abandoned near the city wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fb2309f1-8437-4006-bdaf-36000a57966f", "text": "Their collapsed mouths opened from the ground like broken ovens. Rain had turned the ash around them into pale mud that clung to sandals and gave off a bitter mineral smell.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "72a305c2-4b53-4889-a619-0fcad62c60d4", "text": "The city wall rose behind them, black against the clouded sky.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "968849d1-5092-4f4f-96f5-2975632b1d9d", "text": "Zik led the others between two ruined firing chambers and stopped beneath the remains of a brick arch.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7e80a1c7-1d9c-4137-9397-496e8561843c", "text": "Nothing moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "10e00f96-0005-49ce-a4e4-de8181b24589", "text": "No lamp.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9d00c0a7-568e-4942-95d8-d54b8ad1323e", "text": "No guard.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4dcefbb9-608d-44e4-8203-410decde51d2", "text": "No false temple scribe standing politely in the rain.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4497405e-4c83-4c6b-a4b2-21f9ef208482", "text": "Enhedu crouched and touched the mud.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e86f2d69-5361-4093-bc96-41e5069a275b", "text": "Tracks.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7b388072-3a37-4c29-975d-728756c25425", "text": "How many?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "05fd0c4b-6ce8-4d51-b2f3-9fb99784d704", "text": "Balag asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "22b43a66-0cc3-45f0-a746-6f3f06117d02", "text": "Too many.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "89442a07-68db-41ff-8e91-096cc53d05bd", "text": "Recent?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9172839c-453d-4437-a841-27be27fee4c3", "text": "The rain has softened them.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7353e385-ef0f-453a-9a34-f64bd9467f3c", "text": "She moved two fingers along a shallow impression.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8172d4ca-f7f9-4771-8a93-a4290258030e", "text": "One person stood here for some time.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a0f03b2b-f244-488a-8424-934b42e4b893", "text": "Waiting?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b3709ffc-3387-4f7d-b4ee-9df0bed02a7b", "text": "Ninsun asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ce778348-025a-467c-80cc-669d5a879507", "text": "Or watching.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "317176c3-ccd2-4c35-93c0-4c777527595b", "text": "Zik studied the kiln.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "227c0e85-ea25-4778-a85e-f2161d2d5c95", "text": "The thorn brush concealing the drainage channel had been replaced.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dd183dd6-fe3e-428b-8dff-eb5e4857ef32", "text": "He knew because the longest branch usually pointed toward the wall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "35526ae2-3232-4f4d-a02a-5789e406db37", "text": "Now it pointed outward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9981fd4b-e684-4783-aaf8-87a0d15a611c", "text": "They found the breach,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4e6e1fe2-71a0-4027-9169-a8cb4fcc488b", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "3aab6b96-232c-435f-9d4d-990c9024d321", "text": "Balag shifted the axe higher.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "90d7e752-8638-4b9c-95ac-b3cac596963a", "text": "Then we use another exit.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a679dcac-986e-42f1-8536-bc8fe384ae3b", "text": "The nearest is beneath a tannery.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "edcabe7c-500e-4769-b590-ad744f4d85b9", "text": "How far?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7399a93e-fb46-412e-897e-55582a500bb7", "text": "Too far.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6db716ba-95d8-4427-b7d3-c5a5a4f6820b", "text": "Watched?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9ac5030e-6329-4c1f-8ae4-ffe142cd6d53", "text": "Almost certainly.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ded19016-62e7-4a4b-ad81-97654b380dc1", "text": "Enhedu examined the brush without touching it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7d262025-b6f3-470d-9160-813cfdd1d363", "text": "No cord. No bell. No blade.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9eb7e397-bf0d-45c8-b017-2fd357745cb5", "text": "That you can see,", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
