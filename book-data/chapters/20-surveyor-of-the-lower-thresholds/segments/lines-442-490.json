[{"id": "ed7bb833-cb66-432b-a2cb-84bd7103463b", "text": "Then we should leave before whatever opened it reaches the stairs.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c79f5ad3-9641-40df-ad0a-9dcc74392763", "text": "They finished packing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d398fca7-a487-4af9-95f7-7369d419b4f7", "text": "No one argued.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fbf578da-203e-48d6-90ee-04c973f4eba5", "text": "Balag divided the weight among them with the authority of a man who expected everyone else to make poor decisions if given a choice. He tied one rope across his chest and another beneath his pack. The hammer went at his side, wrapped in cloth so it would not strike the chisels while they moved.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c1a0a412-9577-46fc-a44d-4fe7b702d72c", "text": "Ninsun secured her tablets between folded robes and wrapped the wet clay strip in linen.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1842dc50-cd1d-4fa3-b869-d8b7c8e40e50", "text": "It will deform,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "083a4436-6e38-4fae-8682-3a5f03cbfda9", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "1625687e-0ec0-4450-991b-77c05b632860", "text": "Not if you stop sitting on my records.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "930aa34d-ab22-4472-a2d5-78e1d33ded5e", "text": "I sat on one tablet.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d6571b40-ecca-4fdc-a6b1-11eb65f16ecf", "text": "You shattered the corner.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "0122a206-2f1d-4709-b040-1780c3f09eac", "text": "It was already damaged.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1f378da7-b519-4c52-a26a-a28a2ca541dd", "text": "It had survived six centuries.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9e456e7f-ef01-4a87-bc25-d667a151587d", "text": "It had not met me.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a07f9e9d-dbb0-4d5f-a47e-0fc923969c7d", "text": "Enhedu checked the room for anything they had touched.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ed64bc17-cc96-419e-be81-92d3d056896b", "text": "She wiped the table, the wall cavity, the shutter latch, and the roof edge with a strip of damp cloth.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "12b1d2bc-98fd-469d-b6cf-0b1eefae9eda", "text": "Zik wrapped the journal twice and placed it at the bottom of his satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b7aa6ee7-f6c2-46f3-be89-cd912ed60f58", "text": "The leather knocked once against his palm as he lowered it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "898769aa-6341-401b-afaf-0ac4a04bc849", "text": "A small, patient impact.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "19612dd7-d6e2-4511-9378-071dcd535132", "text": "He stopped.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b57509e8-5feb-4b8e-8208-b19d26a519e9", "text": "Balag looked over.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9c71a09d-ccc0-4fbb-806a-3208c2142b45", "text": "Again?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "550a0f76-fa7a-4ada-8abd-57cd95dbaa0f", "text": "Zik tightened the wrapping.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cc4a71d6-7cdc-417f-8c51-97b4b05dfa9e", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3cc6fc9e-2df6-4830-abbc-a8a25c304f72", "text": "The lie convinced no one.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cc3993d9-5d86-4ff8-8c11-d1aa49c9a688", "text": "He put the bronze seal into a separate pouch and tied it around his neck. The metal rested against his chest, colder than the rain.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f9a31066-b517-4cc2-82c9-5b9da143f033", "text": "Ninsun handed him Bel-iddin's warning.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a21f80fe-55d1-4fa5-abf2-46a4abe60bf5", "text": "You keep it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7e65ac8f-5579-4ff2-b741-e51db78f6488", "text": "Why?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6e202c0b-d77e-4591-9628-2a9ddb072afb", "text": "He wrote it for you.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "72f482de-6218-40d2-8558-70bc3b6a9ba8", "text": "He wrote it for Kurash.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fc7de184-6709-4f8f-8c5d-74f9ed702fab", "text": "He wrote it because he knew Kurash would not listen to him.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "878acc63-7acd-47e1-aff0-47bcdd384955", "text": "Balag's face changed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ecf7d6b9-6257-48da-9852-2b2a8b468d58", "text": "Only slightly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f7364e46-c2a7-4a17-8435-b19ef989ae43", "text": "Ninsun saw and softened her voice.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9e946d9d-1411-4513-a955-d58317a111d7", "text": "That was not blame.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f2cdd162-4a11-4f32-a10b-df76494ed586", "text": "It sounded familiar enough.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2b614972-8d7b-4b95-a8a6-8b438d7ccfae", "text": "Zik took the page.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "00ccc411-2e59-4eae-804e-e440dd8fc9be", "text": "The papyrus was thin where Bel-iddin's stylus had pressed too hard beneath Kurash's name.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8427195a-2807-43dd-9fe4-4a1bb609623f", "text": "He folded it and placed it beside the seal.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d90a392e-399f-46e6-94b7-5285b4637568", "text": "They left through the roof rather than the door.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e1947584-53f3-481e-9243-6580bb91c204", "text": "Enhedu went first, lowering herself onto the adjoining tiles. Ninsun followed with Balag's hand around her forearm. Zik passed the packs across one at a time.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f7c7ead9-1f01-42a8-83fa-79baaa8b6af5", "text": "When Balag climbed out last, the room behind them remained dark.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2c0c2434-a801-4e86-8518-ecbd91976a8c", "text": "The shutter shifted inward after he released it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "da957fd5-f9b3-4b82-abf4-b86c5bb8554a", "text": "Not closing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c895301c-b22f-4bd9-86b4-e719be585119", "text": "Breathing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "96f14757-17b8-4212-8e4a-5afbf495deca", "text": "Balag stared at it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7e6d3ce3-ea11-4d13-8e20-258dcfd0492d", "text": "Did you see that?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "99057d85-a8b3-47e5-a870-4093d795c115", "text": "Yes,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1869ea66-0a84-407d-86bf-08e95d17463f", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false}]
