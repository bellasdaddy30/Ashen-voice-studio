[{"id": "88e18c4b-905b-4a42-8cc5-6b23babdc527", "text": "Enhedu watched the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1407d471-e215-4e89-8fe5-51f8efdfacc0", "text": "What does successor mean?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "eb79a997-9e2d-4206-b5d9-10d6d1b40055", "text": "Zik asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "569e06da-5a2c-40e4-8e24-8fcb98eef07c", "text": "It means Bel-iddin spent the rest of his life trying to keep you away from that tomb.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "64bba7a7-b27e-4611-9c6a-a7d2fa73e3ad", "text": "Zik almost laughed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "506dc53f-9815-491f-90c4-8b5e32dcd29e", "text": "The sound never reached his throat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a470b07a-e9e8-44bb-83c5-07244b36bc60", "text": "He brought me there.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "246e43dc-b1bd-4e17-ab8b-ae77c72b22f9", "text": "He believed distance would not be enough.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6cf1ac73-aa53-413b-b67f-b74d46022093", "text": "So he took me closer?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "43e523bf-7873-4739-9750-31d8ea73f1a1", "text": "He believed knowledge might teach you caution.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e8a74aed-a66f-48d2-9a15-35adc74f123f", "text": "That suggests he did not know me very well.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2ad506bc-33d4-4c66-b8d5-e25768c1c954", "text": "He knew you better than you think.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "455435e1-845c-4da0-91b2-e549e577731c", "text": "Then he should have known caution works poorly when paired with secrets.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ed64eb1c-245c-4d7b-a18a-e5bbd05e77da", "text": "The Collector's fingers touched the outside of the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8189b998-653f-4097-acbb-890fc2e1bda0", "text": "Zik saw their shadows through the narrow gap between the boards.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "49c437f4-abe9-4ac1-b091-7197001d5c72", "text": "Long fingers.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1d3dde77-e0b4-4d23-8f72-bc9bc241eb8e", "text": "Bare.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "df3a49c1-f5dd-43a0-bd4d-e5f327764f6d", "text": "No rings.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "09e6a683-ac35-4bcc-b8f4-3c7100fc0782", "text": "He tried other methods,", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bba5f2d9-ac98-4722-b918-18f36c78571b", "text": "the Collector said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "ca5d9e7d-ba4b-4905-a4a9-9e97cb321b9c", "text": "What methods?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fe37d9c4-0690-4edf-b02e-fe3d9848e5ae", "text": "He altered records. He paid men to forget routes. He moved objects from one collection to another. He convinced a priesthood that a damaged seal belonged in a provincial storehouse where no one would bother cataloguing it for three generations.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "621b986d-1097-47a8-964d-09171361593b", "text": "Ninsun's mouth tightened at the insult to cataloguing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4ea81099-4179-43f9-816e-11a110cdd158", "text": "He erased Ammaru?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9c8852f3-0d6f-4a8e-baf6-54083c822488", "text": "she asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "302ca24d-22c6-4534-bf0b-8a3bdab97b80", "text": "No.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c30cd0b1-5ccf-48c7-a4f0-909486d506a3", "text": "Who did?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "faaa0bbd-8a19-4cfa-afc1-f6330cef265a", "text": "That question is older than your profession.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a54392c1-1ecc-43d0-8f65-665d5b7161dc", "text": "My profession is older than most kingdoms.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c54668f7-6278-4c41-bd46-7324698d5e26", "text": "That is what archivists say whenever they want to make dust sound important.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "46cf70ab-c381-4c9f-b6b1-2e58ba3bb444", "text": "Ninsun stepped closer to the shutter.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d8149f24-6efc-4dd2-be19-11d32f97c425", "text": "Open it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "388783af-5574-44a4-a3fc-689bc93fc5cc", "text": "Enhedu caught the back of her robe.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eff6135d-89a3-4f36-834c-5e889855231e", "text": "No.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "11513c73-9c88-4374-b450-b993e180345a", "text": "I only want to see his face.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c15dadf3-04d2-4338-931e-fb70b9f5aa10", "text": "That has killed better people than you.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "40db8703-8ef6-472a-9a9e-778a5c38f56e", "text": "Ninsun looked offended.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "68bd8f60-9096-4230-90a4-61f61b70c91e", "text": "I doubt that.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "88b00077-9776-4fd9-b62d-d4c6910ea67e", "text": "Zik kept his voice low.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "aaeea199-46ad-46d7-a93f-76ed22ade0e0", "text": "My father knew the seventh drawer named me.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "344aca65-92e0-4038-8bd1-c65cb5c52068", "text": "Yes.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "225e1d29-dd5f-4ea6-b329-0bdf5a9b7441", "text": "He knew before Kurash died?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "40f295b8-984a-43c4-96a0-f1cdf8561fdd", "text": "No.", "speaker": "The Collector", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a5699a15-6669-43ac-bc6b-1110daa2f2a6", "text": "The answer came too quickly.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ca103b8d-ff36-429c-b46e-3fade3fdcff8", "text": "Zik noticed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7fe4091f-ecb1-4232-8f65-1f5150520419", "text": "So the tablet changed.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "92d8c2be-4d90-4d39-b260-89ab9a0df68e", "text": "Silence.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "09a6a626-919a-4fd0-9a34-d4995d96584d", "text": "Balag looked at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e8c5fdf9-8833-44f0-806c-2003600c8f85", "text": "Ninsun stopped resisting Enhedu's grip.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
