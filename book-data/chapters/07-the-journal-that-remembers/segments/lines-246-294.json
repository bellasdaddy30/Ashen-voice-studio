[{"id": "27973d6c-06f9-45a5-a5f2-03f83796e9da", "text": "Ninsun's face changed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "17221374-ee53-409a-adf1-2d03bea85624", "text": "How fresh?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2168c7d9-a4ab-46b4-9dd1-5104e2fc4ad9", "text": "The edges haven't dried.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fea3d484-4ea4-4ff3-8fa9-666de94e7337", "text": "The nearest print darkened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "76013de3-fee6-4002-8f6a-fa761c462bbb", "text": "Water gathered inside it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f2b88dc2-525c-4016-b611-bc7090dbf856", "text": "Black water.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b4e71ace-46c5-4378-9eb4-5f14f66cccd0", "text": "Ninsun took one step toward the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ce49209d-9ed9-45d3-a384-6f57324f0862", "text": "Zik caught her wrist.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f0b1524a-21f4-4b8a-80f8-397d0e534162", "text": "She tried to pull free.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ccb90e97-82b8-49bb-bf7f-7ff164be1756", "text": "My sister—", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ce4c3676-4f8b-48f7-bdba-cb9eb1c5f0da", "text": "Is not a pigeon.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d72ef512-d36b-4967-a2d4-dedb74a065e0", "text": "You don't know that she isn't in there.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a35d2ba0-669b-4cb8-9fce-0388d1d472ef", "text": "I don't know what 'there' is.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "680039d6-2c5f-4f12-bea5-81e9144dd274", "text": "The passage narrowed again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "24e997cb-0359-4fae-bb8e-ed72985fc6ef", "text": "Ninsun's voice sharpened.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fb385a3d-b48a-485a-a243-f7623f086636", "text": "Let go.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "be519ba4-0dc3-4ce0-9b76-e65932291e85", "text": "Not until the wall closes.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f5f5105a-93d3-44a2-9c1d-cd54a9e2b0b5", "text": "That could be the only opening we get.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5dadb06d-aa04-443c-a676-7de325346f80", "text": "Then we get another.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a4e03b70-ca17-4c39-a409-edc8dd809663", "text": "You don't know that.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9d803580-a184-4799-bd68-64a585825bdf", "text": "No.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "362fe1dc-f830-4caf-b4d0-ca63b0b82c57", "text": "Zik looked at the wet footprints disappearing into the dark.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3f4f2ca6-cbf4-42c1-a907-65aa1a4149f1", "text": "But whatever made this wants us to hurry.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3100513e-7e1b-43a1-ac27-08239a92b0fa", "text": "The bricks moved closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3b24a6b2-c178-4e26-b0e3-6e27acac1e6b", "text": "Ninsun stopped pulling.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "27de81ec-905e-4114-bbdb-4e02821cae8b", "text": "The last sliver of passage showed only blackness.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "66c67a66-c1d4-4cd6-af46-3869aa83c870", "text": "Something shifted inside it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8d501d30-82e1-4703-b7e9-f76e83b3856d", "text": "Not a person.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "363c5d96-a644-4412-81d9-40c3cf37ed50", "text": "Too tall.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7fe9b5b6-07c4-463c-b5db-cb4fe2f6dfd3", "text": "Too narrow.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f77fc11a-3c77-4640-a969-43f59637e757", "text": "Then the bricks met.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ededd83a-ffeb-4e9c-92e9-7e8006f880fb", "text": "The wall sealed itself.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "01504039-6a88-47a8-83c4-8d4f5517d85f", "text": "No seam remained.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "93722ffd-192c-4353-bc7f-de42e5884664", "text": "Only the dry fountain, the stopped air, and four people who could no longer pretend the city was merely built over something ancient.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f98bcee1-962f-45ea-9915-91966e806627", "text": "Ninsun looked down at Zik's hand around her wrist.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3bf1852b-63e4-410d-b910-23d35834abc9", "text": "He released her.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "83dcf04d-bf9f-430d-bef4-9af4f52bda17", "text": "She rubbed the pale marks his fingers had left.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "04f7cea2-8cce-46c5-96be-69f0dec2c609", "text": "The ink is still wet, isn't it?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7398861f-d91d-4aa5-a9ef-b9bd429ee290", "text": "she asked.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "0623d765-9938-4bc1-8cb2-52f233890355", "text": "Zik felt the journal's weight inside his satchel.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9b2eceaf-7952-4f48-86b2-4780cb7b6573", "text": "I didn't tell you about the new writing.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e694e272-c798-409d-9252-6eeb5b1430ca", "text": "I know.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "854ee780-ff67-4719-ad9a-bcb93e7da1c8", "text": "Her gaze dropped to his wrapped hand.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "684e4d20-2419-4340-ba55-adace091aeba", "text": "The old tablets say the First City was never a place of the living. It was built as a seal. A lid. Every so often the seal weakens, and something underneath begins to notice the people walking above it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "1ea8ea20-bc07-4968-9680-ea7ca2dfdc30", "text": "Zik closed his hand around the satchel strap.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "72f14947-a1f9-4c57-869b-ee5afc569c1e", "text": "We leave before the fog lifts again.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a1a65568-598c-42ef-abb8-01ade5072c21", "text": "No one argued.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f9c02b80-ac0a-4e2f-b4a4-131241bb61d6", "text": "He had not told them about the final mark the journal had drawn.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4c8992fd-3e91-43d6-9a8d-b7a61645e494", "text": "He had not told them that the message used the name his father only spoke when frightened, or when trying to make certain his son was listening.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
