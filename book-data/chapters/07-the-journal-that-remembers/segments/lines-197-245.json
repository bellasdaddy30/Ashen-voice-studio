[{"id": "1bab370b-702f-4189-9292-8b967c093083", "text": "Balag turned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "49c3f651-381b-4ec1-a62a-8d88dd64b36c", "text": "It still should be.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "56ab9fd4-6d56-433c-9b51-73a889c2fe25", "text": "Ninsun did not look surprised.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7924abbd-94b8-4afd-8b33-dbe6e642d719", "text": "She looked tired.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "bfce2bd2-7e1b-4bdb-8ef1-ac9e618a93a6", "text": "The fog isn't thick enough.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8f13ab7a-35e1-4643-af71-175395854394", "text": "Balag gripped his spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1ec1fc06-2c7d-4f8b-9563-74bbcf0101a7", "text": "What does that mean?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7082be41-b1b6-48a5-8205-52c53a62b39d", "text": "It usually hides the change.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "519fbe9e-92b9-47d0-8a29-d72bbd411253", "text": "The pigeon stepped into the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eaff72cf-a0d0-4a39-b2e5-d8e90bda52cf", "text": "Halfway through, it vanished.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f58b66ba-4b47-47d6-ad2e-40eeb76730fd", "text": "Not flew.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "14e85895-f39a-4172-bf68-8fceb71f4f4e", "text": "Not turned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d7a751a4-2d91-4a1a-bd9c-c5c5be83b905", "text": "Vanished between one pace and the next.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d1bfb117-a938-4016-8719-55e3d7e2ae85", "text": "Balag rose with his spear in both hands.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a0ec6f55-a795-40c3-8832-3df2c0188989", "text": "Enhedu moved away from the pillar, knife low at her side.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ac3b755b-0518-43d0-b92c-4556d435f46c", "text": "Zik crossed the courtyard until he stood three strides from the opening. The bricks around it looked old. More than old. Worn smooth at shoulder height by generations of people passing through.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7183f72c-fe1f-4242-a078-97b0a37813e5", "text": "A line of pale clay footprints marked the floor inside.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "7f6a5a3f-9b9c-48d7-94b6-e7d0a3feb586", "text": "They entered from the courtyard.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3dea33a0-560e-40be-b9bc-67f86851366e", "text": "None came back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1af39657-5e31-43e5-abfc-18887fd48cdf", "text": "Ninsun's voice came quietly behind him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1e20b160-7a41-4fe3-95d9-f7f3f90c007c", "text": "My sister walked into a district that shouldn't have existed three years ago.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "006f7020-3574-4ca4-a9b1-339c53537712", "text": "Zik did not take his eyes from the passage.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "17eed5de-e711-428e-a5f3-8b097cf728a4", "text": "The streets rearranged themselves around her. When the fog lifted, she was gone. The city records never listed her. No one else remembers her name except me.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ddf2ac29-de2b-42c3-85e9-b5a5b4cc1bbe", "text": "The courtyard went still.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "753ad0ed-37d8-45b4-b2d0-34db8a4031d6", "text": "Enhedu's knife stopped moving.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f5731267-f2c6-4b67-8c16-ce537cfa7453", "text": "Balag looked from the wall to Ninsun.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "597d9ba4-7545-4ba5-8f20-e2787769afe6", "text": "Her voice stayed level.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "1796b5ea-a5c9-451c-9c06-1f6d66a48659", "text": "I've spent every year since then in the lower archives trying to prove the old texts were not metaphor. The Seven Gates. The lid over the Great Below. The queen who never leaves her throne. I thought if I could map the changes, I might find where the City took her.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "4c43c99b-65b6-4146-8e7b-71954e482ff3", "text": "She met Zik's eyes.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b756847e-1038-4b33-970a-8c638b457a4a", "text": "Your mark is the same symbol that appears on the oldest underworld seals. The ones no living scribe will copy.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d48d6a44-b8ef-439f-99bc-5697fdc91db0", "text": "The doorway shuddered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "24b7f2fe-a99a-4968-beec-7c068cfa33d5", "text": "For one instant the passage beyond appeared flooded with black water.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d6efee53-9939-4ee5-9b92-2a270b346f31", "text": "Then it was only shadow again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "be468bfd-a7ca-414d-9317-38020707df7a", "text": "Zik tasted the dream at the back of his throat.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "82feaeb9-1540-4f7a-b99e-127ad68c600b", "text": "The impossible doorway began to narrow.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "daab4ad7-92cc-4041-a0db-bc1f24006f1b", "text": "The old bricks slid toward one another without sound.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "aff1548b-bf29-4758-a853-ce8ada0a2670", "text": "Zik stepped forward.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e92d66a1-dc42-4565-a5d5-0c526e81c26a", "text": "Balag caught the back of his tunic.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d1cb15f8-704d-4590-8096-1b8739345f94", "text": "No.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "573fda01-b8bf-447c-baf9-cfb82e828599", "text": "There are prints.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dc354707-e6eb-4860-b0ce-aa10214b80e7", "text": "There are always prints.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c095873f-3ee0-4fc9-90cf-abd1e320fc95", "text": "Not like these.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "08b47138-78f1-4e39-b0bb-8a5091bf7928", "text": "Do the prints carry spears?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7ca9824a-a7c3-4bf1-8fdf-3dca08bae228", "text": "Zik looked at him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fd578eb0-2047-4e0b-a652-54a141c0f2a0", "text": "Balag tightened his grip.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8085e3ad-e498-49ce-9238-600e3d9f2f32", "text": "Then they can wait.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3afffd97-5fd9-4edb-83e5-f25e188655dc", "text": "The gap narrowed to the width of a man's shoulders.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "63b83b6f-9340-4ab2-9db3-9692cc52d791", "text": "Enhedu stepped closer, studying the clay footprints.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "625bc73f-1653-41e9-b564-919597e78fbf", "text": "They're fresh.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
