[{"id": "391550da-006e-417e-a7b1-cd0a60065d5a", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "67bd1e4f-3d3f-4c78-ba6a-5aecab52b1e0", "text": "With stone from where?", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7804bcd0-8b37-4390-8dc1-d7020f2b67c1", "text": "Ninsun took a folded scrap of parchment from her sleeve and opened it across the rim.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "72da0c71-79f4-4954-ba77-6ae70bdd8e8b", "text": "A charcoal rubbing covered the page.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b9bb24ad-dcb3-4739-b94b-f67f074ac707", "text": "Seven lines of cuneiform curved around the drawn outline of the basin.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "c25f3f4e-3331-4ff9-a82c-b820a10ba226", "text": "Zik looked from the rubbing to the fountain.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "2a1a7499-8fe6-4449-bc67-87845194ff4a", "text": "The stone beneath Ninsun's hand was blank.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "47ac5cba-4daf-460b-b814-f62a7ff2398c", "text": "What did it say?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "7470f7d1-fb34-416e-83a2-60330c154bd3", "text": "An offering inscription.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "22815226-a3ce-4e82-acfa-88aabab655a4", "text": "She held the parchment toward him.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "53d2397b-21d7-4ce2-8a12-01b6c816500a", "text": "To the Lady Beneath, Keeper of the Seventh Door, that she may drink and remain below.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cd0ba28c-25d6-4d22-b5ad-2f70e2c23066", "text": "Balag's hand tightened on his spear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "10168760-d751-407e-b13c-06cf7a003b91", "text": "You copied that here?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "28ceec08-43fa-4185-8830-5611747b11bf", "text": "Three nights ago.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c66e41c6-af6c-4381-b2b8-8662c2593232", "text": "Enhedu came closer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "20b87c58-5a63-4a12-84fd-8d66aba3a819", "text": "And now it's gone.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "955651f9-d7e1-494e-86a6-699eed2a561d", "text": "The cuts were deep enough to catch the charcoal.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9e638eb8-e31c-4602-90d9-04ac5eb0f944", "text": "Ninsun pressed her thumbnail into the smooth stone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6b081e2f-0bd6-424f-a36c-5dd0efae67ad", "text": "Now there isn't even a scar.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f1987e9b-fa2f-42a8-844f-774b1fa38cbc", "text": "Zik took the rubbing.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a4b67658-219f-4eab-8cab-3cb6fdd8b03f", "text": "The marks were clear. Uneven in places where the paper had slipped, but clear enough that no one could mistake them for accidental scratches.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f0c0287f-e707-4c93-b624-71c9262aac16", "text": "Who else saw it?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6ac638bb-0f2f-4858-a458-7b79c658117f", "text": "The innkeeper.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c578bb21-40e6-4ace-83ec-364c2278389e", "text": "Does he remember?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f7bf631b-02dc-44e5-aa17-997658d57bd9", "text": "He remembers me wasting charcoal on a blank fountain.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "274a2e42-e99f-4b87-acfc-d0508bf504f1", "text": "Balag stood.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "29d41e9a-7282-489e-a18c-18bb24543f43", "text": "I don't like that.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "132587b1-caa7-47ea-90c6-f48d440c4acc", "text": "You don't like most things,", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "3ee3cf29-0ba4-4d5c-bd29-916eb07d4cab", "text": "Enhedu said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "7b00267f-3c13-41f7-940e-3428a4ecea6e", "text": "I'm right about most things.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "79a51699-f3bf-4f7f-8069-5ce878664014", "text": "Zik read the inscription again.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "eaee3e1d-8101-4934-b3ed-1e5de2c9ae3b", "text": "The Lady Beneath.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fa967545-d453-4960-83c2-efb87781d1b6", "text": "The Seventh Door.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "baaf138b-eed9-4c77-bc0d-54fe63db7f99", "text": "Remain below.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "22a3adf3-2a25-4cca-8810-4a7bcee38fe7", "text": "His father's message shifted inside his satchel with the movement of his breath.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b7a3d07a-11ed-4ec1-84d8-0a9ba3730a32", "text": "It erased the stone,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "92462175-b79d-4d5b-8127-207f2a258e8a", "text": "he said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "e4552aa4-88cc-430f-8c3d-477d8963d684", "text": "Ninsun looked toward the buildings beyond the courtyard.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "de825a19-9593-4078-ac98-f253c2a3b351", "text": "Or replaced it.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fe13171c-0074-43ae-a3b8-da0f2e5eb0e3", "text": "With what?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "318603bc-d0b8-466a-9121-95cee46a34fd", "text": "The fountain everyone remembers.", "speaker": "Ninsun", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6c09decd-871e-405b-93bb-abfe16007a10", "text": "For the first time, Balag had no quick answer.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b3ebcc5d-94d7-4a82-9a99-ca8975fd2abf", "text": "A pigeon landed on the courtyard wall. It took two steps, stopped, and cocked its head toward an empty doorway at the far end.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "cbcbec20-f376-48df-8e01-b693bfccdaa2", "text": "Zik frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "997e9e0c-278c-4019-a5c7-47446922416d", "text": "There had not been a doorway there when he entered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f5fa75d3-294e-4071-b24b-c0502f9ac425", "text": "He was certain of it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "10a5ebb5-7256-40ca-86e6-e50f18b6405b", "text": "The opening was narrow, framed by mud brick darkened with age. A passage ran beyond it for several paces before bending out of sight.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "406f0f12-9d32-4119-bca6-fdad31faf3ca", "text": "Enhedu followed his gaze.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "df6202c2-b1bf-482a-ab36-9b60a731ad3e", "text": "That was a wall.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false}]
