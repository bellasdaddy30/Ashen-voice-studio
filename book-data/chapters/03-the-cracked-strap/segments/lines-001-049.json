[{"id": "82b0c408-17a1-4db7-ad7c-7d61c75ac9fd", "text": "CHAPTER 3", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.65, "delivery": "solemn", "note": "Chapter heading.", "generated": false},
{"id": "18e6a0ca-9ae0-48e6-89de-f2ff2199d362", "text": "The Cracked Strap", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.8, "delivery": "solemn", "note": "Chapter title. Leave a clean beat before story begins.", "generated": false},
{"id": "626b3cc9-3a75-4565-9b3a-19670cdfc699", "text": "By mid-morning the heat had climbed into that dry weight that made thinking feel expensive. One of the donkeys started favoring its left hind leg just after they crossed a stretch of hardpan. Balag noticed first. He always did.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0ba489fa-adc1-4405-84a6-6ba5a544911b", "text": "They stopped in the thin shade of a dead acacia that looked like it had argued with the wind for a century and finally lost. Balag crouched beside the animal, hands moving down the leg with the careful attention of someone who trusted what his fingers told him more than anything a person might say.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "23af710c-9eb5-41b9-b3f5-f325aa928dd4", "text": "Not the leg,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "8919eaf2-f3f4-44d7-a6b7-b1c8d7eb3662", "text": "he muttered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "7f2fe577-f1e5-4a55-9db8-8b6802d904c9", "text": "Strap's gone soft. Leather's cracking through.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a65206e9-28b7-427c-aad6-29951cae0c0f", "text": "Enhedu squinted at the sun.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "1d750826-79cd-40a4-a8e5-31ef9c54141c", "text": "Spare?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b5e379b4-a816-4e42-96d1-091ec4cf8542", "text": "One. Older than this one.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "2fa450b0-832f-4ec2-aa62-42d0e4466960", "text": "Zik dropped his pack and knelt without being asked. He pulled the damaged strap free and turned it over. The leather had dried and split along the stress line where the buckle bit. Not finished yet, but another day of this heat and it would go completely.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4b40e2d0-f8cb-4b15-9cc8-815a8b77c006", "text": "He dug out a short length of braided cord and the small bronze awl he kept for quiet failures like this. The others watched while he worked. He scored the cracked section, cut away the worst of the dry edge, drove new holes, then rebound the strap in a tight overlapping pattern that would take the load better than the original leather ever had.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f052007c-149a-472a-9a8b-e5a9e6c5a525", "text": "It wasn't pretty. It didn't need to be.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ccef62b0-12e8-4565-b961-7ace68b9077b", "text": "Balag rolled the repaired strap between his hands, pressing a thumb against every new stitch.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "967bcd38-7633-4780-8524-d8853320fafe", "text": "You always sew like you're angry.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cecfa8fa-2b69-4ebe-8b07-d57a8f33e480", "text": "I'm not sewing.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "ced0d7ea-d520-4c1c-964a-427a88b77bec", "text": "No?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c0579f34-41ad-457e-9ad1-99a1d3c4b1ef", "text": "I'm arguing with bad leather.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "409a1240-8ea5-4776-a59d-4f822171832f", "text": "Balag snorted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "af620ccd-b73b-4454-b076-c8add9f28fee", "text": "The leather's losing.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "91964a03-a576-4c36-977f-71ec44d1ec43", "text": "It usually does.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bdc61766-078b-493c-9dbf-3ef245dbf729", "text": "He looped the strap back through the buckle and cinched it tight around the pack frame. The leather creaked in protest but held.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b765256d-737c-497f-8eca-d4c7e1c1c1f4", "text": "Good enough,", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "889463b6-a397-4398-996b-3e5eb4f48726", "text": "Balag said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "5c6595e5-ee7f-4f0e-97da-f4c6aa5a9baa", "text": "It'll outlive the donkey.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "273141f9-88e0-43a6-a99f-81bfc0efd784", "text": "The donkey heard that.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "57a91f4c-4c99-4392-a6aa-686651d0671f", "text": "As if to object, the animal swung its head toward Zik and gave a long, offended bray.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "3a554734-0526-48ec-b24d-ea00654929d1", "text": "Enhedu looked up.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "082d4ecc-42b4-49c2-960f-3fc5015da6f7", "text": "I think it agrees with Balag.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "03ae66bc-a691-47ea-9195-489ed2c232c5", "text": "It always agrees with whoever isn't asking it to work.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "86725d97-4da8-4cbe-aa57-b1242de9b125", "text": "Balag scratched the animal behind one ear.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "40b4db31-e0a5-43bf-9a84-e088b9fccfb2", "text": "You'd complain too if someone expected you to carry half a mountain through the desert.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "02a0d8bc-6fcc-467c-9e7f-65e748bde18b", "text": "I don't complain.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "fcb63b00-a0dc-47f9-bde8-50015ffbf3a4", "text": "You complain constantly.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "dc13295b-42ef-4af8-856c-0032776cd088", "text": "I make observations.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "cdad7106-124d-4fcf-b8a1-fc2e57194330", "text": "Very loudly.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "631ae8b0-e5de-4d24-b385-7d4fe93e52d8", "text": "They're important observations.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5518d6a4-48ff-48af-b687-8217e022e604", "text": "They're mostly about me.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "568afea7-d8ba-479d-b91d-d43043a9337a", "text": "They're the easiest ones to verify.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5b3e2113-b514-4a96-87b8-8572a6555fbe", "text": "For the first time since leaving the tomb, Balag laughed without forcing it.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "58eb31ce-a0a4-4f04-8805-4f121fe672de", "text": "The sound caught all three of them by surprise.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "9e58ba7b-7f96-41d0-b075-9d8c93ed14ca", "text": "It died almost as quickly as it had come.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f416c3ef-b88b-46d1-b300-bad9130b5c73", "text": "Zik busied himself trimming one loose strand from the braided cord.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dd3275a2-451b-4249-859b-0a18d98960b8", "text": "I'd forgotten what that sounded like.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "026dde85-bd22-4060-9e30-d8c461236645", "text": "Balag looked away.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d7322231-9328-4a21-aaca-4d7a3f1a6b56", "text": "So had I.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "80d5e9b6-0b5a-43a1-9229-1046966c0f49", "text": "The silence returned, but it no longer felt like something pressing on their shoulders. It settled beside them instead.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "8afa5af1-ab7b-488a-a6b7-0668cc94ad71", "text": "Enhedu picked up the strip of ruined leather and turned it over in her hands.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "4b3a3f02-46a1-4278-adb3-8ae78c980212", "text": "The crack ran almost perfectly through its center.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
