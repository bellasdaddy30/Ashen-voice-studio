[{"id": "61638cce-0dcc-4328-8082-17fba8fbebf7", "text": "She rubbed her thumb along the brittle edge.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b891d3db-ce73-4155-b891-99dc842d7395", "text": "You know why leather fails here?", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "efcf3ccb-e235-4172-ab14-1975da06dd95", "text": "Balag shrugged.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "ba9d4e06-aec4-40c9-9510-8b7e7c7ef76c", "text": "Because it gets old.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e7406c02-a5ba-4b30-80b3-80f815f6bfe2", "text": "No.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "10f1975d-0372-4700-bbf5-68db35d28f8c", "text": "She handed it to Zik.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6d1ac97d-9f69-4c9d-a041-bff731be46e8", "text": "He'll see it.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c0aab0b7-ff04-44f4-b3f8-baf33c37753c", "text": "Zik studied the split.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "929dbdf1-3d7b-47ad-9026-b7f5e735436d", "text": "It wasn't the weight.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "726995f6-e155-42c6-888b-0488b262a841", "text": "Balag folded his arms.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "d0c29930-8e2e-4996-a9a2-8af74bcbd720", "text": "Go on.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "9af80dac-43c5-4ba3-98fd-543fdd0669ca", "text": "It wasn't the heat either.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e9d28970-8e47-4e08-bafb-3a0156340c40", "text": "He bent the leather gently.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "b5932f08-4bc8-495a-b38e-278a65ef253e", "text": "See these lighter lines?", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c43e090c-6b3a-41fd-b355-c2864f3c7e61", "text": "Neither of them answered.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "f5a2e6d7-917f-4a59-9f7a-df82750941c6", "text": "It was drying from the inside.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "f074de6a-d9ac-4f81-8766-073e4f9fa814", "text": "Balag frowned.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "997e8ee5-7aed-448d-9a60-49f3ea11757a", "text": "Leather can do that?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a241e989-0bc6-45ed-8968-c50a751351c7", "text": "It loses the oils first.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e393c910-2046-4e66-ac6c-373f23e93773", "text": "The outside still looks fine.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6c9dc9ca-9b45-4812-b3e4-aa800004b83b", "text": "Exactly.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "149f0820-21a8-49b1-b4ca-bc62032e5e66", "text": "He handed the scrap back.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a67275d2-42ed-4b80-9802-416f923025f2", "text": "It fails long before it looks broken.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "5245f24c-757c-4012-852c-a60dab8d1021", "text": "Enhedu slipped it into her pouch.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "dbc8189b-c999-4d67-8719-d9b11b116bf8", "text": "Useful thing to remember.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d59fa423-96fd-4955-bc05-8fc16016a59d", "text": "Balag raised an eyebrow.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6811ba74-4735-4d6b-8d38-aadede97adde", "text": "For leather?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "57c46d38-ddfd-4bc6-9550-322d090addee", "text": "For people.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "47708113-1fdf-4484-80af-51da293f0061", "text": "Neither man argued.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "fc62b9e5-9f45-4d78-8b66-76381fc81620", "text": "Balag tested the repair with two hard tugs and grunted.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "3739e82e-1705-418f-a941-9b6714d73e58", "text": "It'll hold.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "6b177056-4d23-4823-8190-1757426f0e97", "text": "Until it doesn't,", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "13226b0f-dd5d-4361-a08a-15e8928da213", "text": "Zik said.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "542028ec-5d75-44d1-9ab2-87757347ab1b", "text": "Same as everything else.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "e1b77619-ff8e-4c3f-b76e-ea5420aa9e3f", "text": "Enhedu reached down, picked up the scrap of ruined leather Zik had cut away, and slipped it into a pouch at her belt without comment. Balag noticed.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "6db55fda-499c-43ec-bd00-b6f46430530a", "text": "What the hell do you want with that?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "acd3924a-2b98-4b50-bac4-ef67406f8f3b", "text": "Waste bothers me.", "speaker": "Enhedu", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "a115412c-6e05-496e-aa5a-93c2d7720425", "text": "That was all she offered. She turned the scrap once between her fingers, then left it alone.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "65982475-c589-4ea6-a421-1f942e4e4430", "text": "They rested longer than the schedule allowed. The animals needed it more than anyone wanted to admit. Zik sat with his back against the dead tree and took the journal out only long enough to confirm the last page hadn't changed. Three lines. No new ink. He closed it and, for the first time since the tomb, deliberately left it in the pack instead of keeping it against his ribs.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "74af9327-f1d9-4d72-a710-e61637b49273", "text": "The decision felt small. It also felt like the first thing he had chosen rather than reacted to since the skeleton spoke his name.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "81e82d34-cbe5-460c-b1cc-11f25265dd61", "text": "Balag noticed him staring at nothing in particular.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "e9f3b5de-ad3a-46a0-bc94-50e8f8fd371a", "text": "You thinking about the Collector?", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "bed6df37-b282-49da-87fa-0f74876c3fd0", "text": "Thinking about how much silver it takes to keep a mother in medicine and a crew in rope.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "d47361b3-ea1a-4493-b40d-9235faa458fa", "text": "Balag spat into the dust.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.16, "delivery": "neutral", "note": "Short attribution/action beat; keep tight to surrounding dialogue.", "generated": false},
{"id": "6b751737-6972-4314-9d07-95c881129eba", "text": "Same fucking math again.", "speaker": "Balag", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "b016c816-2a0d-4027-b3c8-ac5c0ef6c299", "text": "Always is.", "speaker": "Zik", "type": "dialogue", "confidence": 1, "pause": 0.28, "delivery": "neutral", "generated": false},
{"id": "c4d5fb00-efe1-4923-a1f8-8fcb7309d207", "text": "They moved on once the shadow of the acacia had shrunk to nothing useful. The repaired strap held. The donkeys settled into their usual sullen rhythm. The journal stayed in the pack, quiet for once.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "a93925ec-d029-4567-bec9-235d96d3bdf2", "text": "Late afternoon the wind shifted and brought the faintest smell of smoke and river mud. Uruk was still a day out, but the desert had started remembering there were cities in the world.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false},
{"id": "0f0f7ecd-77bc-4b72-b027-247584f67891", "text": "Zik flexed his left hand inside the linen. The mark was warm again. Not painful. Just present, like a second pulse that hadn't been invited.", "speaker": "Narrator", "type": "narration", "confidence": 1, "pause": 0.38, "delivery": "measured", "generated": false}]
